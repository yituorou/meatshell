import { Theme } from "theme.slint";
import { ModalLayer } from "modal.slint";
import { GhostButton } from "widgets.slint";
import { ScrollView } from "std-widgets.slint";

// A destructive (red) action button, matching PrimaryButton's shape.
component DangerButton inherits Rectangle {
    in property <string> text;
    callback clicked();
    height: 30px;
    min-width: 80px;
    border-radius: Theme.radius-sm;
    background: touch.pressed ? #c44a4a : (touch.has-hover ? #ec6a6a : Theme.danger);
    animate background { duration: 120ms; }
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        alignment: center;
        Text {
            text: root.text;
            color: white;
            font-size: Theme.fs-md;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// In-app modal confirmation dialog, styled to match the rest of meatshell
// (a dark card over a dimmed backdrop, like SessionDialog).  Purely
// presentational: it emits `confirm` / `cancel` and the caller decides what
// to do.  Used for the irreversible SFTP delete (#28).
export component ConfirmDialog inherits ModalLayer {
    in property <string> title: @tr("Please confirm");
    in property <string> message;
    in property <string> detail;                  // optional, e.g. the file path
    in property <string> confirm-label: @tr("Confirm");
    // Opt in per call site: destructive confirmations must not become
    // keyboard-confirmable merely because they share this component.
    // ModalLayer defaults confirm-on-enter to false.
    // Long AI prompts and other large multi-line pastes need a review surface
    // comparable to the system-information window, with fixed footer actions.
    in property <bool> large-detail: false;
    // Temporarily hide this modal behind a higher-priority prompt without
    // discarding its state (for example, app-exit confirmation).
    // ModalLayer hides covered dialogs while preserving their state.
    // Whether clicking the dimmed backdrop dismisses (cancels) the dialog. Off for
    // security prompts (e.g. host-key trust) so an accidental click outside the card
    // doesn't count as "reject" and abort the connection (#152).
    dismiss-on-backdrop: true;
    // An optional non-confirming action, e.g. save a session while testing it.
    in property <string> secondary-label;
    callback secondary();
    callback confirm();
    callback cancel();

    background: #000000aa;
    cancel-requested => { root.cancel(); }
    confirm-requested => { root.confirm(); }

    Rectangle {
        width: root.large-detail ? min(parent.width - 40px, 1160px) : 380px;
        height: root.large-detail ? min(parent.height - 40px, 760px) : card.preferred-height;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: Theme.popup-bg;
        border-radius: Theme.radius-lg;
        border-width: 1px;
        border-color: Theme.border-strong;
        drop-shadow-blur: 24px;
        drop-shadow-color: #00000080;

        // Swallow clicks inside the card so they don't hit the backdrop.
        TouchArea { width: 100%; height: 100%; }

        card := VerticalLayout {
            padding: 20px;
            spacing: 12px;

            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: "⚠";
                    color: Theme.danger;
                    font-size: Theme.fs-xl;
                    vertical-alignment: center;
                }
                Text {
                    text: root.title;
                    color: Theme.text-primary;
                    font-size: Theme.fs-xl;
                    font-weight: 600;
                    vertical-alignment: center;
                }
            }

            Text {
                text: root.message;
                color: Theme.text-secondary;
                font-size: Theme.fs-md;
                wrap: word-wrap;
            }

            if root.detail != "" && !root.large-detail : Text {
                text: root.detail;
                color: Theme.text-primary;
                font-family: Theme.font-mono;
                font-size: Theme.fs-sm;
                wrap: word-wrap;
            }

            if root.detail != "" && root.large-detail : Rectangle {
                vertical-stretch: 1;
                min-height: 220px;
                background: Theme.bg-root;
                border-width: 1px;
                border-color: Theme.border-subtle;
                border-radius: Theme.radius-sm;
                clip: true;

                detail-scroll := ScrollView {
                    x: 1px;
                    y: 1px;
                    width: parent.width - 2px;
                    height: parent.height - 2px;
                    viewport-width: self.visible-width;
                    viewport-height: max(self.visible-height, detail-text.preferred-height + 16px);

                    detail-text := Text {
                        x: 8px;
                        y: 8px;
                        width: max(1px, detail-scroll.visible-width - 16px);
                        text: root.detail;
                        color: Theme.text-primary;
                        font-family: Theme.font-mono;
                        font-size: Theme.fs-sm;
                        wrap: word-wrap;
                    }
                }
            }

            HorizontalLayout {
                alignment: end;
                spacing: 8px;
                if root.secondary-label != "" : GhostButton {
                    text: root.secondary-label;
                    clicked => { root.secondary(); }
                }
                GhostButton {
                    text: @tr("Cancel");
                    clicked => { root.cancel(); }
                }
                DangerButton {
                    text: root.confirm-label;
                    clicked => { root.confirm(); }
                }
            }
        }
    }
}
