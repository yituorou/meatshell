// Detachable process-monitor window (#23 follow-up).
// Redesigned with a native macOS Activity Monitor / ChatGPT-style tabular card,
// inline CPU gauge, click-to-copy PID, and one-click hover Terminate button.

import { Theme, ThemePalette } from "theme.slint";
import { ModalScope, ModalLayer } from "modal.slint";
import { LabeledInput, GhostButton, OutlineIcon } from "widgets.slint";

export struct ProcRow {
    tab-id: string,
    pid: string,
    user: string,
    cpu: string,       // "12.3" (percent, one decimal)
    mem: string,       // "4.5"
    command: string,   // truncated args
    cpu-frac: float,   // 0.0..1.0, drives the row load bar
    own-process: bool, // may terminate without root authentication
}

component ProcMenuItem inherits Rectangle {
    in property <string> label;
    callback clicked();
    height: 30px;
    border-radius: Theme.radius-sm;
    background: menu-touch.has-hover ? Theme.bg-hover : transparent;
    menu-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    Text {
        text: root.label;
        color: Theme.danger;
        font-size: Theme.fs-sm;
        vertical-alignment: center;
        x: 10px;
    }
}

component ProcDangerButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    callback clicked();
    height: 32px;
    min-width: 96px;
    border-radius: Theme.radius-sm;
    background: !root.enabled ? Theme.bg-hover
        : danger-touch.pressed ? #c44a4a
        : danger-touch.has-hover ? #ec6a6a
        : Theme.danger;
    danger-touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
    Text {
        text: root.text;
        color: root.enabled ? white : Theme.text-muted;
        font-size: Theme.fs-md;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component ProcWindow inherits Window {
    title: "meatshell — " + @tr("Processes");
    icon: @image-url("../assets/icon.png");
    in property <bool> pinned: false;
    always-on-top: root.pinned;
    in-out property <bool> dark-mode <=> Theme.dark;
    in-out property <float> ui-scale <=> Theme.ui-scale;
    in-out property <string> ui-font-family <=> Theme.ui-font-family;
    in-out property <image> wallpaper-img <=> Theme.wallpaper;
    in-out property <bool> wallpaper-active <=> Theme.wallpaper-active;
    in-out property <color> wp-accent <=> Theme.wp-accent;
    in-out property <color> wp-tint <=> Theme.wp-tint;
    in-out property <ThemePalette> theme-palette-dark <=> Theme.palette-dark;
    in-out property <ThemePalette> theme-palette-light <=> Theme.palette-light;
    in-out property <bool> immersive-colors <=> Theme.immersive;
    default-font-family: Theme.ui-font-family;
    in property <bool> is-mac: false;
    in property <bool> custom-titlebar;
    no-frame: root.custom-titlebar;
    in property <[ProcRow]> proc-list;
    in property <string> host;

    in-out property <string> action-status;
    in-out property <bool> action-busy;
    in-out property <bool> action-error;
    property <string> selected-pid;
    property <string> selected-tab-id;
    property <string> selected-user;
    property <string> selected-command;
    property <bool> selected-own-process;
    property <bool> terminate-dialog-open;
    property <bool> terminate-dialog-pending;
    property <string> root-password;
    property <length> menu-x;
    property <length> menu-y;

    callback close-window();
    callback win-drag();
    callback win-resize-se();
    callback copy-pid(string);
    callback terminate-process(string /* tab id */, string /* pid */, string /* root password, empty for own process */);

    terminate-dialog-timer := Timer {
        interval: 0ms;
        running: root.terminate-dialog-pending;
        triggered => {
            root.terminate-dialog-pending = false;
            root.terminate-dialog-open = true;
        }
    }

    min-width: 560px;
    min-height: 360px;
    preferred-width: 780px;
    preferred-height: 560px;
    background: Theme.window-base;

    if Theme.wallpaper-active : Image {
        x: 0; y: 0;
        width: parent.width;
        height: parent.height;
        source: Theme.wallpaper;
        image-fit: cover;
    }

    Rectangle {
        width: parent.width;
        height: parent.height;
        background: Theme.bg-panel;
    }

    ModalScope {
        active: !root.terminate-dialog-open;
        is-mac: root.is-mac;
        cancel-requested => { root.close-window(); }

        VerticalLayout {
            spacing: 0;

            // --- macOS title strip -------------------------------------------
            if root.is-mac && !root.custom-titlebar : Rectangle {
                height: 32px;
                background: Theme.bg-panel;
                Text {
                    x: 80px;
                    width: parent.width - 160px;
                    height: parent.height;
                    text: @tr("Processes") + (root.host != "" ? "  ·  " + root.host : "");
                    color: Theme.text-secondary;
                    font-size: Theme.fs-xs;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }

            // --- Custom titlebar (frameless platforms) -----------------------
            if root.custom-titlebar : Rectangle {
                height: 38px;
                background: Theme.bg-panel;
                tb-drag := TouchArea {
                    pointer-event(e) => {
                        if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                            root.win-drag();
                        }
                    }
                }
                HorizontalLayout {
                    padding-left: 14px;
                    spacing: 8px;
                    VerticalLayout {
                        alignment: center;
                        OutlineIcon {
                            name: "cpu";
                            color: Theme.text-primary;
                            icon-size: 16px;
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        Text {
                            text: @tr("Processes") + (root.host != "" ? "  ·  " + root.host : "");
                            color: Theme.text-primary;
                            font-size: Theme.fs-sm;
                            font-weight: 600;
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Rectangle {
                        width: 46px;
                        background: close-ta.has-hover ? #e81123 : transparent;
                        close-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.close-window(); }
                        }
                        OutlineIcon {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            name: "close";
                            color: close-ta.has-hover ? white : Theme.text-secondary;
                            icon-size: 15px;
                        }
                    }
                }
            }

            // --- Main Dashboard Content --------------------------------------
            VerticalLayout {
                padding-left: 16px * Theme.ui-scale;
                padding-right: 16px * Theme.ui-scale;
                padding-top: 8px * Theme.ui-scale;
                padding-bottom: 16px * Theme.ui-scale;
                spacing: 10px * Theme.ui-scale;

                // Top Summary & Status Bar
                HorizontalLayout {
                    height: 32px * Theme.ui-scale;
                    spacing: 10px * Theme.ui-scale;
                    alignment: start;

                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 28px * Theme.ui-scale;
                            height: 28px * Theme.ui-scale;
                            border-radius: 7px;
                            background: Theme.accent.with-alpha(0.12);
                            OutlineIcon {
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                name: "cpu";
                                color: Theme.accent;
                                icon-size: 15px * Theme.ui-scale;
                            }
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        Text {
                            text: @tr("Processes");
                            color: Theme.text-primary;
                            font-size: Theme.fs-lg;
                            font-weight: 700;
                        }
                    }

                    if root.host != "" : VerticalLayout {
                        alignment: center;
                        Rectangle {
                            height: 22px * Theme.ui-scale;
                            width: host-chip.preferred-width + 16px;
                            border-radius: 6px;
                            background: Theme.dark ? Theme.bg-elevated : Theme.bg-root;
                            border-width: 1px;
                            border-color: Theme.border-subtle;
                            host-chip := Text {
                                text: root.host;
                                color: Theme.text-secondary;
                                font-family: Theme.font-mono;
                                font-size: Theme.fs-xs;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                width: 100%;
                                height: 100%;
                            }
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            height: 22px * Theme.ui-scale;
                            width: cnt-chip.preferred-width + 14px;
                            border-radius: 6px;
                            background: Theme.accent.with-alpha(0.12);
                            cnt-chip := Text {
                                text: root.proc-list.length + " 进程 (按 CPU 排序)";
                                color: Theme.accent;
                                font-size: 11px * Theme.ui-scale;
                                font-weight: 600;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                width: 100%;
                                height: 100%;
                            }
                        }
                    }

                    Rectangle { horizontal-stretch: 1; }

                    if root.action-status != "" : VerticalLayout {
                        alignment: center;
                        Rectangle {
                            height: 24px * Theme.ui-scale;
                            width: status-txt.preferred-width + 16px;
                            border-radius: 6px;
                            background: (root.action-error ? Theme.danger : Theme.success).with-alpha(0.14);
                            status-txt := Text {
                                text: root.action-status;
                                color: root.action-busy ? Theme.text-secondary
                                    : root.action-error ? Theme.danger : Theme.success;
                                font-size: Theme.fs-xs;
                                font-weight: 600;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                width: 100%;
                                height: 100%;
                            }
                        }
                    }
                }

                // Elevated Process Table Card
                Rectangle {
                    vertical-stretch: 1;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: Theme.border-subtle;
                    background: Theme.dark ? Theme.bg-elevated : Theme.bg-root;
                    clip: true;

                    VerticalLayout {
                        spacing: 0;

                        // Table Column Header Bar
                        Rectangle {
                            height: 34px * Theme.ui-scale;
                            background: Theme.dark ? #1b1b1b : #f5f6f8;

                            HorizontalLayout {
                                padding-left: 12px * Theme.ui-scale;
                                padding-right: 12px * Theme.ui-scale;
                                spacing: 10px * Theme.ui-scale;

                                Text {
                                    text: "PID";
                                    width: 68px * Theme.ui-scale;
                                    color: Theme.text-secondary;
                                    font-size: Theme.fs-xs;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: @tr("User");
                                    width: 90px * Theme.ui-scale;
                                    color: Theme.text-secondary;
                                    font-size: Theme.fs-xs;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: "CPU%";
                                    width: 108px * Theme.ui-scale;
                                    color: Theme.text-secondary;
                                    font-size: Theme.fs-xs;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: "MEM%";
                                    width: 64px * Theme.ui-scale;
                                    color: Theme.text-secondary;
                                    font-size: Theme.fs-xs;
                                    font-weight: 600;
                                    horizontal-alignment: right;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: @tr("Command");
                                    horizontal-stretch: 1;
                                    color: Theme.text-secondary;
                                    font-size: Theme.fs-xs;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: "操作";
                                    width: 58px * Theme.ui-scale;
                                    color: Theme.text-secondary;
                                    font-size: Theme.fs-xs;
                                    font-weight: 600;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }

                            Rectangle {
                                y: parent.height - 1px;
                                width: 100%;
                                height: 1px;
                                background: Theme.border-subtle;
                            }
                        }

                        // Scrollable Process Rows
                        Flickable {
                            vertical-stretch: 1;
                            content-width: self.width;
                            content-height: max(self.height, proc-col.preferred-height);

                            proc-col := VerticalLayout {
                                alignment: start;
                                padding: 6px * Theme.ui-scale;
                                spacing: 2px * Theme.ui-scale;

                                if root.proc-list.length == 0 : Rectangle {
                                    height: 180px;
                                    Text {
                                        text: @tr("No processes");
                                        color: Theme.text-muted;
                                        font-size: Theme.fs-sm;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }

                                for p[idx] in root.proc-list : Rectangle {
                                    height: 32px * Theme.ui-scale;
                                    border-radius: 6px;
                                    background: row-touch.has-hover || pid-touch.has-hover || kill-ta.has-hover
                                        ? Theme.bg-hover
                                        : (Math.mod(idx, 2) == 1 ? (Theme.dark ? #ffffff05 : #00000004) : transparent);

                                    row-touch := TouchArea {
                                        pointer-event(e) => {
                                            if (e.kind == PointerEventKind.up && e.button == PointerEventButton.right) {
                                                root.selected-pid = p.pid;
                                                root.selected-tab-id = p.tab-id;
                                                root.selected-user = p.user;
                                                root.selected-command = p.command;
                                                root.selected-own-process = p.own-process;
                                                root.menu-x = self.absolute-position.x - root.absolute-position.x + self.mouse-x;
                                                root.menu-y = self.absolute-position.y - root.absolute-position.y + self.mouse-y;
                                                proc-menu.show();
                                            }
                                        }
                                    }

                                    HorizontalLayout {
                                        padding-left: 8px * Theme.ui-scale;
                                        padding-right: 8px * Theme.ui-scale;
                                        spacing: 10px * Theme.ui-scale;

                                        // 1. PID (click to copy)
                                        Rectangle {
                                            width: 68px * Theme.ui-scale;
                                            pid-touch := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => {
                                                    root.copy-pid(p.pid);
                                                    root.action-status = @tr("PID copied") + ": " + p.pid;
                                                    root.action-error = false;
                                                }
                                            }
                                            Text {
                                                text: p.pid;
                                                color: pid-touch.has-hover ? Theme.accent : Theme.text-secondary;
                                                font-family: Theme.font-mono;
                                                font-size: Theme.fs-xs;
                                                font-weight: 600;
                                                vertical-alignment: center;
                                                height: 100%;
                                            }
                                        }

                                        // 2. User
                                        Text {
                                            text: p.user;
                                            width: 90px * Theme.ui-scale;
                                            color: p.user == "root" ? Theme.text-primary : Theme.text-secondary;
                                            font-family: Theme.font-mono;
                                            font-size: Theme.fs-xs;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }

                                        // 3. CPU% with inline mini gauge bar
                                        HorizontalLayout {
                                            width: 108px * Theme.ui-scale;
                                            spacing: 8px * Theme.ui-scale;
                                            VerticalLayout {
                                                alignment: center;
                                                Rectangle {
                                                    width: 56px * Theme.ui-scale;
                                                    height: 5px * Theme.ui-scale;
                                                    border-radius: 2.5px;
                                                    background: Theme.dark ? #2a2a2a : #e5e7eb;
                                                    clip: true;
                                                    Rectangle {
                                                        x: 0; y: 0;
                                                        height: parent.height;
                                                        width: max(p.cpu-frac > 0.005 ? 3px : 0px, parent.width * clamp(p.cpu-frac, 0.0, 1.0));
                                                        border-radius: 2.5px;
                                                        background: p.cpu-frac > 0.80 ? Theme.danger
                                                                  : p.cpu-frac > 0.40 ? Theme.warning
                                                                  : Theme.accent;
                                                    }
                                                }
                                            }
                                            Text {
                                                text: p.cpu + "%";
                                                horizontal-stretch: 1;
                                                color: p.cpu-frac > 0.80 ? Theme.danger
                                                     : p.cpu-frac > 0.40 ? Theme.warning
                                                     : Theme.text-primary;
                                                font-family: Theme.font-mono;
                                                font-size: Theme.fs-xs;
                                                font-weight: 600;
                                                horizontal-alignment: right;
                                                vertical-alignment: center;
                                            }
                                        }

                                        // 4. MEM%
                                        Text {
                                            text: p.mem + "%";
                                            width: 64px * Theme.ui-scale;
                                            color: Theme.text-secondary;
                                            font-family: Theme.font-mono;
                                            font-size: Theme.fs-xs;
                                            horizontal-alignment: right;
                                            vertical-alignment: center;
                                        }

                                        // 5. Command
                                        Text {
                                            text: p.command;
                                            horizontal-stretch: 1;
                                            color: Theme.text-primary;
                                            font-family: Theme.font-mono;
                                            font-size: Theme.fs-xs;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }

                                        // 6. Inline Terminate Action Button
                                        VerticalLayout {
                                            width: 58px * Theme.ui-scale;
                                            alignment: center;
                                            Rectangle {
                                                height: 22px * Theme.ui-scale;
                                                border-radius: 5px;
                                                border-width: 1px;
                                                border-color: kill-ta.has-hover ? Theme.danger : Theme.border-subtle;
                                                background: kill-ta.has-hover
                                                    ? Theme.danger.with-alpha(0.14)
                                                    : (Theme.dark ? #242424 : #f4f5f7);
                                                kill-ta := TouchArea {
                                                    mouse-cursor: pointer;
                                                    clicked => {
                                                        root.selected-pid = p.pid;
                                                        root.selected-tab-id = p.tab-id;
                                                        root.selected-user = p.user;
                                                        root.selected-command = p.command;
                                                        root.selected-own-process = p.own-process;
                                                        root.root-password = "";
                                                        root.terminate-dialog-pending = true;
                                                    }
                                                }
                                                Text {
                                                    text: "结束";
                                                    color: kill-ta.has-hover ? Theme.danger : Theme.text-secondary;
                                                    font-size: 11px * Theme.ui-scale;
                                                    font-weight: 600;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                    width: 100%;
                                                    height: 100%;
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        proc-menu := PopupWindow {
            x: min(root.menu-x, root.width - self.width - 8px);
            y: min(root.menu-y, root.height - self.height - 8px);
            width: 150px;
            height: 42px;
            Rectangle {
                background: Theme.popup-bg;
                border-radius: Theme.radius-sm;
                border-width: 1px;
                border-color: Theme.border-strong;
                VerticalLayout {
                    padding: 6px;
                    ProcMenuItem {
                        label: @tr("Terminate process");
                        clicked => {
                            proc-menu.close();
                            root.root-password = "";
                            root.terminate-dialog-pending = true;
                        }
                    }
                }
            }
        }

        if root.terminate-dialog-open : ModalLayer {
            is-open: true;
            is-mac: root.is-mac;
            cancel-requested => {
                root.root-password = "";
                root.terminate-dialog-open = false;
            }
            width: parent.width;
            height: parent.height;
            background: #00000088;
            dismiss-on-backdrop: !root.action-busy;
            Rectangle {
                width: 440px;
                height: terminate-card.preferred-height;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                background: Theme.popup-bg;
                border-radius: 14px;
                border-width: 1px;
                border-color: Theme.border-strong;
                TouchArea { }

                terminate-card := VerticalLayout {
                    padding: 22px;
                    spacing: 12px;
                    Text {
                        text: @tr("Terminate process");
                        color: Theme.text-primary;
                        font-size: Theme.fs-lg;
                        font-weight: 600;
                    }
                    Text {
                        text: root.selected-own-process
                            ? @tr("Terminate this process? It may lose unsaved data.")
                            : @tr("This process belongs to root or another user. Enter your administrator (sudo) password to continue.");
                        color: Theme.text-secondary;
                        font-size: Theme.fs-sm;
                        wrap: word-wrap;
                    }
                    Rectangle {
                        height: 52px;
                        border-radius: 8px;
                        background: Theme.bg-panel;
                        border-width: 1px;
                        border-color: Theme.border-subtle;
                        VerticalLayout {
                            padding: 8px;
                            spacing: 4px;
                            alignment: center;
                            Text {
                                text: "PID " + root.selected-pid + "  ·  " + root.selected-user;
                                color: Theme.text-primary;
                                font-family: Theme.font-mono;
                                font-size: Theme.fs-xs;
                                font-weight: 600;
                            }
                            Text {
                                text: root.selected-command;
                                color: Theme.text-muted;
                                font-family: Theme.font-mono;
                                font-size: Theme.fs-xs;
                                overflow: elide;
                            }
                        }
                    }
                    if !root.selected-own-process : LabeledInput {
                        label: @tr("Administrator password");
                        placeholder: @tr("Enter sudo password");
                        password: true;
                        auto-focus: true;
                        value <=> root.root-password;
                        accepted => {
                            if (root.root-password != "" && !root.action-busy) {
                                root.terminate-process(root.selected-tab-id, root.selected-pid, root.root-password);
                                root.root-password = "";
                                root.action-busy = true;
                                root.action-error = false;
                                root.action-status = @tr("Terminating process...");
                                root.terminate-dialog-open = false;
                            }
                        }
                        canceled => {
                            root.root-password = "";
                            root.terminate-dialog-open = false;
                        }
                    }
                    HorizontalLayout {
                        alignment: end;
                        spacing: 8px;
                        GhostButton {
                            text: @tr("Cancel");
                            clicked => {
                                root.root-password = "";
                                root.terminate-dialog-open = false;
                            }
                        }
                        ProcDangerButton {
                            text: @tr("Terminate");
                            enabled: !root.action-busy && (root.selected-own-process || root.root-password != "");
                            clicked => {
                                root.terminate-process(root.selected-tab-id, root.selected-pid,
                                    root.selected-own-process ? "" : root.root-password);
                                root.root-password = "";
                                root.action-busy = true;
                                root.action-error = false;
                                root.action-status = @tr("Terminating process...");
                                root.terminate-dialog-open = false;
                            }
                        }
                    }
                }
            }
        }

        if root.custom-titlebar : Rectangle {
            width: 16px;
            height: 16px;
            x: root.width - self.width;
            y: root.height - self.height;
            TouchArea {
                mouse-cursor: nwse-resize;
                pointer-event(e) => {
                    if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                        root.win-resize-se();
                    }
                }
            }
            Rectangle { x: parent.width - 5px;  y: parent.height - 5px;  width: 2px; height: 2px; background: Theme.text-muted; }
            Rectangle { x: parent.width - 9px;  y: parent.height - 5px;  width: 2px; height: 2px; background: Theme.text-muted; }
            Rectangle { x: parent.width - 5px;  y: parent.height - 9px;  width: 2px; height: 2px; background: Theme.text-muted; }
        }
    }
}
