import { Theme } from "theme.slint";
import { PrimaryButton, GhostButton } from "widgets.slint";
import { ScrollView } from "std-widgets.slint";

export struct SessionInfo {
    id: string,
    name: string,
    host: string,
    serial-detail: string, // device, baud rate and framing; empty for non-serial sessions
    port: int,
    user: string,
    auth: string,      // "password" | "key"
    last-used: string, // ISO timestamp or "never"
    group: string,        // folder/group name ("" = ungrouped)
    group-header: string, // set on the first row of each group → render a header
    collapsed: bool,      // group is collapsed → this session row is hidden
    builtin: bool,        // built-in local shell, not a saved server session
}

// --- SessionRow ------------------------------------------------------------
component SessionRow inherits Rectangle {
    in property <SessionInfo> session;
    in property <bool> compact;
    callback connect();
    callback edit();
    callback duplicate();
    callback move-to-group(string);
    callback remove();
    // Drag-to-reorder: direction -1 = up, 1 = down. Emitted once per row-hop.
    callback reorder(int) -> bool;
    // Drag lifecycle, owned by the Welcome list: start publishes the dragged
    // id, end persists the order. The card never follows the pointer — hops
    // swap rows instantly, so overlapping neighbours / group headers cannot
    // happen at all.
    callback drag-start();
    callback drag-end();
    // Full session list — group-header is non-empty once per group, so the
    // "move to group" submenu can iterate it to list each group exactly once.
    in property <[SessionInfo]> all-sessions;
    // Drag is only allowed outside search (visible indices would not match
    // stored order) and never on built-in system rows.
    in property <bool> reorder-enabled: false;
    // Shared list-level drag state (see Welcome): which session is being
    // dragged. The lifted card follows the dragged session's DATA, not the
    // component holding the pointer grab — rows swap contents under the grab
    // on every hop.
    in property <bool> drag-target: false;
    // List-level drag state, mirrored here so a press can detect a stale
    // drag (the grab was lost when a hop changed the row count and rebuilt
    // the model) and clear it instead of leaving the card lifted.
    in property <bool> list-dragging: false;
    property <bool> system-row: root.session.builtin;
    // Local gesture state: this instance received the press and drives the
    // drag (it keeps the pointer grab across in-place model updates).
    property <bool> pressing: false;
    property <bool> grab-dragging: false;
    property <length> grab-y;

    height: root.compact ? 44px : 36px;

    // Remember where the right-click landed so the popup can appear there.
    property <length> ctx-x;
    property <length> ctx-y;

    touch := TouchArea {
        mouse-cursor: root.grab-dragging ? move : pointer;
        // Connect is handled in pointer-event below so a finished drag never
        // counts as a click.
        pointer-event(e) => {
            // Built-in PowerShell/CMD/WSL rows have no edit/move/delete actions.
            // All menu items are conditional on !system-row, so opening the
            // popup for them only produces an empty rectangle (#336).
            if (!root.system-row && e.kind == PointerEventKind.down && e.button == PointerEventButton.right) {
                ctx-x = self.mouse-x;
                ctx-y = self.mouse-y;
                ctx-menu.show();
            } else if (e.button == PointerEventButton.left) {
                if (e.kind == PointerEventKind.down) {
                    // A press while the list still thinks a drag is running
                    // means that drag's pointer grab was destroyed by a
                    // row-count-changing hop; end it before starting fresh.
                    if (root.list-dragging) {
                        root.drag-end();
                    }
                    root.pressing = true;
                    // Reset any stale drag (e.g. released outside the row).
                    root.grab-dragging = false;
                    root.grab-y = self.mouse-y;
                } else if (e.kind == PointerEventKind.up) {
                    // `pressing` proves this instance received the down: the
                    // row under a released pointer must not treat it as a
                    // click when the grab landed elsewhere after hops.
                    if (root.pressing && !root.grab-dragging) {
                        root.connect();
                    }
                    if (root.grab-dragging) {
                        root.drag-end();
                    }
                    root.pressing = false;
                    root.grab-dragging = false;
                } else if (e.kind == PointerEventKind.cancel) {
                    // System-cancelled grab (e.g. compositor takeover): treat
                    // as a release but never as a connect click.
                    if (root.grab-dragging) {
                        root.drag-end();
                    }
                    root.pressing = false;
                    root.grab-dragging = false;
                }
            }
        }
        moved => {
            if (!root.pressing) { return; }
            if (!root.grab-dragging) {
                // A few pixels of vertical drift start a reorder drag; below
                // that the press still resolves to a connect click.
                if (root.reorder-enabled && abs(touch.mouse-y - root.grab-y) > 5px) {
                    root.grab-dragging = true;
                    root.grab-y = touch.mouse-y;
                    root.drag-start();
                }
            } else {
                // Swap at the neighbour's midpoint, then shift the anchor by a
                // full slot (row + 2px spacing) — NOT back to the cursor — so
                // overshoot carries over and the drag stays glued to the
                // pointer across consecutive hops. Only advance the anchor
                // when the swap happened: at list boundaries reorder fails,
                // and advancing anyway would drift the anchor out of sync.
                if (touch.mouse-y - root.grab-y > (root.height + 2px) / 2) {
                    if (root.reorder(1)) {
                        root.grab-y = root.grab-y + root.height + 2px;
                    }
                } else if (root.grab-y - touch.mouse-y > (root.height + 2px) / 2) {
                    if (root.reorder(-1)) {
                        root.grab-y = root.grab-y - root.height - 2px;
                    }
                }
            }
        }
    }

    // Right-click context menu -----------------------------------------------
    ctx-menu := PopupWindow {
        x: ctx-x;
        y: ctx-y;
        width: 140px;
        // Height follows the content so a variable number of "move to" rows fit.
        height: menu-vl.preferred-height;

        Rectangle {
            background: Theme.popup-bg;
            border-radius: Theme.radius-sm;
            border-width: 1px;
            border-color: Theme.border-strong;
            drop-shadow-blur: 10px;
            drop-shadow-color: #00000050;

            menu-vl := VerticalLayout {
                padding: 4px;
                spacing: 2px;

                // Edit
                if !root.system-row : Rectangle {
                    height: 28px;
                    border-radius: Theme.radius-sm;
                    background: edit-ta.has-hover ? Theme.bg-hover : transparent;
                    edit-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.edit(); }
                    }
                    HorizontalLayout {
                        padding-left: 10px;
                        spacing: 8px;
                        Text { text: "\u{E3C9}"; font-family: "Material Icons"; color: Theme.text-secondary; font-size: Theme.fs-sm; vertical-alignment: center; }
                        Text { text: @tr("Edit"); color: Theme.text-primary; font-size: Theme.fs-md; vertical-alignment: center; horizontal-stretch: 1; }
                    }
                }

                // Duplicate — clone this session as a starting point (#41).
                if !root.system-row : Rectangle {
                    height: 28px;
                    border-radius: Theme.radius-sm;
                    background: dup-ta.has-hover ? Theme.bg-hover : transparent;
                    dup-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.duplicate(); }
                    }
                    HorizontalLayout {
                        padding-left: 10px;
                        spacing: 8px;
                        Text { text: "\u{E14D}"; font-family: "Material Icons"; color: Theme.text-secondary; font-size: Theme.fs-sm; vertical-alignment: center; }
                        Text { text: @tr("Duplicate"); color: Theme.text-primary; font-size: Theme.fs-md; vertical-alignment: center; horizontal-stretch: 1; }
                    }
                }

                // Delete (red tint)
                if !root.system-row : Rectangle {
                    height: 28px;
                    border-radius: Theme.radius-sm;
                    background: del-ta.has-hover ? #cc333320 : transparent;
                    del-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.remove(); }
                    }
                    HorizontalLayout {
                        padding-left: 10px;
                        spacing: 8px;
                        Text { text: "\u{E872}"; font-family: "Material Icons"; color: #cc3333; font-size: Theme.fs-sm; vertical-alignment: center; }
                        Text { text: @tr("Delete"); color: #cc3333; font-size: Theme.fs-md; vertical-alignment: center; horizontal-stretch: 1; }
                    }
                }

                if !root.system-row : Rectangle { height: 1px; background: Theme.border-subtle; }

                // "Move to" hint — labels the group list below so the user knows
                // these entries move the session into that folder.
                if !root.system-row : HorizontalLayout {
                    padding-left: 10px;
                    padding-top: 2px;
                    spacing: 6px;
                    Text { text: "\u{E2C7}"; font-family: "Material Icons"; color: Theme.text-muted; font-size: Theme.fs-xs; vertical-alignment: center; }
                    Text { text: @tr("Move to"); color: Theme.text-muted; font-size: Theme.fs-xs; vertical-alignment: center; horizontal-stretch: 1; }
                }

                // Move to another group (#41). group-header is non-empty once
                // per group (incl. empty folders), so iterating the full list
                // yields each group once; the current group is skipped.
                for s[i] in root.all-sessions : Rectangle {
                    visible: !root.system-row && s.group-header != ""
                        && !s.builtin && s.group-header != root.session.group;
                    height: self.visible ? 28px : 0px;
                    border-radius: Theme.radius-sm;
                    background: mv-ta.has-hover ? Theme.bg-hover : transparent;
                    mv-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.move-to-group(s.group-header); }
                    }
                    HorizontalLayout {
                        padding-left: 10px;
                        spacing: 8px;
                        Text { text: "\u{E2C7}"; font-family: "Material Icons"; color: Theme.text-secondary; font-size: Theme.fs-sm; vertical-alignment: center; }
                        Text { text: s.group-header; color: Theme.text-primary; font-size: Theme.fs-md; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                    }
                }
            }
        }
    }

    // Row content — wrapped in a card so the dragged row can lift (shadow +
    // highlight) while the grabbing TouchArea keeps its grab. The card stays
    // in its slot: row swaps alone convey the reorder.
    card := Rectangle {
        width: parent.width;
        height: parent.height;
        border-radius: Theme.radius-sm;
        background: root.drag-target ? Theme.bg-elevated
            : (touch.has-hover ? Theme.bg-hover : transparent);
        drop-shadow-blur: root.drag-target ? 14px : 0px;
        drop-shadow-color: root.drag-target ? #00000060 : transparent;
        animate background { duration: 120ms; }
        animate drop-shadow-blur { duration: 120ms; }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: root.compact ? 8px : 12px;

        Rectangle {
            width: 18px; height: 18px;
            y: (parent.height - self.height) / 2;
            border-radius: 3px;
            background: Theme.bg-elevated;
            Text {
                text: root.system-row ? "\u{E30A}" : "\u{E875}";   // terminal / server
                font-family: "Material Icons";
                color: Theme.text-secondary;
                font-size: Theme.fs-sm;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        if root.compact : VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 1px;
            Text {
                text: session.name;
                color: Theme.text-primary;
                font-size: Theme.fs-sm;
                overflow: elide;
            }
            Text {
                text: session.serial-detail != "" ? session.serial-detail
                    : session.builtin ? session.host
                    : (session.user != "" ? session.user + "@" : "")
                        + (session.port > 0 ? session.host + ":" + session.port : session.host);
                color: Theme.text-muted;
                font-size: Theme.fs-xs;
                overflow: elide;
            }
        }
        if !root.compact : Text {
            text: session.name;
            color: Theme.text-primary;
            font-size: Theme.fs-md;
            vertical-alignment: center;
            width: 180px;
            overflow: elide;
        }
        if !root.compact : Text {
            text: session.serial-detail != "" ? session.serial-detail
                : session.port > 0 ? session.host + ":" + session.port : session.host;
            color: Theme.text-secondary;
            font-size: Theme.fs-sm;
            vertical-alignment: center;
            width: 180px;
            overflow: elide;
        }
        if !root.compact : Text {
            text: session.serial-detail != "" ? "" : session.user;
            color: Theme.text-secondary;
            font-size: Theme.fs-sm;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
    }
    }
}

component CollapseButton inherits Rectangle {
    in property <string> glyph;
    callback clicked();
    width: 24px;
    height: 24px;
    border-radius: Theme.radius-sm;
    background: ta.has-hover ? Theme.bg-hover : transparent;
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    Text {
        text: root.glyph;
        font-family: "Material Icons";
        color: Theme.text-secondary;
        font-size: 16px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// One generated-group row of the quick-connect menu. Hover is forwarded from
// TouchArea.has-hover (Slint has no `hovered` callback there); the caller reads
// the row's layout position only when the callback actually fires, so no
// `changed` binding needs to touch layout results (#553).
component QuickGroupRow inherits Rectangle {
    in property <bool> group-visible;
    in property <bool> submenu-open;
    in property <string> label;
    callback toggled();
    callback hovered();

    height: 28px;
    border-radius: Theme.radius-sm;
    background: ta.has-hover || root.submenu-open ? Theme.bg-hover : transparent;
    property <bool> hovering: ta.has-hover;
    changed hovering => { if (self.hovering) { root.hovered(); } }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggled(); }
    }
    HorizontalLayout {
        padding-left: 8px;
        spacing: 8px;
        Rectangle {
            width: 16px;
            height: 16px;
            // A fixed-height layout item keeps y = 0; centre it by hand.
            y: (parent.height - self.height) / 2;
            Text {
                text: "\u{E5CA}";   // check
                visible: root.group-visible;
                font-family: "Material Icons";
                color: Theme.text-primary;
                font-size: 16px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        Text { text: root.label; color: Theme.text-primary; font-size: Theme.fs-md; vertical-alignment: center; horizontal-stretch: 1; }
        Text { text: "\u{E5CC}"; font-family: "Material Icons"; color: Theme.text-muted; font-size: 14px; vertical-alignment: center; }
    }
}

// --- Quick connect menu ----------------------------------------------------
// Dropdown sitting next to the "New session" button: create a group, or hover
// a generated group to open its sessions in a second-level menu. Clicking the
// group row keeps its original meaning: show / hide that group.
component QuickConnectMenuButton inherits Rectangle {
    in property <bool> hidden-system;
    in property <bool> hidden-agents;
    // Unfiltered generated shell / agent rows for the second level, including
    // sessions of hidden groups. Clicking one opens it directly.
    in property <[SessionInfo]> builtin-sessions;
    // Window width, used only to decide which side the extra column goes on.
    in property <length> window-width;
    callback new-group();
    callback toggle-group(string /* name */);
    callback connect-session(string /* id */);

    // Second level: a column inside the SAME popup, like the SFTP menu — Slint
    // stops delivering pointer events to a parent popup while a child
    // PopupWindow is open. "" = no group open.
    property <string> open-submenu;
    property <length> sub-width: 160px;
    property <length> main-width: 184px;
    // Where each group row starts inside the parent column: padding 4px, then
    // "New group" (28px), a 1px separator and one 1px gap between items. Used as
    // the submenu column's top spacer — constants, because a row's layout `y`
    // turned out not to match the row's rendered position inside the popup.
    property <length> system-row-y: 4px + 28px + 1px + 1px;
    property <length> agents-row-y: root.system-row-y + 28px + 1px;

    width: 30px;
    height: 30px;
    border-radius: Theme.radius-sm;
    border-width: 1px;
    border-color: Theme.border-strong;
    background: ta.has-hover ? Theme.bg-hover : Theme.bg-elevated;

    Text {
        text: "\u{E5CF}";   // expand_more
        font-family: "Material Icons";
        color: Theme.text-primary;
        font-size: Theme.fs-md;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            // Reset before showing: a submenu left over from the previous
            // dismissal would be drawn again on the first frame otherwise.
            root.open-submenu = "";
            menu.show();
        }
    }

    // NOTE: there is no "popup closed" hook we can use to clear the second
    // level (Slint's `changed is-open` on a PopupWindow crashes the compiler),
    // so every exit path resets `open-submenu` itself and `show()` resets it
    // again before opening. Dismissing the popup thereby never leaves a stale
    // submenu behind.
    menu := PopupWindow {
        // EVERYTHING inside is positioned by the `cols` layout below; only the
        // popup itself is anchored here, so the two columns cannot drift apart.
        //
        // The parent column's right edge sits on the trigger's right edge. When
        // the extra column would overflow the window, the popup slides left by
        // exactly that overflow (it fits in the compact sidebar; in a full-width
        // welcome tab there is no room next to a right-edge button).
        x: root.window-width <= 0px
            ? root.width - root.main-width
            : min(root.width - root.main-width,
                root.window-width - root.absolute-position.x - cols.preferred-width);
        // Directly under the trigger: `root.height` is the 30px button.
        // `parent.height` resolved to the surrounding row and left a big gap.
        y: root.height + 2px;
        width: cols.preferred-width;
        height: cols.preferred-height;
        // Clicks in the empty part of the popup dismiss it, as in the SFTP menu.
        TouchArea { clicked => { root.open-submenu = ""; menu.close(); } }
        function show-submenu(name: string) {
            root.open-submenu = name;
        }
        cols := HorizontalLayout {
        // Parent column: fixed width, its own content height (top-aligned, so a
        // longer submenu never stretches it).
        Rectangle {
            width: root.main-width;
            height: menu-vl.preferred-height;
            background: Theme.popup-bg;
            border-radius: Theme.radius-sm;
            border-width: 1px;
            border-color: Theme.border-strong;
            drop-shadow-blur: 10px;
            drop-shadow-color: #00000050;
            menu-vl := VerticalLayout {
                padding: 4px;
                spacing: 1px;
                // New group
                Rectangle {
                    height: 28px;
                    border-radius: Theme.radius-sm;
                    background: ng-ta.has-hover ? Theme.bg-hover : transparent;
                    ng-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.open-submenu = ""; root.new-group(); menu.close(); }
                    }
                    HorizontalLayout {
                        padding-left: 8px;
                        spacing: 8px;
                        Rectangle { width: 16px; }
                        Text { text: @tr("New group"); color: Theme.text-primary; font-size: Theme.fs-md; vertical-alignment: center; horizontal-stretch: 1; }
                    }
                }
                Rectangle { height: 1px; background: Theme.border-subtle; }
                // Hover opens the second level; clicking a row keeps the old
                // meaning: toggle that group's visibility.
                sg-row := QuickGroupRow {
                    label: @tr("System group");
                    group-visible: !root.hidden-system;
                    submenu-open: root.open-submenu == "system";
                    hovered => { show-submenu("system"); }
                    toggled => { root.toggle-group("system"); show-submenu("system"); }
                }
                ag-row := QuickGroupRow {
                    label: @tr("Agents group");
                    group-visible: !root.hidden-agents;
                    submenu-open: root.open-submenu == "agents";
                    hovered => { show-submenu("agents"); }
                    toggled => { root.toggle-group("agents"); show-submenu("agents"); }
                }
            }
        }

        // Second-level column, right of the parent menu. It lives in this popup
        // (not a child PopupWindow) so pointer events keep reaching both columns
        // — the same trick the SFTP file menu uses (#553).
        if root.open-submenu != "" : VerticalLayout {
            // Spacer: pushes the card down so its top edge lands exactly on the
            // hovered group row (constant row offsets, see system-row-y).
            Rectangle {
                height: root.open-submenu == "system" ? root.system-row-y : root.agents-row-y;
            }
            Rectangle {
            width: root.sub-width;
            height: sub-vl.preferred-height;
            background: Theme.popup-bg;
            border-radius: Theme.radius-sm;
            border-width: 1px;
            border-color: Theme.border-strong;
            drop-shadow-blur: 10px;
            drop-shadow-color: #00000050;
            sub-vl := VerticalLayout {
                padding: 4px;
                spacing: 1px;
                // Keep the old feature reachable: hide / restore the group.
                Rectangle {
                    height: 28px;
                    border-radius: Theme.radius-sm;
                    background: toggle-ta.has-hover ? Theme.bg-hover : transparent;
                    toggle-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.toggle-group(root.open-submenu);
                            root.open-submenu = "";
                            menu.close();
                        }
                    }
                    HorizontalLayout {
                        padding-left: 10px;
                        spacing: 8px;
                        Text { text: "\u{E2C7}"; font-family: "Material Icons"; color: Theme.text-secondary; font-size: Theme.fs-sm; vertical-alignment: center; }
                        Text {
                            text: root.open-submenu == "system"
                                ? (root.hidden-system ? @tr("Restore System group") : @tr("Delete group (hide)"))
                                : (root.hidden-agents ? @tr("Restore Agents group") : @tr("Delete group (hide)"));
                            color: Theme.text-primary; font-size: Theme.fs-md; vertical-alignment: center; horizontal-stretch: 1;
                        }
                    }
                }
                Rectangle { height: 1px; background: Theme.border-subtle; }
                // Every generated session of the hovered group, including
                // hidden ones — this model has no hidden-group filter.
                for s in root.builtin-sessions : Rectangle {
                    visible: s.builtin && s.group == root.open-submenu;
                    height: self.visible ? 28px : 0px;
                    border-radius: Theme.radius-sm;
                    background: ses-ta.has-hover ? Theme.bg-hover : transparent;
                    ses-ta := TouchArea {
                        mouse-cursor: pointer;
                        // Open straight into a terminal tab, no click on the
                        // card in the (possibly filtered / scrolled) list.
                        clicked => {
                            root.connect-session(s.id);
                            root.open-submenu = "";
                            menu.close();
                        }
                    }
                    HorizontalLayout {
                        padding-left: 10px;
                        Text { text: s.name; color: Theme.text-primary; font-size: Theme.fs-md; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                    }
                }
            }
            }
        }
        }
    }
}

// --- Welcome ---------------------------------------------------------------
export component Welcome inherits Rectangle {
    in property <[SessionInfo]> sessions;
    // Generated rows without the hidden-group filter: the group submenu uses
    // this so a hidden group's sessions are still listed and openable.
    in property <[SessionInfo]> builtin-sessions;
    // Window width, forwarded to the quick-connect menu so its second-level
    // column can pick a side instead of running off the window edge.
    in property <length> window-width;
    in property <string> import-hint;        // result text after an import
    in-out property <string> search-query;
    callback new-session();
    callback import-ssh-config();
    callback connect-session(string);
    callback edit-session(string);
    callback duplicate-session(string);
    callback move-session(string /* id */, string /* group */);
    // Drag-to-reorder a host card among its same-group siblings (dir: -1/1).
    // Returns true when the card actually moved.
    callback reorder-session(string /* id */, int /* dir */) -> bool;
    // Drag finished (pointer released) → persist the new order.
    callback reorder-end();
    // Bumped by Rust whenever the sessions model is rebuilt wholesale; that
    // destroys the dragging row's pointer grab, so end the drag cleanly
    // instead of leaving the lifted card stuck (its grab is already gone —
    // no release event will ever arrive).
    in property <int> sessions-revision: 0;
    changed sessions-revision => {
        if (root.list-dragging) {
            root.list-dragging = false;
            root.drag-id = "";
            root.reorder-end();
        }
    }
    // List-level drag-to-reorder state: which session is being dragged.
    // Kept at list level because hops swap row data under the pointer grab —
    // the lifted card must follow the dragged session's data, not the
    // component that owns the grab.
    property <string> drag-id;
    property <bool> list-dragging: false;
    callback toggle-group(string /* group */);
    callback new-group();
    callback edit-group(string /* current-name */);
    callback delete-group(string /* name */);
    // Groups the user removed from the list: the implicit "default" group and
    // the generated "system" / "agents" ones. Their rows stay hidden until
    // restored from a group's context menu.
    in property <bool> hidden-default;
    in property <bool> hidden-system;
    in property <bool> hidden-agents;
    callback restore-group(string /* name */);
    callback remove-session(string);
    callback search-changed(string);
    callback cycle-tab(bool /* reverse */);
    // Customisable shortcuts: key event → action id (see shortcuts.rs).
    callback match-shortcut(string, bool, bool, bool, bool, bool) -> string;
    // Compact mode (welcome-as-sidebar): drop the big title/tagline header and
    // tighten padding so the session list fits a narrow docked panel (#v0.5).
    in property <bool> compact;
    in property <string> dock-edge: "left";
    property <bool> dock-horizontal: root.dock-edge == "left" || root.dock-edge == "right";
    // Collapse the sidebar to the edge icon strip (compact mode only) (#v0.5 M5).
    callback collapse();
    callback dock-drag-move(length, length);
    callback dock-drag-end();

    background: Theme.bg-root;

    // The regular welcome page is itself a tab. When Ctrl+Tab wraps from the
    // last terminal to this page, keep the shortcut chain alive so the next
    // press can continue to the first terminal (#294). The compact welcome
    // sidebar must never take focus away from an active terminal. Windows
    // AccessKit may instantiate this conditional scope while walking the
    // accessibility tree, so defer focus to the next event-loop turn instead of
    // re-entering Slint's winit adapter from `init` (#323).
    if !root.compact : welcome-key-scope := FocusScope {
        property <bool> focus-pending: false;
        init => { self.focus-pending = true; }
        Timer {
            interval: 0ms;
            running: welcome-key-scope.focus-pending;
            triggered => {
                welcome-key-scope.focus-pending = false;
                welcome-key-scope.focus();
            }
        }
        key-pressed(event) => {
            let act = root.match-shortcut(event.text, event.modifiers.control,
                event.modifiers.meta, event.modifiers.alt, event.modifiers.shift, false);
            if (act == "next-tab" || act == "prev-tab") {
                root.cycle-tab(act == "prev-tab");
                accept
            } else {
                reject
            }
        }
    }

    VerticalLayout {
        padding: root.compact ? 12px : 24px;
        spacing: root.compact ? 12px : 20px;

        // Header (title + tagline) — pinned to the top at its natural height so
        // it can't grab the stretch space and spread apart (seen on macOS); the
        // quick-connect card below takes all the remaining height (#dock). Hidden
        // in compact/sidebar mode.
        if !root.compact : VerticalLayout {
            vertical-stretch: 0;
            alignment: start;
            spacing: 4px;
            Text {
                text: "meatshell";
                color: Theme.text-primary;
                font-size: 28px;
                font-weight: 700;
            }
            Text {
                text: @tr("A lightweight and efficient Rust + Slint SSH client");
                color: Theme.text-secondary;
                font-size: Theme.fs-md;
                wrap: no-wrap;
            }
        }

        // Quick Connect card — always fills the remaining height so the panel
        // doesn't jump when the first session is added (the empty placeholder
        // stretches to fill just like the session list does) (#214).
        Rectangle {
            vertical-stretch: 1;
            background: Theme.bg-panel;
            border-radius: Theme.radius-md;
            border-width: 1px;
            border-color: Theme.border-subtle;

            VerticalLayout {
                padding: 16px;
                spacing: 12px;

                Rectangle {
                    height: header-row.preferred-height;
                    TouchArea {
                        enabled: root.compact;
                        mouse-cursor: move;
                        moved => {
                            if (self.pressed) {
                                root.dock-drag-move(self.absolute-position.x + self.mouse-x,
                                                    self.absolute-position.y + self.mouse-y);
                            }
                        }
                        pointer-event(ev) => {
                            if (ev.kind == PointerEventKind.up) { root.dock-drag-end(); }
                            // Grab taken away (popup, deactivation): end the gesture
                            // anyway so no dock preview is stranded.
                            else if (ev.kind == PointerEventKind.cancel) { root.dock-drag-end(); }
                        }
                    }
                    header-row := HorizontalLayout {
                        spacing: 8px;
                        if root.compact && root.dock-edge != "left" : CollapseButton {
                            glyph: root.dock-edge == "right" ? "\u{E5CC}"
                                 : root.dock-edge == "top" ? "\u{E5CE}"
                                 : "\u{E5CF}";
                            clicked => { root.collapse(); }
                        }
                        Text {
                            text: @tr("Quick connect");
                            color: Theme.text-primary;
                            font-size: Theme.fs-lg;
                            font-weight: 600;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        if root.compact && root.dock-edge == "left" : CollapseButton {
                            glyph: "\u{E5CB}";
                            clicked => { root.collapse(); }
                        }
                        Text {
                            text: root.import-hint;
                            color: Theme.text-muted;
                            font-size: Theme.fs-sm;
                            vertical-alignment: center;
                        }
                        if !root.compact : PrimaryButton {
                            text: @tr("+ New session");
                            clicked => { root.new-session(); }
                        }
                        if !root.compact : QuickConnectMenuButton {
                            hidden-system: root.hidden-system;
                            hidden-agents: root.hidden-agents;
                            builtin-sessions: root.builtin-sessions;
                            window-width: root.window-width;
                            connect-session(id) => { root.connect-session(id); }
                            new-group => { root.new-group(); }
                            toggle-group(name) => {
                                if (name == "system") {
                                    if (root.hidden-system) { root.restore-group("system"); } else { root.delete-group("system"); }
                                } else {
                                    if (root.hidden-agents) { root.restore-group("agents"); } else { root.delete-group("agents"); }
                                }
                            }
                        }
                    }
                }
                if root.compact : HorizontalLayout {
                    spacing: 4px;
                    PrimaryButton {
                        text: @tr("+ New session");
                        horizontal-stretch: 1;
                        clicked => { root.new-session(); }
                    }
                    QuickConnectMenuButton {
                        hidden-system: root.hidden-system;
                        hidden-agents: root.hidden-agents;
                        builtin-sessions: root.builtin-sessions;
                        window-width: root.window-width;
                        connect-session(id) => { root.connect-session(id); }
                        new-group => { root.new-group(); }
                        toggle-group(name) => {
                            if (name == "system") {
                                if (root.hidden-system) { root.restore-group("system"); } else { root.delete-group("system"); }
                            } else {
                                if (root.hidden-agents) { root.restore-group("agents"); } else { root.delete-group("agents"); }
                            }
                        }
                    }
                }

                // Filter saved and built-in sessions by display name or host.
                Rectangle {
                    height: 32px;
                    border-radius: Theme.radius-sm;
                    border-width: 1px;
                    border-color: search-input.has-focus ? Theme.accent : Theme.border-subtle;
                    background: Theme.bg-root;

                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 4px;
                        spacing: 6px;

                        Text {
                            text: "\u{E8B6}";
                            font-family: "Material Icons";
                            color: Theme.text-muted;
                            font-size: Theme.fs-sm;
                            vertical-alignment: center;
                        }

                        Rectangle {
                            horizontal-stretch: 1;

                            search-input := TextInput {
                                width: parent.width;
                                height: parent.height;
                                text <=> root.search-query;
                                color: Theme.text-primary;
                                font-family: Theme.ui-font-family;
                                font-size: Theme.fs-sm;
                                vertical-alignment: center;
                                single-line: true;
                                edited => { root.search-changed(root.search-query); }
                            }

                            if root.search-query == "" : Text {
                                width: parent.width;
                                height: parent.height;
                                text: @tr("Search by name or host...");
                                color: Theme.text-muted;
                                font-size: Theme.fs-sm;
                                horizontal-alignment: left;
                                vertical-alignment: center;
                            }
                        }

                        if root.search-query != "" : Rectangle {
                            width: 24px;
                            height: parent.height;

                            Rectangle {
                                width: 24px;
                                height: 24px;
                                y: (parent.height - self.height) / 2;
                                border-radius: Theme.radius-sm;
                                background: clear-search.has-hover ? Theme.bg-hover : transparent;
                                accessible-role: button;
                                accessible-label: @tr("Clear search");

                                Text {
                                    text: "\u{E5CD}";
                                    font-family: "Material Icons";
                                    color: Theme.text-muted;
                                    font-size: Theme.fs-sm;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                                clear-search := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.search-query = "";
                                        root.search-changed("");
                                        search-input.focus();
                                    }
                                }

                                if clear-search.has-hover : Rectangle {
                                    x: parent.width - self.width;
                                    y: parent.height + 4px;
                                    width: clear-search-tip.preferred-width + 16px;
                                    height: 22px;
                                    background: Theme.bg-elevated;
                                    border-radius: Theme.radius-sm;
                                    border-width: 1px;
                                    border-color: Theme.border-strong;
                                    drop-shadow-blur: 8px;
                                    drop-shadow-color: #00000070;

                                    clear-search-tip := Text {
                                        width: parent.width;
                                        height: parent.height;
                                        text: @tr("Clear search");
                                        color: Theme.text-primary;
                                        font-size: Theme.fs-xs;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }

                if sessions.length == 0 : Rectangle {
                    vertical-stretch: 1;
                    background: Theme.bg-root;
                    border-radius: Theme.radius-sm;
                    border-width: 1px;
                    border-color: Theme.border-subtle;

                    VerticalLayout {
                        alignment: center;
                        spacing: 6px;
                        Text {
                            text: root.search-query == ""
                                ? @tr("No sessions yet")
                                : @tr("No matching sessions");
                            color: Theme.text-secondary;
                            font-size: Theme.fs-md;
                            horizontal-alignment: center;
                        }
                        if root.search-query == "" : Text {
                            text: @tr("Use 'New session' (top-right) to add your first server");
                            color: Theme.text-muted;
                            font-size: Theme.fs-sm;
                            horizontal-alignment: center;
                        }
                        // Way back for an empty list after both built-in groups
                        // were removed (there is no group header to right-click).
                        if root.hidden-default || root.hidden-system || root.hidden-agents : Rectangle {
                            height: 26px;
                            border-radius: Theme.radius-sm;
                            background: restore-all-ta.has-hover ? Theme.bg-hover : transparent;
                            restore-all-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    if (root.hidden-default) { root.restore-group("default"); }
                                    if (root.hidden-system) { root.restore-group("system"); }
                                    if (root.hidden-agents) { root.restore-group("agents"); }
                                }
                            }
                            Text {
                                text: @tr("Restore hidden groups");
                                color: Theme.accent;
                                font-size: Theme.fs-sm;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                if sessions.length > 0 : ScrollView {
                    vertical-stretch: 1;
                    content-width: self.visible-width;
                    content-height: max(self.visible-height, sess-list.preferred-height);
                    sess-list := VerticalLayout {
                    spacing: 0px;
                    for session[i] in sessions : VerticalLayout {
                        // Exclude hidden rows from layout spacing while a group
                        // is collapsed; keep its first row for the group header.
                        visible: session.group-header != "" || !session.collapsed;
                        padding-top: self.visible && i > 0 ? 2px : 0px;
                        spacing: 2px;
                        // Group header on the first row of each group (#41).
                        // Click anywhere on it to collapse / expand the group.
                        if session.group-header != "" : Rectangle {
                            height: 26px;
                            // Right-click popup anchor.
                            property <length> gmx;
                            property <length> gmy;
                            HorizontalLayout {
                                padding-top: 6px;
                                padding-left: 4px;
                                spacing: 4px;
                                // Collapse chevron — shown for every group, empty
                                // folders included, so they line up and can be
                                // toggled (an empty group just expands to nothing).
                                Text {
                                    text: session.collapsed ? "\u{E5CC}" : "\u{E5CF}";
                                    font-family: "Material Icons";
                                    color: Theme.text-muted;
                                    font-size: Theme.fs-sm;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: "\u{E2C7}";   // folder glyph
                                    font-family: "Material Icons";
                                    color: Theme.text-muted;
                                    font-size: Theme.fs-sm;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: session.group-header;
                                    color: Theme.text-muted;
                                    font-size: Theme.fs-xs;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;       // fill → text stays left
                                    horizontal-alignment: left;
                                }
                            }
                            TouchArea {
                                mouse-cursor: pointer;
                                // Left-click toggles collapse (any group, incl.
                                // empty); right-click opens the group menu.
                                clicked => {
                                    if root.search-query == "" {
                                        root.toggle-group(session.group);
                                    }
                                }
                                pointer-event(e) => {
                                    if (e.kind == PointerEventKind.down && e.button == PointerEventButton.right) {
                                        gmx = self.mouse-x;
                                        gmy = self.mouse-y;
                                        grp-menu.show();
                                    }
                                }
                            }
                            grp-menu := PopupWindow {
                                x: gmx;
                                y: gmy;
                                width: 168px;
                                // Every group can be deleted except the implicit
                                // "default" group; user folders also offer edit +
                                // new. Removing a built-in group only hides it.
                                // Restore entries appear while one is hidden.
                                property <int> item-count:
                                    (!session.builtin ? 1 : 0)                                 // new group
                                    + (!session.builtin && session.group != "default" ? 1 : 0) // edit
                                    + 1                                                        // delete
                                    + (root.hidden-default ? 1 : 0)
                                    + (root.hidden-system ? 1 : 0)
                                    + (root.hidden-agents ? 1 : 0);
                                height: item-count * 28px + 9px;
                                Rectangle {
                                    background: Theme.popup-bg;
                                    border-radius: Theme.radius-sm;
                                    border-width: 1px;
                                    border-color: Theme.border-strong;
                                    drop-shadow-blur: 10px;
                                    drop-shadow-color: #00000050;
                                    VerticalLayout {
                                        padding: 4px;
                                        spacing: 1px;
                                        // Edit (rename) group — user folders only
                                        // (the implicit "default" group can't be renamed).
                                        if !session.builtin && session.group != "default" : Rectangle {
                                            height: 28px;
                                            border-radius: Theme.radius-sm;
                                            background: eg-ta.has-hover ? Theme.bg-hover : transparent;
                                            eg-ta := TouchArea { mouse-cursor: pointer; clicked => { root.edit-group(session.group); } }
                                            HorizontalLayout {
                                                padding-left: 10px; spacing: 8px;
                                                Text { text: "\u{E3C9}"; font-family: "Material Icons"; color: Theme.text-secondary; font-size: Theme.fs-sm; vertical-alignment: center; }
                                                Text { text: @tr("Edit group"); color: Theme.text-primary; font-size: Theme.fs-md; vertical-alignment: center; horizontal-stretch: 1; }
                                            }
                                        }
                                        // Delete — every group. A user folder is
                                        // dissolved (its sessions fall back to
                                        // ungrouped); a generated group is only
                                        // hidden from this list.
                                        Rectangle {
                                            height: 28px;
                                            border-radius: Theme.radius-sm;
                                            background: dg-ta.has-hover ? #cc333320 : transparent;
                                            dg-ta := TouchArea { mouse-cursor: pointer; clicked => { root.delete-group(session.group); } }
                                            HorizontalLayout {
                                                padding-left: 10px; spacing: 8px;
                                                Text { text: "\u{E872}"; font-family: "Material Icons"; color: #cc3333; font-size: Theme.fs-sm; vertical-alignment: center; }
                                                Text {
                                                    text: session.builtin || session.group == "default"
                                                        ? @tr("Delete group (hide)")
                                                        : @tr("Delete group");
                                                    color: #cc3333; font-size: Theme.fs-md; vertical-alignment: center; horizontal-stretch: 1;
                                                }
                                            }
                                        }
                                        // New group — user folders only.
                                        if !session.builtin : Rectangle {
                                            height: 28px;
                                            border-radius: Theme.radius-sm;
                                            background: ng-ta.has-hover ? Theme.bg-hover : transparent;
                                            ng-ta := TouchArea { mouse-cursor: pointer; clicked => { root.new-group(); } }
                                            HorizontalLayout {
                                                padding-left: 10px; spacing: 8px;
                                                Text { text: "\u{E2CC}"; font-family: "Material Icons"; color: Theme.text-secondary; font-size: Theme.fs-sm; vertical-alignment: center; }
                                                Text { text: @tr("New group"); color: Theme.text-primary; font-size: Theme.fs-md; vertical-alignment: center; horizontal-stretch: 1; }
                                            }
                                        }
                                        // Restore a hidden group.
                                        if root.hidden-default : Rectangle {
                                            height: 28px;
                                            border-radius: Theme.radius-sm;
                                            background: rd-ta.has-hover ? Theme.bg-hover : transparent;
                                            rd-ta := TouchArea { mouse-cursor: pointer; clicked => { root.restore-group("default"); } }
                                            HorizontalLayout {
                                                padding-left: 10px; spacing: 8px;
                                                Text { text: "\u{E2C7}"; font-family: "Material Icons"; color: Theme.text-secondary; font-size: Theme.fs-sm; vertical-alignment: center; }
                                                Text { text: @tr("Restore Ungrouped group"); color: Theme.text-primary; font-size: Theme.fs-md; vertical-alignment: center; horizontal-stretch: 1; }
                                            }
                                        }
                                        if root.hidden-system : Rectangle {
                                            height: 28px;
                                            border-radius: Theme.radius-sm;
                                            background: rs-ta.has-hover ? Theme.bg-hover : transparent;
                                            rs-ta := TouchArea { mouse-cursor: pointer; clicked => { root.restore-group("system"); } }
                                            HorizontalLayout {
                                                padding-left: 10px; spacing: 8px;
                                                Text { text: "\u{E2C7}"; font-family: "Material Icons"; color: Theme.text-secondary; font-size: Theme.fs-sm; vertical-alignment: center; }
                                                Text { text: @tr("Restore System group"); color: Theme.text-primary; font-size: Theme.fs-md; vertical-alignment: center; horizontal-stretch: 1; }
                                            }
                                        }
                                        if root.hidden-agents : Rectangle {
                                            height: 28px;
                                            border-radius: Theme.radius-sm;
                                            background: ra-ta.has-hover ? Theme.bg-hover : transparent;
                                            ra-ta := TouchArea { mouse-cursor: pointer; clicked => { root.restore-group("agents"); } }
                                            HorizontalLayout {
                                                padding-left: 10px; spacing: 8px;
                                                Text { text: "\u{E2C7}"; font-family: "Material Icons"; color: Theme.text-secondary; font-size: Theme.fs-sm; vertical-alignment: center; }
                                                Text { text: @tr("Restore Agents group"); color: Theme.text-primary; font-size: Theme.fs-md; vertical-alignment: center; horizontal-stretch: 1; }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        if session.id != "" && !session.collapsed : SessionRow {
                            session: session;
                            compact: root.compact;
                            all-sessions: root.sessions;
                            // Drag-reorder is meaningless while the list is a
                            // filtered subset, and system rows can't move.
                            // (Whitespace-only queries never reach here: the
                            // search handler normalizes them to "".)
                            reorder-enabled: root.search-query == "" && !session.builtin;
                            drag-target: root.list-dragging && root.drag-id == session.id;
                            list-dragging: root.list-dragging;
                            connect => { root.connect-session(session.id); }
                            edit => { root.edit-session(session.id); }
                            duplicate => { root.duplicate-session(session.id); }
                            move-to-group(g) => { root.move-session(session.id, g); }
                            reorder(dir) => { return root.reorder-session(root.drag-id, dir); }
                            drag-start => { root.drag-id = session.id; root.list-dragging = true; }
                            drag-end => {
                                root.list-dragging = false;
                                root.drag-id = "";
                                root.reorder-end();
                            }
                            remove => { root.remove-session(session.id); }
                        }
                    }
                    }
                }
            }
        }
    }
}
