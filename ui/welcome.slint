import { Theme } from "theme.slint";
import { PrimaryButton, GhostButton, OutlineIcon, IconButton } from "widgets.slint";
import { ScrollView } from "std-widgets.slint";
import { SessionInfo, SessionRow } from "components/business/session_row.slint";
import { SessionGroupHeader } from "components/business/session_group_header.slint";

export { SessionInfo }

// --- Welcome ---------------------------------------------------------------
export component Welcome inherits Rectangle {
    in property <[SessionInfo]> sessions;
    in property <string> import-hint;        // result text after an import
    in-out property <string> search-query;
    callback new-session();
    callback import-ssh-config();
    callback connect-session(string);
    callback edit-session(string);
    callback duplicate-session(string);
    callback move-session(string /* id */, string /* group */);
    // Drag-to-reorder a host card among its same-group siblings (dir: -1/1).
    // Returns true when the card actually moved.
    callback reorder-session(string /* id */, int /* dir */) -> bool;
    // Drag finished (pointer released) → persist the new order.
    callback reorder-end();
    // Bumped by Rust whenever the sessions model is rebuilt wholesale; that
    // destroys the dragging row's pointer grab, so end the drag cleanly
    // instead of leaving the lifted card stuck (its grab is already gone —
    // no release event will ever arrive).
    in property <int> sessions-revision: 0;
    changed sessions-revision => {
        if (root.list-dragging) {
            root.list-dragging = false;
            root.drag-id = "";
            root.reorder-end();
        }
    }
    // List-level drag-to-reorder state: which session is being dragged.
    // Kept at list level because hops swap row data under the pointer grab —
    // the lifted card must follow the dragged session's data, not the
    // component that owns the grab.
    property <string> drag-id;
    property <bool> list-dragging: false;
    property <bool> inline-group-open: false;
    property <string> inline-group-name: "";
    callback toggle-group(string /* group */);
    callback new-group();
    callback create-group-inline(string /* name */);
    callback edit-group(string /* current-name */);
    callback delete-group(string /* name */);
    callback remove-session(string);
    callback search-changed(string);
    callback cycle-tab(bool /* reverse */);
    // Customisable shortcuts: key event → action id (see shortcuts.rs).
    callback match-shortcut(string, bool, bool, bool, bool, bool) -> string;
    // Compact mode (welcome-as-sidebar): drop the big title/tagline header and
    // tighten padding so the session list fits a narrow docked panel (#v0.5).
    in property <bool> compact;
    in property <string> dock-edge: "left";
    property <bool> dock-horizontal: root.dock-edge == "left" || root.dock-edge == "right";
    // Collapse the sidebar to the edge icon strip (compact mode only) (#v0.5 M5).
    callback collapse();
    callback dock-drag-move(length, length);
    callback dock-drag-end();

    background: root.compact ? Theme.bg-panel : Theme.bg-root;

    // The regular welcome page is itself a tab. When Ctrl+Tab wraps from the
    // last terminal to this page, keep the shortcut chain alive so the next
    // press can continue to the first terminal (#294). The compact welcome
    // sidebar must never take focus away from an active terminal. Windows
    // AccessKit may instantiate this conditional scope while walking the
    // accessibility tree, so defer focus to the next event-loop turn instead of
    // re-entering Slint's winit adapter from `init` (#323).
    if !root.compact : welcome-key-scope := FocusScope {
        property <bool> focus-pending: false;
        init => { self.focus-pending = true; }
        Timer {
            interval: 0ms;
            running: welcome-key-scope.focus-pending;
            triggered => {
                welcome-key-scope.focus-pending = false;
                welcome-key-scope.focus();
            }
        }
        key-pressed(event) => {
            let act = root.match-shortcut(event.text, event.modifiers.control,
                event.modifiers.meta, event.modifiers.alt, event.modifiers.shift, false);
            if (act == "next-tab" || act == "prev-tab") {
                root.cycle-tab(act == "prev-tab");
                accept
            } else {
                reject
            }
        }
    }

    VerticalLayout {
        padding: root.compact ? 0px : 24px;
        spacing: root.compact ? 0px : 18px;

        // Header (title + tagline) — pinned to the top at its natural height so
        // it can't grab the stretch space and spread apart (seen on macOS); the
        // quick-connect card below takes all the remaining height (#dock). Hidden
        // in compact/sidebar mode.
        if !root.compact : HorizontalLayout {
            vertical-stretch: 0;
            spacing: 12px;
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: start;
                spacing: 4px;
                Text {
                    text: "meatshell";
                    color: Theme.text-primary;
                    font-size: 26px;
                    font-weight: 700;
                }
                Text {
                    text: @tr("A lightweight and efficient Rust + Slint SSH client");
                    color: Theme.text-secondary;
                    font-size: Theme.fs-sm;
                    wrap: no-wrap;
                }
            }
            VerticalLayout {
                alignment: center;
                HorizontalLayout {
                    spacing: 8px;
                    GhostButton {
                        text: @tr("New group");
                        clicked => { root.new-group(); }
                    }
                    PrimaryButton {
                        text: @tr("+ New session");
                        clicked => { root.new-session(); }
                    }
                }
            }
        }

        // Quick Connect card — frameless flat container in compact sidebar mode
        // (no nested box-in-box borders), elevated card in full-page tab mode.
        Rectangle {
            vertical-stretch: 1;
            background: Theme.bg-panel;
            border-radius: root.compact ? 0px : Theme.radius-md;
            border-width: root.compact ? 0px : 1px;
            border-color: Theme.border-subtle;

            VerticalLayout {
                padding-left: (root.compact ? 12px : 18px) * Theme.ui-scale;
                padding-right: (root.compact ? 12px : 18px) * Theme.ui-scale;
                padding-top: (root.compact ? 8px : 16px) * Theme.ui-scale;
                padding-bottom: (root.compact ? 10px : 16px) * Theme.ui-scale;
                spacing: (root.compact ? 8px : 12px) * Theme.ui-scale;

                Rectangle {
                    z: 60;
                    height: (root.compact ? 32px : 28px) * Theme.ui-scale;
                    TouchArea {
                        enabled: root.compact;
                        mouse-cursor: move;
                        moved => {
                            if (self.pressed) {
                                root.dock-drag-move(self.absolute-position.x + self.mouse-x,
                                                    self.absolute-position.y + self.mouse-y);
                            }
                        }
                        pointer-event(ev) => {
                            if (ev.kind == PointerEventKind.up) { root.dock-drag-end(); }
                            // Grab taken away (popup, deactivation): end the gesture
                            // anyway so no dock preview is stranded.
                            else if (ev.kind == PointerEventKind.cancel) { root.dock-drag-end(); }
                        }
                    }
                    header-row := HorizontalLayout {
                        spacing: 4px * Theme.ui-scale;
                        if root.compact && root.dock-edge != "left" : IconButton {
                            size: 28px * Theme.ui-scale;
                            glyph: root.dock-edge == "right" ? "chevron-right"
                                 : root.dock-edge == "top" ? "chevron-up"
                                 : "chevron-down";
                            font-family: "Material Icons";
                            tooltip: @tr("Collapse");
                            clicked => { root.collapse(); }
                        }
                        Text {
                            text: @tr("Quick connect");
                            color: Theme.text-primary;
                            font-size: root.compact ? Theme.fs-lg : Theme.fs-lg;
                            font-weight: 600;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        if root.import-hint != "" : Text {
                            text: root.import-hint;
                            color: Theme.text-muted;
                            font-size: Theme.fs-xs;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        // Compact header action icons: New Group + New Session + Collapse
                        if root.compact : IconButton {
                            size: 28px * Theme.ui-scale;
                            glyph: "folder-plus";
                            font-family: "Material Icons";
                            tooltip: @tr("New group");
                            clicked => {
                                root.inline-group-open = !root.inline-group-open;
                                if (root.inline-group-open) {
                                    root.inline-group-name = "";
                                }
                            }
                        }
                        if root.compact : IconButton {
                            size: 28px * Theme.ui-scale;
                            glyph: "plus";
                            font-family: "Material Icons";
                            tooltip: @tr("New session");
                            clicked => { root.new-session(); }
                        }
                        if root.compact && root.dock-edge == "left" : IconButton {
                            size: 28px * Theme.ui-scale;
                            glyph: "chevron-left";
                            font-family: "Material Icons";
                            tooltip: @tr("Collapse");
                            tooltip-left: true;
                            clicked => { root.collapse(); }
                        }
                    }
                }

                // Inline New Group creation bar (replaces unnecessary popup modal)
                if root.inline-group-open : Rectangle {
                    height: 36px * Theme.ui-scale;
                    border-radius: Theme.radius-md;
                    border-width: 1px;
                    border-color: Theme.border-strong;
                    background: Theme.bg-root;

                    HorizontalLayout {
                        padding-left: 10px * Theme.ui-scale;
                        padding-right: 4px * Theme.ui-scale;
                        spacing: 6px * Theme.ui-scale;

                        Text {
                            text: "\u{E2CC}";
                            font-family: "Material Icons";
                            color: Theme.text-secondary;
                            font-size: 17px * Theme.ui-scale;
                            vertical-alignment: center;
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                            inline-grp-input := TextInput {
                                width: parent.width;
                                height: parent.height;
                                text <=> root.inline-group-name;
                                color: Theme.text-primary;
                                font-family: Theme.ui-font-family;
                                font-size: Theme.fs-sm;
                                vertical-alignment: center;
                                single-line: true;
                                init => { self.focus(); }
                                accepted => {
                                    if (root.inline-group-name != "") {
                                        root.create-group-inline(root.inline-group-name);
                                        root.inline-group-open = false;
                                        root.inline-group-name = "";
                                    }
                                }
                            }
                            if root.inline-group-name == "" : Text {
                                width: parent.width;
                                height: parent.height;
                                text: @tr("Enter group name...");
                                color: Theme.text-muted;
                                font-size: Theme.fs-sm;
                                horizontal-alignment: left;
                                vertical-alignment: center;
                            }
                        }

                        Rectangle {
                            width: 26px * Theme.ui-scale;
                            height: 26px * Theme.ui-scale;
                            y: (parent.height - self.height) / 2;
                            border-radius: Theme.radius-sm;
                            background: grp-ok-ta.has-hover ? Theme.bg-hover : transparent;
                            grp-ok-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    if (root.inline-group-name != "") {
                                        root.create-group-inline(root.inline-group-name);
                                        root.inline-group-open = false;
                                        root.inline-group-name = "";
                                    }
                                }
                            }
                            Text {
                                text: "\u{E5CA}"; // check
                                font-family: "Material Icons";
                                color: Theme.success;
                                font-size: 16px * Theme.ui-scale;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        Rectangle {
                            width: 26px * Theme.ui-scale;
                            height: 26px * Theme.ui-scale;
                            y: (parent.height - self.height) / 2;
                            border-radius: Theme.radius-sm;
                            background: grp-cancel-ta.has-hover ? Theme.bg-hover : transparent;
                            grp-cancel-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.inline-group-open = false;
                                    root.inline-group-name = "";
                                }
                            }
                            Text {
                                text: "\u{E5CD}"; // close
                                font-family: "Material Icons";
                                color: Theme.text-muted;
                                font-size: 16px * Theme.ui-scale;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                // Filter saved and built-in sessions by display name or host.
                Rectangle {
                    height: 36px * Theme.ui-scale;
                    border-radius: Theme.radius-md;
                    border-width: 1px;
                    border-color: search-input.has-focus ? Theme.accent : Theme.border-subtle;
                    background: Theme.bg-root;

                    HorizontalLayout {
                        padding-left: 10px * Theme.ui-scale;
                        padding-right: 6px * Theme.ui-scale;
                        spacing: 6px * Theme.ui-scale;

                        VerticalLayout {
                            alignment: center;
                            OutlineIcon {
                                name: "search";
                                color: Theme.text-muted;
                                icon-size: 15px * Theme.ui-scale;
                            }
                        }

                        Rectangle {
                            horizontal-stretch: 1;

                            search-input := TextInput {
                                width: parent.width;
                                height: parent.height;
                                text <=> root.search-query;
                                color: Theme.text-primary;
                                font-family: Theme.ui-font-family;
                                font-size: Theme.fs-sm;
                                vertical-alignment: center;
                                single-line: true;
                                edited => { root.search-changed(root.search-query); }
                            }

                            if root.search-query == "" : Text {
                                width: parent.width;
                                height: parent.height;
                                text: @tr("Search by name or host...");
                                color: Theme.text-muted;
                                font-size: Theme.fs-sm;
                                horizontal-alignment: left;
                                vertical-alignment: center;
                            }
                        }

                        if root.search-query != "" : Rectangle {
                            width: 24px;
                            height: parent.height;

                            Rectangle {
                                width: 24px;
                                height: 24px;
                                y: (parent.height - self.height) / 2;
                                border-radius: Theme.radius-sm;
                                background: clear-search.has-hover ? Theme.bg-hover : transparent;
                                accessible-role: button;
                                accessible-label: @tr("Clear search");

                                Text {
                                    text: "\u{E5CD}";
                                    font-family: "Material Icons";
                                    color: Theme.text-muted;
                                    font-size: Theme.fs-sm;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                                clear-search := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.search-query = "";
                                        root.search-changed("");
                                        search-input.focus();
                                    }
                                }

                                if clear-search.has-hover : Rectangle {
                                    x: parent.width - self.width;
                                    y: parent.height + 4px;
                                    width: clear-search-tip.preferred-width + 16px;
                                    height: 22px;
                                    background: Theme.bg-elevated;
                                    border-radius: Theme.radius-sm;
                                    border-width: 1px;
                                    border-color: Theme.border-strong;
                                    drop-shadow-blur: 8px;
                                    drop-shadow-color: #00000070;

                                    clear-search-tip := Text {
                                        width: parent.width;
                                        height: parent.height;
                                        text: @tr("Clear search");
                                        color: Theme.text-primary;
                                        font-size: Theme.fs-xs;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }

                if sessions.length == 0 : Rectangle {
                    vertical-stretch: 1;
                    background: Theme.bg-root;
                    border-radius: Theme.radius-sm;
                    border-width: 1px;
                    border-color: Theme.border-subtle;

                    VerticalLayout {
                        alignment: center;
                        spacing: 6px;
                        Text {
                            text: root.search-query == ""
                                ? @tr("No sessions yet")
                                : @tr("No matching sessions");
                            color: Theme.text-secondary;
                            font-size: Theme.fs-md;
                            horizontal-alignment: center;
                        }
                        if root.search-query == "" : Text {
                            text: @tr("Use 'New session' (top-right) to add your first server");
                            color: Theme.text-muted;
                            font-size: Theme.fs-sm;
                            horizontal-alignment: center;
                        }
                    }
                }

                if sessions.length > 0 : ScrollView {
                    vertical-stretch: 1;
                    content-width: self.visible-width;
                    content-height: max(self.visible-height, sess-list.preferred-height);
                    sess-list := VerticalLayout {
                    spacing: 0px;
                    for session[i] in sessions : VerticalLayout {
                        // Exclude hidden rows from layout spacing while a group
                        // is collapsed; keep its first row for the group header.
                        visible: session.group-header != "" || !session.collapsed;
                        padding-top: self.visible && i > 0 ? 2px : 0px;
                        spacing: 2px;
                        // Group header on the first row of each group (#41).
                        if session.group-header != "" : SessionGroupHeader {
                            session: session;
                            search-query: root.search-query;
                            toggle-group(g) => { root.toggle-group(g); }
                            edit-group(g) => { root.edit-group(g); }
                            delete-group(g) => { root.delete-group(g); }
                            new-group() => { root.new-group(); }
                        }
                        if session.id != "" && !session.collapsed : SessionRow {
                            session: session;
                            compact: root.compact;
                            all-sessions: root.sessions;
                            // Drag-reorder is meaningless while the list is a
                            // filtered subset, and system rows can't move.
                            reorder-enabled: root.search-query == "" && !session.builtin;
                            drag-target: root.list-dragging && root.drag-id == session.id;
                            list-dragging: root.list-dragging;
                            connect => { root.connect-session(session.id); }
                            edit => { root.edit-session(session.id); }
                            duplicate => { root.duplicate-session(session.id); }
                            move-to-group(g) => { root.move-session(session.id, g); }
                            reorder(dir) => { return root.reorder-session(root.drag-id, dir); }
                            drag-start => { root.drag-id = session.id; root.list-dragging = true; }
                            drag-end => {
                                root.list-dragging = false;
                                root.drag-id = "";
                                root.reorder-end();
                            }
                            remove => { root.remove-session(session.id); }
                        }
                    }
                    }
                }
            }
        }
    }
}
