// Central design tokens for meatshell.
//
// All colour values are reactive: change `dark` and every widget repaints
// automatically via Slint's property-binding system.
//
// Dark palette  — high-contrast charcoal (original meatshell look).
// Light palette — Apple macOS-inspired:
//   • Backgrounds use #f5f5f7 (Apple page gray) instead of pure white to
//     avoid eye-strain.
//   • Primary text is #1d1d1f (Apple near-black) not #000000.
//   • Accent is #0071e3 (Apple blue), consistent across both themes.

// One colour theme variant (light or dark) of the Wallpaper & theme presets.
// Rust fills it from the selected preset; the defaults below are the original
// MeatShell palette.
export struct ThemePalette {
    bg-root: color,
    bg-panel: color,
    bg-panel-alt: color,
    bg-elevated: color,
    bg-hover: color,
    bg-active: color,
    tab-active-bg: color,
    tab-active-border: color,
    border-subtle: color,
    border-strong: color,
    text-primary: color,
    text-secondary: color,
    text-muted: color,
    accent: color,
    accent-hover: color,
    accent-pressed: color,
    term-bg: color,
}

// Terminal colour scheme for one mode (Settings › Terminal colours). Rust fills
// it from the chosen scheme; `custom` is false for MeatShell's default
// terminal colours, which keep the colour theme's terminal background and the
// accent-tinted selection.
export struct TermColors {
    custom: bool,
    bg: color,
    fg: color,
    cursor: color,
    selection: color,
}

export global Theme {
    // Set by Rust on startup (system detection) and on user toggle.
    in-out property <bool> dark: true;

    // --- Colour theme presets (Settings › Wallpaper & theme) --------------
    in-out property <ThemePalette> palette-dark: {
        bg-root: #1b1d23, bg-panel: #23262d, bg-panel-alt: #2a2d35,
        bg-elevated: #30333c, bg-hover: #373a44, bg-active: #3f4350,
        tab-active-bg: #171a20, tab-active-border: #06070a,
        border-subtle: #3a3d46, border-strong: #4a4e59,
        text-primary: #e6e8ee, text-secondary: #b4b9c4, text-muted: #9196a3,
        accent: #4a90e2, accent-hover: #5aa0f2, accent-pressed: #3a80d2,
        term-bg: #0e0f13,
    };
    in-out property <ThemePalette> palette-light: {
        bg-root: #f5f5f7, bg-panel: #ffffff, bg-panel-alt: #f2f2f7,
        bg-elevated: #e8e8ed, bg-hover: #e0e0e6, bg-active: #d8d8de,
        tab-active-bg: #ffffff, tab-active-border: #c7c7cc,
        border-subtle: #e2e2e8, border-strong: #c7c7cc,
        text-primary: #1d1d1f, text-secondary: #45454a, text-muted: #606066,
        accent: #0071e3, accent-hover: #0077ed, accent-pressed: #006adb,
        term-bg: #fafafa,
    };
    property <ThemePalette> p: root.dark ? root.palette-dark : root.palette-light;
    // Immersive colours: with a wallpaper, take accent + surface tint from the
    // image. Off keeps the wallpaper but uses the colour theme.
    in-out property <bool> immersive: true;
    out property <bool> immersive-active: root.wallpaper-active && root.immersive;

    // --- Immersive wallpaper (set by Rust from the wallpaper module) -------
    // When a wallpaper is active the window paints `wallpaper` behind everything
    // (see app.slint), panels/terminal frost over it, accent + surfaces shift
    // toward the image's colours, and Rust sets `dark` from the image luminance.
    in-out property <image> wallpaper;
    in-out property <bool>  wallpaper-active: false;
    in-out property <color> wp-accent: #4a90e2;   // vivid accent from the image
    in-out property <color> wp-tint:   #808080;   // average colour, tints surfaces
    // Frosted glass: Rust bakes a small blurred copy of the wallpaper (Slint has
    // no runtime blur). With frost on, windows paint that copy instead of the
    // sharp image, plus a wash matching light/dark mode, so the gaps between
    // panels read as frosted glass rather than the raw (possibly bright) image.
    in-out property <image> wallpaper-blurred;
    in-out property <bool>  wallpaper-frost: false;   // display mode: frosted glass vs transparency
    out property <bool> frost-active: root.wallpaper-active && root.wallpaper-frost
        && root.wallpaper-blurred.width > 0;
    out property <image> wallpaper-backdrop: root.frost-active ? root.wallpaper-blurred : root.wallpaper;
    // Window backdrop layer: one full-window layer between the wallpaper and
    // all panels, in the theme's own root colour (dark in dark mode, light in
    // light mode), so e.g. a light wallpaper doesn't glare through a dark UI.
    // Panels keep their own transparency on top of it.
    // Frosted glass: fixed alpha 0x61 ≈ 38% dark / 0x73 ≈ 45% light over the
    // blurred image. Transparency: `gap-dim` (user slider "Backdrop layer
    // opacity", default 0.4) over the sharp image.
    in-out property <float> gap-dim: 0.4;
    out property <brush> frost-wash: !root.wallpaper-active ? transparent
        : root.frost-active ? (root.dark ? #10131a61 : #f4f6fa73)
        : root.p.bg-root.with-alpha(root.gap-dim);
    // Frosted-panel opacity over a wallpaper (0.30–1.00). User-adjustable via the
    // Interface › Wallpaper opacity slider; bg-root / term-bg derive from it so one
    // control scales the whole wallpaper wash. Default 0.85 (15% transparency).
    in-out property <float> panel-alpha: 0.85;
    // Panel layout style (Settings › Wallpaper & theme): rounded floating cards
    // separated by gaps (default), or square panels flush against each other and
    // divided by 1px lines. Rust persists the choice.
    in-out property <bool> flat-panels: false;

    // --- Appearance skin ---------------------------------------------------
    // 0 classic (frosted wallpaper, the original look), 1 signal room,
    // 2 aurora ink, 3 liquid chrome. A skin owns the material — surface fills,
    // backdrop and edge light — while the palette preset still owns the
    // colours, so the two can never contradict each other: each skin ships
    // with a matching preset in `color_theme.rs`.
    //
    // Classic falls through to every existing expression, so choosing it keeps
    // the app pixel-identical to before this property existed.
    in-out property <int> skin: 0;
    out property <bool> skin-classic: root.skin == 0;
    out property <bool> skin-signal:  root.skin == 1;
    out property <bool> skin-aurora:  root.skin == 2;
    out property <bool> skin-chrome:  root.skin == 3;
    out property <bool> skin-styled:  root.skin != 0;
    // 1px light on the top edge of a card: the cheapest way to read as glass
    // instead of a flat rectangle.
    out property <brush> skin-edge: root.skin-signal ? (root.dark ? #ff8a5c66 : #d2542a4d)
        : root.skin-aurora ? (root.dark ? #f0b26b55 : #b07a344a)
        : root.skin-chrome ? (root.dark ? #ffffff3d : #ffffff)
        : transparent;
    // Card hairline. Chrome is machined metal: a white edge on top that falls
    // into a dark shadow at the bottom, so the 1px outline reads as thickness
    // rather than as a stroke. Signal / aurora keep a light top edge only.
    out property <brush> skin-card-border: root.skin-signal
        ? @linear-gradient(180deg, #ffffff21 0%, #ffffff0d 9%, #ffffff00 100%)
        : root.skin-aurora
        ? @linear-gradient(180deg, #ffffff26 0%, #ffffff0a 10%, #ffffff00 100%)
        : root.skin-chrome
        ? (root.dark
            ? @linear-gradient(180deg, #ffffff33 0%, #ffffff14 10%, #ffffff00 100%)
            : @linear-gradient(180deg, #ffffff 0%, #0000000f 42%, #0000002e 100%))
        : root.border-subtle;
    // Aurora is glass over light: panels stay slightly translucent so the
    // backdrop's washes read through them instead of being walled off. Nested
    // surfaces sit a little denser than the outer card.
    property <float> aurora-glass: 0.68;
    // Height of the Signal Room's live-throughput strip. app.slint reserves it
    // above the dock area (and shifts the floating toolbar down by the same
    // amount); 0 for every other skin, so their layout is untouched.
    out property <length> signal-band-h: root.skin-signal ? 18px : 0px;
    property <float> tint-amt: 0.10;              // how far surfaces pull to wp-tint

    // Frost a base surface: pull it slightly toward the wallpaper tint and make
    // it translucent so the image shows through. Returns the plain base colour
    // when no wallpaper is active (so the normal opaque theme is unchanged).
    pure function frost(base: color, alpha: float) -> brush {
        return root.immersive-active
            ? base.mix(root.wp-tint, 1.0 - root.tint-amt).with-alpha(alpha)
            : (root.wallpaper-active ? base.with-alpha(alpha) : base);
    }

    // --- Palette -----------------------------------------------------------
    // Opaque window base — the wallpaper Image covers it when active, so panels
    // frost over the image rather than over this.
    out property <brush> window-base: root.p.bg-root;

    property <color> base-bg-root:      root.p.bg-root;
    property <color> base-bg-panel:     root.p.bg-panel;
    property <color> base-bg-panel-alt: root.p.bg-panel-alt;
    property <color> base-bg-elevated:  root.p.bg-elevated;
    property <color> base-bg-hover:     root.p.bg-hover;
    property <color> base-bg-active:    root.p.bg-active;

    // Surface ladders per skin. Each skin has a dark and a light variant so the
    // app's dark/light switch keeps working; the light variants are the same
    // material under daylight, not a different design.
    property <color> skin-root: root.skin-signal ? (root.dark ? #07090c : #e9e1d2)
        : root.skin-aurora ? (root.dark ? #050807 : #dfe4dc)
        : root.skin-chrome ? (root.dark ? #16181b : #e7e5de)
        : root.p.bg-root;
    property <color> skin-root-top: root.skin-signal ? (root.dark ? #0e1218 : #f4ede1)
        : root.skin-aurora ? (root.dark ? #0a100d : #ecefe8)
        : root.skin-chrome ? (root.dark ? #1f232a : #f1efe9)
        : root.p.bg-root;
    property <color> skin-panel-top: root.skin-signal ? (root.dark ? #161c25 : #fffdf9)
        : root.skin-aurora ? (root.dark ? #101814 : #fdfefc)
        : root.skin-chrome ? (root.dark ? #23272e : #ffffff)
        : root.p.bg-panel;
    property <color> skin-panel: root.skin-signal ? (root.dark ? #0e1217 : #f9f4ec)
        : root.skin-aurora ? (root.dark ? #0a110e : #f8faf6)
        : root.skin-chrome ? (root.dark ? #1c1f24 : #f4f2ec)
        : root.p.bg-panel;
    property <color> skin-panel-alt: root.skin-signal ? (root.dark ? #12171d : #f2ecdf)
        : root.skin-aurora ? (root.dark ? #0d1411 : #eef1ea)
        : root.skin-chrome ? (root.dark ? #22262c : #efede6)
        : root.p.bg-panel-alt;
    property <color> skin-elevated: root.skin-signal ? (root.dark ? #171d25 : #fffdf7)
        : root.skin-aurora ? (root.dark ? #131b17 : #fcfdf9)
        : root.skin-chrome ? (root.dark ? #282d34 : #faf9f5)
        : root.p.bg-elevated;
    property <color> skin-hover: root.skin-signal ? (root.dark ? #1c2430 : #eae3d4)
        : root.skin-aurora ? (root.dark ? #1a241f : #e6eadf)
        : root.skin-chrome ? (root.dark ? #30363e : #eae8e1)
        : root.p.bg-hover;
    property <color> skin-active: root.skin-signal ? (root.dark ? #253040 : #e0d8c7)
        : root.skin-aurora ? (root.dark ? #232f29 : #dce1d6)
        : root.skin-chrome ? (root.dark ? #3a414a : #e2e0d9)
        : root.p.bg-active;

    // bg-root frosts lighter (lower alpha) so the wallpaper reads clearly in
    // empty / inset areas; panels stay mostly opaque for legible text.
    // A styled skin replaces the frost with its own opaque surface: the point
    // of signal / aurora / chrome is that the app keeps its identity whatever
    // image is behind it, so the wallpaper is covered (see the backdrop layers
    // in app.slint) rather than showing through.
    out property <brush> bg-root: root.skin-classic
        ? frost(base-bg-root, max(0.0, root.panel-alpha - 0.44))
        : @linear-gradient(180deg, skin-root-top 0%, skin-root 64%);
    // Styled panels get a 4% vertical lift: a flat rectangle reads as a block,
    // while a faint top-to-bottom step reads as a surface with a light source.
    out property <brush> bg-panel: root.skin-classic
        ? frost(base-bg-panel, root.panel-alpha)
        : root.skin-aurora
        ? @linear-gradient(180deg,
            skin-panel-top.with-alpha(root.aurora-glass) 0%,
            skin-panel.with-alpha(root.aurora-glass - 0.04) 100%)
        : @linear-gradient(180deg, skin-panel-top 0%, skin-panel 100%);
    out property <brush> bg-panel-alt: root.skin-classic
        ? frost(base-bg-panel-alt, root.panel-alpha)
        : root.skin-aurora
        ? skin-panel-alt.with-alpha(min(1.0, root.aurora-glass + 0.06))
        : skin-panel-alt;
    out property <brush> bg-elevated: root.skin-classic
        ? frost(base-bg-elevated, root.panel-alpha)
        : root.skin-aurora
        ? skin-elevated.with-alpha(min(1.0, root.aurora-glass + 0.08))
        : skin-elevated;
    out property <brush> bg-hover: root.skin-classic
        ? frost(base-bg-hover, min(1.0, root.panel-alpha + 0.04))
        : skin-hover;
    out property <brush> bg-active: root.skin-classic
        ? frost(base-bg-active, min(1.0, root.panel-alpha + 0.08))
        : skin-active;
    // Floating cards (resource panel, Quick connect, quick commands, recent
    // connections). In dark mode the plain panel colour sits too close to the
    // window behind it to show the card's edge, so cards get a lighter slate
    // there; light mode already has the contrast and keeps bg-panel.
    in-out property <color> card-dark: #2D3440;
    out property <brush> card-bg: root.skin-styled ? root.bg-panel
        : (root.dark ? frost(root.card-dark, root.panel-alpha) : root.bg-panel);
    // Settings dialog: 20% less transparent than the other panels so its dense
    // grey labels stay legible even at a low wallpaper overlay (user request).
    out property <brush> bg-panel-strong: frost(base-bg-panel, min(1.0, root.panel-alpha + 0.20));
    // Menus, editors and modal cards must stay readable independently of the
    // wallpaper transparency selected for ordinary application panels (#287).
    out property <brush> popup-bg: base-bg-panel;
    out property <brush> popup-bg-alt: base-bg-panel-alt;

    // Active terminal tab: with wallpaper, pull from the image's average colour
    // so the strip feels immersed; without wallpaper, make the active tab one
    // clear step darker/lighter than the surrounding tab bar (#200).
    // Styled skins drop the boxed look for a surface + a 2px light beneath the
    // label (see tabs.slint), so the fill here only sets the tint.
    out property <brush> tab-active-bg: root.skin-signal ? skin-panel-alt
        : root.skin-aurora ? #ffffff12
        : root.skin-chrome ? (root.dark ? #2b3138 : #ffffff)
        : (root.immersive-active
            ? root.wp-tint.mix(root.wp-accent, 0.68).with-alpha(min(1.0, root.panel-alpha + 0.10))
            : (root.wallpaper-active
                ? root.p.tab-active-bg.with-alpha(min(1.0, root.panel-alpha + 0.10))
                : root.p.tab-active-bg));
    out property <brush> tab-active-border: root.skin-styled ? root.accent
        : (root.immersive-active
            ? root.wp-accent.with-alpha(0.72)
            : root.p.tab-active-border);

    out property <brush> border-subtle: root.p.border-subtle;
    out property <brush> border-strong: root.p.border-strong;

    out property <brush> text-primary:   root.p.text-primary;
    // Light-mode secondary/muted are dark enough to read over a see-through
    // frosted-wallpaper panel.
    out property <brush> text-secondary: root.p.text-secondary;
    out property <brush> text-muted:     root.p.text-muted;

    // A styled skin keeps its preset's accent: immersive colours come from the
    // wallpaper, and the whole point of a skin is to not depend on the image.
    out property <brush> accent:         root.immersive-active && !root.skin-styled
        ? root.wp-accent : root.p.accent;
    out property <brush> accent-hover:   root.immersive-active && !root.skin-styled
        ? root.wp-accent.brighter(0.12) : root.p.accent-hover;
    out property <brush> accent-pressed: root.immersive-active && !root.skin-styled
        ? root.wp-accent.darker(0.12) : root.p.accent-pressed;
    // The same accent as a plain colour: several properties (drop-shadow,
    // border colours) are typed <color> and can't take a <brush>.
    out property <color> accent-color: root.immersive-active && !root.skin-styled
        ? root.wp-accent : root.p.accent;

    out property <brush> success: dark ? #4ec9b0 : #34c759;
    out property <brush> warning: dark ? #e2a84a : #ff9f0a;
    out property <brush> danger:  dark ? #e25c5c : #ff3b30;

    // Terminal uses its own background so it stays readable regardless of
    // what the shell / remote app outputs via ANSI colour codes. With a
    // wallpaper it frosts (kept neutral, not tinted) so text stays legible.
    // A terminal colour scheme replaces the background, text, cursor and
    // selection colours for its mode.
    in-out property <TermColors> term-colors-dark: {
        custom: false, bg: #0e0f13, fg: #d4d4d4, cursor: #d4d4d4, selection: #4a90e2,
    };
    in-out property <TermColors> term-colors-light: {
        custom: false, bg: #fafafa, fg: #2d2d2f, cursor: #2d2d2f, selection: #0071e3,
    };
    property <TermColors> tc: root.dark ? root.term-colors-dark : root.term-colors-light;
    property <color> base-term-bg: root.tc.custom ? root.tc.bg : root.p.term-bg;
    out property <brush> term-bg: root.skin-styled ? base-term-bg
        : (root.wallpaper-active ? base-term-bg.with-alpha(max(0.0, root.panel-alpha - 0.14)) : base-term-bg);
    out property <brush> term-fg: root.tc.fg;
    out property <color> term-cursor: root.tc.cursor;
    out property <brush> term-selection: root.tc.custom ? root.tc.selection : root.accent.with-alpha(0.40);

    // True on macOS (set by Rust). App shortcuts use Cmd (⌘) here instead of
    // Ctrl, so the physical Ctrl key stays free for the shell (^C/^X…) (#158).
    in-out property <bool> is-mac: false;

    // Whether the app window is focused & visible. Rust drives this from winit
    // focus/minimize/occlusion events; the terminal cursor stops blinking when
    // it's false, so an idle background window doesn't repaint (#127).
    in-out property <bool> window-focused: true;

    // Global UI scale (#100/#117/#118). Rust sets this from the saved setting;
    // all font sizes and spacing/radii below multiply by it, so the whole UI
    // grows/shrinks live (the terminal font has its own size setting).
    in-out property <float> ui-scale: 1.0;
    // Settings-panel font scale (#v0.5). The settings card + its text multiply by
    // this so the panel (which is exempt from ui-scale) can still be enlarged.
    in-out property <float> panel-font: 1.0;

    // --- Typography --------------------------------------------------------
    out property <length> fs-xs: 11px * root.ui-scale;
    out property <length> fs-sm: 12px * root.ui-scale;
    out property <length> fs-md: 13px * root.ui-scale;
    out property <length> fs-lg: 15px * root.ui-scale;
    out property <length> fs-xl: 18px * root.ui-scale;

    // Embedded glyph-complete monospace (Cascadia Mono under a unique name, #114).
    out property <string> font-mono: "Meatshell Mono";

    // UI (sans) font for editable inputs. The embedded mono font has no CJK
    // glyphs and native TextInput doesn't glyph-fallback like Text does, so
    // typing Chinese into a bare TextInput renders tofu. Rust sets this to a
    // CJK-capable system font on startup (empty = platform default).
    in-out property <string> ui-font-family: "";

    // Terminal font — user-configurable via Interface settings, set by Rust
    // from the config on startup. cell size in terminal_view derives from these.
    in-out property <string> term-font-family: "Meatshell Mono";
    in-out property <length> term-font-size: 13px;
    in-out property <bool> term-font-bold: false;

    // --- Geometry ----------------------------------------------------------
    out property <length> radius-sm: 4px * root.ui-scale;
    out property <length> radius-md: 6px * root.ui-scale;
    out property <length> radius-lg: 10px * root.ui-scale;

    // Card layout geometry: the docked panels inset their card by `card-gap`
    // inside the rect Rust gave them, and the central card keeps the same
    // distance from the window edges (Rust mirrors this in `central_insets`).
    // Flat mode removes both the gap and the rounding so panels touch; their
    // 1px hairlines then read as divider lines.
    out property <length> card-gap: root.flat-panels ? 0px : 10px;
    out property <length> card-radius: root.flat-panels ? 0px : root.radius-md;

    out property <length> gap-xs: 4px * root.ui-scale;
    out property <length> gap-sm: 8px * root.ui-scale;
    out property <length> gap-md: 12px * root.ui-scale;
    out property <length> gap-lg: 16px * root.ui-scale;
}
