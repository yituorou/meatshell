// Central design tokens for meatshell.
//
// All colour values are reactive: change `dark` and every widget repaints
// automatically via Slint's property-binding system.
//
// Dark palette  — high-contrast charcoal (original meatshell look).
// Light palette — Apple macOS-inspired:
//   • Backgrounds use #f5f5f7 (Apple page gray) instead of pure white to
//     avoid eye-strain.
//   • Primary text is #1d1d1f (Apple near-black) not #000000.
//   • Accent is #0071e3 (Apple blue), consistent across both themes.

// One colour theme variant (light or dark) of the Wallpaper & theme presets.
// Rust fills it from the selected preset; the defaults below are the original
// MeatShell palette.
export struct ThemePalette {
    bg-root: color,
    bg-panel: color,
    bg-panel-alt: color,
    bg-elevated: color,
    bg-hover: color,
    bg-active: color,
    tab-active-bg: color,
    tab-active-border: color,
    border-subtle: color,
    border-strong: color,
    text-primary: color,
    text-secondary: color,
    text-muted: color,
    accent: color,
    accent-hover: color,
    accent-pressed: color,
    term-bg: color,
}

export global Theme {
    // Set by Rust on startup (system detection) and on user toggle.
    in-out property <bool> dark: true;

    // --- Colour theme presets (Settings › Wallpaper & theme) --------------
    in-out property <ThemePalette> palette-dark: {
        bg-root: #212121, bg-panel: #171717, bg-panel-alt: #1d1d1d,
        bg-elevated: #242424, bg-hover: #2b2b2b, bg-active: #333333,
        tab-active-bg: #212121, tab-active-border: #3b82f6,
        border-subtle: #2e2e2e, border-strong: #3e3e3e,
        text-primary: #ececec, text-secondary: #b4b4b4, text-muted: #8e8e8e,
        accent: #3b82f6, accent-hover: #60a5fa, accent-pressed: #2563eb,
        term-bg: #212121,
    };
    in-out property <ThemePalette> palette-light: {
        bg-root: #ffffff, bg-panel: #f9f9f9, bg-panel-alt: #f3f3f3,
        bg-elevated: #efefef, bg-hover: #e8e8e8, bg-active: #e0e0e0,
        tab-active-bg: #ffffff, tab-active-border: #2563eb,
        border-subtle: #e8e8e8, border-strong: #d4d4d4,
        text-primary: #0d0d0d, text-secondary: #4e4e4e, text-muted: #6b6b6b,
        accent: #2563eb, accent-hover: #1d4ed8, accent-pressed: #1e40af,
        term-bg: #ffffff,
    };
    property <ThemePalette> p: root.dark ? root.palette-dark : root.palette-light;
    // Immersive colours: with a wallpaper, take accent + surface tint from the
    // image. Off keeps the wallpaper but uses the colour theme.
    in-out property <bool> immersive: true;
    out property <bool> immersive-active: root.wallpaper-active && root.immersive;

    // --- Immersive wallpaper (set by Rust from the wallpaper module) -------
    // When a wallpaper is active the window paints `wallpaper` behind everything
    // (see app.slint), panels/terminal frost over it, accent + surfaces shift
    // toward the image's colours, and Rust sets `dark` from the image luminance.
    in-out property <image> wallpaper;
    in-out property <bool>  wallpaper-active: false;
    in-out property <color> wp-accent: #4a90e2;   // vivid accent from the image
    in-out property <color> wp-tint:   #808080;   // average colour, tints surfaces
    // Frosted-panel opacity over a wallpaper (0.30–1.00). User-adjustable via the
    // Interface › Wallpaper opacity slider; bg-root / term-bg derive from it so one
    // control scales the whole wallpaper wash. Default 0.85 (15% transparency).
    in-out property <float> panel-alpha: 0.85;
    property <float> tint-amt: 0.10;              // how far surfaces pull to wp-tint

    // Frost a base surface: pull it slightly toward the wallpaper tint and make
    // it translucent so the image shows through. Returns the plain base colour
    // when no wallpaper is active (so the normal opaque theme is unchanged).
    pure function frost(base: color, alpha: float) -> brush {
        return root.immersive-active
            ? base.mix(root.wp-tint, 1.0 - root.tint-amt).with-alpha(alpha)
            : (root.wallpaper-active ? base.with-alpha(alpha) : base);
    }

    // --- Palette -----------------------------------------------------------
    // Opaque window base — the wallpaper Image covers it when active, so panels
    // frost over the image rather than over this.
    out property <brush> window-base: root.p.bg-root;

    property <color> base-bg-root:      root.p.bg-root;
    property <color> base-bg-panel:     root.p.bg-panel;
    property <color> base-bg-panel-alt: root.p.bg-panel-alt;
    property <color> base-bg-elevated:  root.p.bg-elevated;
    property <color> base-bg-hover:     root.p.bg-hover;
    property <color> base-bg-active:    root.p.bg-active;

    // bg-root frosts lighter (lower alpha) so the wallpaper reads clearly in
    // empty / inset areas; panels stay mostly opaque for legible text.
    out property <brush> bg-root:      frost(base-bg-root, max(0.0, root.panel-alpha - 0.44));
    out property <brush> bg-panel:     frost(base-bg-panel, root.panel-alpha);
    out property <brush> bg-panel-alt: frost(base-bg-panel-alt, root.panel-alpha);
    out property <brush> bg-elevated:  frost(base-bg-elevated, root.panel-alpha);
    out property <brush> bg-hover:     frost(base-bg-hover, min(1.0, root.panel-alpha + 0.04));
    out property <brush> bg-active:    frost(base-bg-active, min(1.0, root.panel-alpha + 0.08));
    // Settings dialog: 20% less transparent than the other panels so its dense
    // grey labels stay legible even at a low wallpaper overlay (user request).
    out property <brush> bg-panel-strong: frost(base-bg-panel, min(1.0, root.panel-alpha + 0.20));
    // Menus, editors and modal cards must stay readable independently of the
    // wallpaper transparency selected for ordinary application panels (#287).
    out property <brush> popup-bg: base-bg-panel;
    out property <brush> popup-bg-alt: base-bg-panel-alt;

    // Active terminal tab: with wallpaper, pull from the image's average colour
    // so the strip feels immersed; without wallpaper, make the active tab one
    // clear step darker/lighter than the surrounding tab bar (#200).
    out property <brush> tab-active-bg: root.immersive-active
        ? root.wp-tint.mix(root.wp-accent, 0.68).with-alpha(min(1.0, root.panel-alpha + 0.10))
        : (root.wallpaper-active
            ? root.p.tab-active-bg.with-alpha(min(1.0, root.panel-alpha + 0.10))
            : root.p.tab-active-bg);
    out property <brush> tab-active-border: root.immersive-active
        ? root.wp-accent.with-alpha(0.72)
        : root.p.tab-active-border;

    out property <brush> border-subtle: root.p.border-subtle;
    out property <brush> border-strong: root.p.border-strong;

    out property <brush> text-primary:   root.p.text-primary;
    // Light-mode secondary/muted are dark enough to read over a see-through
    // frosted-wallpaper panel.
    out property <brush> text-secondary: root.p.text-secondary;
    out property <brush> text-muted:     root.p.text-muted;

    out property <brush> accent:         root.immersive-active ? root.wp-accent                 : root.p.accent;
    out property <brush> accent-hover:   root.immersive-active ? root.wp-accent.brighter(0.12) : root.p.accent-hover;
    out property <brush> accent-pressed: root.immersive-active ? root.wp-accent.darker(0.12)   : root.p.accent-pressed;

    out property <brush> success: dark ? #3fb950 : #16a34a;
    out property <brush> warning: dark ? #d29922 : #d97706;
    out property <brush> danger:  dark ? #f85149 : #dc2626;

    // Terminal uses its own background so it stays readable regardless of
    // what the shell / remote app outputs via ANSI colour codes. With a
    // wallpaper it frosts (kept neutral, not tinted) so text stays legible.
    // When an explicit iTerm2 / custom terminal color scheme is active, its
    // background, foreground, cursor, and selection colors take precedence.
    in-out property <bool> term-scheme-active: false;
    in-out property <bool> term-scheme-is-dark: true;
    in-out property <color> term-scheme-bg: #212121;
    in-out property <color> term-scheme-fg: #d4d4d4;
    in-out property <color> term-scheme-cursor: #d4d4d4;
    in-out property <color> term-scheme-cursor-text: #212121;
    in-out property <color> term-scheme-selection: #3b82f6;
    in-out property <color> term-scheme-selection-text: #ffffff;
    in-out property <color> term-scheme-accent: #3b82f6;

    out property <brush> term-bg: root.term-scheme-active
        ? root.term-scheme-bg
        : (root.wallpaper-active ? root.p.term-bg.with-alpha(max(0.0, root.panel-alpha - 0.14)) : root.p.term-bg);
    out property <color> term-fg: root.term-scheme-active ? root.term-scheme-fg : (dark ? #d4d4d4 : #2d2d2f);
    out property <color> term-cursor: root.term-scheme-active ? root.term-scheme-cursor : root.term-fg;
    out property <color> term-cursor-text: root.term-scheme-active
        ? root.term-scheme-cursor-text
        : (dark ? #212121 : #fafafa);
    out property <color> term-selection: root.term-scheme-active
        ? root.term-scheme-selection.with-alpha(0.45)
        : (root.immersive-active ? root.wp-accent.with-alpha(0.40) : root.p.accent.with-alpha(0.40));
    out property <color> term-selection-text: root.term-scheme-active
        ? root.term-scheme-selection-text
        : root.term-fg;

    // Terminal-scoped chrome (status strip, command bar, find bar, scrollbar)
    // adapts to the active iTerm2 color scheme when one is selected.
    out property <brush> term-bar-bg: root.term-scheme-active
        ? (root.term-scheme-is-dark ? root.term-scheme-bg.darker(0.12) : root.term-scheme-bg.darker(0.04))
        : root.bg-panel-alt;
    out property <brush> term-bar-elevated: root.term-scheme-active
        ? (root.term-scheme-is-dark ? root.term-scheme-bg.brighter(0.10) : root.term-scheme-bg.darker(0.08))
        : root.bg-elevated;
    out property <brush> term-bar-hover: root.term-scheme-active
        ? (root.term-scheme-is-dark ? root.term-scheme-bg.brighter(0.18) : root.term-scheme-bg.darker(0.13))
        : root.bg-hover;
    out property <brush> term-bar-active: root.term-scheme-active
        ? (root.term-scheme-is-dark ? root.term-scheme-bg.brighter(0.24) : root.term-scheme-bg.darker(0.18))
        : root.bg-active;
    out property <brush> term-input-bg: root.term-scheme-active
        ? (root.term-scheme-is-dark ? root.term-scheme-bg.darker(0.20) : root.term-scheme-bg.brighter(0.06))
        : root.bg-root;
    out property <brush> term-border-subtle: root.term-scheme-active
        ? root.term-scheme-fg.with-alpha(0.14)
        : root.border-subtle;
    out property <brush> term-border-strong: root.term-scheme-active
        ? root.term-scheme-fg.with-alpha(0.28)
        : root.border-strong;
    out property <brush> term-text-primary: root.term-scheme-active
        ? root.term-scheme-fg
        : root.text-primary;
    out property <brush> term-text-secondary: root.term-scheme-active
        ? root.term-scheme-fg.with-alpha(0.75)
        : root.text-secondary;
    out property <brush> term-text-muted: root.term-scheme-active
        ? root.term-scheme-fg.with-alpha(0.50)
        : root.text-muted;
    out property <brush> term-accent: root.term-scheme-active
        ? root.term-scheme-accent
        : root.accent;
    out property <brush> term-accent-hover: root.term-scheme-active
        ? root.term-scheme-accent.brighter(0.12)
        : root.accent-hover;

    // True on macOS (set by Rust). App shortcuts use Cmd (⌘) here instead of
    // Ctrl, so the physical Ctrl key stays free for the shell (^C/^X…) (#158).
    in-out property <bool> is-mac: false;

    // Whether the app window is focused & visible. Rust drives this from winit
    // focus/minimize/occlusion events; the terminal cursor stops blinking when
    // it's false, so an idle background window doesn't repaint (#127).
    in-out property <bool> window-focused: true;

    // Global UI scale (#100/#117/#118). Rust sets this from the saved setting;
    // all font sizes and spacing/radii below multiply by it, so the whole UI
    // grows/shrinks live (the terminal font has its own size setting).
    in-out property <float> ui-scale: 1.0;
    // Settings-panel font scale (#v0.5). The settings card + its text multiply by
    // this so the panel (which is exempt from ui-scale) can still be enlarged.
    in-out property <float> panel-font: 1.0;

    // --- Typography --------------------------------------------------------
    out property <length> fs-xs: 12px * root.ui-scale;
    out property <length> fs-sm: 13px * root.ui-scale;
    out property <length> fs-md: 14px * root.ui-scale;
    out property <length> fs-lg: 16px * root.ui-scale;
    out property <length> fs-xl: 22px * root.ui-scale;

    // Embedded glyph-complete monospace (Cascadia Mono under a unique name, #114).
    out property <string> font-mono: "Meatshell Mono";

    // UI (sans) font for editable inputs. The embedded mono font has no CJK
    // glyphs and native TextInput doesn't glyph-fallback like Text does, so
    // typing Chinese into a bare TextInput renders tofu. Rust sets this to a
    // CJK-capable system font on startup (PingFang SC on macOS, Microsoft YaHei on Windows).
    in-out property <string> ui-font-family: "PingFang SC, Microsoft YaHei";

    // Terminal font — user-configurable via Interface settings, set by Rust
    // from the config on startup. cell size in terminal_view derives from these.
    in-out property <string> term-font-family: "Meatshell Mono";
    in-out property <length> term-font-size: 13px;
    in-out property <bool> term-font-bold: false;

    // --- Geometry ----------------------------------------------------------
    out property <length> radius-sm: 6px * root.ui-scale;
    out property <length> radius-md: 8px * root.ui-scale;
    out property <length> radius-lg: 12px * root.ui-scale;

    out property <length> gap-xs: 4px * root.ui-scale;
    out property <length> gap-sm: 8px * root.ui-scale;
    out property <length> gap-md: 12px * root.ui-scale;
    out property <length> gap-lg: 16px * root.ui-scale;
}

// Root-level floating tooltip state so tooltips inside toolbars, headers, or
// clipped containers are rendered on top of the entire window and never
// occluded by sibling rows or panes below them.
export global TooltipState {
    in-out property <string> text: "";
    in-out property <length> anchor-x: 0px;
    in-out property <length> anchor-y: 0px;
    in-out property <length> anchor-w: 0px;
    in-out property <length> anchor-h: 0px;

    public function show(t: string, ax: length, ay: length, aw: length, ah: length) {
        self.text = t;
        self.anchor-x = ax;
        self.anchor-y = ay;
        self.anchor-w = aw;
        self.anchor-h = ah;
    }

    public function hide(t: string) {
        if (self.text == t) {
            self.text = "";
        }
    }
}
