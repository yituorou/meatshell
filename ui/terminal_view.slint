import { Theme, TooltipState } from "theme.slint";
import { SftpPanel, SftpEntry, SftpTreeNode, SftpLocalPlace, TunnelInfo, TransferInfo } from "sftp_panel.slint";
import { TabInfo } from "tabs.slint";
import { DockExpandButton, OutlineIcon, IconButton } from "widgets.slint";

// Embed the terminal fonts here too so the cell-probe Text below measures
// with the CORRECT font (the built-in Meatshell Mono), not a system fallback.
// Font imports in app.slint are globally available in theory, but some Slint
// builds only register them in the entry-point file's component tree; importing
// them here guarantees the probe uses Meatshell Mono for its width calc.
import "fonts/MeatshellMono-Regular.ttf";
import "fonts/MeatshellMono-Bold.ttf";

// One coloured run of text on the terminal grid.  The Rust side groups
// consecutive vt100 cells that share fg + bg + bold into a single span and
// tags it with its grid position (row, col) and width in cells, so the UI can
// place both a background fill and the text with absolute monospace coordinates.
// `bg` is transparent (alpha 0) when the cell uses the default background.
export struct TermSpan {
    text: string,
    fg: color,
    bg: color,
    bold: bool,
    underline: bool, // SGR 4; drawn across every cell, blanks included (#444)
    row: int,
    col: int,
    cells: int,
    cjk: bool,   // contains CJK chars → render with the CJK-capable font (#54)
    font: string, // non-empty: system fallback family for a glyph the terminal font lacks (#461)
    emoji: bool,
    emoji-image: image,
}

// A find-match highlight rectangle on the terminal grid.
export struct TermMatch {
    row: int,
    col: int,
    len: int,
}

// Find-bar position across the whole buffer (#535): `current` is 1-based,
// 0 when there is no match.
export struct FindStatus {
    current: int,
    total: int,
}

import { QuickCmd, MenuItem, QuickDockPanel } from "components/business/quick_dock_panel.slint";
import { TerminalStatusStrip } from "components/business/terminal_status_strip.slint";
import { TerminalQuickPopup } from "components/business/terminal_quick_popup.slint";

export { QuickCmd, QuickDockPanel }

// --- TerminalView ----------------------------------------------------------

export component TerminalView inherits Rectangle {
    in property <bool> active: true;
    in property <bool> zen-mode: false;
    in property <float> terminal-line-spacing: 1.0;
    in property <bool> extra-paste-shortcuts-enabled: true;
    in property <bool> quick-sidebar-enabled: false;
    in property <bool> quick-panel-docked: false;
    in property <string> quick-external-command;
    in property <bool> quick-external-send-enter;
    in property <int> quick-external-sequence;
    in property <int> focus-sequence;
    in property <string> tab-id;
    in property <string> status-line: @tr("Not connected");
    in property <[TermSpan]> spans;     // coloured runs of the visible screen
    in property <int> cursor-row;       // cursor cell (grid coords)
    in property <int> cursor-col;
    in property <string> cursor-style: "block";
    in property <color> cursor-color: Theme.term-fg;
    in property <int> rows-used;        // content rows, for viewport sizing
    in property <int> scroll-max;       // scrollback depth (max offset) (#103)
    in property <int> scroll-offset;    // current offset (0 = live bottom) (#103)
    in property <bool>   is-alt-screen;
    in property <bool>   mouse-tracked;   // remote app wants mouse events (btop/htop/mc)
    in property <[TermMatch]> find-matches; // search-highlight rectangles
    in property <TermMatch> find-current;   // the match Enter/▲/▼ is on; len 0 = none visible (#535)
    in property <[TermMatch]> selection;    // drag-selection highlight rectangles

    in property <string>  sftp-path: "/";
    in property <[SftpEntry]> sftp-entries;
    in property <string>  sftp-status: "";
    in property <bool>    sftp-loading: false;
    in property <[SftpTreeNode]> sftp-tree-nodes: [];
    in property <[TabInfo]> sftp-transfer-targets: [];
    in property <string> sftp-sort-key: "";
    in property <int> sftp-sort-dir: 0;
    in property <bool> sftp-show-type: true;
    in property <bool> sftp-show-size: true;
    in property <bool> sftp-show-modified: true;
    in property <bool> sftp-show-permissions: true;
    in property <bool> sftp-show-owner: true;
    in property <bool> sftp-show-group: true;
    in property <bool> sftp-available: true;
    in property <[TunnelInfo]> tunnels: [];

    // Split (dual-pane) view: local folder on the left, remote on the right.
    in property <bool> sftp-dual: false;
    in property <string> sftp-local-path: "";
    in property <[SftpEntry]> sftp-local-entries;
    in property <string> sftp-local-status: "";
    in property <bool> sftp-local-loading: false;
    in property <int> sftp-local-selected-count;
    // Split-view divider: 0 = even split (default), else an explicit width.
    in property <length> sftp-local-pane-width: 0px;
    callback persist-sftp-local-pane-width(length);
    // Places dropdown data + persisted split preferences (#532).
    in property <[SftpLocalPlace]> sftp-local-quick-places;
    in property <[SftpLocalPlace]> sftp-local-drive-places;
    in property <[string]> sftp-local-bookmarks;
    in property <[string]> sftp-local-recent;
    in property <bool> sftp-local-bookmarked: false;
    in property <float> sftp-local-split: 0.0;
    callback persist-sftp-split(bool);
    callback persist-sftp-local-split(float);
    callback sftp-local-places-refresh();
    callback sftp-local-toggle-bookmark();
    callback sftp-local-remove-bookmark(string);
    callback sftp-local-clear-recent();

    // Per-session now (#v0.5): the AppWindow stores these in each TerminalState
    // and writes back via the set-* callbacks, so each tab/pane keeps its own SFTP
    // size + collapse state (resizing/collapsing one no longer affects the others).
    in property <length> sftp-panel-height: 220px;
    in property <length> sftp-panel-width: 380px;     // extent when docked left/right
    in property <length> sftp-saved-height: 220px;    // height to restore on un-collapse
    in property <length> sftp-tree-width: 160px;
    in property <bool>   sftp-collapsed: false;       // SFTP panel minimised (toolbar only)
    callback set-sftp-panel-height(length);
    callback set-sftp-panel-width(length);
    callback set-sftp-saved-height(length);
    callback persist-sftp-tree-width(length);
    callback toggle-sftp-column(string);
    callback set-sftp-collapsed(bool);

    // --- SFTP docking (within the terminal area) ---------------------------
    // Which edge of the terminal area the SFTP panel sits on: left|right|top|bottom.
    in-out property <string> sftp-dock: "bottom";
    property <bool> sftp-horizontal: root.sftp-dock == "left" || root.sftp-dock == "right";
    // Drag-to-dock snap state (mirrors the resource-panel docking in app.slint).
    property <bool> sftp-panel-dragging;
    property <float> sftp-drag-nx;
    property <float> sftp-drag-ny;
    property <string> sftp-dock-target:
        !root.sftp-panel-dragging ? ""
        : root.sftp-drag-nx < 0.22 ? "left"
        : root.sftp-drag-nx > 0.78 ? "right"
        : root.sftp-drag-ny < 0.22 ? "top"
        : root.sftp-drag-ny > 0.78 ? "bottom"
        : "";
    callback persist-sftp-dock(string);

    // Command bar (#55): quick commands + input box + history (all shared/global,
    // fed from Rust); send-to-all is a per-tab toggle.
    in property <[QuickCmd]> quick-commands;
    in property <[string]> command-history;   // oldest first (newest last, #113)
    in property <[string]> history-view;       // filtered dropdown, oldest first (newest last, #101)
    // Same rows as history-view, one line each for display (#419). Actions
    // (run / copy / delete / recall) keep using the raw history-view strings.
    in property <[string]> history-preview;
    property <bool> send-to-all: false;
    in property <bool> cmd-bar-hidden: false;  // toolbar toggle hides the whole bar
    // Status strip telemetry & quick-action integration.
    in property <string> conn-host: "";
    in property <int> conn-state: 1;           // 0 connecting, 1 connected, 2 disconnected
    in property <bool> is-local-mode: true;
    in property <bool> metrics-available: true;
    in property <bool> lang-en: false;
    in property <float> cpu-percent: 0.0;
    in property <float> mem-percent: 0.0;
    in property <string> net-up: "";
    in property <string> net-down: "";
    in property <bool> monitor-active: false;
    in property <bool> proc-available: false;
    in property <bool> system-info-available: false;
    callback toggle-monitor();
    callback show-processes();
    callback show-system-info();
    // Effective terminal font size in px: per-session zoom override when > 0,
    // else the window/global size (Theme.term-font-size).
    in property <float> term-font-size-px: Theme.term-font-size / 1px;
    property <bool> quick-open: false;         // quick-command popup visibility
    property <bool> history-open: false;       // history dropdown visibility
    property <bool> history-autocomplete: false; // live suggestions from command input (#349)
    property <int> history-cursor: -1;         // ↑/↓ recall index (-1 = live input)
    // The history dropdown is created by the key-press / click handlers while
    // Slint is still dispatching the event. Focusing its search TextInput
    // synchronously in `init` can re-enter the Windows IME/accessibility
    // plumbing and read the popup's half-built layout, panicking with
    // "Recursion detected" (#349 / #343-style). Defer focus to next tick.
    property <bool> history-search-focus-pending: false;
    // Keyboard-driven selection in the open history dropdown (#140): ↑/↓ move it,
    // Enter runs history-view[history-selected].
    property <int> history-selected: 0;
    callback run-command(string /* cmd */, bool /* to-all */);
    callback manage-quick-commands();          // open the add/edit/delete dialog
    callback quick-dock-drag-move(length, length);
    callback quick-dock-drag-end();
    callback toggle-quick-group(string /* group */);  // collapse/expand a group (#55)
    // Right-click management on the popup, mirroring the welcome session list (#55).
    callback edit-quick-command(int /* index */);
    callback duplicate-quick-command(int /* index */);
    callback delete-quick-command(int /* index */);
    callback move-quick-command(int /* index */, string /* group */);
    callback new-quick-group();
    callback rename-quick-group(string /* group */);
    callback delete-quick-group(string /* group */);
    callback copy-text(string);                // copy a history command to clipboard (#96)
    callback delete-history(int /* index */);  // remove a history entry (#96)
    callback delete-history-cmd(string /* cmd */); // remove a history entry by command (#101)
    callback search-history(string /* query */);   // filter the history dropdown (#101)

    callback send-key(string, bool, bool, bool);
    // Temporary on-device diagnostics for #312. Rust redacts printable text.
    callback diagnose-key-event(string, bool, bool, bool, bool);
    callback cycle-tab(bool /* reverse */);
    // Customisable shortcuts: key event → action id ("" = send to shell).
    callback match-shortcut(string, bool, bool, bool, bool, bool) -> string;
    // Ctrl+Shift+N (⌘⇧N on macOS) — open a new application window (#multi-window).
    callback new-window-key();
    // Font zoom: Ctrl+= / Ctrl+- / Ctrl+0 (⌘ on macOS). Direction:
    // 1 = larger, -1 = smaller, 0 = reset to default.
    callback zoom-key(int /* direction */, bool /* window-wide */);
    // Ctrl+Alt+Z (⌘⌥Z on macOS) — toggle zen (focus) mode.
    callback zen-key();
    // Alt+Enter (⌥↩ on macOS) — toggle terminal fullscreen (#495).
    callback fullscreen-key();
    callback terminal-resize(float, float);
    callback sftp-navigate(string);
    callback sftp-download(string);
    callback sftp-open-file(string);                // double-click a file (#493)
    callback sftp-upload-clicked(string, bool);
    callback sftp-paste-upload(string);             // upload clipboard files (#508)
    callback sftp-refresh(string);
    callback sftp-tree-expand(string);
    callback sftp-delete(string);
    in property <int> sftp-selected-count;          // checked-entry count (#100)
    callback sftp-toggle-select(int);               // toggle a row's checkbox (#100)
    callback sftp-select-range(int, int);           // Shift+click range select
    // Path bookmarks + recent folders (#500).
    in property <[string]> sftp-bookmarks;
    in property <[string]> sftp-recent;
    in property <bool> sftp-bookmarked;
    callback sftp-toggle-bookmark(string);
    callback sftp-remove-bookmark(string);
    callback sftp-clear-recent();
    callback sftp-places-refresh();
    callback sftp-drag-out(int);                    // drag rows to Explorer (#504)
    callback sftp-download-selected();              // download checked entries (#100)
    callback sftp-delete-selected();                // delete checked entries (#100)
    callback sftp-copy-to-target(string, string);
    callback sftp-copy-selected-to-target(string);
    callback sftp-view(string);
    callback sftp-edit(string);
    callback sftp-open-external(string);
    callback sftp-edit-external(string);
    callback sftp-sort-request(string);
    callback sftp-clear-sort();
    callback tunnel-add(string, string, string, string, string, string, bool, bool);
    callback tunnel-stop(string);
    callback tunnel-start(string);
    callback tunnel-delete(string);
    // Context-menu extensions (#69), forwarded up to the app shell.
    callback sftp-rename-request(string, string);
    callback sftp-chmod-request(string, string, int);
    callback sftp-copy-path(string);
    callback sftp-new-folder(string);
    callback sftp-new-file(string);
    callback sftp-create-entry-inline(string /* kind */, string /* dir */, string /* name */);
    // Split (dual-pane) view: local pane + two-way transfers.
    callback sftp-toggle-dual();
    callback sftp-local-navigate(string);
    callback sftp-local-up();
    callback sftp-local-home();
    callback sftp-local-refresh();
    callback sftp-local-open(string);
    callback sftp-local-toggle-select(int);
    callback sftp-local-select-range(int, int);
    callback sftp-local-copy-path(string);
    callback sftp-local-upload(string);
    callback sftp-local-upload-selected();
    callback sftp-download-to-local(string);
    callback sftp-download-selected-to-local();
    callback sftp-local-sort-request(string, int);
    pure callback sftp-entry-matches(string, string, string) -> bool;
    in property <[TransferInfo]> transfers: [];
    in property <bool> has-active-transfers: false;
    in property <string> download-dir: "";
    callback cancel-transfer(string);
    callback clear-transfers();
    callback pick-download-dir();
    callback open-download-dir();
    callback paste-from-clipboard();
    callback copy-terminal-text();
    callback clear-terminal();              // wipe this session's screen buffer
    callback find-query-changed(string);    // recompute search highlights
    // The pointer entered (true) or left (false) the terminal output (#540).
    callback output-hover(bool);
    // Move to a match across scrollback + screen (#535): dir 0 = settle on a
    // match for a new query, 1 = next, -1 = previous (both wrap around).
    callback find-step(string /* query */, int /* dir */) -> FindStatus;
    callback terminal-scroll(float);         // scroll history by fractional lines (+ = up); Rust keeps the sub-line remainder so momentum decays smoothly
    // Wheel inside an alt-screen app (tmux/less/vim): forward to the program so it
    // scrolls, instead of doing nothing (#170). dir = +1 up / -1 down; col/row =
    // mouse cell. Rust sends a mouse-wheel event if the app tracks the mouse, else
    // arrow keys (alternate-scroll).
    callback terminal-wheel(int /* dir */, int /* col */, int /* row */);
    callback terminal-scroll-to(int);       // jump to an absolute scrollback offset (#103)
    // Handle Home/End/PageUp/PageDown locally only while the normal terminal
    // is scrolled through history. Returns false when the PTY must receive it.
    callback terminal-scrollback-key(string /* key */) -> bool;
    // Forward a mouse button event to the PTY for mouse-tracking TUI apps
    // (btop/htop/mc). kind: 0=press 1=release 2=drag-motion; button: 0=left
    // 1=middle 2=right; col/row are grid cells. Returns true when the event was
    // sent to the remote (the caller then skips its own local handling).
    callback terminal-mouse(int /* kind */, int /* button */, int /* col */, int /* row */) -> bool;
    callback select-start(int, int, bool, bool); // row, col, ctrl, shift
    callback select-update(int, int);       // extend drag-selection to (row, col)
    callback select-end();                  // finish selection → copy to clipboard
    callback select-clear();                // drop the local selection, no copy (#542)
    callback select-word(int, int);         // double-click word → select + copy (#287)
    callback select-autoscroll(int);        // auto-scroll while dragging past edge (dir: -1 up / +1 down)

    // Right-click context-menu anchor + find-bar visibility (private UI state).
    property <length> ctx-x;
    property <length> ctx-y;
    property <bool> find-active: false;
    property <FindStatus> find-status;
    // A context-menu click creates the conditional find bar while Slint is
    // still dispatching the popup event. Focusing its TextInput synchronously
    // can re-enter the Windows IME/accessibility plumbing and panic (#343).
    property <bool> find-focus-pending: false;
    property <bool> selecting: false;
    // Delay a tracked left-click until we know whether it is a click or a
    // drag. This keeps Vim mouse support while allowing normal text selection.
    property <bool> mouse-press-pending: false;
    property <length> mouse-press-x: 0px;
    property <length> mouse-press-y: 0px;
    // Auto-scroll direction while drag-selecting past the visible edge.
    // 0 = none, -1 = above top (scroll to older), +1 = below bottom (newer).
    property <int> autoscroll-dir: 0;
    property <length> vis-y: 0px;   // scratch: cursor Y within the visible viewport
    // Defer ime-input.focus() to the next event-loop tick so AccessKit tree
    // construction (on new TerminalView instantiation) finishes before focus
    // changes — avoids RefCell re-entry panic in WinitWindowAdapter (#AccessKit).
    property <bool> focus-pending: false;

    changed quick-external-sequence => {
        if (root.active) {
            if (root.quick-external-send-enter) {
                root.run-command(root.quick-external-command, root.send-to-all);
                root.focus-pending = true;
            } else {
                cmd-input.text = root.quick-external-command;
                cmd-input.focus();
            }
        }
    }

    changed focus-sequence => {
        if (root.active) {
            root.focus-pending = true;
        }
    }

    // Entering local scrollback hides the live cursor and parks ime-input
    // off-screen. Keep that anchor focused so all non-navigation keys still
    // reach the remote PTY; focus-defer-timer performs this asynchronously to
    // avoid re-entering Slint's IME/accessibility plumbing.
    changed cursor-row => {
        if (root.cursor-row < 0) {
            root.focus-pending = true;
        }
    }

    background: Theme.term-bg;
    forward-focus: ime-input;

    // Drag state (private)
    property <bool>   sftp-dragging:     false;
    property <length> drag-start-mouse-y: 0px;
    in-out property <bool> sftp-fullscreen: false;

    // --- Real cell-size measurement ----------------------------------------
    // A hidden Text rendered with the exact terminal font reports the true
    // Consolas cell width/height for the current font size.  We derive the PTY
    // column/row counts from these measured cells instead of guessing 8×16px,
    // so full-screen programs (nano/vim) get an accurate row count and their
    // bottom shortcut bar is no longer clipped off the visible area.
    // Measure a 50-char run, not a single glyph: a single Text's preferred-width
    // includes left/right side bearings and is wider than the real per-character
    // advance, which would make absolutely-positioned spans drift apart.  The
    // average advance over a long run (side bearings amortised) is accurate.
    // Cell-size probe: must be RENDERED (opacity:0, not visible:false) so Slint
    // resolves the correct embedded font before computing preferred-width/height.
    // visible:false can skip font loading and fall back to a system font (e.g.
    // Consolas ~6.5 px/char instead of Meatshell Mono ~7.6 px/char), giving a
    // cell-w that is too narrow and a term-cols that is too large.
    cell-probe := Text {
        text: "MMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMM"; // exactly 50×M
        font-family: Theme.term-font-family;
        font-size: root.term-font-size-px * 1px;
        font-weight: Theme.term-font-bold ? 700 : 400;
        // Keep it in layout but invisible: opacity:0 forces full font loading.
        opacity: 0;
        // Park it at y<0 so it never overlaps terminal content.
        y: -200px;
        width: 0px; // zero out layout contribution
        height: 0px;
    }
    // cell-w / cell-h come straight from the probe so they ALWAYS match the
    // font the spans below are actually rendered with.  (Forcing a hard-coded
    // minimum here is dangerous: if the spans fall back to a system font, a
    // mismatched cell-w garbles the grid.  Keep them derived from one source.)
    property <length> cell-w: max(1px, cell-probe.preferred-width / 50);
    property <length> cell-h: max(1px, cell-probe.preferred-height * root.terminal-line-spacing);
    // Usable text box = key-capture width minus the 10px left/right padding of
    // output-text; usable height = key-capture height minus the 8px top pad.
    // Measure key-capture, not root: with the SFTP panel docked left/right the
    // terminal area (`central`) is narrower than the view, and counting
    // columns from root.width ran text under the panel or off the window (#505).
    // The old 16px bottom focus-recovery strip was redundant once body-touch
    // covered the full output and visibly stole one terminal row.
    // Subtract 1 column as a safety margin: the cell-probe's preferred-width/50
    // average can differ slightly from the per-character advance actually used
    // by the renderer (DPI rounding, font hinting), and over many columns the
    // accumulated error can push the last cells past the visible grid (#433).
    property <float> term-cols: max(10, floor((key-capture.width - 20px) / cell-w) - 1);
    property <float> term-rows: max(5,  floor((key-capture.height - 8px) / cell-h));
    // Only resize the PTY while this tab is visible.  Inactive tabs are laid
    // out at width 0 (→ term-cols collapses to 10); resizing the remote to 10
    // columns reflows the vt100 screen and destroys the scrollback, so when you
    // switch back the output is gone.  Guarding on `visible` keeps each hidden
    // session frozen at its real size; `changed visible` re-syncs on return.
    property <bool> has-real-size: key-capture.width >= 80px && key-capture.height >= 80px;
    changed term-cols => { if (root.visible && root.has-real-size) { root.terminal-resize(root.term-cols, root.term-rows); } }
    changed term-rows => { if (root.visible && root.has-real-size) { root.terminal-resize(root.term-cols, root.term-rows); } }
    changed has-real-size => { if (root.visible && root.has-real-size) { root.terminal-resize(root.term-cols, root.term-rows); } }

    init => { if (root.has-real-size) { root.terminal-resize(root.term-cols, root.term-rows); } }

    // Bottom-pinning / alt-screen alignment is handled declaratively by
    // scroll-clip.view-y; nothing to sync imperatively here anymore.
    // Reset the history filter whenever the dropdown opens; the search box itself
    // is recreated empty because the `if` subtree is destroyed on close (#101).
    changed history-open => {
        if (root.history-open) {
            if (!root.history-autocomplete) { root.search-history(""); }
            // List is oldest→newest (#101): default-select the newest entry.
            root.history-selected = root.history-view.length > 0
                ? root.history-view.length - 1 : 0;
        } else {
            root.history-autocomplete = false;
        }
    }
    changed visible => {
        if (self.visible) {
            root.focus-pending = true;
            // Re-sync the PTY size on return (it was frozen while hidden).
            if (root.has-real-size) {
                root.terminal-resize(root.term-cols, root.term-rows);
            }
        }
    }

    focus-defer-timer := Timer {
        interval: 0ms;
        running: root.focus-pending;
        triggered => {
            if (root.focus-pending) {
                ime-input.focus();
                root.focus-pending = false;
            }
        }
    }

    VerticalLayout {
        spacing: 0;

        // --- Status strip ---------------------------------------------------
        TerminalStatusStrip {
            zen-mode: root.zen-mode;
            status-line: root.status-line;
            conn-state: root.conn-state;
            is-local-mode: root.is-local-mode;
            conn-host: root.conn-host;
            is-alt-screen: root.is-alt-screen;
            find-active: root.find-active;
            monitor-active: root.monitor-active;
            metrics-available: root.metrics-available;
            lang-en: root.lang-en;
            cpu-percent: root.cpu-percent;
            mem-percent: root.mem-percent;
            proc-available: root.proc-available;
            system-info-available: root.system-info-available;
            sftp-available: root.sftp-available;
            sftp-collapsed: root.sftp-collapsed;
            copy-host(host) => { root.copy-text(host); }
            toggle-find() => {
                root.find-active = !root.find-active;
                if (root.find-active) {
                    root.find-focus-pending = true;
                } else {
                    root.find-query-changed("");
                }
            }
            toggle-monitor() => { root.toggle-monitor(); }
            show-processes() => { root.show-processes(); }
            show-system-info() => { root.show-system-info(); }
            toggle-sftp() => { root.set-sftp-collapsed(!root.sftp-collapsed); }
        }

        // SFTP docking region — terminal + command-bar (central) on one side,
        // the SFTP panel docked to the chosen edge. Absolute geometry, mirroring
        // the resource-panel dock area in app.slint (#dock).
        dock-region := Rectangle {
        vertical-stretch: 1;
        // Collapsed SFTP hides completely (0px) since the top status strip
        // already provides the SFTP toggle button.
        property <length> sf-w: root.sftp-collapsed || !root.sftp-available ? 0px
            : root.sftp-horizontal ? max(300px, root.sftp-panel-width)
            : root.sftp-panel-width;
        property <length> sf-h: root.sftp-collapsed || !root.sftp-available ? 0px : root.sftp-panel-height;
        property <length> sp: root.sftp-collapsed || !root.sftp-available ? 0px : 4px;
        property <length> bottom-strip-h: 0px;

        central := Rectangle {
            visible: !(root.sftp-fullscreen && root.sftp-available && !root.sftp-collapsed);
            x: root.sftp-dock == "left" ? parent.sf-w + parent.sp : 0px;
            y: root.sftp-dock == "top"  ? parent.sf-h + parent.sp : 0px;
            width:  root.sftp-fullscreen && root.sftp-available && !root.sftp-collapsed
                ? 0px
                : (root.sftp-horizontal ? parent.width - parent.sf-w - parent.sp : parent.width);
            height: root.sftp-fullscreen && root.sftp-available && !root.sftp-collapsed
                ? 0px
                : (root.sftp-horizontal ? parent.height : parent.height - parent.sf-h - parent.sp - parent.bottom-strip-h);
            clip: true;
            VerticalLayout {
            spacing: 0;

        // --- Key-capture scope + scrollable output --------------------------
        key-capture := FocusScope {
            vertical-stretch: 1;
            // Any click inside this scope (e.g. the middle-click paste strip)
            // can grab focus to the FocusScope itself.  Key forwarding lives on
            // the hidden `ime-input` TextInput, so a bare FocusScope focus means
            // the cursor stops blinking and typing stops working.  Forwarding
            // focus to ime-input guarantees the text input always ends up with
            // the keyboard focus, no matter what grabbed it.
            forward-focus: ime-input;
            property <bool> cursor-blink: true;

            init => { root.focus-pending = true; }

            Timer {
                // Stop blinking (and thus repainting) when the window isn't
                // focused — an idle background terminal should cost ~0 CPU (#127).
                running: ime-input.has-focus && Theme.window-focused;
                interval: 530ms;
                triggered => { key-capture.cursor-blink = !key-capture.cursor-blink; }
            }

            // Auto-scroll while the drag-selection is held past the top/bottom
            // edge: ticks repeatedly so the scrollback keeps moving even when the
            // mouse is held still beyond the edge.
            Timer {
                running: root.selecting && root.autoscroll-dir != 0;
                interval: 50ms;
                triggered => { root.select-autoscroll(root.autoscroll-dir); }
            }

            VerticalLayout {
                spacing: 0;

                // Plain clipped container instead of a Flickable.  Two reasons:
                //
                // 1. Cursor flicker: Slint resets the mouse-cursor to default at
                //    the start of *every* mouse event and re-derives it from the
                //    items actually visited.  A Flickable intercepts wheel
                //    events in bursts (gesture start + an 800ms capture window,
                //    items/flickable.rs handle_mouse_filter) without visiting
                //    children, so nobody claimed the cursor and the pointer
                //    flipped arrow↔I-beam while the capture window opened and
                //    lapsed.  Without the Flickable, every wheel lands on
                //    body-touch-overlay below, which always claims I-beam.
                // 2. Scroll ownership: the captured wheel also scrolled
                //    content-y natively (flick physics included), fighting the
                //    Rust-managed view_offset and the `changed spans` snap-back.
                //    All scrolling already flows through terminal-scroll /
                //    terminal-scroll-to, so the Flickable only ever added drift.
                scroll-clip := Rectangle {
                    vertical-stretch: 1;
                    clip: true;

                    // Content height of the grid viewport.  Alt-screen: lock to
                    // exactly the visible height so full-screen programs (nano/
                    // vim) render top-aligned with no internal scroll.  Bash:
                    // grow with the content so we can scroll back through history.
                    property <length> content-h: root.is-alt-screen
                        ? self.height
                        : max(self.height, 8px + root.rows-used * root.cell-h + 8px);
                    // Vertical placement of the content inside the clip: newest
                    // output pinned to the bottom edge (negative), alt-screen
                    // top-aligned (0).  Replaces the old imperative
                    // `flickable.content-y = height - content-height` sync —
                    // as a binding it can no longer drift between rebuilds.
                    property <length> view-y: root.is-alt-screen
                        ? 0px
                        : self.height - self.content-h;

                    // The terminal grid.  Each coloured run is placed with
                    // absolute coordinates derived from its (row, col) and the
                    // measured Consolas cell size — no per-line layout needed,
                    // which keeps the model flat (a single `for`).
                    Rectangle {
                        x: 10px;
                        y: 8px + parent.view-y;
                        width: parent.width - 20px;
                        height: parent.content-h - 8px;

                        // Click-to-focus over the whole terminal body.  Without
                        // this, clicking anywhere in the output area blurs the
                        // hidden ime-input (Slint clears focus on a click that
                        // lands on a non-focusable element), which makes the
                        // cursor vanish and keystrokes stop — recoverable only by
                        // reopening the tab.  This TouchArea sits *below* the text
                        // (Text never grabs pointer events, so clicks fall through
                        // to it) and restores focus on every click; middle-click
                        // also pastes, matching the bottom strip.
                        body-touch := TouchArea {
                            x: 0px;
                            y: 0px;
                            width: parent.width;
                            height: parent.height;
                            mouse-cursor: text;
                            pointer-event(ev) => {
                                if (ev.kind == PointerEventKind.down) {
                                    // Any button press re-takes keyboard focus.
                                    ime-input.focus();
                                    if (ev.button == PointerEventButton.right) {
                                        root.ctx-x = self.mouse-x;
                                        root.ctx-y = self.mouse-y;
                                        ctx-menu.show();
                                    } else if (ev.button == PointerEventButton.left
                                            && root.mouse-tracked && !ev.modifiers.shift) {
                                        root.mouse-press-pending = true;
                                        root.mouse-press-x = self.mouse-x;
                                        root.mouse-press-y = self.mouse-y;
                                    } else if (ev.button == PointerEventButton.left) {
                                        root.selecting = true;
                                        root.select-start(
                                            floor(self.mouse-y / root.cell-h),
                                            floor(self.mouse-x / root.cell-w),
                                            ev.modifiers.control,
                                            ev.modifiers.shift);
                                    }
                                } else if (ev.kind == PointerEventKind.up) {
                                    if (root.extra-paste-shortcuts-enabled && ev.button == PointerEventButton.middle) {
                                        root.paste-from-clipboard();
                                        ime-input.focus();
                                    } else if (ev.button == PointerEventButton.left
                                            && root.mouse-tracked && !ev.modifiers.shift
                                            && root.mouse-press-pending) {
                                        root.mouse-press-pending = false;
                                        root.terminal-mouse(0, 0,
                                            floor(self.mouse-y / root.cell-h),
                                            floor(self.mouse-x / root.cell-w));
                                        root.terminal-mouse(1, 0,
                                            floor(self.mouse-y / root.cell-h),
                                            floor(self.mouse-x / root.cell-w));
                                    } else if (ev.button == PointerEventButton.left
                                            && root.selecting) {
                                        root.selecting = false;
                                        root.autoscroll-dir = 0;
                                        root.select-end();
                                    }
                                }
                            }
                            double-clicked => {
                                if (root.mouse-tracked) {
                                    // Mouse-tracking TUI: double-click = two forwarded
                                    // presses, not a local word-select (#terminal-mouse).
                                } else {
                                    root.select-word(
                                        floor(self.mouse-y / root.cell-h),
                                        floor(self.mouse-x / root.cell-w));
                                }
                            }
                            moved => {
                                if (root.mouse-press-pending && self.pressed
                                        && (abs(self.mouse-x - root.mouse-press-x) > 4px
                                            || abs(self.mouse-y - root.mouse-press-y) > 4px)) {
                                    root.mouse-press-pending = false;
                                    root.selecting = true;
                                    root.select-start(
                                        floor(root.mouse-press-y / root.cell-h),
                                        floor(root.mouse-press-x / root.cell-w), false, false);
                                }
                                if (root.selecting) {
                                    // Position of the cursor within the *visible*
                                    // viewport (body-touch sits on the grid Rectangle
                                    // at content y=8px; content-y offsets the scroll).
                                    root.select-update(
                                        floor(self.mouse-y / root.cell-h),
                                        floor(self.mouse-x / root.cell-w));
                                    if (!root.is-alt-screen) {
                                        // vy = mouse position inside the visible window.
                                        // Only auto-scroll once the drag actually leaves
                                        // the top/bottom edge — selecting *within* the
                                        // visible area must never make the view jump or
                                        // the selection snap to an edge row (#41). Slint
                                        // captures the pointer while pressed, so dragging
                                        // past the edge still scrolls to extend across
                                        // more than one screen.
                                        root.vis-y = self.mouse-y + 8px + scroll-clip.view-y;
                                        if (root.vis-y < 0) {
                                            root.autoscroll-dir = -1;       // past top → older
                                        } else if (root.vis-y > scroll-clip.height) {
                                            root.autoscroll-dir = 1;        // past bottom → newer
                                        } else {
                                            root.autoscroll-dir = 0;
                                        }
                                    }
                                } else if (root.mouse-tracked && self.pressed) {
                                    root.terminal-mouse(2, 0,
                                        floor(self.mouse-y / root.cell-h),
                                        floor(self.mouse-x / root.cell-w));
                                }
                            }
                            scroll-event(ev) => {
                                // Positive delta-y = wheel up.
                                if (root.is-alt-screen) {
                                    // Alt-screen app (tmux/less/vim): forward the wheel
                                    // so the program scrolls instead of nothing (#170).
                                    root.terminal-wheel(
                                        ev.delta-y > 0 ? 1 : -1,
                                        floor(self.mouse-x / root.cell-w),
                                        floor(self.mouse-y / root.cell-h));
                                } else {
                                    // Normal screen: scroll our own scrollback history
                                    // (~3 lines per notch).
                                    // Raw pixel delta → fractional lines. The
                                    // magnitude matters: macOS momentum events
                                    // decay to sub-pixel steps, and quantizing
                                    // each to a fixed ±3 lines turned the tail
                                    // into an exaggerated staircase with a hard
                                    // stop. Rust accumulates the fractions.
                                    root.terminal-scroll(ev.delta-y / root.cell-h);
                                }
                                accept
                            }
                        }

                        // Drag-selection highlights (under the text, blue tint or scheme selection).
                        for s in root.selection : Rectangle {
                            x: s.col * root.cell-w;
                            y: s.row * root.cell-h;
                            width: s.len * root.cell-w;
                            height: root.cell-h;
                            background: Theme.term-selection;
                        }

                        // Search-match highlights (behind the text).
                        for m in root.find-matches : Rectangle {
                            x: m.col * root.cell-w;
                            y: m.row * root.cell-h;
                            width: m.len * root.cell-w;
                            height: root.cell-h;
                            background: Theme.warning.with-alpha(0.45);
                            border-radius: 2px;
                        }
                        // The current match stands out from the others (#535).
                        if root.find-current.len > 0 : Rectangle {
                            x: root.find-current.col * root.cell-w;
                            y: root.find-current.row * root.cell-h;
                            width: root.find-current.len * root.cell-w;
                            height: root.cell-h;
                            background: Theme.warning.with-alpha(0.85);
                            border-width: 1px;
                            border-color: Theme.warning;
                            border-radius: 2px;
                        }

                        // Each span = a background fill (transparent for the
                        // default bg) with its text on top.  Wrapping the Text in
                        // the bg Rectangle keeps one element per span and renders
                        // btop/htop/mc panels, meter bars and graph fills.
                        for span in root.spans : Rectangle {
                            x: span.col * root.cell-w;
                            y: span.row * root.cell-h;
                            width: span.cells * root.cell-w;
                            height: root.cell-h;
                            background: span.bg;
                            // A wide-CJK span is a single char in a 2-cell box; clip
                            // it so a glyph whose advance differs from 2×cell-w can't
                            // bleed over the neighbouring cell / cursor (#60 follow-up).
                            clip: span.cjk;
                            // Auto-sized Text (no width/height bindings) so its
                            // layout never re-enters parley's FontContext.
                            if !span.emoji : Text {
                                x: 0px;
                                y: 0px;
                                text: span.text;
                                color: span.fg;
                                // CJK spans use the CJK-capable UI font: the mono
                                // terminal font lacks CJK glyphs and Slint tofu's
                                // *isolated* CJK punctuation (、。,) on fallback (#54).
                                // A non-empty span.font names a system font that
                                // has a glyph the terminal font lacks (`➜`, #461).
                                font-family: span.font != "" ? span.font
                                    : span.cjk ? Theme.ui-font-family : Theme.term-font-family;
                                font-size: root.term-font-size-px * 1px;
                                font-weight: (Theme.term-font-bold || span.bold) ? 700 : 400;
                            }
                            if span.emoji : Image {
                                x: 0px;
                                y: 0px;
                                width: parent.width;
                                height: parent.height;
                                source: span.emoji-image;
                                image-fit: contain;
                            }
                            // SGR 4 underline. A cell-wide rule rather than a
                            // font decoration, so underlined *spaces* (input
                            // fields, login forms) show it too, like PuTTY (#444).
                            if span.underline : Rectangle {
                                x: 0px;
                                height: max(1px, floor(root.cell-h / 14px) * 1px);
                                y: parent.height - self.height - max(1px, floor(root.cell-h / 10px) * 1px);
                                width: parent.width;
                                background: span.fg;
                            }
                        }

                        // Blinking cursor (overlay, decoupled from text). Its
                        // shape follows the persisted user preference (#275).
                        Rectangle {
                            // The VT cursor already names the active grid cell.
                            // A bar belongs on that cell's leading edge too;
                            // shifting it one column in alternate-screen apps put
                            // it after ASCII glyphs and inside wide CJK cells (#319).
                            x: root.cursor-col * root.cell-w;
                            y: root.cursor-row * root.cell-h
                                + (root.cursor-style == "underline" ? max(0px, root.cell-h - max(2px, root.cell-h / 8)) : 0px);
                            width: root.cursor-style == "bar" ? max(2px, root.cell-w / 8) : root.cell-w;
                            height: root.cursor-style == "underline" ? max(2px, root.cell-h / 8) : root.cell-h;
                            background: root.cursor-style == "block"
                                ? root.cursor-color.with-alpha(0.80)
                                : root.cursor-color;
                            // Blink while focused; show solid (no repaint) when the
                            // window is unfocused so the cursor neither vanishes nor
                            // keeps the window repainting (#127).
                            //
                            // Also require an actual live cursor (cursor-row >= 0):
                            // scrolled-back renders report -1 ("no live cursor").
                            // Block/bar styles then sit a full cell above the grid,
                            // where scroll-clip's clip hides them — but the
                            // UNDERLINE style offsets its dash to the bottom of
                            // that row, which lands back INSIDE the clip as a
                            // blinking horizontal dash at column 0 of the first
                            // row. Gate on the row instead of trusting clipping.
                            visible: root.cursor-row >= 0
                                && ime-input.has-focus
                                && (key-capture.cursor-blink || !Theme.window-focused);
                        }

                        // Top-most transparent interaction layer. On macOS,
                        // scroll events over rendered terminal text may not reach
                        // the older body TouchArea below the spans, so keep the
                        // terminal's click/select/wheel handling above all text
                        // while leaving the visual output untouched (#198).
                        body-touch-overlay := TouchArea {
                            x: 0px;
                            y: 0px;
                            width: parent.width;
                            height: parent.height;
                            mouse-cursor: text;
                            // The macOS wheel fallback only claims the wheel
                            // while Slint itself says the pointer is over the
                            // terminal output, not over the SFTP panel or a
                            // popup next to or above it (#540).
                            changed has-hover => { root.output-hover(self.has-hover); }
                            pointer-event(ev) => {
                                if (ev.kind == PointerEventKind.down) {
                                    ime-input.focus();
                                    if (ev.button == PointerEventButton.right) {
                                        root.ctx-x = self.mouse-x;
                                        root.ctx-y = self.mouse-y;
                                        ctx-menu.show();
                                    } else if (ev.button == PointerEventButton.left
                                            && root.mouse-tracked && !ev.modifiers.shift) {
                                        // Mouse-tracking TUI (btop/htop/mc): forward the
                                        // press so the remote acts on it (#terminal-mouse).
                                        // Shift+click still selects locally (xterm-style).
                                        // A plain click also drops a local selection made
                                        // with Shift+drag, which nothing else cleared (#542).
                                        if (root.selection.length > 0) {
                                            root.select-clear();
                                        }
                                        root.terminal-mouse(0, 0,
                                            floor(self.mouse-y / root.cell-h),
                                            floor(self.mouse-x / root.cell-w));
                                    } else if (ev.button == PointerEventButton.left) {
                                        root.selecting = true;
                                        root.select-start(
                                            floor(self.mouse-y / root.cell-h),
                                            floor(self.mouse-x / root.cell-w),
                                            ev.modifiers.control,
                                            ev.modifiers.shift);
                                    }
                                } else if (ev.kind == PointerEventKind.up) {
                                    if (root.extra-paste-shortcuts-enabled && ev.button == PointerEventButton.middle) {
                                        root.paste-from-clipboard();
                                        ime-input.focus();
                                    } else if (ev.button == PointerEventButton.left
                                            && root.mouse-tracked && !ev.modifiers.shift
                                            && root.mouse-press-pending) {
                                        root.mouse-press-pending = false;
                                        root.terminal-mouse(0, 0,
                                            floor(self.mouse-y / root.cell-h),
                                            floor(self.mouse-x / root.cell-w));
                                        root.terminal-mouse(1, 0,
                                            floor(self.mouse-y / root.cell-h),
                                            floor(self.mouse-x / root.cell-w));
                                    } else if (ev.button == PointerEventButton.left
                                            && root.selecting) {
                                        root.selecting = false;
                                        root.autoscroll-dir = 0;
                                        root.select-end();
                                    }
                                }
                            }
                            double-clicked => {
                                if (root.mouse-tracked) {
                                    // Mouse-tracking TUI: double-click = two forwarded
                                    // presses, not a local word-select (#terminal-mouse).
                                } else {
                                    root.select-word(
                                        floor(self.mouse-y / root.cell-h),
                                        floor(self.mouse-x / root.cell-w));
                                }
                            }
                            moved => {
                                if (root.mouse-press-pending && self.pressed
                                        && (abs(self.mouse-x - root.mouse-press-x) > 4px
                                            || abs(self.mouse-y - root.mouse-press-y) > 4px)) {
                                    root.mouse-press-pending = false;
                                    root.selecting = true;
                                    root.select-start(
                                        floor(root.mouse-press-y / root.cell-h),
                                        floor(root.mouse-press-x / root.cell-w), false, false);
                                }
                                if (root.selecting) {
                                    root.select-update(
                                        floor(self.mouse-y / root.cell-h),
                                        floor(self.mouse-x / root.cell-w));
                                    if (!root.is-alt-screen) {
                                        root.vis-y = self.mouse-y + 8px + scroll-clip.view-y;
                                        if (root.vis-y < 0) {
                                            root.autoscroll-dir = -1;
                                        } else if (root.vis-y > scroll-clip.height) {
                                            root.autoscroll-dir = 1;
                                        } else {
                                            root.autoscroll-dir = 0;
                                        }
                                    }
                                } else if (root.mouse-tracked && self.pressed) {
                                    // Drag-motion while a button is held → forward to the
                                    // remote so btop/htop graphs/hover regions track it.
                                    root.terminal-mouse(2, 0,
                                        floor(self.mouse-y / root.cell-h),
                                        floor(self.mouse-x / root.cell-w));
                                }
                            }
                            scroll-event(ev) => {
                                if (root.is-alt-screen) {
                                    root.terminal-wheel(
                                        ev.delta-y > 0 ? 1 : -1,
                                        floor(self.mouse-x / root.cell-w),
                                        floor(self.mouse-y / root.cell-h));
                                } else {
                                    // Raw pixel delta → fractional lines. The
                                    // magnitude matters: macOS momentum events
                                    // decay to sub-pixel steps, and quantizing
                                    // each to a fixed ±3 lines turned the tail
                                    // into an exaggerated staircase with a hard
                                    // stop. Rust accumulates the fractions.
                                    root.terminal-scroll(ev.delta-y / root.cell-h);
                                }
                                accept
                            }
                        }

                        // --- Right-click context menu ---------------------
                        ctx-menu := PopupWindow {
                            x: root.ctx-x;
                            y: root.ctx-y;
                            width: 132px;
                            height: 132px;
                            Rectangle {
                                background: Theme.popup-bg;
                                border-radius: Theme.radius-sm;
                                border-width: 1px;
                                border-color: Theme.border-strong;
                                drop-shadow-blur: 12px;
                                drop-shadow-color: #00000060;
                                VerticalLayout {
                                    padding: 4px;
                                    spacing: 1px;
                                    MenuItem {
                                        icon: "\u{E14D}"; label: @tr("Copy");
                                        clicked => { root.copy-terminal-text(); ime-input.focus(); }
                                    }
                                    MenuItem {
                                        icon: "\u{E14F}"; label: @tr("Paste");
                                        clicked => { root.paste-from-clipboard(); ime-input.focus(); }
                                    }
                                    MenuItem {
                                        icon: "\u{E872}"; label: @tr("Clear buffer");
                                        clicked => { root.clear-terminal(); ime-input.focus(); }
                                    }
                                    MenuItem {
                                        icon: "\u{E8B6}"; label: @tr("Find");
                                        clicked => { root.find-active = true; }
                                    }
                                }
                            }
                        }
                    }
                }

            }

            // --- Hidden TextInput — keyboard + Chinese IME capture -----------
            //
            // Key design decision: return `accept` for EVERY key and forward
            // them all via send-key.  Returning `reject` makes Slint bubble the
            // event without inserting the character into `text`, so `edited`
            // never fires for regular keystrokes — only IME-committed chars
            // (which go through a separate WM_IME_CHAR path) reach `edited`.
            //
            // By forwarding everything in key-pressed we guarantee English and
            // all direct-mode input reaches the PTY.  `edited` is kept as a
            // safety net for IME commits that Windows delivers via WM_IME_CHAR
            // rather than WM_CHAR (and therefore don't fire key-pressed).
            ime-input := TextInput {
                // Absolute 1x1 IME anchor: it captures keyboard/IME input without
                // participating in layout or exposing a second I-beam hit area.
                // Following the VT cursor also places native IME candidate UI near
                // the actual insertion point.
                // While scrolled back through history the live cursor is hidden
                // (cursor-row < 0), but this keyboard anchor must remain inside
                // the clipped view. Slint clears keyboard focus before dispatching
                // a key when the focused item is outside its visible clip. A 0×0
                // anchor at the origin remains visible to that check while never
                // participating in mouse hit-testing or painting a second caret.
                x: root.cursor-row >= 0
                    ? 10px + max(0, root.cursor-col) * root.cell-w
                    : 0px;
                y: root.cursor-row >= 0
                    ? 8px + root.cursor-row * root.cell-h
                    : 0px;
                width: 0px;
                height: 0px;
                opacity: 0;
                // Opacity does not suppress Slint's focused TextInput caret on
                // every renderer. This input exists only as a keyboard/IME
                // anchor; the terminal cursor above is the sole visible caret.
                text-cursor-width: 0px;
                single-line: true;

                // Reset blink phase on focus gain so cursor appears immediately.
                changed has-focus => {
                    if (self.has-focus) { key-capture.cursor-blink = true; }
                }

                key-pressed(event) => {
                    // Keep the caret visible while typing or moving it. Without
                    // this reset an old blink phase can hide the cursor halfway
                    // through a repeated arrow-key sequence (#319).
                    key-capture.cursor-blink = true;
                    root.diagnose-key-event(event.text,
                        event.modifiers.control, event.modifiers.meta,
                        event.modifiers.alt, event.modifiers.shift);
                    // ⚠ macOS modifier naming is SWAPPED by Slint (see the winit
                    // backend's muda.rs): `event.modifiers.control` is the **Cmd (⌘)**
                    // key and `event.modifiers.meta` is the **physical Ctrl** key.
                    // So `control` already gives ⌘ shortcuts on macOS for free, and
                    // the physical Ctrl (meta on macOS) is what must reach the shell
                    // so ^C/^X work in nano/vim (#158).
                    //
                    // App shortcuts are user-customisable: Rust resolves the
                    // event against the keymap (src/app/shortcuts.rs) and
                    // returns an action id, or "" when the key belongs to the
                    // shell. That includes the alt-screen rule (plain Ctrl+V
                    // reaches vim) and the extra paste chords (#300).
                    let act = root.match-shortcut(event.text, event.modifiers.control,
                        event.modifiers.meta, event.modifiers.alt, event.modifiers.shift,
                        root.is-alt-screen);
                    // Hidden (inactive tab) views that still hold focus reject
                    // the window-scoped actions so the window-level fallback
                    // applies them to the visible session (#zoom, #zen).
                    if (!root.visible && (act == "zen" || act == "fullscreen"
                            || act == "zoom-in" || act == "zoom-out" || act == "zoom-reset"
                            || act == "zoom-in-all" || act == "zoom-out-all"
                            || act == "zoom-reset-all")) {
                        reject
                    } else if (act == "next-tab" || act == "prev-tab") {
                        root.cycle-tab(act == "prev-tab");
                        accept
                    } else if (act == "find") {
                        root.find-active = true;
                        accept
                    } else if (act == "history-search") {
                        root.history-open = true;
                        accept
                    // Intercepted before send-key so the keystroke never
                    // reaches the remote shell.
                    } else if (act == "new-window") {
                        root.new-window-key();
                        accept
                    } else if (act == "zen") {
                        root.zen-key();
                        accept
                    } else if (act == "fullscreen") {
                        root.fullscreen-key();
                        accept
                    } else if (act == "zoom-in" || act == "zoom-out" || act == "zoom-reset"
                            || act == "zoom-in-all" || act == "zoom-out-all"
                            || act == "zoom-reset-all") {
                        root.zoom-key(
                            (act == "zoom-in" || act == "zoom-in-all") ? 1
                                : (act == "zoom-out" || act == "zoom-out-all") ? -1 : 0,
                            act == "zoom-in-all" || act == "zoom-out-all"
                                || act == "zoom-reset-all");
                        accept
                    // ^C to the PTY — the same bytes as the physical Ctrl+C,
                    // whichever chord the user bound it to.
                    } else if (act == "interrupt") {
                        root.send-key("c", true, false, false);
                        accept
                    } else if (act == "copy") {
                        root.copy-terminal-text();
                        accept
                    } else if (act == "paste") {
                        root.paste-from-clipboard();
                        // Clipboard access on Windows can deliver WM_KILLFOCUS.
                        // Restore focus explicitly so the cursor keeps blinking.
                        ime-input.focus();
                        accept
                    // ── macOS: swallow any other ⌘ combo (control == Cmd here) so it
                    // isn't typed into the shell as a literal character. ──
                    } else if (Theme.is-mac && event.modifiers.control) {
                        accept
                    // ── Esc with a local selection on screen clears it and is
                    // not sent, like Windows Terminal: pressing Esc to dismiss
                    // a highlight must not also cancel Codex/vim (#542). With
                    // no selection, Esc reaches the program as usual.
                    } else if (event.text == Key.Escape && root.selection.length > 0
                            && !event.modifiers.control && !event.modifiers.meta
                            && !event.modifiers.alt && !event.modifiers.shift) {
                        root.select-clear();
                        accept
                    // ── Local history navigation ────────────────────────────
                    // Only Rust can authoritatively tell whether this normal
                    // terminal is scrolled back. When it declines, preserve the
                    // regular PTY route so less/vim/tmux own these keys.
                    } else if ((event.text == Key.Home || event.text == Key.End
                                || event.text == Key.PageUp || event.text == Key.PageDown)
                            && root.terminal-scrollback-key(event.text)) {
                        accept
                    // ── All other keys (printable, Ctrl+X, arrows, …) → the shell.
                    // The control flag is the *physical* Ctrl key: `meta` on macOS,
                    // `control` elsewhere, so ^X/^C reach the PTY everywhere (#158).
                    // Return `accept` for everything: `reject` would drop the char.
                    } else {
                        root.send-key(event.text,
                                      Theme.is-mac ? event.modifiers.meta : event.modifiers.control,
                                      event.modifiers.alt, event.modifiers.shift);
                        accept
                    }
                }

                // Safety-net for IME commits delivered via WM_IME_CHAR (which
                // may not fire key-pressed).  Guard with preedit-text == "" to
                // skip in-progress compositions.
                edited => {
                    if (self.preedit-text == "" && self.text != "") {
                        root.send-key(self.text, false, false, false);
                        self.text = "";
                    }
                }
            }

            // --- Find bar (overlay, top) ------------------------------------
            // Terminal scrollbar (#103) — a slim overlay on the right edge of the
            // output area, shown only when there's scrollback (and not on the
            // alternate screen). Driven by scroll-max/scroll-offset; click or drag
            // the track to jump to an absolute position.
            if root.scroll-max > 0 && !root.is-alt-screen : Rectangle {
                x: scroll-clip.x + scroll-clip.width - 10px;
                y: scroll-clip.y + 4px;
                width: 8px;
                height: scroll-clip.height - 8px;
                track-ta := TouchArea {
                    moved => {
                        if (self.pressed) {
                            root.terminal-scroll-to(clamp(round(root.scroll-max * (1 - self.mouse-y / self.height)), 0, root.scroll-max));
                        }
                    }
                    pointer-event(e) => {
                        if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                            // The scrollbar is not focusable, but its pointer
                            // interaction can leave the off-screen IME anchor
                            // without keyboard focus. Restore it on the next
                            // UI turn so scrollback keys and remote input work
                            // immediately after a click or drag.
                            root.focus-pending = true;
                            root.terminal-scroll-to(clamp(round(root.scroll-max * (1 - self.mouse-y / self.height)), 0, root.scroll-max));
                        }
                    }
                }
                Rectangle {
                    property <float> total: root.scroll-max + root.term-rows;
                    x: 1px;
                    width: 6px;
                    height: max(28px, parent.height * root.term-rows / total);
                    y: (parent.height - self.height) * (root.scroll-max - root.scroll-offset) / max(1, root.scroll-max);
                    background: track-ta.has-hover || track-ta.pressed
                        ? Theme.term-text-secondary : Theme.term-border-strong;
                    border-radius: 3px;
                    animate background { duration: 100ms; }
                }
            }

            if root.find-active : Rectangle {
                x: 0;
                y: 0;
                width: parent.width;
                height: 34px;
                background: Theme.term-bar-bg;
                border-width: 1px;
                border-color: Theme.term-border-strong;
                border-radius: Theme.radius-sm;

                // Let the popup click and the conditional component's first
                // layout pass finish before asking the platform for focus.
                find-focus-timer := Timer {
                    interval: 0ms;
                    running: root.find-focus-pending;
                    triggered => {
                        root.find-focus-pending = false;
                        if (root.find-active) { find-input.focus(); }
                    }
                }

                HorizontalLayout {
                    padding: 6px;
                    spacing: 6px;
                    Text {
                        text: "\u{E8B6}";
                        font-family: "Material Icons";
                        color: Theme.term-text-secondary;
                        font-size: Theme.fs-sm;
                        vertical-alignment: center;
                    }
                    Rectangle {
                        background: Theme.term-input-bg;
                        border-radius: 3px;
                        horizontal-stretch: 1;
                        find-input := TextInput {
                            x: 6px;
                            width: parent.width - 12px;
                            height: parent.height;
                            color: Theme.term-text-primary;
                            font-family: Theme.ui-font-family; // CJK-capable (#54)
                            font-size: Theme.fs-md;
                            vertical-alignment: center;
                            single-line: true;
                            // Defer focus until popup event dispatch and layout
                            // have completed; synchronous focus crashes on
                            // Windows when opened from right-click (#343).
                            init => { root.find-focus-pending = true; }
                            edited => {
                                root.find-query-changed(self.text);
                                root.find-status = root.find-step(self.text, 0);
                            }
                            key-pressed(e) => {
                                if (e.text == "\u{001b}") {       // Esc closes find
                                    root.find-active = false;
                                    root.find-query-changed("");
                                    root.find-status = { current: 0, total: 0 };
                                    self.text = "";
                                    ime-input.focus();
                                    accept
                                } else if (e.text == "\u{000a}" || e.text == "\u{000d}") {
                                    // Enter: next match, Shift+Enter: previous;
                                    // both wrap around (#535).
                                    root.find-status = root.find-step(self.text, e.modifiers.shift ? -1 : 1);
                                    accept
                                } else {
                                    reject
                                }
                            }
                        }
                    }
                    // "3/12", or a hint when the query matches nothing (#535).
                    if find-input.text != "" : Text {
                        text: root.find-status.total == 0
                            ? @tr("No results")
                            : root.find-status.current + "/" + root.find-status.total;
                        color: root.find-status.total == 0 ? Theme.warning : Theme.term-text-secondary;
                        font-size: Theme.fs-xs;
                        vertical-alignment: center;
                    }
                    Rectangle {
                        width: 24px;
                        border-radius: 3px;
                        background: find-prev-ta.has-hover ? Theme.term-bar-hover : transparent;
                        find-prev-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.find-status = root.find-step(find-input.text, -1);
                                find-input.focus();
                            }
                        }
                        Text {
                            text: "\u{E5CE}"; // expand_less: previous match
                            font-family: "Material Icons";
                            color: find-prev-ta.has-hover ? Theme.term-text-primary : Theme.term-text-secondary;
                            font-size: Theme.fs-md;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    Rectangle {
                        width: 24px;
                        border-radius: 3px;
                        background: find-next-ta.has-hover ? Theme.term-bar-hover : transparent;
                        find-next-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.find-status = root.find-step(find-input.text, 1);
                                find-input.focus();
                            }
                        }
                        Text {
                            text: "\u{E5CF}"; // expand_more: next match
                            font-family: "Material Icons";
                            color: find-next-ta.has-hover ? Theme.term-text-primary : Theme.term-text-secondary;
                            font-size: Theme.fs-md;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    Rectangle {
                        width: 24px;
                        close-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.find-active = false;
                                root.find-query-changed("");
                                root.find-status = { current: 0, total: 0 };
                                find-input.text = "";
                                ime-input.focus();
                            }
                        }
                        Text {
                            text: "\u{E5CD}";
                            font-family: "Material Icons";
                            color: close-ta.has-hover ? Theme.term-text-primary : Theme.term-text-secondary;
                            font-size: Theme.fs-sm;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        // --- Command bar (#55): quick commands + input box + history ---------
        cmd-bar := Rectangle {
            visible: !root.cmd-bar-hidden;
            height: root.cmd-bar-hidden ? 0px : 38px;
            background: Theme.term-bar-bg;
            border-width: 0;
            property <bool> lang-en: @tr("Quick") == "Quick";

            Rectangle {
                x: 0;
                y: 0;
                width: parent.width;
                height: 1px;
                background: Theme.term-border-subtle;
            }

            // Outside-click backdrop: covers the terminal above so clicking
            // anywhere out of an open popup dismisses it.
            if root.quick-open || root.history-open : TouchArea {
                x: 0; y: -2000px; width: parent.width; height: 2000px;
                clicked => { root.quick-open = false; root.history-open = false; }
            }

            HorizontalLayout {
                padding-left: 8px; padding-right: 8px;
                padding-top: 5px; padding-bottom: 5px;
                spacing: 6px;

                // Quick-command toggle pill. Shown whenever the quick sidebar
                // is not currently expanded.
                if !root.quick-panel-docked : Rectangle {
                    width: qc-row.preferred-width + 18px;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: root.quick-open
                        ? Theme.term-accent
                        : (qc-ta.has-hover ? Theme.term-border-subtle : transparent);
                    background: root.quick-open
                        ? Theme.term-accent.with-alpha(0.18)
                        : (qc-ta.has-hover ? Theme.term-bar-hover : Theme.term-bar-elevated);
                    qc-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.history-open = false; root.quick-open = !root.quick-open; }
                    }
                    qc-row := HorizontalLayout {
                        width: parent.width; height: parent.height;
                        alignment: center;
                        spacing: 5px;
                        VerticalLayout {
                            alignment: center;
                            OutlineIcon {
                                name: "bolt";
                                icon-size: 13px;
                                color: root.quick-open ? Theme.term-accent : Theme.term-text-secondary;
                            }
                        }
                        Text {
                            text: @tr("Quick");
                            color: root.quick-open ? Theme.term-text-primary : Theme.term-text-secondary;
                            font-size: Theme.fs-sm;
                            font-weight: root.quick-open ? 600 : 500;
                            vertical-alignment: center;
                        }
                        VerticalLayout {
                            alignment: center;
                            OutlineIcon {
                                name: root.quick-open ? "chevron-down" : "chevron-up";
                                icon-size: 11px;
                                color: Theme.term-text-muted;
                            }
                        }
                    }
                }

                // Command input box with terminal prompt icon + auto-hiding placeholder + clear button.
                Rectangle {
                    horizontal-stretch: 1;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: cmd-input.has-focus ? Theme.term-accent : Theme.term-border-subtle;
                    background: Theme.term-input-bg;
                    clip: true;

                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 6px;
                        spacing: 6px;

                        // Prompt icon (>_ )
                        VerticalLayout {
                            alignment: center;
                            OutlineIcon {
                                name: "terminal";
                                icon-size: 13px;
                                color: cmd-input.has-focus ? Theme.term-accent : Theme.term-text-muted;
                            }
                        }

                        // Input container
                        Rectangle {
                            horizontal-stretch: 1;
                            clip: true;

                            TouchArea {
                                mouse-cursor: text;
                                clicked => { cmd-input.focus(); }
                                scroll-event(event) => {
                                    command-scroll.content-y = clamp(
                                        command-scroll.content-y + event.delta-y,
                                        min(0px, command-scroll.height - command-scroll.content-height), 0px);
                                    accept
                                }
                            }

                            // Hide placeholder immediately on focus or when any text is present,
                            // preventing overlap during CJK/IME preedit composition.
                            if !cmd-input.has-focus && cmd-input.text == "" : Text {
                                x: 0px;
                                width: parent.width;
                                height: parent.height;
                                text: @tr("Type a command, Enter to send");
                                color: Theme.term-text-muted;
                                font-size: Theme.fs-sm;
                                horizontal-alignment: left;
                                vertical-alignment: center;
                                overflow: elide;
                            }

                            command-scroll := Flickable {
                                width: parent.width;
                                height: parent.height;
                                content-width: self.width;
                                content-height: max(self.height, cmd-input.preferred-height);
                                cmd-input := TextInput {
                                    x: 0px;
                                    width: max(1px, command-scroll.width - 4px);
                                    y: 0px;
                                    height: max(command-scroll.height, self.preferred-height);
                                    color: Theme.term-text-primary;
                                    font-family: Theme.ui-font-family;
                                    font-size: Theme.fs-md;
                                    vertical-alignment: center;
                                    wrap: char-wrap;
                                    page-height: command-scroll.height;
                                    cursor-position-changed(position) => {
                                        let cursor-y = position.y + command-scroll.content-y;
                                        if (cursor-y < 0px) {
                                            command-scroll.content-y = min(0px, command-scroll.content-y - cursor-y);
                                        } else if (cursor-y > command-scroll.height - self.font-size) {
                                            command-scroll.content-y = max(
                                                min(0px, command-scroll.height - command-scroll.content-height),
                                                command-scroll.content-y - (cursor-y - command-scroll.height + self.font-size));
                                        }
                                    }
                                    // Preserve pasted newlines. A single-line input rewrites
                                    // them as spaces and corrupts heredoc terminators before
                                    // run-command receives the text (#319).
                                    single-line: false;
                                    // Enter sends; ↑/↓ recall history.
                                    accepted => {
                                        root.run-command(self.text, root.send-to-all);
                                        self.text = "";
                                        root.history-open = false;
                                        root.history-cursor = -1;
                                        root.focus-pending = true;
                                    }
                                    edited => {
                                        root.history-cursor = -1;
                                        root.quick-open = false;
                                        root.history-autocomplete = self.text != "";
                                        root.search-history(self.text);
                                        root.history-open = root.history-autocomplete;
                                        // Oldest→newest list: default-select the newest match.
                                        root.history-selected = root.history-view.length > 0
                                            ? root.history-view.length - 1 : 0;
                                    }
                                    key-pressed(e) => {
                                        if (e.text == Key.Return && !e.modifiers.shift) {
                                            root.run-command(self.text, root.send-to-all);
                                            self.text = "";
                                            root.history-open = false;
                                            root.history-cursor = -1;
                                            root.focus-pending = true;
                                            accept
                                        // ⌘R / Ctrl+R opens the searchable history dropdown and
                                        // focuses its search box — full keyboard history recall
                                        // (#140). Esc closes it / returns to terminal. (The
                                        // Ctrl+E/K/U line-editing below stays on Ctrl — those
                                        // are the standard readline bindings on macOS too.)
                                        } else if (root.match-shortcut(e.text, e.modifiers.control,
                                                        e.modifiers.meta, e.modifiers.alt,
                                                        e.modifiers.shift, false) == "next-tab") {
                                            root.cycle-tab(false);
                                            accept
                                        } else if (root.match-shortcut(e.text, e.modifiers.control,
                                                        e.modifiers.meta, e.modifiers.alt,
                                                        e.modifiers.shift, false) == "prev-tab") {
                                            root.cycle-tab(true);
                                            accept
                                        } else if ((Theme.is-mac ? e.modifiers.meta : e.modifiers.control)
                                                && (e.text == "r" || e.text == "R" || e.text == "\u{0012}")) {
                                            root.history-autocomplete = false;
                                            root.history-open = true;
                                            accept
                                        } else if (e.text == Key.Escape) {
                                            if (root.history-open) { root.history-open = false; }
                                            else { ime-input.focus(); }   // back to the terminal
                                            accept
                                        } else if (e.text == Key.UpArrow) {
                                            if (root.history-autocomplete && root.history-view.length > 0) {
                                                root.history-selected = root.history-selected <= 0
                                                    ? root.history-view.length - 1
                                                    : root.history-selected - 1;
                                            } else {
                                                // Model is oldest→newest (#113): first ↑ jumps
                                                // to newest, then steps toward older entries.
                                                if (root.command-history.length > 0) {
                                                    root.history-cursor = root.history-cursor == -1
                                                        ? root.command-history.length - 1
                                                        : max(root.history-cursor - 1, 0);
                                                    self.text = root.command-history[root.history-cursor];
                                                }
                                            }
                                            accept
                                        } else if (e.text == Key.DownArrow) {
                                            if (root.history-autocomplete && root.history-view.length > 0) {
                                                root.history-selected = root.history-selected >= root.history-view.length - 1
                                                    ? 0 : root.history-selected + 1;
                                            } else {
                                                // ↓ steps toward newer; past newest → live input.
                                                if (root.history-cursor != -1) {
                                                    if (root.history-cursor < root.command-history.length - 1) {
                                                        root.history-cursor += 1;
                                                        self.text = root.command-history[root.history-cursor];
                                                    } else {
                                                        root.history-cursor = -1;
                                                        self.text = "";
                                                    }
                                                }
                                            }
                                            accept
                                        } else if (e.text == Key.Tab && root.history-autocomplete) {
                                            if (root.history-view.length > 0
                                                    && root.history-selected < root.history-view.length) {
                                                self.text = root.history-view[root.history-selected];
                                                self.set-selection-offsets(1000000, 1000000);
                                            }
                                            root.history-open = false;
                                            accept
                                        // --- readline line-editing keys (#103) ---
                                        // Ctrl+A / Cmd+A selects all text in this GUI input.
                                        } else if (e.modifiers.control && (e.text =="a" || e.text == "A" || e.text == "\u{0001}")) {
                                            self.select-all();
                                            accept
                                        // Ctrl+E → end of line.
                                        } else if ((Theme.is-mac ? e.modifiers.meta : e.modifiers.control) && (e.text =="e" || e.text == "E" || e.text == "\u{0005}")) {
                                            self.set-selection-offsets(1000000, 1000000);
                                            accept
                                        // Ctrl+K → kill from cursor to end (deletes + clipboard).
                                        } else if ((Theme.is-mac ? e.modifiers.meta : e.modifiers.control) && (e.text =="k" || e.text == "K" || e.text == "\u{000B}")) {
                                            self.set-selection-offsets(self.cursor-position_byte-offset, 1000000);
                                            self.cut();
                                            accept
                                        // Ctrl+U → kill from start to cursor.
                                        } else if ((Theme.is-mac ? e.modifiers.meta : e.modifiers.control) && (e.text =="u" || e.text == "U" || e.text == "\u{0015}")) {
                                            self.set-selection-offsets(0, self.cursor-position_byte-offset);
                                            self.cut();
                                            accept
                                        } else {
                                            reject
                                        }
                                    }
                                }
                            }
                        }

                        // Quick clear button when text is entered
                        if cmd-input.text != "" : VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 18px;
                                height: 18px;
                                border-radius: 9px;
                                background: cmd-clr-ta.has-hover ? Theme.term-bar-hover : transparent;
                                cmd-clr-ta := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        cmd-input.text = "";
                                        root.history-open = false;
                                        root.history-cursor = -1;
                                        cmd-input.focus();
                                    }
                                }
                                OutlineIcon {
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    name: "close";
                                    icon-size: 11px;
                                    color: Theme.term-text-muted;
                                }
                            }
                        }
                    }
                }

                // History toggle button (icon + label for clear discoverability).
                Rectangle {
                    width: hist-row.preferred-width + 16px;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: (root.history-open && !root.history-autocomplete)
                        ? Theme.term-accent
                        : (hist-ta.has-hover ? Theme.term-border-subtle : transparent);
                    background: (root.history-open && !root.history-autocomplete)
                        ? Theme.term-accent.with-alpha(0.18)
                        : (hist-ta.has-hover ? Theme.term-bar-hover : Theme.term-bar-elevated);
                    hist-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.quick-open = false;
                            root.history-autocomplete = false;
                            root.history-open = !root.history-open;
                        }
                    }
                    hist-row := HorizontalLayout {
                        width: parent.width; height: parent.height;
                        alignment: center;
                        spacing: 4px;
                        VerticalLayout {
                            alignment: center;
                            OutlineIcon {
                                name: "history";
                                icon-size: 13px;
                                color: (root.history-open && !root.history-autocomplete)
                                    ? Theme.term-accent : Theme.term-text-secondary;
                            }
                        }
                        Text {
                            text: cmd-bar.lang-en ? "History" : "历史";
                            color: (root.history-open && !root.history-autocomplete)
                                ? Theme.term-text-primary : Theme.term-text-secondary;
                            font-size: Theme.fs-sm;
                            font-weight: (root.history-open && !root.history-autocomplete) ? 600 : 500;
                            vertical-alignment: center;
                        }
                    }
                }

                // Send-to-all (broadcast) toggle pill.
                Rectangle {
                    width: all-row.preferred-width + 16px;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: root.send-to-all
                        ? Theme.term-accent
                        : (all-ta.has-hover ? Theme.term-border-subtle : transparent);
                    background: root.send-to-all ? Theme.term-accent
                              : all-ta.has-hover ? Theme.term-bar-hover : Theme.term-bar-elevated;
                    all-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.send-to-all = !root.send-to-all; }
                    }
                    all-row := HorizontalLayout {
                        width: parent.width; height: parent.height;
                        alignment: center;
                        spacing: 4px;
                        VerticalLayout {
                            alignment: center;
                            OutlineIcon {
                                name: root.send-to-all ? "check" : "globe";
                                icon-size: 12px;
                                color: root.send-to-all ? #ffffff : Theme.term-text-muted;
                            }
                        }
                        Text {
                            text: @tr("All sessions");
                            font-size: Theme.fs-sm;
                            font-weight: root.send-to-all ? 600 : 500;
                            vertical-alignment: center;
                            color: root.send-to-all ? #ffffff : Theme.term-text-secondary;
                        }
                    }
                }

                // Send button.
                Rectangle {
                    width: send-row.preferred-width + 18px;
                    border-radius: 6px;
                    background: send-ta.has-hover ? Theme.term-accent-hover : Theme.term-accent;
                    send-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.run-command(cmd-input.text, root.send-to-all);
                            cmd-input.text = "";
                            root.history-cursor = -1;
                            root.focus-pending = true;
                        }
                    }
                    send-row := HorizontalLayout {
                        width: parent.width; height: parent.height;
                        alignment: center;
                        spacing: 4px;
                        Text {
                            text: @tr("Send") + " ↵";
                            color: #ffffff;
                            font-size: Theme.fs-sm;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            // --- Quick-command popup (opens upward) --------------------------
            if root.quick-open : TerminalQuickPopup {
                quick-commands: root.quick-commands;
                quick-sidebar-enabled: root.quick-sidebar-enabled;
                entry-matches(n, t, q) => { return root.sftp-entry-matches(n, t, q); }
                toggle-quick-group(g) => { root.toggle-quick-group(g); }
                rename-quick-group(g) => { root.rename-quick-group(g); }
                delete-quick-group(g) => { root.delete-quick-group(g); }
                new-quick-group() => { root.new-quick-group(); }
                activate-command(cmd, send-enter) => {
                    if (send-enter) {
                        root.run-command(cmd, root.send-to-all);
                        root.focus-pending = true;
                    } else {
                        cmd-input.text = cmd;
                        cmd-input.focus();
                    }
                    root.quick-open = false;
                }
                edit-quick-command(idx) => { root.edit-quick-command(idx); }
                duplicate-quick-command(idx) => { root.duplicate-quick-command(idx); }
                delete-quick-command(idx) => { root.delete-quick-command(idx); }
                move-quick-command(idx, grp) => { root.move-quick-command(idx, grp); }
                manage-quick-commands() => { root.manage-quick-commands(); }
                quick-dock-drag-move(x, y) => { root.quick-dock-drag-move(x, y); }
                quick-dock-drag-end() => { root.quick-dock-drag-end(); }
                close-popup() => { root.quick-open = false; }
            }

            // --- History popup (opens upward) -------------------------------
            if root.history-open : Rectangle {
                width: min(420px, max(280px, parent.width - 16px));
                x: max(8px, parent.width - self.width - 8px);
                height: root.history-autocomplete
                    ? min(200px, max(40px, h-col.preferred-height + 12px))
                    : min(340px, 76px + max(32px, min(252px, h-col.preferred-height + 10px)));
                y: -self.height - 6px;
                background: Theme.popup-bg;
                border-radius: 10px;
                border-width: 1px;
                border-color: Theme.border-strong;
                drop-shadow-blur: 20px;
                drop-shadow-color: #00000075;
                clip: true;
                TouchArea {}
                VerticalLayout {
                    padding: 6px;
                    spacing: 5px;

                    // Header bar when opened explicitly via History button or Ctrl+R
                    if !root.history-autocomplete : HorizontalLayout {
                        height: 24px;
                        padding-left: 4px;
                        padding-right: 4px;
                        spacing: 6px;
                        VerticalLayout {
                            alignment: center;
                            OutlineIcon {
                                name: "history";
                                icon-size: 13px;
                                color: Theme.accent;
                            }
                        }
                        Text {
                            text: cmd-bar.lang-en ? "Command History" : "历史命令";
                            color: Theme.text-primary;
                            font-size: Theme.fs-sm;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                        Text {
                            text: cmd-bar.lang-en
                                ? "Click to fill · ▶ to run · ↑↓/Enter"
                                : "点击填入输入框 · ▶ 直接执行 · ↑↓/回车";
                            color: Theme.text-muted;
                            font-size: 11px;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                    }

                    // History list fills the popup; the search box is pinned at the
                    // bottom (next to the command input) so it stays in a fixed,
                    // easy-to-find spot no matter how tall the list is (#131).
                    h-flick := Flickable {
                    vertical-stretch: 1;
                    content-width: self.width;
                    content-height: max(self.height, h-col.preferred-height);
                    // The newest commands are at the bottom, next to the search box
                    // and the command input, so open scrolled there (#447). Scrolling
                    // by hand replaces this binding until the popup reopens.
                    content-y: min(0px, self.height - self.content-height);
                    // Keep the ↑/↓ keyboard selection visible (#447).
                    property <int> follow-selected: root.history-selected;
                    changed follow-selected => { self.reveal-row(self.follow-selected); }
                    public function scroll-to-newest() {
                        self.content-y = min(0px, self.height - self.content-height);
                    }
                    function reveal-row(row: int) {
                        if (row < 0 || row >= root.history-view.length) { return; }
                        // Rows are 28px tall below h-col's 4px top padding.
                        let top = 4px + row * 28px;
                        let bottom = top + 28px;
                        if (top < -self.content-y) {
                            self.content-y = -top;
                        } else if (bottom > self.height - self.content-y) {
                            self.content-y = self.height - bottom;
                        }
                    }
                    h-col := VerticalLayout {
                        padding: 4px;
                        alignment: start;
                        if root.history-view.length == 0 : Text {
                            text: root.command-history.length == 0 ? @tr("No history yet") : @tr("No match");
                            color: Theme.text-muted; font-size: Theme.fs-xs;
                            horizontal-alignment: center;
                            height: 32px; vertical-alignment: center;
                        }
                        for h[idx] in root.history-view : Rectangle {
                            height: 28px;
                            border-radius: 6px;
                            background: idx == root.history-selected ? Theme.bg-active
                                      : (h-item-ta.has-hover ? Theme.bg-hover : transparent);
                            // Row body click recalls the command into the input box.
                            h-item-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    cmd-input.text = h;
                                    root.history-open = false;
                                    cmd-input.focus();
                                }
                            }
                            HorizontalLayout {
                                padding-left: 8px; padding-right: 4px; spacing: 5px;
                                Text {
                                    text: "$";
                                    color: Theme.accent;
                                    font-family: Theme.font-mono;
                                    font-size: Theme.fs-xs;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: idx < root.history-preview.length ? root.history-preview[idx] : h;
                                    color: Theme.text-primary;
                                    font-size: Theme.fs-sm;
                                    font-family: Theme.font-mono;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    overflow: elide;
                                }
                                // Run (▶) — execute immediately, on this tab.
                                Rectangle {
                                    width: 24px; y: (parent.height - self.height) / 2; height: 24px;
                                    border-radius: Theme.radius-sm;
                                    background: hrun.has-hover ? Theme.accent.with-alpha(0.25) : transparent;
                                    hrun := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.run-command(h, root.send-to-all);
                                            root.history-open = false;
                                            root.focus-pending = true;
                                        }
                                    }
                                    Text { text: "\u{E037}"; font-family: "Material Icons";
                                           color: Theme.accent; font-size: Theme.fs-md;
                                           horizontal-alignment: center; vertical-alignment: center; }
                                }
                                // Copy (⧉) — to clipboard, keep the popup open.
                                Rectangle {
                                    width: 24px; y: (parent.height - self.height) / 2; height: 24px;
                                    border-radius: Theme.radius-sm;
                                    background: hcopy.has-hover ? Theme.bg-elevated : transparent;
                                    hcopy := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.copy-text(h); }
                                    }
                                    OutlineIcon {
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        name: "copy";
                                        icon-size: 12px;
                                        color: Theme.text-secondary;
                                    }
                                }
                                // Delete (×) — remove this entry.
                                Rectangle {
                                    width: 24px; y: (parent.height - self.height) / 2; height: 24px;
                                    border-radius: Theme.radius-sm;
                                    background: hdel.has-hover ? Theme.danger.with-alpha(0.18) : transparent;
                                    hdel := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.delete-history-cmd(h); }
                                    }
                                    OutlineIcon {
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        name: "trash";
                                        icon-size: 12px;
                                        color: Theme.danger;
                                    }
                                }
                            }
                        }
                    }
                    }
                    // Search box (#101) pinned at the bottom, right above the
                    // command input, so it stays in a fixed, easy-to-find spot no
                    // matter how tall the list is — like FinalShell (#131).
                    if !root.history-autocomplete : Rectangle {
                        height: 30px;
                        border-radius: 6px;
                        background: Theme.bg-root;
                        border-width: 1px;
                        border-color: hist-search.has-focus ? Theme.accent : Theme.border-subtle;
                        // Defer focus to the next event-loop tick (see init below).
                        history-search-focus-timer := Timer {
                            interval: 0ms;
                            running: root.history-search-focus-pending;
                            triggered => {
                                root.history-search-focus-pending = false;
                                if (root.history-open) { hist-search.focus(); }
                            }
                        }
                        HorizontalLayout {
                            padding-left: 8px; padding-right: 8px; spacing: 6px;
                            VerticalLayout {
                                alignment: center;
                                OutlineIcon {
                                    name: "search";
                                    icon-size: 13px;
                                    color: hist-search.has-focus ? Theme.accent : Theme.text-muted;
                                }
                            }
                            Rectangle {
                                horizontal-stretch: 1;
                                hist-search := TextInput {
                                    width: 100%; height: 100%;
                                    vertical-alignment: center;
                                    color: Theme.text-primary;
                                    font-family: Theme.ui-font-family;
                                    font-size: Theme.fs-sm;
                                    single-line: true;
                                    // Auto-focus so Ctrl+R lands you typing (#140).
                                    // Defer to the next event-loop tick: focusing
                                    // synchronously while the popup's first layout
                                    // pass is still running re-enters the Windows
                                    // IME/accessibility plumbing and reads the
                                    // half-built layout, panicking with "Recursion
                                    // detected" (#349 / #343).
                                    init => { root.history-search-focus-pending = true; }
                                    edited => {
                                        root.search-history(self.text);
                                        root.history-selected = root.history-view.length > 0 ? root.history-view.length - 1 : 0;
                                        h-flick.scroll-to-newest();
                                    }
                                    // ↑/↓ move the selection, Enter runs it, Esc
                                    // closes and returns focus to the terminal (#140).
                                    key-pressed(e) => {
                                        if (e.text == Key.Escape) {
                                            root.history-open = false;
                                            ime-input.focus();
                                            accept
                                        } else if (e.text == Key.UpArrow) {
                                            if (root.history-view.length > 0) {
                                                root.history-selected = root.history-selected <= 0
                                                    ? root.history-view.length - 1
                                                    : root.history-selected - 1;
                                            }
                                            accept
                                        } else if (e.text == Key.DownArrow) {
                                            if (root.history-view.length > 0) {
                                                root.history-selected = root.history-selected >= root.history-view.length - 1
                                                    ? 0
                                                    : root.history-selected + 1;
                                            }
                                            accept
                                        } else if (e.text == Key.Return) {
                                            if (root.history-view.length > 0
                                                    && root.history-selected < root.history-view.length) {
                                                root.run-command(root.history-view[root.history-selected], root.send-to-all);
                                                root.history-open = false;
                                                root.focus-pending = true;
                                            }
                                            accept
                                        } else {
                                            reject   // let typing filter the list
                                        }
                                    }
                                }
                                if !hist-search.has-focus && hist-search.text == "" : Text {
                                    text: @tr("Search history");
                                    color: Theme.text-muted; font-size: Theme.fs-sm;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
            }
        }
            }
        }

        // --- SFTP resize splitter (orientation follows the dock edge) -------
        Rectangle {
            visible: root.sftp-available && !root.sftp-collapsed && !root.sftp-fullscreen;   // gone when collapsed or fullscreen
            x: root.sftp-dock == "left"   ? parent.sf-w
             : root.sftp-dock == "right"  ? parent.width - parent.sf-w - 4px
             : 0px;
            y: root.sftp-dock == "top"    ? parent.sf-h
             : root.sftp-dock == "bottom" ? parent.height - parent.sf-h - 4px
             : 0px;
            width:  root.sftp-horizontal ? 4px : parent.width;
            height: root.sftp-horizontal ? parent.height : 4px;
            background: divider-ta.has-hover || root.sftp-dragging
                ? Theme.accent : Theme.border-subtle;
            divider-ta := TouchArea {
                // Hit area extends a few px past the thin visual bar so it's easy
                // to grab without landing on the terminal / SFTP edge.
                x: root.sftp-horizontal ? -4px : 0px;
                y: root.sftp-horizontal ? 0px : -4px;
                width:  root.sftp-horizontal ? 12px : parent.width;
                height: root.sftp-horizontal ? parent.height : 12px;
                mouse-cursor: root.sftp-horizontal ? ew-resize : ns-resize;
                pointer-event(ev) => {
                    if (ev.kind == PointerEventKind.down) {
                        root.sftp-dragging = true;
                        root.set-sftp-collapsed(false);
                    } else if (ev.kind == PointerEventKind.up) {
                        root.sftp-dragging = false;
                    }
                }
                // Direct tracking: the panel's docked edge follows the cursor's
                // position within the (stable) dock-region — no deltas, so no
                // moving-frame / accumulation issues. NOTE: `parent` here is the
                // thin splitter Rectangle, so refer to `dock-region` explicitly
                // for the region's size/origin (#dock).
                moved => {
                    if (root.sftp-dragging) {
                        if (root.sftp-horizontal) {
                            // Floor matches SftpPanel's compact two-row toolbar;
                            // narrower widths make the path field and actions unusable.
                            root.set-sftp-panel-width(clamp(
                                root.sftp-dock == "right"
                                    ? dock-region.width - ((self.absolute-position.x + self.mouse-x) - dock-region.absolute-position.x)
                                    : (self.absolute-position.x + self.mouse-x) - dock-region.absolute-position.x,
                                300px, max(310px, dock-region.width - 200px)));
                        } else {
                            root.set-sftp-panel-height(clamp(
                                root.sftp-dock == "bottom"
                                    ? dock-region.height - ((self.absolute-position.y + self.mouse-y) - dock-region.absolute-position.y)
                                    : (self.absolute-position.y + self.mouse-y) - dock-region.absolute-position.y,
                                60px, max(80px, dock-region.height - 80px)));
                        }
                    }
                }
            }
        }

        // --- SFTP panel — positioned on the docked edge ---------------------
        if root.sftp-available && !root.sftp-collapsed : SftpPanel {
            x: root.sftp-fullscreen && !root.sftp-collapsed
                ? 0px
                : (root.sftp-dock == "right" ? parent.width - parent.sf-w : 0px);
            y: root.sftp-fullscreen && !root.sftp-collapsed
                ? 0px
                : (root.sftp-dock == "bottom" ? parent.height - parent.sf-h : 0px);
            width: root.sftp-fullscreen && !root.sftp-collapsed
                ? parent.width
                : (root.sftp-horizontal ? parent.sf-w : parent.width);
            height: root.sftp-fullscreen && !root.sftp-collapsed
                ? parent.height
                : (root.sftp-horizontal ? parent.height : parent.sf-h);
            dock-edge: root.sftp-dock;
            sftp-fullscreen: root.sftp-fullscreen;
            set-dock-edge(edge) => {
                root.sftp-fullscreen = false;
                root.set-sftp-collapsed(false);
                root.sftp-dock = edge;
                root.persist-sftp-dock(edge);
            }
            toggle-fullscreen() => {
                root.set-sftp-collapsed(false);
                root.sftp-fullscreen = !root.sftp-fullscreen;
            }
            show-tree: !root.sftp-horizontal || root.sftp-fullscreen;   // hide the tree when narrow (vertical) unless fullscreen
            tree-width: root.sftp-tree-width;
            persist-tree-width(width) => { root.persist-sftp-tree-width(width); }
            show-type: root.sftp-show-type;
            show-size: root.sftp-show-size;
            show-modified: root.sftp-show-modified;
            show-permissions: root.sftp-show-permissions;
            show-owner: root.sftp-show-owner;
            show-group: root.sftp-show-group;
            toggle-column(key) => { root.toggle-sftp-column(key); }
            compact: root.sftp-collapsed && root.sftp-horizontal;  // clean strip when side+collapsed
            dock-drag-move(ax, ay) => {
                root.sftp-panel-dragging = true;
                root.sftp-drag-nx = (ax - dock-region.absolute-position.x) / dock-region.width;
                root.sftp-drag-ny = (ay - dock-region.absolute-position.y) / dock-region.height;
            }
            dock-drag-end() => {
                if (root.sftp-dock-target != "") {
                    root.sftp-dock = root.sftp-dock-target;
                    root.persist-sftp-dock(root.sftp-dock);
                }
                root.sftp-panel-dragging = false;
            }
            collapsed:     root.sftp-collapsed;
            current-tab-id: root.tab-id;
            current-path:  root.sftp-path;
            entries:       root.sftp-entries;
            status:        root.sftp-status;
            loading:       root.sftp-loading;
            tree-nodes:    root.sftp-tree-nodes;
            transfer-targets: root.sftp-transfer-targets;
            selected-count: root.sftp-selected-count;
            sort-key: root.sftp-sort-key;
            sort-dir: root.sftp-sort-dir;
            tunnels: root.tunnels;
            toggle-collapsed => {
                if (root.sftp-collapsed) {
                    // Re-expand; the panel height was preserved while collapsed.
                    root.set-sftp-collapsed(false);
                } else {
                    // Minimise: just collapse. sf-h becomes the 36px bar; the
                    // panel height is preserved (no 30px poke that would pollute
                    // the global default seeded into new sessions) (M5).
                    root.set-sftp-collapsed(true);
                }
            }
            navigate(path)      => { root.sftp-navigate(path); }
            download(path)      => { root.sftp-download(path); }
            open-file(path)     => { root.sftp-open-file(path); }
            upload-clicked(dir, folder) => { root.sftp-upload-clicked(dir, folder); }
            paste-upload(dir)   => { root.sftp-paste-upload(dir); }
            match-shortcut(t, c, m, a, s) => { return root.match-shortcut(t, c, m, a, s, false); }
            // A key typed while the file list had focus belongs to the shell:
            // send it and move focus back to the terminal.
            forward-key(key, ctrl, alt, shift) => {
                root.send-key(key, ctrl, alt, shift);
                root.focus-pending = true;
            }
            refresh(path)       => { root.sftp-refresh(path); }
            tree-expand(path)   => { root.sftp-tree-expand(path); }
            delete(path)        => { root.sftp-delete(path); }
            toggle-select(i)    => { root.sftp-toggle-select(i); }
            select-range(a, b)  => { root.sftp-select-range(a, b); }
            bookmarks: root.sftp-bookmarks;
            recent: root.sftp-recent;
            bookmarked: root.sftp-bookmarked;
            toggle-bookmark(p)  => { root.sftp-toggle-bookmark(p); }
            remove-bookmark(p)  => { root.sftp-remove-bookmark(p); }
            clear-recent()      => { root.sftp-clear-recent(); }
            places-refresh()    => { root.sftp-places-refresh(); }
            drag-out(i)         => { root.sftp-drag-out(i); }
            download-selected() => { root.sftp-download-selected(); }
            delete-selected()   => { root.sftp-delete-selected(); }
            copy-to-target(path, target) => { root.sftp-copy-to-target(path, target); }
            copy-selected-to-target(target) => { root.sftp-copy-selected-to-target(target); }
            view(path)          => { root.sftp-view(path); }
            edit(path)          => { root.sftp-edit(path); }
            open-external(path) => { root.sftp-open-external(path); }
            edit-external(path) => { root.sftp-edit-external(path); }
            sort-request(key)   => { root.sftp-sort-request(key); }
            clear-sort()        => { root.sftp-clear-sort(); }
            tunnel-add(name, kind, bind, bind-port, host, host-port, save, auto-start) => {
                root.tunnel-add(name, kind, bind, bind-port, host, host-port, save, auto-start);
            }
            tunnel-stop(id)     => { root.tunnel-stop(id); }
            tunnel-start(id)    => { root.tunnel-start(id); }
            tunnel-delete(id)   => { root.tunnel-delete(id); }
            rename-request(path, name) => { root.sftp-rename-request(path, name); }
            chmod-request(path, name, mode) => { root.sftp-chmod-request(path, name, mode); }
            copy-path(path)     => { root.sftp-copy-path(path); }
            new-folder(dir)     => { root.sftp-new-folder(dir); }
            new-file(dir)       => { root.sftp-new-file(dir); }
            create-entry-inline(kind, dir, name) => { root.sftp-create-entry-inline(kind, dir, name); }
            dual: root.sftp-dual;
            local-path: root.sftp-local-path;
            local-entries: root.sftp-local-entries;
            local-status: root.sftp-local-status;
            local-loading: root.sftp-local-loading;
            local-selected-count: root.sftp-local-selected-count;
            local-pane-default: root.sftp-local-pane-width;
            persist-local-pane-width(v) => { root.persist-sftp-local-pane-width(v); }
            local-quick-places: root.sftp-local-quick-places;
            local-drive-places: root.sftp-local-drive-places;
            local-bookmarks: root.sftp-local-bookmarks;
            local-recent: root.sftp-local-recent;
            local-bookmarked: root.sftp-local-bookmarked;
            local-split-ratio: root.sftp-local-split;
            persist-local-split-ratio(v) => { root.persist-sftp-local-split(v); }
            local-places-refresh() => { root.sftp-local-places-refresh(); }
            local-toggle-bookmark() => { root.sftp-local-toggle-bookmark(); }
            local-remove-bookmark(path) => { root.sftp-local-remove-bookmark(path); }
            local-clear-recent() => { root.sftp-local-clear-recent(); }
            toggle-dual()          => { root.sftp-toggle-dual(); }
            local-navigate(path)   => { root.sftp-local-navigate(path); }
            local-up()             => { root.sftp-local-up(); }
            local-home()           => { root.sftp-local-home(); }
            local-refresh()        => { root.sftp-local-refresh(); }
            local-open(path)       => { root.sftp-local-open(path); }
            local-toggle-select(i) => { root.sftp-local-toggle-select(i); }
            local-select-range(a, b) => { root.sftp-local-select-range(a, b); }
            local-copy-path(path)  => { root.sftp-local-copy-path(path); }
            local-upload(path)     => { root.sftp-local-upload(path); }
            local-upload-selected() => { root.sftp-local-upload-selected(); }
            download-to-local(path) => { root.sftp-download-to-local(path); }
            download-selected-to-local() => { root.sftp-download-selected-to-local(); }
            local-sort-request(k, d) => { root.sftp-local-sort-request(k, d); }
            entry-matches(n, t, q) => { return root.sftp-entry-matches(n, t, q); }
            transfers: root.transfers;
            has-active-transfers: root.has-active-transfers;
            download-dir: root.download-dir;
            cancel-transfer(id) => { root.cancel-transfer(id); }
            clear-transfers() => { root.clear-transfers(); }
            pick-download-dir() => { root.pick-download-dir(); }
            open-download-dir() => { root.open-download-dir(); }
        }

        // Drag-to-dock snap overlay — four edge zones; the one under the cursor
        // (sftp-dock-target) lights up. Purely visual (#dock).
        if root.sftp-panel-dragging : Rectangle {
            x: 0; y: 0; width: parent.width; height: parent.height;
            Rectangle {
                x: 0; y: 0; width: parent.width * 0.22; height: parent.height;
                background: root.sftp-dock-target == "left" ? Theme.accent.with-alpha(0.35) : Theme.accent.with-alpha(0.10);
                border-width: root.sftp-dock-target == "left" ? 2px : 0px; border-color: Theme.accent;
            }
            Rectangle {
                x: parent.width * 0.78; y: 0; width: parent.width * 0.22; height: parent.height;
                background: root.sftp-dock-target == "right" ? Theme.accent.with-alpha(0.35) : Theme.accent.with-alpha(0.10);
                border-width: root.sftp-dock-target == "right" ? 2px : 0px; border-color: Theme.accent;
            }
            Rectangle {
                x: 0; y: 0; width: parent.width; height: parent.height * 0.22;
                background: root.sftp-dock-target == "top" ? Theme.accent.with-alpha(0.35) : Theme.accent.with-alpha(0.10);
                border-width: root.sftp-dock-target == "top" ? 2px : 0px; border-color: Theme.accent;
            }
            Rectangle {
                x: 0; y: parent.height * 0.78; width: parent.width; height: parent.height * 0.22;
                background: root.sftp-dock-target == "bottom" ? Theme.accent.with-alpha(0.35) : Theme.accent.with-alpha(0.10);
                border-width: root.sftp-dock-target == "bottom" ? 2px : 0px; border-color: Theme.accent;
            }
        }

        }
    }
}
