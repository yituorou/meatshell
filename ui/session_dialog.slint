import { Theme } from "theme.slint";
import { ModalLayer } from "modal.slint";
import { ComboBox, CheckBox } from "std-widgets.slint";
import { LabeledInput, PrimaryButton, GhostButton, IconButton } from "widgets.slint";

// One SSH port-forward row shown in the session dialog (#56). `summary` is a
// ready-to-display line like "-L 127.0.0.1:8080 → host:80".
export struct PortFwd {
    id: string,
    kind: string,
    auto-start: bool,
    name: string,
    bind-addr: string,
    bind-port: string,
    host: string,
    host-port: string,
}

export struct TriggerDraft {
    expect: string,
    response: string,
    append-enter: bool,
    repeat: bool,
}

export struct JumpHop {
    id: string,
    choice: int,
    // Only a newly added, never-selected row can be omitted on Save/Test.
    placeholder: bool,
}

export struct SessionDraft {
    id: string,
    name: string,
    kind: string,      // "ssh" | "serial" | "telnet" | "rdp"
    host: string,
    port: int,
    user: string,
    auth: string,      // "password" | "key"
    password: string,
    private-key-path: string,
    private-key-inline: string,
    private-key-inline-mode: bool,
    proxy: string,     // "" | "socks5://host:port" | "http://host:port"
    group: string,     // folder/group name ("" = ungrouped)
    // Serial-only (ignored unless kind == "serial")
    serial-port: string,
    baud-rate: int,
    data-bits: int,
    stop-bits: int,
    parity: string,        // "none" | "odd" | "even"
    flow-control: string,  // "none" | "hardware" | "software"
    // RDP-only (ignored unless kind == "rdp")
    rdp-domain: string,      // Windows logon domain ("" = none)
    rdp-resolution: string,  // "fullscreen" | "custom" | "WxH"
    rdp-width: int,          // desktop size used by the "custom" choice
    rdp-height: int,
    encoding: string,
    // Honor VT100 line drawing (DEC Special Graphics) even in UTF-8 mode (#376),
    // like PuTTY's Window → Translation option. On by default.
    vt100-drawing: bool,
    // Session logging override (#265): "default" | "on" | "off".
    session-log: string,
    // Skip shell-integration setup for Windows / pwsh servers or interactive
    // auto-login scripts where injected commands break the shell.
    disable-shell-integration: bool,
    // Free-form note (B站 suggestion).
    note: string,
    // Explicit first-hop-first route, owned by this session (#211).
    jumps: [JumpHop],
    allow-secret-reveal: bool,
    // Expose this session to MCP clients (#432).
    allow-mcp-access: bool,
}

// A single segment in a segmented selector (auth toggle, baud presets, …).
component SegOption inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback clicked();
    height: 30px;
    horizontal-stretch: 1;
    border-radius: Theme.radius-sm;
    border-width: 1px;
    background: active ? Theme.accent : Theme.bg-root;
    border-color: active ? Theme.accent : Theme.border-subtle;
    Text {
        text: root.label;
        color: active ? white : Theme.text-primary;
        font-size: Theme.fs-md;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Compact single-line input (no label) used in the port-forward add form (#56).
component MiniInput inherits Rectangle {
    in property <string> placeholder;
    in-out property <string> value;
    callback edited(string);
    height: 30px;
    horizontal-stretch: 1;
    border-radius: Theme.radius-sm;
    border-width: 1px;
    border-color: mi.has-focus ? Theme.accent : Theme.border-subtle;
    background: Theme.bg-root;
    // Hide on focus: IME preedit is visible before value is committed.
    if root.value == "" && !mi.has-focus : Text {
        x: 8px;
        width: parent.width - 16px;
        height: parent.height;
        overflow: elide;
        text: root.placeholder;
        color: Theme.text-muted;
        font-family: Theme.ui-font-family;
        font-size: Theme.fs-md;
        vertical-alignment: center;
    }

    mi := TextInput {
        x: 8px;
        width: parent.width - 16px;
        height: parent.height;
        color: Theme.text-primary;
        font-family: Theme.ui-font-family;
        font-size: Theme.fs-md;
        vertical-alignment: center;
        single-line: true;
        text <=> root.value;
        edited => { root.edited(root.value); }
    }
}

// Every forwarding rule stays editable in-place. "Add" creates another row
// of this same form instead of converting the current form into a summary (#277).
component PortForwardRow inherits VerticalLayout {
    in property <PortFwd> forward;
    in property <int> index;
    callback updated(int, PortFwd);
    callback remove(int);

    property <string> kind: forward.kind;
    property <bool> auto-start: forward.auto-start;
    property <string> name: forward.name;
    property <string> bind-addr: forward.bind-addr;
    property <string> bind-port: forward.bind-port;
    property <string> host: forward.host;
    property <string> host-port: forward.host-port;

    function notify-updated() {
        root.updated(root.index, {
            id: root.forward.id,
            kind: root.kind,
            auto-start: root.auto-start,
            name: root.name,
            bind-addr: root.bind-addr,
            bind-port: root.bind-port,
            host: root.host,
            host-port: root.host-port,
        });
    }

    spacing: 6px;
    padding: 8px;

    HorizontalLayout {
        spacing: 6px;
        SegOption { label: @tr("Local (-L)"); active: root.kind == "local"; clicked => { root.kind = "local"; root.notify-updated(); } }
        SegOption { label: @tr("Remote (-R)"); active: root.kind == "remote"; clicked => { root.kind = "remote"; root.notify-updated(); } }
        SegOption { label: @tr("Dynamic (-D)"); active: root.kind == "dynamic"; clicked => { root.kind = "dynamic"; root.notify-updated(); } }
        Rectangle {
            width: 30px;
            height: 30px;
            border-radius: Theme.radius-sm;
            background: remove-area.has-hover ? Theme.danger.with-alpha(0.18) : transparent;
            remove-area := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.remove(root.index); }
            }
            Text {
                text: "\u{E5CD}";
                font-family: "Material Icons";
                color: Theme.danger;
                font-size: Theme.fs-sm;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
    HorizontalLayout {
        spacing: 6px;
        Rectangle {
            width: 16px; height: 16px; border-radius: 3px;
            border-width: 1px; border-color: Theme.border-subtle;
            background: root.auto-start ? Theme.accent : Theme.bg-root;
            TouchArea { clicked => { root.auto-start = !root.auto-start; root.notify-updated(); } }
            Text { text: root.auto-start ? "X" : ""; color: #ffffff; horizontal-alignment: center; vertical-alignment: center; }
        }
        Text { text: @tr("Start automatically when connecting"); color: Theme.text-secondary; font-size: Theme.fs-sm; }
    }
    MiniInput {
        placeholder: @tr("Name (optional)");
        value <=> root.name;
        edited(value) => { root.name = value; root.notify-updated(); }
    }
    HorizontalLayout {
        spacing: 6px;
        MiniInput {
            placeholder: "127.0.0.1";
            value <=> root.bind-addr;
            edited(value) => { root.bind-addr = value; root.notify-updated(); }
        }
        MiniInput {
            placeholder: @tr("Listen port");
            value <=> root.bind-port;
            edited(value) => { root.bind-port = value; root.notify-updated(); }
        }
    }
    if root.kind != "dynamic" : HorizontalLayout {
        spacing: 6px;
        MiniInput {
            placeholder: @tr("Target host");
            value <=> root.host;
            edited(value) => { root.host = value; root.notify-updated(); }
        }
        MiniInput {
            placeholder: @tr("Target port");
            value <=> root.host-port;
            edited(value) => { root.host-port = value; root.notify-updated(); }
        }
    }
}

component TriggerRow inherits VerticalLayout {
    in property <TriggerDraft> trigger;
    in property <int> index;
    callback updated(int, TriggerDraft);
    callback remove(int);

    property <string> expect: trigger.expect;
    property <string> response: trigger.response;
    property <bool> append-enter: trigger.append-enter;
    property <bool> repeat: trigger.repeat;

    function notify-updated() {
        root.updated(root.index, {
            expect: root.expect,
            response: root.response,
            append-enter: root.append-enter,
            repeat: root.repeat,
        });
    }

    spacing: 6px;
    padding: 8px;
    HorizontalLayout {
        spacing: 6px;
        MiniInput {
            placeholder: @tr("Expected output");
            value <=> root.expect;
            edited(value) => { root.expect = value; root.notify-updated(); }
        }
        Rectangle {
            width: 30px; height: 30px;
            border-radius: Theme.radius-sm;
            background: trigger-remove.has-hover ? Theme.danger.with-alpha(0.18) : transparent;
            trigger-remove := TouchArea { mouse-cursor: pointer; clicked => { root.remove(root.index); } }
            Text {
                text: "\u{E5CD}"; font-family: "Material Icons"; color: Theme.danger;
                font-size: Theme.fs-sm; horizontal-alignment: center; vertical-alignment: center;
            }
        }
    }
    MiniInput {
        placeholder: @tr("Response (leave blank to keep saved value)");
        value <=> root.response;
        edited(value) => { root.response = value; root.notify-updated(); }
    }
    HorizontalLayout {
        spacing: 14px;
        SegOption {
            label: @tr("Send Enter"); active: root.append-enter;
            clicked => { root.append-enter = !root.append-enter; root.notify-updated(); }
        }
        SegOption {
            label: @tr("Repeat"); active: root.repeat;
            clicked => { root.repeat = !root.repeat; root.notify-updated(); }
        }
    }
}

// Group field with an editable text box + a dropdown of existing groups (#179).
// Type to create a new group, or click the ▾ to pick one already in use.
component GroupCombo inherits VerticalLayout {
    in property <string> label;
    in property <string> placeholder;
    in-out property <string> value;
    in property <[string]> groups;       // existing group names
    spacing: 4px;

    Text {
        text: root.label;
        color: Theme.text-secondary;
        font-size: Theme.fs-sm;
    }

    Rectangle {
        height: 32px;
        border-radius: Theme.radius-sm;
        border-width: 1px;
    border-color: ginput.has-focus ? Theme.accent : Theme.border-strong;
    background: Theme.bg-elevated;

        // Hide on focus: IME preedit is visible before value is committed.
        if root.value == "" && !ginput.has-focus : Text {
            x: 10px;
            width: parent.width - 44px;
            height: parent.height;
            overflow: elide;
            text: root.placeholder;
            color: Theme.text-muted;
            font-family: Theme.ui-font-family;
            font-size: Theme.fs-md;
            vertical-alignment: center;
        }

        ginput := TextInput {
            x: 10px;
            width: parent.width - 44px;     // room for the ▾ button
            height: parent.height;
            text <=> root.value;
            color: Theme.text-primary;
            font-family: Theme.ui-font-family;
            font-size: Theme.fs-md;
            vertical-alignment: center;
            single-line: true;
        }


        // ▾ — opens the existing-groups list (no-op when there are none).
        drop-ta := TouchArea {
            x: parent.width - 36px;
            width: 36px;
            height: parent.height;
            mouse-cursor: root.groups.length > 0 ? pointer : default;
            clicked => { if (root.groups.length > 0) { groups-popup.show(); } }
            Rectangle {
                width: 28px;
                height: 28px;
                border-radius: Theme.radius-sm;
                background: (drop-ta.has-hover && root.groups.length > 0) ? Theme.bg-hover : transparent;
                Text {
                    // Plain Unicode caret — the dialog's CJK UI font has this but
                    // not the Material icon range, which would tofu (#179).
                    text: "▼";
                    color: root.groups.length > 0 ? Theme.text-secondary : Theme.border-strong;
                    font-size: Theme.fs-xs;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        groups-popup := PopupWindow {
            x: 0;
            y: parent.height + 3px;
            width: parent.width;
            Rectangle {
                background: Theme.popup-bg-alt;
                border-radius: Theme.radius-sm;
                border-width: 1px;
                border-color: Theme.border-subtle;
                VerticalLayout {
                    padding: 4px;
                    spacing: 1px;
                    for g in root.groups : Rectangle {
                        height: 28px;
                        border-radius: Theme.radius-sm;
                        background: g-ta.has-hover ? Theme.bg-hover : transparent;
                        g-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.value = g; groups-popup.close(); }
                        }
                        Text {
                            x: 10px;
                            width: parent.width - 20px;
                            text: g;
                            color: Theme.text-primary;
                            font-size: Theme.fs-md;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                }
            }
        }
    }
}

// Read-only dropdown picking an SSH jump host from a fixed list of saved
// sessions (#211). Index-based: `choices[0]` is the unselected entry, and
// `selected-index` maps into the parallel `ids` list held by the caller.
component JumpCombo inherits VerticalLayout {
    in property <string> label;
    in property <[string]> choices;      // display labels; index 0 = unselected
    in-out property <int> selected-index: 0;
    callback selected(int);
    spacing: 4px;

    Text {
        text: root.label;
        color: Theme.text-secondary;
        font-size: Theme.fs-sm;
    }

    Rectangle {
        height: 32px;
        border-radius: Theme.radius-sm;
        border-width: 1px;
    border-color: jump-ta.has-hover ? Theme.accent : Theme.border-strong;
    background: Theme.bg-elevated;

        jump-ta := TouchArea {
            mouse-cursor: pointer;
            clicked => { jump-popup.show(); }
        }

        Text {
            x: 10px;
            width: parent.width - 44px;
            height: parent.height;
            text: (root.selected-index >= 0 && root.selected-index < root.choices.length)
                ? root.choices[root.selected-index] : "";
            color: root.selected-index > 0 ? Theme.text-primary : Theme.text-muted;
            font-size: Theme.fs-md;
            vertical-alignment: center;
            overflow: elide;
        }

        Rectangle {
            x: parent.width - 36px;
            width: 28px;
            height: 28px;
            border-radius: Theme.radius-sm;
            background: jump-ta.has-hover ? Theme.bg-hover : transparent;
            Text {
                text: "▼";
                color: Theme.text-secondary;
                font-size: Theme.fs-xs;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        jump-popup := PopupWindow {
            x: 0;
            y: parent.height + 3px;
            width: parent.width;
            Rectangle {
                background: Theme.popup-bg-alt;
                border-radius: Theme.radius-sm;
                border-width: 1px;
                border-color: Theme.border-subtle;
                VerticalLayout {
                    padding: 4px;
                    spacing: 1px;
                    for c[idx] in root.choices : Rectangle {
                        height: 28px;
                        border-radius: Theme.radius-sm;
                        background: c-ta.has-hover ? Theme.bg-hover : transparent;
                        c-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.selected-index = idx; jump-popup.close(); root.selected(idx); }
                        }
                        Text {
                            x: 10px;
                            width: parent.width - 20px;
                            text: c;
                            color: Theme.text-primary;
                            font-size: Theme.fs-md;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                }
            }
        }
    }
}

// SerialPort field with an editable text box + a dropdown of existing serial ports.
// Type to input a serial port, or click the ▾ to pick one already in use.
component SerialPortCombo inherits VerticalLayout {
    in property <string> label;
    in property <string> placeholder;
    in-out property <string> value;
