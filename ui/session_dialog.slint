import { Theme } from "theme.slint";
import { ModalLayer } from "modal.slint";
import { ComboBox, CheckBox } from "std-widgets.slint";
import { LabeledInput, PrimaryButton, GhostButton, IconButton, OutlineIcon } from "widgets.slint";
import { PortFwd, TriggerDraft, JumpHop, SessionDraft, SegOption, MiniInput, SftpModeOption, TermTypePicker } from "components/business/session_types.slint";
import { GroupCombo, JumpCombo, SerialPortCombo } from "components/business/session_combos.slint";
import { PortForwardRow, TriggerRow, JumpRow } from "components/business/session_rows.slint";
import { SessionRdpFields, SessionSerialFields } from "pages/dialogs/session_rdp_serial_fields.slint";

export { PortFwd, TriggerDraft, JumpHop, SessionDraft, JumpRow }

// Terminal character encoding picker (#338, #435). Shared by SSH/Telnet (in
// the Advanced section) and serial (main section: serial has no Advanced).
// Values are encoding_rs / WHATWG labels; unknown labels fall back to UTF-8.
component EncodingPicker inherits VerticalLayout {
    in-out property <string> value: "UTF-8";
    spacing: 4px;
    Text {
        text: @tr("Terminal character encoding");
        color: Theme.text-secondary;
        font-size: Theme.fs-sm;
    }
    ComboBox {
        model: [
            "UTF-8", "GBK", "GB18030", "Big5", "Shift_JIS", "EUC-JP", "EUC-KR",
            "Windows-1252", "ISO-8859-1", "ISO-8859-2", "Windows-1251", "KOI8-R",
            "Windows-1250", "Windows-1256", "Windows-874",
        ];
        current-value: root.value;
        selected(value) => { root.value = value; }
    }
    Text {
        text: @tr("Use GBK for servers configured for GB2312 or GBK output.");
        color: Theme.text-muted;
        font-size: Theme.fs-xs;
    }
    Rectangle { height: 6px; }
}

// Modal dialog for creating / editing a session (SSH / Serial / Telnet).
// The dialog is purely presentational — it stores values in mutable
// properties and emits `submit` / `cancel` callbacks up to the main window.
export component SessionDialog inherits ModalLayer {
    in-out property <bool> is-editing: false;
    in-out property <string> draft-id;
    in-out property <string> draft-name;
    in-out property <string> draft-kind: "ssh";
    in-out property <string> draft-host;
    in-out property <string> draft-port: "22";
    in-out property <string> draft-user;
    // Set when Create/Save is pressed with an empty host (SSH/Telnet) (#110).
    in-out property <bool> host-missing: false;
    in-out property <string> draft-auth: "password";
    in-out property <string> draft-password;
    in-out property <string> draft-key-path;
    in-out property <string> draft-key-inline;
    in-out property <bool> draft-key-inline-mode: false;
    in-out property <string> draft-proxy-type: "none";  // "none" | "socks5" | "http"
    in-out property <string> draft-proxy-hostport;
    in-out property <string> draft-group;
    in property <[string]> session-groups;   // existing groups for the dropdown (#179)
    // Saved SSH candidates and the ordered route for this session (#211).
    in property <[string]> jump-choices;
    in property <[JumpHop]> jumps;
    in-out property <bool> allow-secret-reveal: false;
    in-out property <bool> allow-mcp-access: true;
    property <bool> password-revealed: false;
    property <bool> key-revealed: false;
    callback reveal-secret(bool /* private key */) -> string;
    // Opted-in credentials are loaded masked. Never overwrite an unsaved edit.
    function load-saved-credentials() {
        if root.is-open && root.allow-secret-reveal {
            if root.draft-password == "" { root.draft-password = root.reveal-secret(false); }
            if root.draft-key-inline-mode && root.draft-key-inline == "" {
                root.draft-key-inline = root.reveal-secret(true);
            }
        }
    }
    changed allow-secret-reveal => {
        root.password-revealed = false;
        root.key-revealed = false;
        root.load-saved-credentials();
    }
    changed draft-key-inline-mode => { root.connection-draft-changed(); root.load-saved-credentials(); }
    callback add-jump();
    callback update-jump(int, int);
    callback delete-jump(int);
    callback move-jump(int, int);
    in-out property <string> draft-serial-port;
    in property <[string]> session-serial-ports;   // existing serial-ports for the dropdown
    in-out property <string> draft-baud: "115200";
    in-out property <string> draft-data-bits: "8";
    in-out property <string> draft-stop-bits: "1";
    in-out property <string> draft-parity: "none";
    in-out property <string> draft-flow: "none";
    in-out property <string> draft-rdp-domain;
    // "fullscreen" | "custom" | "<width>x<height>" (a preset from the dropdown).
    in-out property <string> draft-rdp-resolution: "1280x720";
    in-out property <string> draft-rdp-width: "1280";
    in-out property <string> draft-rdp-height: "720";
    in-out property <bool> draft-rdp-legacy-tls: false;
    in-out property <bool> draft-rdp-admin: false;
    in-out property <bool> draft-rdp-smart-sizing: false;
    in-out property <string> draft-rdp-cert-policy: "ignore";
    in-out property <string> draft-rdp-network: "auto";
    in-out property <bool> draft-rdp-sound: false;
    in-out property <bool> draft-rdp-clipboard: true;
    in-out property <bool> draft-rdp-gfx: false;
    in-out property <string> draft-rdp-extra-args: "";
    in-out property <bool> show-rdp-advanced: false;
    in-out property <string> rdp-preview: "";
    in-out property <string> draft-encoding: "UTF-8";
    in-out property <bool> draft-vt100-drawing: true;
    in-out property <string> draft-term-type: "xterm-256color";
    in-out property <string> draft-session-log: "default";
    in-out property <bool> draft-disable-shell-integration: false;
    in-out property <string> draft-sftp-mode: "";
    in-out property <string> draft-sftp-command: "";
    in-out property <string> draft-note;
    in-out property <string> test-status;

    // Port forwards / tunnels (#56). Every row is an editable form (#277).
    in property <[PortFwd]> forwards;
    in property <[TriggerDraft]> triggers;
    in-out property <bool> show-advanced: false;   // collapse proxy + forwarding (#56)

    // A result belongs to the tested endpoint and credentials. Editing either
    // cancels the old attempt before its result can label a different draft.
    callback connection-draft-changed();
    changed draft-kind => { root.connection-draft-changed(); }
    changed draft-host => { root.connection-draft-changed(); root.rdp-preview = ""; }
    changed draft-port => { root.connection-draft-changed(); root.rdp-preview = ""; }
    changed draft-user => { root.connection-draft-changed(); root.rdp-preview = ""; }
    changed draft-auth => { root.connection-draft-changed(); }
    changed draft-password => { root.connection-draft-changed(); }
    changed draft-key-path => { root.connection-draft-changed(); }
    changed draft-key-inline => { root.connection-draft-changed(); }
    changed draft-proxy-type => {
        root.connection-draft-changed();
        if (self.draft-proxy-type != "none") { self.show-advanced = true; }
    }
    changed draft-proxy-hostport => { root.connection-draft-changed(); }
    changed draft-serial-port => { root.connection-draft-changed(); }
    changed draft-baud => { root.connection-draft-changed(); }
    changed draft-data-bits => { root.connection-draft-changed(); }
    changed draft-stop-bits => { root.connection-draft-changed(); }
    changed draft-parity => { root.connection-draft-changed(); }
    changed draft-flow => { root.connection-draft-changed(); }
    changed draft-rdp-cert-policy => { root.rdp-preview = ""; }
    changed draft-rdp-network => { root.rdp-preview = ""; }
    changed draft-rdp-sound => { root.rdp-preview = ""; }
    changed draft-rdp-clipboard => { root.rdp-preview = ""; }
    changed draft-rdp-gfx => { root.rdp-preview = ""; }
    changed draft-rdp-extra-args => { root.rdp-preview = ""; }
    changed draft-rdp-legacy-tls => { root.rdp-preview = ""; }
    changed draft-rdp-admin => { root.rdp-preview = ""; }
    changed draft-rdp-smart-sizing => { root.rdp-preview = ""; }
    changed draft-rdp-resolution => { root.rdp-preview = ""; }
    changed draft-rdp-width => { root.rdp-preview = ""; }
    changed draft-rdp-height => { root.rdp-preview = ""; }
    changed draft-rdp-domain => { root.rdp-preview = ""; }

    public function submit-current() {
        root.stop-test();
        // SSH/Telnet need a host; block submit and flag it (#110).
        if (root.draft-kind != "serial" && root.draft-host == "") {
            root.host-missing = true;
            return;
        }
        root.host-missing = false;
        root.submit(root.current-draft());
    }

    public function current-draft() -> SessionDraft {
        return {
            id: root.draft-id,
            name: root.draft-name,
            kind: root.draft-kind,
            host: root.draft-host,
            port: root.draft-port.to-float(),
            user: root.draft-user,
            auth: root.draft-auth,
            password: root.draft-password,
            private-key-path: root.draft-key-path,
            private-key-inline: root.draft-key-inline,
            private-key-inline-mode: root.draft-key-inline-mode,
            proxy: (root.draft-proxy-type == "none" || root.draft-proxy-hostport == "") ? ""
                 : root.draft-proxy-type == "http" ? "http://" + root.draft-proxy-hostport
                 : "socks5://" + root.draft-proxy-hostport,
            group: root.draft-group,
            serial-port: root.draft-serial-port,
            baud-rate: root.draft-baud.to-float(),
            data-bits: root.draft-data-bits.to-float(),
            stop-bits: root.draft-stop-bits.to-float(),
            parity: root.draft-parity,
            flow-control: root.draft-flow,
            rdp-domain: root.draft-rdp-domain,
            rdp-resolution: root.draft-rdp-resolution,
            rdp-width: root.draft-rdp-width.to-float(),
            rdp-height: root.draft-rdp-height.to-float(),
            rdp-legacy-tls: root.draft-rdp-legacy-tls,
            rdp-admin: root.draft-rdp-admin,
            rdp-smart-sizing: root.draft-rdp-smart-sizing,
            rdp-cert-policy: root.draft-rdp-cert-policy,
            rdp-network: root.draft-rdp-network,
            rdp-sound: root.draft-rdp-sound,
            rdp-clipboard: root.draft-rdp-clipboard,
            rdp-gfx: root.draft-rdp-gfx,
            rdp-extra-args: root.draft-rdp-extra-args,
            encoding: root.draft-encoding,
            vt100-drawing: root.draft-vt100-drawing,
            term-type: root.draft-term-type,
            session-log: root.draft-session-log,
            disable-shell-integration: root.draft-disable-shell-integration,
            sftp-mode: root.draft-sftp-mode,
            sftp-command: root.draft-sftp-command,
            note: root.draft-note,
            jumps: root.jumps,
            allow-secret-reveal: root.allow-secret-reveal,
            allow-mcp-access: root.allow-mcp-access,
        };
    }

    callback submit(SessionDraft);
    callback test-connection(SessionDraft);
    callback preview-rdp(SessionDraft) -> string;
    callback cancel();
    callback closed();
    callback stop-test();
    callback add-forward();
    callback update-forward(int /* index */, PortFwd);
    callback delete-forward(int /* index */);
    callback add-trigger();
    callback update-trigger(int /* index */, TriggerDraft);
    callback delete-trigger(int /* index */);
    callback pick-key-file();   // open a native file picker for the private key
    // Segmented filter inside the expanded Advanced section (0 = All, 1 = Terminal/Proxy, 2 = Tunnels/SFTP, 3 = Triggers).
    property <int> adv-tab: 0;
    // Use the wider 2-column partitioned layout in application windows (>720px),
    // falling back to single-column in narrow windows and 700px test fixtures.
    property <bool> wide-card: root.width > 720px;

    cancel-requested => { root.cancel(); }
    background: #00000080;

    // Clear the host-required flag each time the dialog opens (#110).
    changed is-open => {
        if (self.is-open) {
            self.host-missing = false;
            self.password-revealed = false;
            self.key-revealed = false;
            root.load-saved-credentials();
        } else {
            root.closed();
            root.draft-password = "";
            root.draft-key-inline = "";
            root.password-revealed = false;
            root.key-revealed = false;
        }
    }


    Rectangle {
        width: root.wide-card ? min(680px * Theme.ui-scale, parent.width - 32px) : min(440px, parent.width - 32px);
        // Height follows the content, but never exceeds the window — past that
        // the body scrolls (the dialog grows with the advanced section / many
        // port forwards) (#56). Header (52px + 1px divider) and the pinned
        // action footer (1px divider + its row) stay outside the scroll (#525).
        height: min(body.preferred-height + 54px + footer.preferred-height, parent.height - (root.wide-card ? 48px : 40px));
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: Theme.popup-bg;
        border-radius: Theme.radius-lg;
        border-width: 1px;
        border-color: Theme.border-strong;
        drop-shadow-blur: 24px;
        drop-shadow-color: #00000080;

        // Prevent backdrop click from propagating when user clicks inside the card
        TouchArea {
            width: 100%; height: 100%;
        }

        VerticalLayout {
            spacing: 0px;

        Rectangle {
            width: 100%;
            height: 52px;
            background: Theme.bg-panel-alt;
            border-top-left-radius: Theme.radius-lg;
            border-top-right-radius: Theme.radius-lg;

            HorizontalLayout {
                padding-left: 20px;
                padding-right: 10px;
                spacing: 10px;

                Text {
                    text: is-editing ? @tr("Edit session") : @tr("New session");
                    color: Theme.text-primary;
                    font-size: Theme.fs-lg;
                    font-weight: 600;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }

                Rectangle {
                    width: 30px;
                    height: 30px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 7px;
                    background: close-ta.has-hover ? Theme.bg-hover : transparent;
                    animate background { duration: 90ms; }
                    close-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.cancel(); }
                    }
                    OutlineIcon {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        name: "close";
                        icon-size: 16px;
                        color: close-ta.has-hover ? Theme.text-primary : Theme.text-secondary;
                    }
                }
            }
        }

        Rectangle {
            width: 100%;
            height: 1px;
            background: Theme.border-subtle;
        }

        Flickable {
            // Keep mouse grabs with text selections and jump handles. Wheel
            // scrolling still works, as in the terminal tab strip (#408).
            interactive: false;
            width: 100%;
            vertical-stretch: 1;
            content-width: self.width;
            content-height: body.preferred-height;
            body := VerticalLayout {
                padding: 20px;
                spacing: 12px;

            // Connection type selector (always shown).
            VerticalLayout {
                spacing: 4px;
                Text {
                    text: @tr("Connection type");
                    color: Theme.text-secondary;
                    font-size: Theme.fs-sm;
                }
                HorizontalLayout {
                    spacing: 6px;
                    SegOption {
                        label: "SSH";
                        active: root.draft-kind == "ssh";
                        clicked => {
                            // Switch protocol defaults while leaving non-default ports untouched (#303).
                            if (root.draft-kind != "ssh" && (root.draft-port == "23" || root.draft-port == "3389")) {
                                root.draft-port = "22";
                            }
                            root.draft-kind = "ssh";
                        }
                    }
                    SegOption {
                        label: @tr("Serial");
                        active: root.draft-kind == "serial";
                        clicked => { root.draft-kind = "serial"; }
                    }
                    SegOption {
                        label: "Telnet";
                        active: root.draft-kind == "telnet";
                        clicked => {
                            if (root.draft-kind != "telnet" && (root.draft-port == "22" || root.draft-port == "3389")) {
                                root.draft-port = "23";
                            }
                            root.draft-kind = "telnet";
                        }
                    }
                    SegOption {
                        label: "RDP";
                        active: root.draft-kind == "rdp";
                        clicked => {
                            if (root.draft-kind != "rdp" && (root.draft-port == "22" || root.draft-port == "23")) {
                                root.draft-port = "3389";
                            }
                            root.draft-kind = "rdp";
                        }
                    }
                }
            }

            if root.wide-card : HorizontalLayout {
                spacing: 12px;
                LabeledInput {
                    horizontal-stretch: 1;
                    input-background: Theme.bg-elevated;
                    idle-border: Theme.border-strong;
                    label: @tr("Name");
                    placeholder: @tr("e.g. production web-01");
                    value <=> root.draft-name;
                }
                GroupCombo {
                    horizontal-stretch: 1;
                    label: @tr("Group (optional)");
                    placeholder: @tr("e.g. Production / Database");
                    value <=> root.draft-group;
                    groups: root.session-groups;
                }
            }

            if !root.wide-card : LabeledInput {
                input-background: Theme.bg-elevated;
                idle-border: Theme.border-strong;
                label: @tr("Name");
                placeholder: @tr("e.g. production web-01");
                value <=> root.draft-name;
            }

            // Optional group/folder to organize sessions by business (#41).
            // Editable + dropdown of existing groups (#179).
            if !root.wide-card : GroupCombo {
                label: @tr("Group (optional)");
                placeholder: @tr("e.g. Production / Database");
                value <=> root.draft-group;
                groups: root.session-groups;
            }

            // Free-form note — in wide layout, moved to the Advanced section so
            // the primary form stays focused on connection + authentication.
            if !root.wide-card : LabeledInput {
                input-background: Theme.bg-elevated;
                idle-border: Theme.border-strong;
                label: @tr("Note (optional)");
                placeholder: @tr("Anything to remember about this host");
                value <=> root.draft-note;
            }

            // ── SSH / Telnet share host + port ──────────────────────────────
            if root.draft-kind != "serial" : HorizontalLayout {
                spacing: 12px;
                LabeledInput {
                    input-background: Theme.bg-elevated;
                    idle-border: Theme.border-strong;
                    label: @tr("Host / IP");
                    placeholder: "192.168.1.10";
                    value <=> root.draft-host;
                    horizontal-stretch: 2;
                }
                LabeledInput {
                    input-background: Theme.bg-elevated;
                    idle-border: Theme.border-strong;
                    label: @tr("Port");
                    placeholder: root.draft-kind == "telnet" ? "23"
                        : root.draft-kind == "rdp" ? "3389" : "22";
                    value <=> root.draft-port;
                    horizontal-stretch: 1;
                }
            }

            // Inline error when a host-less SSH/Telnet session is submitted (#110).
            if root.host-missing && root.draft-host == "" && root.draft-kind != "serial" : Text {
                text: @tr("Please enter a host / IP address.");
                color: Theme.danger;
                font-size: Theme.fs-sm;
            }

            if root.wide-card && root.draft-kind != "serial" : Rectangle {
                height: 1px;
                background: Theme.border-subtle;
            }

            // ── SSH: user + auth. Telnet: optional auto-login (#507) ────────
            if root.draft-kind == "ssh" || root.draft-kind == "telnet" : LabeledInput {
                input-background: Theme.bg-elevated;
                idle-border: Theme.border-strong;
                label: @tr("Username");
                placeholder: root.draft-kind == "telnet"
                    ? @tr("Optional, typed at the login prompt")
                    : @tr("Prompted on connect if blank");
                value <=> root.draft-user;
            }

            if root.draft-kind == "telnet" : LabeledInput {
                input-background: Theme.bg-elevated;
                idle-border: Theme.border-strong;
                label: @tr("Password");
                placeholder: root.is-editing
                    ? (root.allow-secret-reveal ? @tr("Enter a new password") : @tr("Leave blank to keep the current password"))
                    : @tr("Optional, typed at the password prompt");
                password: true;
                reveal-enabled: root.allow-secret-reveal;
                revealed <=> root.password-revealed;
                reveal => { root.reveal-secret(false) }
                value <=> root.draft-password;
            }

            if root.draft-kind == "telnet" : Text {
                text: @tr("MeatShell answers the device's first login and password prompts with these. Leave them blank to type them yourself.");
                color: Theme.text-muted;
                font-size: Theme.fs-xs;
                wrap: word-wrap;
            }

            if root.draft-kind == "ssh" : VerticalLayout {
                spacing: 4px;
                Text {
                    text: @tr("Authentication");
                    color: Theme.text-secondary;
                    font-size: Theme.fs-sm;
                }
                HorizontalLayout {
                    spacing: 6px;
                    SegOption {
                        label: @tr("Password");
                        active: root.draft-auth == "password";
                        clicked => { root.draft-auth = "password"; }
                    }
                    SegOption {
                        label: @tr("Keyboard-interactive");
                        active: root.draft-auth == "keyboard-interactive";
                        clicked => { root.draft-auth = "keyboard-interactive"; }
                    }
                    SegOption {
                        label: @tr("Private key");
                        active: root.draft-auth == "key";
                        clicked => { root.draft-auth = "key"; }
                    }
                }
            }

            if root.draft-kind == "ssh" && (root.draft-auth == "password" || root.draft-auth == "keyboard-interactive") : LabeledInput {
                input-background: Theme.bg-elevated;
                idle-border: Theme.border-strong;
                label: root.draft-auth == "keyboard-interactive" ? @tr("Password / first answer") : @tr("Password");
                placeholder: root.is-editing
                    ? (root.allow-secret-reveal ? @tr("Enter a new password") : @tr("Leave blank to keep the current password"))
                    : "••••••••";
                password: true;
                reveal-enabled: root.allow-secret-reveal;
                revealed <=> root.password-revealed;
                reveal => { root.reveal-secret(false) }
                value <=> root.draft-password;
            }

            if root.draft-kind == "ssh" && root.draft-auth == "keyboard-interactive" : Text {
                text: @tr("Server prompts are shown during login; MFA / OTP prompts will ask again.");
                color: Theme.text-muted;
                font-size: Theme.fs-xs;
                wrap: word-wrap;
            }

            if root.draft-kind == "ssh" && root.draft-auth == "key" : VerticalLayout {
                spacing: 4px;
                Text {
                    text: @tr("Private key");
                    color: Theme.text-secondary;
                    font-size: Theme.fs-sm;
                }
                HorizontalLayout {
                    spacing: 6px;
                    SegOption {
                        label: @tr("Private key file");
                        active: !root.draft-key-inline-mode;
                        clicked => { root.draft-key-inline-mode = false; }
                    }
                    SegOption {
                        label: @tr("Paste private key");
                        active: root.draft-key-inline-mode;
                        clicked => { root.draft-key-inline-mode = true; }
                    }
                }
                if !root.draft-key-inline-mode : VerticalLayout {
                    spacing: 4px;
                HorizontalLayout {
                    spacing: 8px;
                    Rectangle {
                        height: 32px;
                        horizontal-stretch: 1;
                        border-radius: Theme.radius-sm;
                        border-width: 1px;
                        border-color: keyin.has-focus ? Theme.accent : Theme.border-strong;
                        background: Theme.bg-elevated;
                        keyin := TextInput {
                            x: 10px; y: 0px;
                            width: parent.width - 20px;
                            height: parent.height;
                            text <=> root.draft-key-path;
                            color: Theme.text-primary;
                            font-family: Theme.ui-font-family; // CJK-capable (#54)
                            font-size: Theme.fs-md;
                            vertical-alignment: center;
                            single-line: true;
                        }
                        if root.draft-key-path == "" : Text {
                            x: 10px; y: 0px;
                            height: parent.height;
                            text: "/home/you/.ssh/id_ed25519";
                            color: Theme.text-muted;
                            font-size: Theme.fs-md;
                            vertical-alignment: center;
                        }
                    }
                    Rectangle {
                        width: 64px; height: 32px;
                        border-radius: Theme.radius-sm;
                        border-width: 1px;
                        border-color: Theme.border-subtle;
                        background: browse-ta.has-hover ? Theme.bg-hover : Theme.bg-elevated;
                        Text {
                            text: @tr("Browse…");
                            color: Theme.text-primary;
                            font-size: Theme.fs-sm;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        browse-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.pick-key-file(); }
                        }
                    }
                }
                Text {
                    text: @tr("Pick the private key itself (not the .pub public key)");
                    color: Theme.text-muted;
                    font-size: Theme.fs-xs;
                }
                }
                if root.draft-key-inline-mode : VerticalLayout {
                    spacing: 4px;
                    if root.allow-secret-reveal : IconButton {
                        glyph: root.key-revealed ? "\u{E8F4}" : "\u{E8F5}";
                        font-family: "Material Icons";
                        tooltip: root.key-revealed ? @tr("Hide secret") : @tr("Show secret");
                        clicked => {
                            if !root.key-revealed && root.draft-key-inline == "" {
                                root.draft-key-inline = root.reveal-secret(true);
                            }
                            root.key-revealed = !root.key-revealed;
                        }
                    }
                    Rectangle {
                        height: 118px;
                        horizontal-stretch: 1;
                        border-radius: Theme.radius-sm;
                        border-width: 1px;
                        border-color: keytext.has-focus ? Theme.accent : Theme.border-strong;
                        background: Theme.bg-elevated;
                        clip: true;
                        keytext := TextInput {
                            input-type: root.key-revealed ? InputType.text : InputType.password;
                            x: 10px;
                            y: 8px;
                            width: parent.width - 20px;
                            height: parent.height - 16px;
                            text <=> root.draft-key-inline;
                            color: Theme.text-primary;
                            font-family: Theme.font-mono;
                            font-size: Theme.fs-sm;
                            single-line: false;
                            wrap: word-wrap;
                        }
                        if root.draft-key-inline == "" : Text {
                            x: 10px;
                            y: 8px;
                            width: parent.width - 20px;
                            text: "-----BEGIN OPENSSH PRIVATE KEY-----";
                            color: Theme.text-muted;
                            font-family: Theme.font-mono;
                            font-size: Theme.fs-sm;
                        }
                    }
                    Text {
                        text: @tr("Private key content is encrypted before saving.");
                        color: Theme.text-muted;
                        font-size: Theme.fs-xs;
                    }
                }
            }

            // Passphrase for an *encrypted* private key (#90). Reuses the
            // password field; blank means the key isn't encrypted (or, when
            // editing, keep the saved passphrase).
            if root.draft-kind == "ssh" && root.draft-auth == "key" : LabeledInput {
                input-background: Theme.bg-elevated;
                idle-border: Theme.border-strong;
                label: @tr("Key passphrase");
                placeholder: root.is-editing
                    ? (root.allow-secret-reveal ? @tr("Enter a key passphrase") : @tr("Leave blank to keep the current passphrase"))
                    : @tr("Leave blank if the key isn't encrypted");
                password: true;
                reveal-enabled: root.allow-secret-reveal;
                revealed <=> root.password-revealed;
                reveal => { root.reveal-secret(false) }
                value <=> root.draft-password;
            }

            if root.draft-kind == "ssh" || root.draft-kind == "rdp" || root.draft-kind == "telnet" : CheckBox {
                text: @tr("Allow viewing saved credentials in this session");
                checked <=> root.allow-secret-reveal;
                toggled => {
                    root.password-revealed = false;
                    root.key-revealed = false;
                }
            }

            if root.allow-secret-reveal && (root.draft-kind == "ssh" || root.draft-kind == "rdp" || root.draft-kind == "telnet") : Text {
                text: @tr("Credentials start hidden. Click the eye to view. Save to remember this option.");
                color: Theme.text-muted;
                font-size: Theme.fs-xs;
                wrap: word-wrap;
            }

            // MCP scope (#432): keep manual-only servers out of reach of agents.
            CheckBox {
                text: @tr("Allow MCP access to this session");
                checked <=> root.allow-mcp-access;
            }

            if !root.allow-mcp-access : Text {
                text: @tr("Hidden from MCP clients: they cannot list, connect to, or route through this session. The CLI is unaffected.");
                color: Theme.text-muted;
                font-size: Theme.fs-xs;
                wrap: word-wrap;
            }

            // ── RDP-only fields ─────────────────────────────────────────────
            if root.draft-kind == "rdp" : SessionRdpFields {
                is-editing: root.is-editing;
                allow-secret-reveal: root.allow-secret-reveal;
                password-revealed <=> root.password-revealed;
                draft-user <=> root.draft-user;
                draft-password <=> root.draft-password;
                draft-rdp-domain <=> root.draft-rdp-domain;
                draft-rdp-resolution <=> root.draft-rdp-resolution;
                draft-rdp-width <=> root.draft-rdp-width;
                draft-rdp-height <=> root.draft-rdp-height;
                draft-rdp-legacy-tls <=> root.draft-rdp-legacy-tls;
                draft-rdp-admin <=> root.draft-rdp-admin;
                draft-rdp-smart-sizing <=> root.draft-rdp-smart-sizing;
                draft-rdp-cert-policy <=> root.draft-rdp-cert-policy;
                draft-rdp-network <=> root.draft-rdp-network;
                draft-rdp-sound <=> root.draft-rdp-sound;
                draft-rdp-clipboard <=> root.draft-rdp-clipboard;
                draft-rdp-gfx <=> root.draft-rdp-gfx;
                draft-rdp-extra-args <=> root.draft-rdp-extra-args;
                show-rdp-advanced <=> root.show-rdp-advanced;
                rdp-preview <=> root.rdp-preview;
                reveal-password => { root.reveal-secret(false) }
                trigger-preview => { root.rdp-preview = root.preview-rdp(root.current-draft()); }
            }

            // ── Serial-only fields ──────────────────────────────────────────
            if root.draft-kind == "serial" : SessionSerialFields {
                draft-serial-port <=> root.draft-serial-port;
                session-serial-ports: root.session-serial-ports;
                draft-baud <=> root.draft-baud;
                draft-data-bits <=> root.draft-data-bits;
                draft-stop-bits <=> root.draft-stop-bits;
                draft-parity <=> root.draft-parity;
                draft-flow <=> root.draft-flow;
            }

            // Serial has no Advanced section; console gear (switches, PLCs)
            // often talks GBK, so the encoding lives here for it (#435).
            if root.draft-kind == "serial" : EncodingPicker {
                value <=> root.draft-encoding;
            }

            // ── Advanced (collapsed by default): proxy + port forwarding ────
            // Not offered for serial (nothing to configure) or RDP (its extras
            // live in the main section, and the SSH-only parts do not apply).
            if root.draft-kind != "serial" && root.draft-kind != "rdp" : Rectangle {
                height: 26px;
                border-radius: Theme.radius-sm;
                background: adv-ta.has-hover ? Theme.bg-hover : Theme.bg-elevated;
                adv-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.show-advanced = !root.show-advanced; }
                }
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 6px;
                    Text {
                        text: "\u{E429}"; // tune
                        font-family: "Material Icons";
                        color: root.show-advanced ? Theme.accent : Theme.text-muted;
                        font-size: Theme.fs-sm;
                        vertical-alignment: center;
                    }
                    Text {
                        text: @tr("Advanced (encoding, proxy, tunnels)");
                        color: root.show-advanced ? Theme.text-primary : (adv-ta.has-hover ? Theme.text-primary : Theme.text-secondary);
                        font-size: Theme.fs-sm;
                        font-weight: root.show-advanced ? 600 : 400;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Text {
                        text: root.show-advanced ? "\u{E5CE}" : "\u{E5CF}";
                        font-family: "Material Icons";
                        color: Theme.text-muted;
                        font-size: Theme.fs-md;
                        vertical-alignment: center;
                    }
                }
            }

            // Segmented category switcher for the Advanced section
            if root.show-advanced && root.draft-kind != "serial" && root.draft-kind != "rdp" : HorizontalLayout {
                spacing: 6px;
                SegOption {
                    label: @tr("Terminal");
                    active: root.adv-tab == 0;
                    clicked => { root.adv-tab = 0; }
                }
                SegOption {
                    label: @tr("Proxy (optional)");
                    active: root.adv-tab == 1;
                    clicked => { root.adv-tab = 1; }
                }
                if root.draft-kind == "ssh" : SegOption {
                    label: @tr("Port forwarding");
                    active: root.adv-tab == 2;
                    clicked => { root.adv-tab = 2; }
                }
                if root.draft-kind == "ssh" : SegOption {
                    label: @tr("Login triggers");
                    active: root.adv-tab == 3;
                    clicked => { root.adv-tab = 3; }
                }
            }

            if root.wide-card && root.show-advanced && (root.adv-tab == 0 || root.adv-tab == 1) : LabeledInput {
                input-background: Theme.bg-elevated;
                idle-border: Theme.border-strong;
                label: @tr("Note (optional)");
                placeholder: @tr("Anything to remember about this host");
                value <=> root.draft-note;
            }

            // ── Terminal character encoding (SSH / Telnet) (#338, #435) ─────
            if root.show-advanced && (root.adv-tab == 0 || root.adv-tab == 1) && (root.draft-kind == "ssh" || root.draft-kind == "telnet") : EncodingPicker {
                value <=> root.draft-encoding;
            }

            // ── Terminal type (SSH / Telnet) (#498) ─────────────────────────
            if root.show-advanced && (root.adv-tab == 0 || root.adv-tab == 1) && (root.draft-kind == "ssh" || root.draft-kind == "telnet") : TermTypePicker {
                value <=> root.draft-term-type;
            }

            // ── VT100 line drawing (all session kinds) (#376) ───────────────
            // Mirror of PuTTY's "Enable VT100 line drawing even in UTF-8 mode":
            // honor ESC(0 / SO-SI charset switches and map DEC Special Graphics
            // to box-drawing glyphs even when the encoding is UTF-8.
            if root.show-advanced && (root.adv-tab == 0 || root.adv-tab == 1) : VerticalLayout {
                spacing: 6px;

                HorizontalLayout {
                    spacing: 8px;
                    Rectangle {
                        width: 18px; height: 18px; y: 1px;
                        border-radius: 4px;
                        border-width: 1px;
                        border-color: root.draft-vt100-drawing ? Theme.accent : Theme.border-strong;
                        background: root.draft-vt100-drawing ? Theme.accent : transparent;
                        Text {
                            text: root.draft-vt100-drawing ? "\u{E5CA}" : "";
                            font-family: "Material Icons"; color: white; font-size: 14px;
                            width: 100%; height: 100%;
                            horizontal-alignment: center; vertical-alignment: center;
                        }
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.draft-vt100-drawing = !root.draft-vt100-drawing; }
                        }
                    }
                    Text {
                        text: @tr("Enable VT100 line drawing even in UTF-8 mode");
                        color: Theme.text-primary; font-size: Theme.fs-sm;
                        vertical-alignment: center; horizontal-stretch: 1;
                    }
                }
                Text {
                    text: @tr("Show box-drawing output from servers that switch charsets (ESC(0, SO/SI) while staying in UTF-8, e.g. top or mc frames.");
                    color: Theme.text-muted; font-size: Theme.fs-xs; wrap: word-wrap;
                }
                Rectangle { height: 6px; }
            }

            // ── Session log override (terminal sessions) (#265) ─────────────
            if root.show-advanced && (root.adv-tab == 0 || root.adv-tab == 1) && root.draft-kind != "rdp" : VerticalLayout {
                spacing: 4px;
                Text {
                    text: @tr("Session log");
                    color: Theme.text-secondary;
                    font-size: Theme.fs-sm;
                }
                HorizontalLayout {
                    spacing: 6px;
                    SegOption {
                        label: @tr("Follow global");
                        active: root.draft-session-log != "on" && root.draft-session-log != "off";
                        clicked => { root.draft-session-log = "default"; }
                    }
                    SegOption {
                        label: @tr("Always record");
                        active: root.draft-session-log == "on";
                        clicked => { root.draft-session-log = "on"; }
                    }
                    SegOption {
                        label: @tr("Never record");
                        active: root.draft-session-log == "off";
                        clicked => { root.draft-session-log = "off"; }
                    }
                }
                Text {
                    text: @tr("Saves this session's terminal output as timestamped plain text. Keystrokes are not recorded. The folder is set in Settings → Session log.");
                    color: Theme.text-muted; font-size: Theme.fs-xs; wrap: word-wrap;
                }
                Rectangle { height: 6px; }
            }

            // ── Optional outbound proxy (SSH / Telnet only) ─────────────────
            if root.show-advanced && (root.adv-tab == 0 || root.adv-tab == 1) && root.draft-kind != "serial" : VerticalLayout {
                spacing: 4px;
                Text {
                    text: @tr("Proxy (optional)");
                    color: Theme.text-secondary;
                    font-size: Theme.fs-sm;
                }
                HorizontalLayout {
                    spacing: 6px;
                    SegOption { label: @tr("None"); active: root.draft-proxy-type == "none"; clicked => { root.draft-proxy-type = "none"; } }
                    SegOption { label: "SOCKS5"; active: root.draft-proxy-type == "socks5"; clicked => { root.draft-proxy-type = "socks5"; } }
                    SegOption { label: "HTTP"; active: root.draft-proxy-type == "http"; clicked => { root.draft-proxy-type = "http"; } }
                }
                if root.draft-proxy-type != "none" : LabeledInput {
                    input-background: Theme.bg-elevated;
                    idle-border: Theme.border-strong;
                    label: @tr("Proxy address");
                    placeholder: "127.0.0.1:1080";
                    value <=> root.draft-proxy-hostport;
                }
                Text {
                    text: root.draft-proxy-type == "none"
                        ? @tr("No proxy — use $ALL_PROXY or connect directly")
                        : @tr("Format: host:port  (with auth: user:pass@host:port)");
                    color: Theme.text-muted;
                    font-size: Theme.fs-xs;
                }
            }

            // Each row is one actual hop. Reordering never rewrites saved hops.
            // In wide layout, Jump chain is part of the collapsible Advanced section.
            if root.draft-kind == "ssh" && (!root.wide-card || (root.show-advanced && (root.adv-tab == 0 || root.adv-tab == 1))) : VerticalLayout {
                spacing: 6px;
                Text { text: @tr("Jump chain (optional)"); color: Theme.text-secondary; font-size: Theme.fs-sm; }
                Text {
                    text: @tr("Local → hops below → target. First hop connects first.");
                    color: Theme.text-muted; font-size: Theme.fs-xs;
                    wrap: word-wrap;
                }
                for hop[i] in root.jumps : JumpRow {
                    hop: hop; index: i; count: root.jumps.length;
                    choices: root.jump-choices;
                    selected(choice) => { root.update-jump(i, choice); }
                    remove => { root.delete-jump(i); }
                    move(to) => { root.move-jump(i, to); }
                }
                GhostButton {
                    text: @tr("+ Add jump host");
                    clicked => { if root.jumps.length < 16 { root.add-jump(); } }
                }
                if root.draft-host != "" : Text {
                    text: @tr("Target") + ": " + (root.draft-user != "" ? root.draft-user + "@" : "") + root.draft-host + ":" + root.draft-port;
                    color: Theme.text-secondary; font-size: Theme.fs-sm; overflow: elide;
                }
            }

            // ── Port forwarding / tunnels (SSH only) (#56) ──────────────────
            if root.show-advanced && (root.adv-tab == 0 || root.adv-tab == 2) && root.draft-kind == "ssh" : VerticalLayout {
                spacing: 6px;

                // Interactive-login compatibility toggle (#140): shell hooks and
                // remote monitoring can interfere with auto-login scripts.
                HorizontalLayout {
                    spacing: 8px;
                    Rectangle {
                        width: 18px; height: 18px; y: 1px;
                        border-radius: 4px;
                        border-width: 1px;
                        border-color: root.draft-disable-shell-integration ? Theme.accent : Theme.border-strong;
                        background: root.draft-disable-shell-integration ? Theme.accent : transparent;
                        Text {
                            text: root.draft-disable-shell-integration ? "\u{E5CA}" : "";
                            font-family: "Material Icons"; color: white; font-size: 14px;
                            width: 100%; height: 100%;
                            horizontal-alignment: center; vertical-alignment: center;
                        }
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.draft-disable-shell-integration = !root.draft-disable-shell-integration; }
                        }
                    }
                    Text {
                        text: @tr("Interactive login compatibility mode");
                        color: Theme.text-primary; font-size: Theme.fs-sm;
                        vertical-alignment: center; horizontal-stretch: 1;
                    }
                }
                Text {
                    text: @tr("For auto-login scripts or non-POSIX shells: skips shell hooks and remote monitoring while keeping SFTP available.");
                    color: Theme.text-muted; font-size: Theme.fs-xs; wrap: word-wrap;
                }
                Rectangle { height: 6px; }

                // SFTP privileges (#438): servers that refuse root logins can
                // still browse root-only files, like WinSCP's "SFTP server".
                Text {
                    text: @tr("SFTP privileges");
                    color: Theme.text-secondary;
                    font-size: Theme.fs-sm;
                }
                // Radio rows bound straight to the draft: the dialog is reused
                // between sessions, so no widget-internal selection can go stale.
                SftpModeOption {
                    label: @tr("Login user (default)");
                    checked: root.draft-sftp-mode != "sudo" && root.draft-sftp-mode != "custom";
                    clicked => { root.draft-sftp-mode = ""; }
                }
                SftpModeOption {
                    label: @tr("Root, via sudo");
                    checked: root.draft-sftp-mode == "sudo";
                    clicked => { root.draft-sftp-mode = "sudo"; }
                }
                SftpModeOption {
                    label: @tr("Custom SFTP server command");
                    checked: root.draft-sftp-mode == "custom";
                    clicked => { root.draft-sftp-mode = "custom"; }
                }
                if root.draft-sftp-mode == "custom" : LabeledInput {
                    label: @tr("SFTP server command");
                    placeholder: "sudo -u www-data /usr/lib/openssh/sftp-server";
                    value <=> root.draft-sftp-command;
                }
                Text {
                    text: root.draft-sftp-mode == "sudo"
                        ? @tr("The SFTP panel runs sftp-server through sudo, so it can read and write files only root can. Needs passwordless sudo, or the saved login password when sudo asks for one.")
                        : root.draft-sftp-mode == "custom"
                            ? @tr("Runs this command instead of the sftp subsystem; it must speak SFTP on stdin/stdout. Folder downloads (tar) still run as the login user.")
                            : @tr("The SFTP panel works as the user you log in with.");
                    color: Theme.text-muted; font-size: Theme.fs-xs; wrap: word-wrap;
                }
                Rectangle { height: 6px; }

                Text {
                    text: @tr("Port forwarding");
                    color: Theme.text-secondary;
                    font-size: Theme.fs-sm;
                }

                for f[i] in root.forwards : PortForwardRow {
                    forward: f;
                    index: i;
                    updated(index, value) => { root.update-forward(index, value); }
                    remove(index) => { root.delete-forward(index); }
                }
                HorizontalLayout {
                    alignment: end;
                    PrimaryButton {
                        text: @tr("Add");
                        clicked => { root.add-forward(); }
                    }
                }
                Text {
                    text: @tr("-L: local port → target reached from the server; -R: server port → target reached from here; -D: local SOCKS5 proxy");
                    color: Theme.text-muted;
                    font-size: Theme.fs-xs;
                }
            }

            // ── Expect/send login triggers (SSH only) (#212) ───────────────
            if root.show-advanced && (root.adv-tab == 0 || root.adv-tab == 3) && root.draft-kind == "ssh" : VerticalLayout {
                spacing: 6px;
                Text { text: @tr("Login triggers"); color: Theme.text-secondary; font-size: Theme.fs-sm; }
                for trigger[i] in root.triggers : TriggerRow {
                    trigger: trigger;
                    index: i;
                    updated(index, value) => { root.update-trigger(index, value); }
                    remove(index) => { root.delete-trigger(index); }
                }
                HorizontalLayout {
                    alignment: end;
                    PrimaryButton { text: @tr("Add trigger"); clicked => { root.add-trigger(); } }
                }
                Text {
                    text: @tr("When expected text appears, send the response automatically. Responses are stored encrypted.");
                    color: Theme.text-muted; font-size: Theme.fs-xs; wrap: word-wrap;
                }
            }
        }
        }

        Rectangle {
            width: 100%;
            height: 1px;
            background: Theme.border-subtle;
        }

        // Action row pinned below the scrolling body (#525). It used to be the
        // last item inside the Flickable, so once the advanced section made
        // the dialog taller than the window it was clipped off the bottom and
        // could only be reached by wheel-scrolling a body with no scrollbar.
        footer := HorizontalLayout {
                padding-left: 20px;
                padding-right: 20px;
                padding-top: 12px;
                padding-bottom: 12px;
                spacing: 8px;
                GhostButton {
                    text: @tr("Test connection");
                    clicked => {
                        if (root.draft-kind != "serial" && root.draft-host == "") {
                            root.host-missing = true;
                            return;
                        }
                        if (root.draft-kind == "serial" && root.draft-serial-port == "") {
                            root.test-status = @tr("Please enter a serial port.");
                            return;
                        }
                        root.host-missing = false;
                        root.test-status = @tr("Testing...");
                        root.test-connection(root.current-draft());
                    }
                }
                if root.test-status != "" : Text {
                    text: root.test-status;
                    color: root.test-status == @tr("Connection OK") ? Theme.success : Theme.text-muted;
                    font-size: Theme.fs-xs;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
                if root.test-status == "" : Rectangle { horizontal-stretch: 1; }
                GhostButton {
                    text: @tr("Cancel");
                    clicked => { root.cancel(); }
                }
                PrimaryButton {
                    text: is-editing ? @tr("Save") : @tr("Create");
                    clicked => {
                        root.submit-current();
                    }
                }
            }
        }
        Rectangle {
            x: 0; y: 0;
            width: 100%; height: 100%;
            border-radius: Theme.radius-lg;
            border-width: 1px;
            border-color: Theme.border-strong;
            background: transparent;
        }
    }
}
