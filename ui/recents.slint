// Recent connections.
//
// * `RecentsCard`: a floating, frosted card in the empty main area of the
//   welcome-sidebar layout. It defers to the wallpaper — no history, no card.
// * `RecentsShelf`: a row of tiles on the full welcome page (sidebar off),
//   between the title and Quick connect, like Safari's start page.
//
// Both follow the Interface › Wallpaper opacity slider like the Resources
// sidebar: the tiles use the same `Theme.bg-panel`, the card the slightly
// stronger `bg-panel-strong` (it sits centred on the wallpaper).

import { Theme } from "theme.slint";

export struct RecentSession {
    id: string,
    name: string,
    detail: string, // user@host, program, serial port…
    when: string,   // "Just now", "12 min ago", "Yesterday"… (Rust keeps it fresh)
    icon: string,   // Material Icons glyph for the connection type
}

// Hairline edge and hover wash that read on any wallpaper, like macOS
// materials: translucent white on dark, translucent black on light.
global RecentStyle {
    out property <brush> hairline: Theme.dark ? #ffffff1a : #0000001a;
    out property <brush> hover: Theme.dark ? #ffffff1a : #0000000d;
    out property <brush> pressed: Theme.dark ? #ffffff29 : #00000017;
}

component TypeIcon inherits Rectangle {
    in property <string> glyph;
    in property <float> zoom: 1.0;
    width: 30px * root.zoom;
    height: self.width;
    border-radius: 8px * root.zoom;
    background: Theme.accent.with-alpha(Theme.dark ? 0.18 : 0.12);
    Text {
        text: root.glyph;
        font-family: "Material Icons";
        font-size: 16px * root.zoom;
        color: Theme.accent;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// Round × that replaces the time while the pointer is over an entry.
//
// It stays in the tree and is only hidden: the pointer moving onto it takes
// the hover away from the entry underneath, so an `if entry-hovered` button
// would vanish under the pointer and the click would connect instead. Its
// own `hovered` keeps it (and the entry's highlight) up meanwhile.
component RemoveButton inherits Rectangle {
    callback clicked();
    in property <float> zoom: 1.0;
    out property <bool> hovered: ta.has-hover;
    width: 22px * root.zoom;
    height: self.width;
    border-radius: self.width / 2;
    background: ta.pressed ? RecentStyle.pressed : (ta.has-hover ? RecentStyle.hover : transparent);
    accessible-role: button;
    accessible-label: @tr("Remove from recents");
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    Text {
        text: "\u{E5CD}";
        font-family: "Material Icons";
        font-size: 14px * root.zoom;
        color: ta.has-hover ? Theme.text-primary : Theme.text-muted;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// "Recent connections" ······ "Clear"
component Header inherits HorizontalLayout {
    // The shelf's header sits straight on the wallpaper, not on a panel:
    // use the stronger colours there, like the page title above it.
    in property <bool> on-wallpaper: false;
    in property <float> zoom: 1.0;
    callback clear();
    Text {
        text: @tr("Recent connections");
        color: root.on-wallpaper ? Theme.text-primary : Theme.text-secondary;
        font-size: Theme.fs-sm;
        font-weight: 600;
        vertical-alignment: center;
        horizontal-stretch: 1;
    }
    Rectangle {
        width: clear-text.preferred-width + 12px * root.zoom;
        height: 22px * root.zoom;
        border-radius: 6px * root.zoom;
        background: clear-ta.has-hover ? RecentStyle.hover : transparent;
        accessible-role: button;
        accessible-label: @tr("Clear recents");
        clear-ta := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.clear(); }
        }
        clear-text := Text {
            text: @tr("Clear");
            color: clear-ta.has-hover || root.on-wallpaper ? Theme.text-primary : Theme.text-muted;
            font-size: Theme.fs-xs;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

component RecentRow inherits Rectangle {
    in property <RecentSession> item;
    in property <float> zoom: 1.0;
    callback connect();
    callback remove();
    property <bool> hovered: ta.has-hover || rm.hovered;
    border-radius: 10px * root.zoom;
    background: ta.pressed ? RecentStyle.pressed : (root.hovered ? RecentStyle.hover : transparent);
    animate background { duration: 120ms; }
    accessible-role: button;
    accessible-label: root.item.name;

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.connect(); }
    }
    HorizontalLayout {
        padding-left: 9px * root.zoom;
        padding-right: 9px * root.zoom;
        spacing: 12px * root.zoom;
        alignment: stretch;
        TypeIcon {
            zoom: root.zoom;
            glyph: root.item.icon;
            y: (parent.height - self.height) / 2;
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 1px * root.zoom;
            Text {
                text: root.item.name;
                color: Theme.text-primary;
                font-size: Theme.fs-md;
                font-weight: 500;
                overflow: elide;
            }
            Text {
                text: root.item.detail;
                color: Theme.text-muted;
                font-size: Theme.fs-xs;
                overflow: elide;
            }
        }
        Rectangle {
            width: max(when.preferred-width, 22px * root.zoom);
            when := Text {
                visible: !root.hovered;
                width: parent.width;
                height: parent.height;
                text: root.item.when;
                color: Theme.text-muted;
                font-size: Theme.fs-xs;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
            rm := RemoveButton {
                zoom: root.zoom;
                visible: root.hovered;
                x: parent.width - self.width;
                y: (parent.height - self.height) / 2;
                clicked => { root.remove(); }
            }
        }
    }
}

// Panel that fills the empty main area (welcome-sidebar layout). The central
// card around it supplies the rounded edge, so it has none of its own.
export component RecentsCard inherits Rectangle {
    in property <[RecentSession]> items;
    // Rows that fit the area; the rest are left out rather than overflowing.
    in property <int> max-rows: 6;
    // Roomier controls than the shelf tiles — taller rows, larger type icons,
    // × and Clear buttons. Text keeps the theme sizes so it matches the
    // surrounding panels.
    property <float> zoom: 1.2;
    property <length> pad: 16px;
    // Row and header+padding heights, so the caller can work out `max-rows`.
    out property <length> row-height: 48px * root.zoom;
    out property <length> chrome-height: 2 * root.pad + 28px * root.zoom;
    callback connect(string);
    callback remove(string);
    callback clear();
    callback refresh();

    // Same surface as the session list and resource panels, so the wallpaper
    // opacity slider sets its transparency too.
    background: Theme.card-bg;

    // Fade in rather than pop.
    property <bool> appeared: false;
    init => { self.appeared = true; }
    opacity: self.appeared ? 1 : 0;
    animate opacity { duration: 240ms; easing: ease-out; }

    // Relative times ("5 min ago") age while the card is on screen.
    Timer {
        interval: 60s;
        running: true;
        triggered => { root.refresh(); }
    }

    // pad + header (28px × zoom, its gap included) + pad = chrome-height.
    VerticalLayout {
        padding: root.pad;
        spacing: 0px;
        alignment: start;
        Header {
            zoom: root.zoom;
            height: 28px * root.zoom;
            padding-left: 9px * root.zoom;
            padding-right: 3px * root.zoom;
            padding-bottom: 6px * root.zoom;
            clear => { root.clear(); }
        }
        for item[i] in root.items : RecentRow {
            zoom: root.zoom;
            visible: i < root.max-rows;
            height: self.visible ? root.row-height : 0px;
            item: item;
            connect => { root.connect(item.id); }
            remove => { root.remove(item.id); }
        }
    }
}

component RecentTile inherits Rectangle {
    in property <RecentSession> item;
    callback connect();
    callback remove();
    property <bool> hovered: ta.has-hover || rm.hovered;
    height: 60px;
    border-radius: 12px;
    background: Theme.card-bg;
    border-width: 1px;
    border-color: root.hovered ? Theme.accent.with-alpha(0.55) : RecentStyle.hairline;
    animate border-color { duration: 120ms; }
    accessible-role: button;
    accessible-label: root.item.name;

    Rectangle {
        border-radius: parent.border-radius;
        background: ta.pressed ? RecentStyle.pressed : (root.hovered ? RecentStyle.hover : transparent);
        animate background { duration: 120ms; }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.connect(); }
    }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 10px;
        spacing: 10px;
        TypeIcon {
            glyph: root.item.icon;
            y: (parent.height - self.height) / 2;
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;
            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: root.item.name;
                    color: Theme.text-primary;
                    font-size: Theme.fs-md;
                    font-weight: 500;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                Text {
                    text: root.item.when;
                    color: Theme.text-muted;
                    font-size: Theme.fs-xs;
                    vertical-alignment: center;
                    // Keep the slot while hovered so the name doesn't shift.
                    opacity: root.hovered ? 0 : 1;
                }
            }
            Text {
                text: root.item.detail;
                color: Theme.text-muted;
                font-size: Theme.fs-xs;
                overflow: elide;
            }
        }
    }
    rm := RemoveButton {
        visible: root.hovered;
        x: parent.width - self.width - 6px;
        y: 6px;
        clicked => { root.remove(); }
    }
}

// Row of tiles for the full welcome page. Tiles share the width evenly and
// never get narrower than `min-tile`; the ones that don't fit are left out
// rather than squeezed.
export component RecentsShelf inherits VerticalLayout {
    in property <[RecentSession]> items;
    callback connect(string);
    callback remove(string);
    callback clear();
    callback refresh();

    property <length> gap: 10px;
    property <length> min-tile: 200px;
    property <int> fit: max(1, floor((self.width + self.gap) / (self.min-tile + self.gap)));
    property <int> count: min(root.items.length, root.fit);
    property <length> tile: (self.width - (self.count - 1) * self.gap) / max(1, self.count);
    spacing: 8px;

    Timer {
        interval: 60s;
        running: true;
        triggered => { root.refresh(); }
    }

    Header {
        on-wallpaper: true;
        padding-left: 2px;
        clear => { root.clear(); }
    }
    Rectangle {
        height: 60px;
        for item[i] in root.items : RecentTile {
            visible: i < root.count;
            x: i * (root.tile + root.gap);
            width: root.tile;
            item: item;
            connect => { root.connect(item.id); }
            remove => { root.remove(item.id); }
        }
    }
}
