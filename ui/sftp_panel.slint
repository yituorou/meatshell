import { Theme } from "theme.slint";
import { ScrollView } from "std-widgets.slint";
import { TabInfo } from "tabs.slint";

// ---------------------------------------------------------------------------
// Data types
// ---------------------------------------------------------------------------

export struct SftpEntry {
    name: string,
    full-path: string,
    is-dir: bool,
    size: string,
    size-bytes: float,
    modified: string,
    modified-ts: float,
    mode: int,        // POSIX permission bits, for the chmod dialog (#84)
    file-type: string,
    permissions: string,
    permissions-mode: int,
    owner: string,
    group: string,
    selected: bool,   // multi-select checkbox state (#100)
}

export struct SftpTreeNode {
    path: string,
    name: string,
    depth: int,
    expanded: bool,
    has-children: bool,
}

// One row of the local pane's places dropdown (#532): a quick location such as
// the desktop or a drive, resolved by Rust (drive labels come from the OS).
export struct SftpLocalPlace {
    label: string,
    path: string,
    icon: string,
    current: bool,
}

export struct TunnelInfo {
    id: string,
    name: string,
    kind: string,
    bind: string,
    target: string,
    status: string,
    active: bool,
}

// One row of the file-list right-click context menu.
component SftpMenuItem inherits Rectangle {
    in property <string> label;
    in property <string> icon;
    in property <brush> tint: Theme.text-primary;
    in property <bool> enabled: true;   // disabled items grey out + ignore clicks
    callback clicked();
    height: 26px;
    border-radius: Theme.radius-sm;
    background: (root.enabled && ta.has-hover) ? Theme.bg-hover : transparent;
    ta := TouchArea {
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { if (root.enabled) { root.clicked(); } }
    }
    Text {
        x: 8px;
        text: root.icon;
        color: root.enabled ? root.tint : Theme.text-muted;
        font-family: "Material Icons";
        font-size: Theme.fs-sm;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: 18px;
        height: parent.height;
    }
    Text {
        x: 30px;
        text: root.label;
        color: root.enabled ? root.tint : Theme.text-muted;
        font-size: Theme.fs-sm;
        vertical-alignment: center;
        height: parent.height;
    }
}

// One folder in the places menu: click jumps there; bookmarks also get a
// remove button (#500).
component SftpPlaceRow inherits Rectangle {
    in property <string> path;
    in property <string> icon;
    in property <bool> current;      // the folder the panel is showing
    in property <bool> removable;
    // Optional friendly name; falls back to the path when empty (remote rows).
    in property <string> label: "";
    callback go();
    callback remove();
    height: 26px;
    border-radius: Theme.radius-sm;
    background: row-ta.has-hover ? Theme.bg-hover : transparent;
    row-ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.go(); }
    }
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 4px;
        spacing: 6px;
        Text {
            width: 16px;
            text: root.icon;
            font-family: "Material Icons";
            color: root.current ? Theme.accent : Theme.text-secondary;
            font-size: Theme.fs-sm;
            vertical-alignment: center;
        }
        Text {
            horizontal-stretch: 1;
            text: root.label == "" ? root.path : root.label;
            color: root.current ? Theme.accent : Theme.text-primary;
            font-size: Theme.fs-sm;
            overflow: elide;
            vertical-alignment: center;
        }
        if root.removable && row-ta.has-hover : Rectangle {
            width: 20px;
            border-radius: Theme.radius-sm;
            background: rm-ta.has-hover ? Theme.bg-active : transparent;
            rm-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.remove(); }
            }
            Text {
                text: "\u{E5CD}"; // close
                font-family: "Material Icons";
                color: Theme.text-secondary;
                font-size: Theme.fs-xs;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}

// Toolbar button that opens the path bookmarks + recent folders menu (#500).
// Used by both the wide and the compact toolbar layouts.
component SftpPlacesButton inherits Rectangle {
    in property <[string]> bookmarks;
    in property <[string]> recent;
    in property <string> current-path;
    callback opened();
    callback navigate(string);
    callback remove-bookmark(string);
    callback clear-recent();
    // Menu geometry: section headers 22px, rows 26px + 1px spacing.
    property <length> rows-h:
        22px + max(1, root.bookmarks.length) * 27px
        + 8px
        + 22px + max(1, root.recent.length) * 27px
        + (root.recent.length > 0 ? 27px : 0px);
    width: 24px; height: 22px;
    border-radius: Theme.radius-sm;
    background: places-ta.has-hover ? Theme.bg-hover : transparent;
    places-ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.opened();
            places-menu.show();
        }
    }
    Text { text: "\u{E889}"; // history
           font-family: "Material Icons";
           color: Theme.text-secondary; font-size: Theme.fs-sm;
           horizontal-alignment: center; vertical-alignment: center; }
    places-menu := PopupWindow {
        x: min(0px, root.width - self.width);
        y: root.height + 2px;
        width: 320px;
        height: min(380px, root.rows-h + 8px);
        Rectangle {
            background: Theme.popup-bg;
            border-radius: Theme.radius-sm;
            border-width: 1px;
            border-color: Theme.border-strong;
            drop-shadow-blur: 12px;
            drop-shadow-color: #00000060;
            ScrollView {
                VerticalLayout {
                    padding: 4px;
                    spacing: 1px;
                    Text {
                        height: 22px;
                        text: @tr("Bookmarks");
                        color: Theme.text-muted;
                        font-size: Theme.fs-xs;
                        vertical-alignment: center;
                    }
                    if root.bookmarks.length == 0 : Text {
                        height: 26px;
                        text: @tr("None yet. Click ☆ to bookmark the current folder.");
                        color: Theme.text-muted;
                        font-size: Theme.fs-xs;
                        vertical-alignment: center;
                    }
                    for b in root.bookmarks : SftpPlaceRow {
                        path: b;
                        icon: "\u{E838}"; // star
                        current: b == root.current-path;
                        removable: true;
                        go => { root.navigate(b); }
                        remove => { root.remove-bookmark(b); }
                    }
                    Rectangle { height: 8px; }
                    Text {
                        height: 22px;
                        text: @tr("Recent");
                        color: Theme.text-muted;
                        font-size: Theme.fs-xs;
                        vertical-alignment: center;
                    }
                    if root.recent.length == 0 : Text {
                        height: 26px;
                        text: @tr("Folders you open will show up here.");
                        color: Theme.text-muted;
                        font-size: Theme.fs-xs;
                        vertical-alignment: center;
                    }
                    for r in root.recent : SftpPlaceRow {
                        path: r;
                        icon: "\u{E889}"; // history
                        current: r == root.current-path;
                        go => { root.navigate(r); }
                    }
                    if root.recent.length > 0 : SftpMenuItem {
                        label: @tr("Clear recent");
                        icon: "\u{E0B8}"; // clear_all
                        clicked => { root.clear-recent(); }
                    }
                }
            }
        }
    }
}

// Star toggle: bookmark / un-bookmark the folder the panel is showing (#500).
component SftpStarButton inherits Rectangle {
    in property <bool> bookmarked;
    callback toggled();
    width: 24px; height: 22px;
    border-radius: Theme.radius-sm;
    background: star-ta.has-hover ? Theme.bg-hover : transparent;
    star-ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggled(); }
    }
    Text { text: root.bookmarked ? "\u{E838}" : "\u{E83A}"; // star / star_border
           font-family: "Material Icons";
           color: root.bookmarked ? Theme.warning : Theme.text-secondary;
           font-size: Theme.fs-sm;
           horizontal-alignment: center; vertical-alignment: center; }
}

// Places dropdown for the local pane: home, desktop, downloads, documents and
// the machine's drives (#532). Rust resolves the list, so drive labels and the
// current-folder highlight follow the real machine.
component LocalPlacesButton inherits Rectangle {
    in property <[SftpLocalPlace]> quick-places;
    in property <[SftpLocalPlace]> drive-places;
    in property <[string]> bookmarks;
    in property <[string]> recent;
    in property <string> current-path: "";
    callback opened();
    callback navigate(string);
    callback remove-bookmark(string);
    callback clear-recent();
    // Section headers are 22px, rows 26px + 1px spacing; 8px between groups.
    property <length> rows-h:
        22px + max(1, root.bookmarks.length) * 27px
        + (root.bookmarks.length == 0 ? 26px : 0px)
        + 8px
        + 22px + max(1, root.recent.length) * 27px
        + (root.recent.length == 0 ? 26px : 0px)
        + (root.recent.length > 0 ? 27px : 0px)
        + 8px
        + (root.quick-places.length + root.drive-places.length) * 27px
        + (root.quick-places.length > 0 && root.drive-places.length > 0 ? 8px : 0px);
    // The menu is a fixed number of rows, and it opens on whichever side of the
    // button has room: a bottom-docked panel has no space below it (the panel
    // sits on the window's bottom edge), a tall side dock has plenty.
    property <length> menu-h: min(400px, root.rows-h + 8px);
    in property <length> pane-height: 0px;
    width: 22px; height: 22px;
    border-radius: Theme.radius-sm;
    background: places-ta.has-hover ? Theme.bg-hover : transparent;
    places-ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.opened();
            places-menu.show();
        }
    }
    Text {
        text: "\u{E2C7}"; // folder
        font-family: "Material Icons";
        color: Theme.text-secondary;
        font-size: Theme.fs-sm;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    places-menu := PopupWindow {
        x: 0px;
        y: root.pane-height > root.menu-h + 100px ? root.height + 2px : -(root.menu-h + 4px);
        width: 250px;
        height: root.menu-h;
        Rectangle {
            background: Theme.popup-bg;
            border-radius: Theme.radius-sm;
            border-width: 1px;
            border-color: Theme.border-strong;
            drop-shadow-blur: 12px;
            drop-shadow-color: #00000060;
            ScrollView {
                VerticalLayout {
                    padding: 4px;
                    spacing: 1px;
                    Text {
                        height: 22px;
                        text: @tr("Bookmarks");
                        color: Theme.text-muted;
                        font-size: Theme.fs-xs;
                        vertical-alignment: center;
                    }
                    if root.bookmarks.length == 0 : Text {
                        height: 26px;
                        text: @tr("None yet. Click ☆ to bookmark the current folder.");
                        color: Theme.text-muted;
                        font-size: Theme.fs-xs;
                        vertical-alignment: center;
                    }
                    for b in root.bookmarks : SftpPlaceRow {
                        path: b;
                        icon: "\u{E838}"; // star
                        current: b == root.current-path;
                        removable: true;
                        go => { root.navigate(b); }
                        remove => { root.remove-bookmark(b); }
                    }
                    Rectangle { height: 8px; }
                    Text {
                        height: 22px;
                        text: @tr("Recent");
                        color: Theme.text-muted;
                        font-size: Theme.fs-xs;
                        vertical-alignment: center;
                    }
                    if root.recent.length == 0 : Text {
                        height: 26px;
                        text: @tr("Folders you open will show up here.");
                        color: Theme.text-muted;
                        font-size: Theme.fs-xs;
                        vertical-alignment: center;
                    }
                    for r in root.recent : SftpPlaceRow {
                        path: r;
                        icon: "\u{E889}"; // history
                        current: r == root.current-path;
                        go => { root.navigate(r); }
                    }
                    if root.recent.length > 0 : SftpMenuItem {
                        label: @tr("Clear recent");
                        icon: "\u{E0B8}"; // clear_all
                        clicked => { root.clear-recent(); }
                    }
                    Rectangle { height: 8px; }
                    for place in root.quick-places : SftpPlaceRow {
                        label: place.label;
                        path: place.path;
                        icon: place.icon;
                        current: place.current;
                        go => { root.navigate(place.path); }
                    }
                    if root.quick-places.length > 0 && root.drive-places.length > 0 : Rectangle {
                        height: 8px;
                    }
                    for place in root.drive-places : SftpPlaceRow {
                        label: place.label;
                        path: place.path;
                        icon: place.icon;
                        current: place.current;
                        go => { root.navigate(place.path); }
                    }
                }
            }
        }
    }
}

// ---------------------------------------------------------------------------
// LocalPane — this machine's folders, the left half of the split view
// ---------------------------------------------------------------------------
//
// The right half keeps the regular remote listing, so the two panes can be
// compared side by side and files/folders copied either way with the buttons
// in each pane's header (or the row context menu). Browsing is entirely local:
// the folder is read on a Rust worker thread and the rows arrive through
// `local-entries`, exactly like the remote listing.
component LocalPane inherits Rectangle {
    in property <[SftpEntry]> entries;
    in property <string> path: "";
    in property <bool> loading: false;
    in property <string> status: "";
    in property <int> selected-count: 0;
    // Places dropdown data (#532), resolved by Rust for this machine.
    in property <[SftpLocalPlace]> quick-places;
    in property <[SftpLocalPlace]> drive-places;
    // Local bookmarks + recent folders, machine-wide (#532).
    in property <[string]> bookmarks;
    in property <[string]> recent;
    in property <bool> bookmarked: false;

    callback navigate(string);      // "..", "~" or a typed path
    callback up();
    callback home();
    callback refresh();
    callback places-refresh();      // re-read drives / user folders
    callback toggle-bookmark();
    callback remove-bookmark(string);
    callback clear-recent();
    callback open(string);          // double-click on a file
    callback toggle-select(int);
    callback select-range(int, int);
    callback copy-path(string);
    callback upload(string);        // upload this entry (file or whole folder)
    callback upload-selected();
    // Split-view drag & drop: the panel owns the gesture, this pane only
    // reports it (absolute cursor coordinates, so the panel can find the
    // opposite pane).
    callback drag-begin(int /*row*/, int /*item count*/, string /*label*/, length /*abs x*/, length /*abs y*/);
    callback drag-move(length /*abs x*/, length /*abs y*/);
    callback drag-end(length /*abs x*/, length /*abs y*/);
    callback drag-cancel();

    property <int> selected-row: -1;
    property <int> select-anchor: -1;
    property <bool> shift-click-pending: false;
    property <bool> drag-started: false;
    property <length> menu-x;
    property <length> menu-y;
    property <string> menu-target;
    property <bool> menu-target-is-dir;
    // Narrow halves drop the optional columns so the name stays readable.
    property <bool> show-size: root.width > 250px;
    property <bool> show-modified: root.width > 350px;

    background: Theme.bg-panel;
    clip: true;

    // Keep the editable path field in sync when navigation happens elsewhere
    // (up / home / double-click), mirroring the panel's own path bar.
    changed path => {
        path-input.text = root.path;
        root.selected-row = -1;
        root.select-anchor = -1;
    }

    VerticalLayout {
        spacing: 0;

        // --- Path bar: local path + up/home/refresh/upload ------------------
        Rectangle {
            height: 28px;
            background: Theme.bg-panel-alt;
            HorizontalLayout {
                padding-left: 6px;
                padding-right: 4px;
                spacing: 3px;
                Text {
                    width: 16px;
                    text: "\u{E30C}"; // computer
                    font-family: "Material Icons";
                    color: Theme.text-secondary;
                    font-size: Theme.fs-sm;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                Rectangle {
                    horizontal-stretch: 1;
                    height: 22px;
                    border-radius: Theme.radius-sm;
                    background: Theme.bg-root;
                    border-width: 1px;
                    border-color: path-input.has-focus ? Theme.accent : Theme.border-subtle;
                    path-input := TextInput {
                        x: 6px;
                        width: parent.width - 12px;
                        height: parent.height;
                        text: root.path;
                        color: Theme.text-primary;
                        font-family: Theme.ui-font-family;
                        font-size: Theme.fs-sm;
                        vertical-alignment: center;
                        single-line: true;
                        accepted => { root.navigate(self.text); }
                    }
                }
                // Bookmark the folder being shown; hidden when the pane is too
                // narrow to spare the room (the path field would collapse).
                if root.width > 260px : SftpStarButton {
                    bookmarked: root.bookmarked;
                    toggled => { root.toggle-bookmark(); }
                }
                Rectangle {
                    width: 22px; height: 22px;
                    border-radius: Theme.radius-sm;
                    background: up-ta.has-hover ? Theme.bg-hover : transparent;
                    up-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.up(); }
                    }
                    Text { text: "↑"; color: Theme.text-secondary; font-size: Theme.fs-md;
                           horizontal-alignment: center; vertical-alignment: center; }
                }
                // Places: bookmarks, recent folders, user folders and drives
                // (#532), replacing the plain "home" button.
                LocalPlacesButton {
                    quick-places: root.quick-places;
                    drive-places: root.drive-places;
                    bookmarks: root.bookmarks;
                    recent: root.recent;
                    current-path: root.path;
                    pane-height: root.height;
                    opened => { root.places-refresh(); }
                    navigate(path) => { root.navigate(path); }
                    remove-bookmark(path) => { root.remove-bookmark(path); }
                    clear-recent() => { root.clear-recent(); }
                }
                Rectangle {
                    width: 22px; height: 22px;
                    border-radius: Theme.radius-sm;
                    background: ref-ta.has-hover ? Theme.bg-hover : transparent;
                    ref-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.refresh(); }
                    }
                    Text { text: "\u{E5D5}"; // refresh
                           font-family: "Material Icons";
                           color: Theme.text-secondary; font-size: Theme.fs-sm;
                           horizontal-alignment: center; vertical-alignment: center; }
                }
                // Upload: the checked rows, or the clicked row when nothing is checked.
                Rectangle {
                    width: root.width > 300px ? 66px : 24px;
                    height: 22px;
                    border-radius: Theme.radius-sm;
                    background: ul-ta.has-hover ? Theme.accent-hover : Theme.accent;
                    ul-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            if (root.selected-count > 0) {
                                root.upload-selected();
                            } else if (root.selected-row >= 0 && root.selected-row < root.entries.length) {
                                root.upload(root.entries[root.selected-row].full-path);
                            }
                        }
                    }
                    Text {
                        text: root.width > 300px ? @tr("Upload") : "\u{E2C6}"; // file_upload
                        font-family: root.width > 300px ? Theme.ui-font-family : "Material Icons";
                        color: #ffffff;
                        font-size: Theme.fs-sm;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
        Rectangle { height: 1px; background: Theme.border-subtle; }

        // --- Column headers -------------------------------------------------
        Rectangle {
            height: 20px;
            background: Theme.bg-root;
            HorizontalLayout {
                padding-left: 8px; padding-right: 8px; spacing: 8px;
                Rectangle { width: 16px; }
                Text {
                    text: @tr("Name");
                    color: Theme.text-muted; font-size: Theme.fs-xs;
                    horizontal-stretch: 1; min-width: 90px;
                    horizontal-alignment: left; vertical-alignment: center;
                }
                if root.show-size : Text {
                    text: @tr("Size");
                    color: Theme.text-muted; font-size: Theme.fs-xs;
                    width: 64px; horizontal-alignment: right; vertical-alignment: center;
                }
                if root.show-modified : Text {
                    text: @tr("Modified");
                    color: Theme.text-muted; font-size: Theme.fs-xs;
                    width: 104px; horizontal-alignment: right; vertical-alignment: center;
                }
            }
        }
        Rectangle { height: 1px; background: Theme.border-subtle; }

        // --- Rows -----------------------------------------------------------
        file-area := Rectangle {
            vertical-stretch: 1;
            clip: true;
            ScrollView {
                width: parent.width;
                height: parent.height;
                content-width: self.visible-width;
                content-height: max(self.visible-height, local-list.preferred-height);

                local-list := VerticalLayout {
                    spacing: 0;

                    if root.loading : Rectangle {
                        height: 36px;
                        Text { text: @tr("Loading..."); color: Theme.text-muted; font-size: Theme.fs-sm;
                               horizontal-alignment: center; vertical-alignment: center; }
                    }
                    if !root.loading && root.entries.length == 0 : Rectangle {
                        height: 36px;
                        Text { text: @tr("Empty directory"); color: Theme.text-muted; font-size: Theme.fs-sm;
                               horizontal-alignment: center; vertical-alignment: center; }
                    }

                    for entry[i] in root.entries : Rectangle {
                        height: 24px;
                        background: entry.selected
                            ? #4a90e235
                            : (i == root.selected-row
                                ? #4a90e240
                                : (row-ta.has-hover ? #4a90e225
                                   : (mod(i, 2) == 0 ? transparent : #ffffff08)));

                        row-ta := TouchArea {
                            mouse-cursor: pointer;
                            // Drag a row onto the remote half to upload it (the
                            // whole checked set when the row is one of several
                            // checked items, like a file manager).
                            moved => {
                                if (self.pressed && !root.drag-started
                                        && (abs(self.mouse-x - self.pressed-x) > 6px
                                            || abs(self.mouse-y - self.pressed-y) > 6px)) {
                                    root.drag-started = true;
                                    root.drag-begin(
                                        i,
                                        entry.selected && root.selected-count > 1 ? root.selected-count : 1,
                                        entry.selected && root.selected-count > 1 ? @tr("Selected items") : entry.name,
                                        self.absolute-position.x + self.mouse-x,
                                        self.absolute-position.y + self.mouse-y);
                                } else if (root.drag-started) {
                                    root.drag-move(self.absolute-position.x + self.mouse-x,
                                                   self.absolute-position.y + self.mouse-y);
                                }
                            }
                            clicked => {
                                root.selected-row = i;
                                if (root.shift-click-pending) {
                                    root.shift-click-pending = false;
                                } else {
                                    root.select-anchor = i;
                                }
                            }
                            double-clicked => {
                                if (entry.is-dir) {
                                    root.navigate(entry.full-path);
                                } else {
                                    root.open(entry.full-path);
                                }
                            }
                            pointer-event(ev) => {
                                if (ev.kind == PointerEventKind.up) {
                                    if (root.drag-started) {
                                        root.drag-end(self.absolute-position.x + self.mouse-x,
                                                      self.absolute-position.y + self.mouse-y);
                                    }
                                    root.drag-started = false;
                                } else if (ev.kind == PointerEventKind.cancel) {
                                    if (root.drag-started) {
                                        root.drag-cancel();
                                    }
                                    root.drag-started = false;
                                } else if (ev.kind == PointerEventKind.down) {
                                    root.drag-started = false;
                                }
                                if (ev.kind == PointerEventKind.down
                                        && ev.button == PointerEventButton.left
                                        && ev.modifiers.shift) {
                                    root.shift-click-pending = true;
                                    root.select-range(root.select-anchor < 0 ? i : root.select-anchor, i);
                                    if (root.select-anchor < 0) { root.select-anchor = i; }
                                }
                                if (ev.kind == PointerEventKind.down
                                        && ev.button == PointerEventButton.right) {
                                    root.selected-row = i;
                                    root.menu-target = entry.full-path;
                                    root.menu-target-is-dir = entry.is-dir;
                                    root.menu-x = self.absolute-position.x + self.mouse-x - file-area.absolute-position.x;
                                    root.menu-y = self.absolute-position.y + self.mouse-y - file-area.absolute-position.y;
                                    local-menu.show();
                                }
                            }
                        }

                        HorizontalLayout {
                            padding-left: 8px; padding-right: 8px; spacing: 8px;
                            // Multi-select checkbox: batch uploads.
                            Rectangle {
                                width: 16px;
                                y: (parent.height - self.height) / 2;
                                height: 16px;
                                border-radius: 3px;
                                border-width: 1px;
                                border-color: entry.selected ? Theme.accent : Theme.border-strong;
                                background: entry.selected ? Theme.accent : transparent;
                                cb-ta := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        if (root.shift-click-pending) {
                                            root.shift-click-pending = false;
                                        } else {
                                            root.toggle-select(i);
                                            root.select-anchor = i;
                                        }
                                    }
                                    pointer-event(ev) => {
                                        if (ev.kind == PointerEventKind.down
                                                && ev.button == PointerEventButton.left
                                                && ev.modifiers.shift) {
                                            root.shift-click-pending = true;
                                            root.select-range(root.select-anchor < 0 ? i : root.select-anchor, i);
                                            if (root.select-anchor < 0) { root.select-anchor = i; }
                                        }
                                    }
                                }
                                if entry.selected : Text {
                                    text: "\u{E5CA}"; // check
                                    font-family: "Material Icons";
                                    color: #ffffff;
                                    font-size: 13px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    width: parent.width; height: parent.height;
                                }
                            }

                            HorizontalLayout {
                                horizontal-stretch: 1;
                                min-width: 90px;
                                spacing: 4px;
                                Text {
                                    text: entry.is-dir ? "\u{E2C7}" : "\u{E24D}";
                                    font-family: "Material Icons";
                                    color: entry.is-dir ? Theme.accent : Theme.text-secondary;
                                    font-size: Theme.fs-sm;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: entry.name;
                                    color: entry.is-dir ? Theme.accent : Theme.text-primary;
                                    font-size: Theme.fs-sm;
                                    horizontal-stretch: 1;
                                    overflow: elide;
                                    vertical-alignment: center;
                                }
                            }
                            if root.show-size : Text {
                                text: entry.is-dir ? "" : entry.size;
                                color: Theme.text-secondary; font-size: Theme.fs-xs;
                                width: 64px; horizontal-alignment: right; vertical-alignment: center;
                            }
                            if root.show-modified : Text {
                                text: entry.modified;
                                color: Theme.text-muted; font-size: Theme.fs-xs;
                                width: 104px; horizontal-alignment: right; vertical-alignment: center;
                            }
                        }
                    }

                    // Whitespace below the rows: right-click clears the target.
                    Rectangle {
                        vertical-stretch: 1;
                        min-height: 24px;
                        ws-ta := TouchArea {
                            pointer-event(ev) => {
                                if (ev.kind == PointerEventKind.down
                                        && ev.button == PointerEventButton.right) {
                                    root.selected-row = -1;
                                    root.menu-target = "";
                                    root.menu-x = self.absolute-position.x + self.mouse-x - file-area.absolute-position.x;
                                    root.menu-y = self.absolute-position.y + self.mouse-y - file-area.absolute-position.y;
                                    local-menu.show();
                                }
                            }
                        }
                    }
                }
            }

            local-menu := PopupWindow {
                x: root.menu-x;
                y: root.menu-y;
                width: 168px;
                height: 5 * 27px + 14px;
                Rectangle {
                    background: Theme.popup-bg;
                    border-radius: Theme.radius-sm;
                    border-width: 1px;
                    border-color: Theme.border-strong;
                    drop-shadow-blur: 12px;
                    drop-shadow-color: #00000060;
                    VerticalLayout {
                        padding: 4px;
                        spacing: 1px;
                        SftpMenuItem {
                            label: @tr("Upload to server");
                            enabled: root.menu-target != "";
                            clicked => { root.upload(root.menu-target); }
                        }
                        SftpMenuItem {
                            label: @tr("Upload checked items");
                            enabled: root.selected-count > 0;
                            clicked => { root.upload-selected(); }
                        }
                        SftpMenuItem {
                            label: @tr("Open");
                            enabled: root.menu-target != "" && !root.menu-target-is-dir;
                            clicked => { root.open(root.menu-target); }
                        }
                        SftpMenuItem {
                            label: @tr("Copy path");
                            enabled: root.menu-target != "";
                            clicked => { root.copy-path(root.menu-target); }
                        }
                        Rectangle { height: 1px; background: Theme.border-subtle; }
                        SftpMenuItem {
                            label: @tr("Refresh");
                            clicked => { root.refresh(); }
                        }
                    }
                }
            }
        }

        // --- Status line: only for errors / truncation notices --------------
        if root.status != "" : Rectangle {
            height: 18px;
            background: Theme.bg-panel-alt;
            Text {
                x: 6px;
                width: parent.width - 12px;
                height: parent.height;
                text: root.status;
                color: Theme.text-muted;
                font-size: Theme.fs-xs;
                vertical-alignment: center;
                overflow: elide;
            }
        }
    }
}

// ---------------------------------------------------------------------------
// SftpPanel — left directory tree + right file listing
// ---------------------------------------------------------------------------

export component SftpPanel inherits Rectangle {
    // --- Properties --------------------------------------------------------
    in property <string>  current-path: "/";
    in property <[SftpEntry]>    entries;
    in property <string>  status: @tr("SFTP not connected");
    in property <bool>    loading: false;
    in property <[SftpTreeNode]> tree-nodes: [];
    in property <string> current-tab-id;
    in property <[TabInfo]> transfer-targets: [];
    in property <string> sort-key: "";
    in property <int> sort-dir: 0; // 0 default / 1 asc / -1 desc
    in property <bool> show-type: true;
    in property <bool> show-size: true;
    in property <bool> show-modified: true;
    in property <bool> show-permissions: true;
    in property <bool> show-owner: true;
    in property <bool> show-group: true;
    callback toggle-column(string);
    in property <[TunnelInfo]> tunnels: [];
    in property <bool> collapsed: false;   // when true only the toolbar shows
    in property <bool> show-tree: true;    // hide the directory tree when narrow (#dock)
    in property <bool> compact: false;     // side-docked + collapsed → render nothing but a clean strip (#dock)
    // Split view (dual pane): a local-folder browser replaces the directory tree
    // on the left, the remote listing stays on the right, and each pane can copy
    // into the other. The remote path bar and its buttons keep working as before,
    // so the toolbar always describes the *remote* side.
    in property <bool> dual: false;
    in property <[SftpEntry]> local-entries;
    in property <string> local-path: "";
    in property <string> local-status: "";
    in property <bool> local-loading: false;
    in property <int> local-selected-count: 0;
    in property <[SftpLocalPlace]> local-quick-places;
    in property <[SftpLocalPlace]> local-drive-places;
    in property <[string]> local-bookmarks;
    in property <[string]> local-recent;
    in property <bool> local-bookmarked: false;
    // 0 = split the panel in the middle (the default); dragging the divider
    // stores an explicit width, reported back through `persist-local-pane-width`
    // so Rust can hit-test drops on the local half with the same geometry.
    in property <length> local-pane-default: 0px;
    in-out property <length> local-pane-width: 0px;
    // Persisted share of the panel (0 = even). Used when no width has been
    // dragged in this session, so the split survives a restart (#532).
    in property <float> local-split-ratio: 0.0;
    callback persist-local-pane-width(length);
    callback persist-local-split-ratio(float);
    init => { root.local-pane-width = root.local-pane-default; }
    property <bool> local-resizing: false;
    // Effective local extent: the dragged width, else the saved ratio, else
    // half the panel. The remote half always keeps ~200px so its Name column
    // and buttons stay usable in a narrow dock.
    property <length> local-w: clamp(
        root.local-pane-width > 0px
            ? root.local-pane-width
            : (root.local-split-ratio > 0.0 ? root.width * root.local-split-ratio : root.width / 2),
        160px,
        max(160px, root.width - 200px));
    // Tree is only meaningful in the classic view.
    property <bool> tree-shown: root.show-tree && !root.dual;
    // Responsive columns: Name always keeps `name-min` so filenames stay readable.
    // Optional columns fill whatever is left in priority order (high → low):
    // Permissions → Type → Size → Modified → Owner → Group. The first *enabled*
    // column that no longer fits is hidden, together with every lower-priority
    // column — never the Name. Layout cost: chrome (checkbox + paddings + gap)
    // 40px; each extra column costs its width plus 8px inter-column spacing.
    in-out property <length> tree-width: 160px;
    callback persist-tree-width(length);
    property <bool> tree-resizing: false;
    property <length> list-w: root.tree-shown
        ? root.width - root.tree-width - 5px
        : (root.dual ? root.width - root.local-w - 5px : root.width);
    property <length> name-min: 180px;     // guaranteed Name column width
    property <length> chrome-w: 40px;      // checkbox + paddings + gap into Name
    property <length> extras-w: max(0px, root.list-w - root.chrome-w - root.name-min);
    // Per-column layout cost = visual width + 8px spacing.
    property <length> cost-permissions: 112px;
    property <length> cost-type: 108px;
    property <length> cost-size: 80px;
    property <length> cost-modified: 124px;
    property <length> cost-owner: 92px;
    property <length> cost-group: 92px;
    // Columns claim the space in on-screen order, so a narrow list drops them
    // from the right. Permissions and Type used to be fitted first, which hid
    // Size and Modified in an ordinary-width panel (#531).
    property <bool> fit-size: !root.show-size || root.extras-w >= root.cost-size;
    property <bool> show-size-col: root.show-size && root.fit-size;
    property <length> used-1: root.show-size-col ? root.cost-size : 0px;
    property <bool> fit-modified: root.fit-size && (!root.show-modified || root.extras-w - root.used-1 >= root.cost-modified);
    property <bool> show-modified-col: root.show-modified && root.fit-modified;
    property <length> used-2: root.used-1 + (root.show-modified-col ? root.cost-modified : 0px);
    property <bool> fit-type: root.fit-modified && (!root.show-type || root.extras-w - root.used-2 >= root.cost-type);
    property <bool> show-type-col: root.show-type && root.fit-type;
    property <length> used-3: root.used-2 + (root.show-type-col ? root.cost-type : 0px);
    property <bool> fit-permissions: root.fit-type && (!root.show-permissions || root.extras-w - root.used-3 >= root.cost-permissions);
    property <bool> show-permissions-col: root.show-permissions && root.fit-permissions;
    property <length> used-4: root.used-3 + (root.show-permissions-col ? root.cost-permissions : 0px);
    property <bool> fit-owner: root.fit-permissions && (!root.show-owner || root.extras-w - root.used-4 >= root.cost-owner);
    property <bool> show-owner-col: root.show-owner && root.fit-owner;
    property <length> used-5: root.used-4 + (root.show-owner-col ? root.cost-owner : 0px);
    property <bool> fit-group: root.fit-owner && (!root.show-group || root.extras-w - root.used-5 >= root.cost-group);
    property <bool> show-group-col: root.show-group && root.fit-group;
    property <int> selected-row: -1;       // clicked/highlighted file-list row (#70)
    in property <int> selected-count;      // number of checked entries (#100)
    // Shift+click range selection: the anchor is the last row plainly clicked
    // or toggled; a Shift+click checks every row from the anchor to the
    // clicked one. `shift-click-pending` lets the `clicked` handler skip its
    // normal action when `pointer-event` already handled a Shift+press.
    property <int> select-anchor: -1;
    property <bool> shift-click-pending: false;
    // One native drag per press (#504); reset on the next press/release.
    property <bool> drag-out-started: false;
    // Panel-level right-click context menu (#84). One menu for the whole list:
    // an empty `menu-target` means the click landed on whitespace, which greys
    // out the item-specific actions (download/rename/…) but keeps new/refresh.
    property <length> menu-x;
    property <length> menu-y;
    property <string> menu-target;          // "" = whitespace
    property <string> menu-target-name;
    property <bool>   menu-target-is-dir;
    property <int>    menu-target-mode;     // permission bits for the chmod dialog
    // The right-clicked row is one of several checked rows: Delete then acts
    // on the whole selection, as in a file manager (#531).
    property <bool>   menu-on-selection: false;
    property <string> panel-mode: "files";
    property <string> tunnel-kind: "local";
    property <string> tunnel-name: "";
    property <string> tunnel-bind: "127.0.0.1";
    property <string> tunnel-bind-port: "1080";
    property <string> tunnel-host: "127.0.0.1";
    property <string> tunnel-host-port: "80";
    property <bool> tunnel-save: false;
    property <bool> tunnel-auto-start: true;
    // The full toolbar needs roughly 560px once a useful path field, the
    // Files/Tunnels tabs and the Split view toggle are included. Below that,
    // switch deliberately to a two-row compact layout instead of allowing
    // fixed-size controls to squeeze the path and each other (#285). When the
    // directory tree is visible (panel docked top/bottom), the toolbar still
    // spans the full panel width — but the *content* area below is narrower by
    // the tree extent. Raise the narrow threshold so the toolbar adapts before
    // buttons get clipped at the right edge (#433).
    property <bool> narrow-toolbar: root.width < (560px + (root.tree-shown ? root.tree-width + 5px : 0px));

    property <length> column-menu-x: 8px;
    property <length> column-menu-y: 22px;

    // --- Callbacks ---------------------------------------------------------
    callback toggle-collapsed();    // minimise / restore the panel
    callback navigate(string);
    callback download(string);
    // Double-click on a file (#493): open it in the built-in editor when it
    // is text, otherwise download it.
    callback open-file(string);
    callback upload-clicked(string /* remote dir */, bool /* folder */);
    callback refresh(string);
    callback tree-expand(string);   // toggle expand/collapse + navigate
    callback delete(string);        // remove a remote file/dir
    callback toggle-select(int);    // toggle a row's multi-select checkbox (#100)
    callback select-range(int /* from */, int /* to */); // Shift+click: check exactly rows from..to
    // Path bookmarks + recent folders for this session (#500).
    in property <[string]> bookmarks;
    in property <[string]> recent;
    in property <bool> bookmarked;      // current-path is bookmarked
    callback toggle-bookmark(string);
    callback remove-bookmark(string);
    callback clear-recent();
    callback places-refresh();
    // Row `i` was dragged out of the list (#504): Rust starts the OS drag
    // with that row, or with every checked row when it is one of them.
    callback drag-out(int);
    callback download-selected();   // download all checked entries (#100)
    callback delete-selected();     // delete all checked entries (#100)
    callback copy-to-target(string /* path */, string /* target tab */);
    callback copy-selected-to-target(string /* target tab */);
    callback view(string);          // open read-only in the built-in viewer
    callback edit(string);          // open writable in the built-in editor
    callback open-external(string);     // open with the OS default app (#81)
    callback edit-external(string);     // open externally + watch/re-upload (#81)
    callback sort-request(string /* name|size|modified */);
    callback clear-sort();
    callback tunnel-add(string /* name */, string /* kind */, string /* bind */, string /* bind-port */, string /* host */, string /* host-port */, bool /* save */, bool /* auto-start */);
    callback tunnel-stop(string /* id */);
    callback tunnel-start(string /* id */);
    callback tunnel-delete(string /* id */);
    // Context-menu extensions (#69). The *-request callbacks open dialogs in
    // the app shell; copy-path goes straight to the system clipboard.
    callback rename-request(string /* path */, string /* current name */);
    callback chmod-request(string /* path */, string /* name */, int /* mode */);
    callback copy-path(string);
    callback new-folder(string /* parent dir */);
    callback new-file(string /* parent dir */);
    // Upload the files / folders on the OS clipboard into `dir` (#508).
    callback paste-upload(string /* remote dir */);
    // The keymap (src/app/shortcuts.rs): which app action a key is, "" if none.
    callback match-shortcut(string, bool, bool, bool, bool) -> string;
    // A key the file list does not handle, for the terminal (focus moves back).
    callback forward-key(string, bool /* ctrl */, bool /* alt */, bool /* shift */);
    // Split view: local pane + two-way transfers (the panel forwards these to
    // the app shell, which owns the local filesystem side).
    callback toggle-dual();
    callback local-navigate(string /* path */);
    callback local-up();
    callback local-home();
    callback local-refresh();
    callback local-places-refresh();
    callback local-toggle-bookmark();
    callback local-remove-bookmark(string /* path */);
    callback local-clear-recent();
    callback local-open(string /* local path */);
    callback local-toggle-select(int /* row */);
    callback local-select-range(int /* from */, int /* to */);
    callback local-copy-path(string /* local path */);
    callback local-upload(string /* local path */);
    callback local-upload-selected();
    // Remote → the local folder shown in the left pane.
    callback download-to-local(string /* remote path */);
    callback download-selected-to-local();

    // --- Split-view drag & drop -------------------------------------------
    // Dragging a row onto the other half moves the file(s) there: local →
    // remote uploads into the remote folder, remote → local downloads into the
    // local folder. A row that belongs to a multi-item check drags the whole
    // checked set, like a file manager. A remote row dragged outside the panel
    // still falls back to the OS drag-out (#504).
    //
    // Cursor geometry (both the drag ghost and the highlighted drop pane) is
    // computed in the event handlers and stored: bindings must not peek at
    // `absolute-position`, which would recurse while the layout is running.
    property <bool> drag-active: false;
    property <string> drag-from: "";     // "local" | "remote"
    property <int> drag-row: -1;
    property <int> drag-count: 1;
    property <string> drag-label: "";
    property <length> drag-x;
    property <length> drag-y;
    property <bool> drop-local: false;
    property <bool> drop-remote: false;
    property <length> drop-x;
    property <length> drop-y;
    property <length> drop-w;
    property <length> drop-h;
    // Top of the panel's content area (below the toolbar): the drag hit test
    // and the drop highlight both start here. Mirrors the toolbar height in the
    // layout below.
    property <length> content-top: root.narrow-toolbar && root.panel-mode == "files" ? 62px : 34px;

    public function begin-drag(from: string, row: int, count: int, label: string,
                               ax: length, ay: length) {
        root.drag-from = from;
        root.drag-row = row;
        root.drag-count = count;
        root.drag-label = label;
        root.drag-active = true;
        root.update-drag(ax, ay);
    }

    // Absolute cursor → panel-local ghost position + which pane is under it.
    // The local half starts at the panel's left edge and is `local-w` wide; the
    // remote half is everything right of the 5px divider. Only the panel's own
    // geometry is read (no element ids), so this stays out of the layout pass.
    public function update-drag(ax: length, ay: length) {
        if (!root.drag-active) { return; }
        root.drag-x = ax - root.absolute-position.x;
        root.drag-y = ay - root.absolute-position.y;
        let top = root.content-top;
        let bottom = max(top, root.height - 18px);
        root.drop-local = root.drag-from == "remote"
            && root.drag-x >= 0px && root.drag-x <= root.local-w
            && root.drag-y >= top && root.drag-y <= bottom;
        root.drop-remote = root.drag-from == "local"
            && root.drag-x >= root.local-w + 5px && root.drag-x <= root.width
            && root.drag-y >= top && root.drag-y <= bottom;
        root.drop-x = root.drop-local ? 0px : root.local-w + 5px;
        root.drop-y = top;
        root.drop-w = root.drop-local ? root.local-w : max(0px, root.width - root.local-w - 5px);
        root.drop-h = max(0px, root.height - top - 18px);
    }

    public function end-drag(ax: length, ay: length) {
        if (!root.drag-active) { return; }
        root.update-drag(ax, ay);
        if (root.drag-from == "local" && root.drop-remote) {
            if (root.drag-count > 1) {
                root.local-upload-selected();
            } else if (root.drag-row >= 0 && root.drag-row < root.local-entries.length) {
                root.local-upload(root.local-entries[root.drag-row].full-path);
            }
        } else if (root.drag-from == "remote" && root.drop-local) {
            if (root.drag-count > 1) {
                root.download-selected-to-local();
            } else if (root.drag-row >= 0 && root.drag-row < root.entries.length) {
                root.download-to-local(root.entries[root.drag-row].full-path);
            }
        }
        root.cancel-drag();
    }

    public function cancel-drag() {
        root.drag-active = false;
        root.drag-from = "";
        root.drag-row = -1;
        root.drag-count = 1;
        root.drag-label = "";
        root.drop-local = false;
        root.drop-remote = false;
    }

    // Drag-to-dock: empty areas of the panel are a grab handle; coordinates are
    // reported in window space so the parent can compute the target edge (#dock).
    callback dock-drag-move(length /* abs-x */, length /* abs-y */);
    callback dock-drag-end();

    // -----------------------------------------------------------------------
    background: Theme.bg-panel;
    clip: true;

    // Keep the editable path bar in sync when the directory changes elsewhere
    // (tree click, file double-click, terminal cd) (#54).
    changed current-path => {
        path-input.text = root.current-path;
        compact-path-input.text = root.current-path;
        root.selected-row = -1;
        root.select-anchor = -1;
    }

    // Drag empty space to re-dock; interactive widgets (file list, tree, toolbar
    // buttons) sit in front and capture their own events (#dock). Move cursor
    // only while dragging; hovering empty space keeps the arrow (#360).
    dock-bg := TouchArea {
        mouse-cursor: self.pressed ? move : default;
        moved => {
            if (self.pressed) {
                root.dock-drag-move(self.absolute-position.x + self.mouse-x,
                                    self.absolute-position.y + self.mouse-y);
            }
        }
        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.up) { root.dock-drag-end(); }
            // Grab taken away (popup, deactivation): end the gesture
            // anyway so no dock preview is stranded.
            else if (ev.kind == PointerEventKind.cancel) { root.dock-drag-end(); }
        }
    }

    // Hidden entirely when side-docked + collapsed: the horizontal toolbar would
    // otherwise squish into an unusable vertical strip. `visible` (not `if`) so
    // ids like path-input stay accessible to handlers. The parent floats a clean
    // expand button over this (#dock).
    VerticalLayout {
        visible: !root.compact;
        spacing: 0;

        // --- Toolbar (full width) ------------------------------------------
        Rectangle {
            height: root.narrow-toolbar && root.panel-mode == "files" ? 62px : 34px;
            background: Theme.bg-panel-alt;

            VerticalLayout {
                spacing: 6px;

                HorizontalLayout {
                height: 34px;
                // Pushed the left padding from 6px to 10px so the dock drag grip
                // sits a bit further from the panel edge and the Files tab no longer
                // feels crowded against it (#toolbar-shadow-overlap).
                padding-left: 10px;
                padding-right: 6px;
                padding-top: 6px;
                padding-bottom: 6px;
                spacing: 4px;

                // Dedicated drag handle to re-dock the panel. The toolbar is full
                // of controls, so dragging "empty space" is unreliable; this grip
                // is always grabbable and reports window-space coords (#dock).
                Rectangle {
                    width: 16px;
                    y: (parent.height - self.height) / 2;
                    height: 22px;
                    grip-ta := TouchArea {
                        mouse-cursor: move;
                        moved => {
                            if (self.pressed) {
                                root.dock-drag-move(self.absolute-position.x + self.mouse-x,
                                                    self.absolute-position.y + self.mouse-y);
                            }
                        }
                        pointer-event(ev) => {
                            if (ev.kind == PointerEventKind.up) { root.dock-drag-end(); }
                            // Grab taken away (popup, deactivation): end the
                            // gesture anyway so no dock preview is stranded.
                            else if (ev.kind == PointerEventKind.cancel) { root.dock-drag-end(); }
                        }
                    }
                    Text {
                        text: "\u{E945}";   // drag_indicator
                        font-family: "Material Icons";
                        color: grip-ta.has-hover ? Theme.text-secondary : Theme.text-muted;
                        font-size: 16px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: parent.width;
                        height: parent.height;
                    }
                }

                // Small transparent spacer between the dock drag grip and the Files
                // tab. Without it the grip's hover state visually bleeds into the
                // tab's background, making the two look like a single overlapping
                // shape (#toolbar-shadow-overlap).
                Rectangle {
                    width: 6px;
                    height: 22px;
                    background: transparent;
                }

                Rectangle {
                    width: root.narrow-toolbar ? 28px : 48px;
                    height: 22px;
                    border-radius: Theme.radius-sm;
                    background: root.panel-mode == "files" ? Theme.accent : (files-tab-ta.has-hover ? Theme.bg-hover : transparent);
                    files-tab-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.panel-mode = "files"; }
                    }
                    Text {
                        text: root.narrow-toolbar ? "\u{E2C7}" : @tr("Files");
                        font-family: root.narrow-toolbar ? "Material Icons" : Theme.ui-font-family;
                        color: root.panel-mode == "files" ? #ffffff : Theme.text-secondary;
                        font-size: Theme.fs-xs;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                Rectangle {
                    width: root.narrow-toolbar ? 28px : 58px;
                    height: 22px;
                    border-radius: Theme.radius-sm;
                    background: root.panel-mode == "tunnels" ? Theme.accent : (tunnels-tab-ta.has-hover ? Theme.bg-hover : transparent);
                    tunnels-tab-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.panel-mode = "tunnels"; }
                    }
                    Text {
                        text: root.narrow-toolbar ? "\u{E0B6}" : @tr("Tunnels");
                        font-family: root.narrow-toolbar ? "Material Icons" : Theme.ui-font-family;
                        color: root.panel-mode == "tunnels" ? #ffffff : Theme.text-secondary;
                        font-size: Theme.fs-xs;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                // Split view toggle: swaps the left directory tree for a local
                // folder browser so files can be pushed to / pulled from the
                // host side by side. Highlighted while the split view is on.
                Rectangle {
                    visible: root.panel-mode == "files";
                    width: root.width > 420px ? 76px : 24px;
                    height: 22px;
                    border-radius: Theme.radius-sm;
                    background: root.dual ? Theme.accent : (dual-ta.has-hover ? Theme.bg-hover : transparent);
                    dual-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.toggle-dual(); }
                    }
                    Text {
                        text: root.width > 420px ? @tr("Split view") : "\u{E8D2}";
                        font-family: root.width > 420px ? Theme.ui-font-family : "Material Icons";
                        color: root.dual ? #ffffff : Theme.text-secondary;
                        font-size: Theme.fs-xs;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                // In compact mode keep navigation tabs at the left and primary
                // actions aligned at the right. The path gets the full second row.
                if root.narrow-toolbar : Rectangle { horizontal-stretch: 1; }

                // Keep parent navigation discoverable in the narrow layout
                // instead of hiding this primary action in the overflow menu
                // (#322). It stays beside the other compact toolbar actions.
                if root.narrow-toolbar && !root.tree-shown && root.panel-mode == "files" : Rectangle {
                    width: 24px; height: 22px;
                    border-radius: Theme.radius-sm;
                    background: compact-up-ta.has-hover ? Theme.bg-hover : transparent;
                    compact-up-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.navigate(".."); }
                    }
                    Text { text: "↑"; color: Theme.text-secondary; font-size: Theme.fs-md;
                           horizontal-alignment: center; vertical-alignment: center; }
                }

                // Editable path bar: type or paste a path and press Enter to
                // jump there; copy / paste-jump buttons sit right after it (#54).
                Rectangle {
                    visible: root.panel-mode == "files" && !root.narrow-toolbar;
                    // Floor the path field at 100px so switching to Files mode
                    // (which reveals copy/paste/up/upload next to it) doesn't
                    // squeeze the input down to an unreadable strip in
                    // mid-width panels (~380–480px) (#toolbar-input-shrink).
                    min-width: 100px;
                    horizontal-stretch: 1;
                    height: 22px;
                    border-radius: Theme.radius-sm;
                    background: Theme.bg-root;
                    border-width: 1px;
                    border-color: path-input.has-focus ? Theme.accent : Theme.border-subtle;
                    path-input := TextInput {
                        x: 6px;
                        width: parent.width - 12px;
                        height: parent.height;
                        text: root.current-path;
                        color: Theme.text-primary;
                        // CJK-capable font so typed Chinese isn't tofu (#54).
                        font-family: Theme.ui-font-family;
                        font-size: Theme.fs-sm;
                        vertical-alignment: center;
                        single-line: true;
                        accepted => { root.navigate(self.text); }
                    }
                }

                // Bookmark the current folder / open bookmarks + recent (#500).
                SftpStarButton {
                    visible: root.panel-mode == "files" && !root.narrow-toolbar;
                    bookmarked: root.bookmarked;
                    toggled => { root.toggle-bookmark(root.current-path); }
                }
                SftpPlacesButton {
                    visible: root.panel-mode == "files" && !root.narrow-toolbar;
                    bookmarks: root.bookmarks;
                    recent: root.recent;
                    current-path: root.current-path;
                    opened => { root.places-refresh(); }
                    navigate(p) => { root.navigate(p); }
                    remove-bookmark(p) => { root.remove-bookmark(p); }
                    clear-recent => { root.clear-recent(); }
                }

                // Copy the current path to the clipboard.
                Rectangle {
                    visible: root.panel-mode == "files" && !root.narrow-toolbar;
                    width: 24px; height: 22px;
                    border-radius: Theme.radius-sm;
                    background: copy-ta.has-hover ? Theme.bg-hover : transparent;
                    copy-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            path-input.select-all();
                            path-input.copy();
                            path-input.clear-selection();
                        }
                    }
                    Text { text: "\u{E14D}"; font-family: "Material Icons";
                           color: Theme.text-secondary; font-size: Theme.fs-sm;
                           horizontal-alignment: center; vertical-alignment: center; }
                }

                // Paste a path from the clipboard and jump straight to it.
                Rectangle {
                    visible: root.panel-mode == "files" && !root.narrow-toolbar;
                    width: 24px; height: 22px;
                    border-radius: Theme.radius-sm;
                    background: pj-ta.has-hover ? Theme.bg-hover : transparent;
                    pj-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            path-input.select-all();
                            path-input.paste();
                            root.navigate(path-input.text);
                        }
                    }
                    Text { text: "\u{E14F}"; font-family: "Material Icons";
                           color: Theme.text-secondary; font-size: Theme.fs-sm;
                           horizontal-alignment: center; vertical-alignment: center; }
                }

                up-btn := Rectangle {
                    visible: root.panel-mode == "files" && !root.narrow-toolbar;
                    width: 24px; height: 22px;
                    border-radius: Theme.radius-sm;
                    background: up-ta.has-hover ? Theme.bg-hover : transparent;
                    up-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.navigate(".."); }
                    }
                    Text { text: "↑"; color: Theme.text-secondary; font-size: Theme.fs-md;
                           horizontal-alignment: center; vertical-alignment: center; }
                }

                // Upload: a small menu offers file vs folder (#85). The remote
                // SFTP upload handles both — only the local picker differs.
                ul-btn := Rectangle {
                    visible: root.panel-mode == "files";
                    width: root.narrow-toolbar ? 24px : 52px; height: 22px;
                    border-radius: Theme.radius-sm;
                    background: ul-ta.has-hover ? Theme.accent-hover : Theme.accent;
                    ul-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { ul-menu.show(); }
                    }
                    Text { text: root.narrow-toolbar ? "↑" : @tr("Upload"); color: #ffffff; font-size: Theme.fs-sm;
                           horizontal-alignment: center; vertical-alignment: center; }
                    ul-menu := PopupWindow {
                        x: 0; y: parent.height + 2px;
                        width: 124px;
                        height: 2 * 27px + 8px;
                        Rectangle {
                            background: Theme.popup-bg;
                            border-radius: Theme.radius-sm;
                            border-width: 1px;
                            border-color: Theme.border-strong;
                            drop-shadow-blur: 12px;
                            drop-shadow-color: #00000060;
                            VerticalLayout {
                                padding: 4px;
                                spacing: 1px;
                                SftpMenuItem {
                                    label: @tr("Upload file");
                                    clicked => { root.upload-clicked(root.current-path, false); }
                                }
                                SftpMenuItem {
                                    label: @tr("Upload folder");
                                    clicked => { root.upload-clicked(root.current-path, true); }
                                }
                            }
                        }
                    }
                }

                // Secondary path actions move into an overflow menu in compact
                // mode so they never compete with the path field for width.
                compact-more-btn := Rectangle {
                    visible: root.narrow-toolbar && !root.tree-shown && root.panel-mode == "files";
                    width: 24px;
                    height: 22px;
                    border-radius: Theme.radius-sm;
                    background: compact-more-ta.has-hover ? Theme.bg-hover : transparent;
                    compact-more-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { compact-more-menu.show(); }
                    }
                    Text {
                        text: "\u{E5D4}";
                        font-family: "Material Icons";
                        color: Theme.text-secondary;
                        font-size: Theme.fs-md;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    compact-more-menu := PopupWindow {
                        x: parent.width - self.width;
                        y: parent.height + 2px;
                        width: 142px;
                        height: 3 * 27px + 8px;
                        Rectangle {
                            background: Theme.popup-bg;
                            border-radius: Theme.radius-sm;
                            border-width: 1px;
                            border-color: Theme.border-strong;
                            drop-shadow-blur: 12px;
                            drop-shadow-color: #00000060;
                            VerticalLayout {
                                padding: 4px;
                                spacing: 1px;
                                SftpMenuItem {
                                    label: @tr("Copy path");
                                    clicked => {
                                        compact-path-input.select-all();
                                        compact-path-input.copy();
                                        compact-path-input.clear-selection();
                                    }
                                }
                                SftpMenuItem {
                                    label: @tr("Paste and go");
                                    clicked => {
                                        compact-path-input.select-all();
                                        compact-path-input.paste();
                                        root.navigate(compact-path-input.text);
                                    }
                                }
                                SftpMenuItem {
                                    label: @tr("Refresh");
                                    clicked => { root.refresh(root.current-path); }
                                }
                            }
                        }
                    }
                }

                // Batch actions on checked entries — only when something's checked (#100).
                if root.panel-mode == "files" && root.selected-count > 0 && !root.narrow-toolbar : HorizontalLayout {
                    spacing: 2px;
                    width: 34px;
                    Text {
                        text: "\u{E834}"; // check_box
                        font-family: "Material Icons";
                        color: Theme.accent;
                        font-size: Theme.fs-sm;
                        vertical-alignment: center;
                    }
                    Text {
                        text: root.selected-count;
                        color: Theme.accent;
                        font-size: Theme.fs-sm;
                        vertical-alignment: center;
                    }
                }
                if root.panel-mode == "files" && root.selected-count > 0 && !root.narrow-toolbar : Rectangle {
                    width: 24px; height: 22px;
                    border-radius: Theme.radius-sm;
                    background: dls-ta.has-hover ? Theme.bg-hover : transparent;
                    dls-ta := TouchArea { mouse-cursor: pointer; clicked => { root.download-selected(); } }
                    Text { text: "\u{E2C4}"; font-family: "Material Icons"; color: Theme.text-secondary;
                           font-size: Theme.fs-md; horizontal-alignment: center; vertical-alignment: center; }
                }
                if root.panel-mode == "files" && root.selected-count > 0 && !root.narrow-toolbar : Rectangle {
                    width: 24px; height: 22px;
                    border-radius: Theme.radius-sm;
                    background: dels-ta.has-hover ? Theme.danger.with-alpha(0.18) : transparent;
                    dels-ta := TouchArea { mouse-cursor: pointer; clicked => { root.delete-selected(); } }
                    Text { text: "\u{E872}"; font-family: "Material Icons"; color: Theme.danger;
                           font-size: Theme.fs-md; horizontal-alignment: center; vertical-alignment: center; }
                }

                Rectangle {
                    visible: root.panel-mode == "files" && !root.narrow-toolbar;
                    width: 24px; height: 22px;
                    border-radius: Theme.radius-sm;
                    background: ref-ta.has-hover ? Theme.bg-hover : transparent;
                    ref-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.refresh(root.current-path); }
                    }
                    Text { text: "\u{E5D5}"; font-family: "Material Icons";
                           color: Theme.text-secondary; font-size: Theme.fs-sm;
                           horizontal-alignment: center; vertical-alignment: center; }
                }

                // Minimise / restore the SFTP panel (#41).
                Rectangle {
                    width: 24px; height: 22px;
                    border-radius: Theme.radius-sm;
                    background: min-ta.has-hover ? Theme.bg-hover : transparent;
                    min-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.toggle-collapsed(); }
                    }
                    // expand_less (▲, restore) when collapsed, expand_more (▼) otherwise.
                    Text { text: root.collapsed ? "\u{E5CE}" : "\u{E5CF}"; font-family: "Material Icons";
                           color: Theme.text-secondary; font-size: Theme.fs-md;
                           horizontal-alignment: center; vertical-alignment: center; }
                }
                }

                // Preserve path navigation in the side-docked compact layout by
                // moving it to a real second layout row. The layout spacing keeps
                // a stable gutter regardless of first-row alignment/padding.
                HorizontalLayout {
                    visible: root.narrow-toolbar && !root.tree-shown && root.panel-mode == "files";
                    height: self.visible ? 22px : 0px;
                    padding-left: 6px;
                    padding-right: 6px;
                    Rectangle {
                        horizontal-stretch: 1;
                        height: 22px;
                        border-radius: Theme.radius-sm;
                        background: Theme.bg-root;
                        border-width: 1px;
                        border-color: compact-path-input.has-focus ? Theme.accent : Theme.border-subtle;
                        compact-path-input := TextInput {
                            x: 6px;
                            width: parent.width - 12px;
                            height: parent.height;
                            text: root.current-path;
                            color: Theme.text-primary;
                            font-family: Theme.ui-font-family;
                            font-size: Theme.fs-sm;
                            vertical-alignment: center;
                            single-line: true;
                            accepted => { root.navigate(self.text); }
                        }
                    }
                    SftpStarButton {
                        bookmarked: root.bookmarked;
                        toggled => { root.toggle-bookmark(root.current-path); }
                    }
                    SftpPlacesButton {
                        bookmarks: root.bookmarks;
                        recent: root.recent;
                        current-path: root.current-path;
                        opened => { root.places-refresh(); }
                        navigate(p) => { root.navigate(p); }
                        remove-bookmark(p) => { root.remove-bookmark(p); }
                        clear-recent => { root.clear-recent(); }
                    }
                }
            }
        }

        // --- Main area: tree (left) + file list (right) --------------------
        if root.panel-mode == "files" : HorizontalLayout {
            vertical-stretch: 1;
            spacing: 0;

            // ── Left: directory tree (hidden when the panel is narrow) ──────
            if root.tree-shown : VerticalLayout {
                width: root.tree-width;
                spacing: 0;

                // Tree header
                Rectangle {
                    height: 20px;
                    background: Theme.bg-root;
                    Text {
                        x: 8px;
                        text: @tr("Directory tree");
                        color: Theme.text-muted;
                        font-size: Theme.fs-xs;
                        vertical-alignment: center;
                        height: parent.height;
                    }
                }
                Rectangle { height: 1px; background: Theme.border-subtle; }

                // Tree list with scrollbar
                ScrollView {
                    vertical-stretch: 1;

                    tree-list := VerticalLayout {
                        spacing: 0;

                        for node[i] in root.tree-nodes : Rectangle {
                            height: 22px;
                            background: node-ta.has-hover
                                ? Theme.bg-hover
                                : (node.path == root.current-path
                                    ? #4a90e230
                                    : (mod(i, 2) == 0 ? transparent : #ffffff08));

                            node-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.tree-expand(node.path); }
                            }

                            HorizontalLayout {
                                spacing: 0;
                                padding-top: 1px;

                                // Depth indent spacer
                                Rectangle { width: node.depth * 12px; }

                                // Expand/collapse arrow
                                Text {
                                    width: 14px;
                                    text: node.has-children
                                        ? (node.expanded ? "▼" : "▶")
                                        : " ";
                                    color: Theme.text-muted;
                                    font-size: 9px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                // Folder name
                                Text {
                                    text: node.depth == 0 ? "/" : node.name;
                                    color: node.path == root.current-path
                                        ? Theme.accent
                                        : Theme.text-primary;
                                    font-size: Theme.fs-sm;
                                    horizontal-stretch: 1;
                                    overflow: elide;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
            }

            // Draggable directory-tree divider (#287).
            if root.tree-shown : Rectangle {
                width: 5px;
                background: tree-split.pressed ? Theme.accent : Theme.border-subtle;
                tree-split := TouchArea {
                    x: -3px;
                    width: parent.width + 6px;
                    mouse-cursor: ew-resize;
                    pointer-event(ev) => {
                        if (ev.kind == PointerEventKind.down) {
                            root.tree-resizing = true;
                        } else if (ev.kind == PointerEventKind.up) {
                            root.tree-resizing = false;
                            root.persist-tree-width(root.tree-width);
                        }
                    }
                    moved => {
                        if (root.tree-resizing) {
                            root.tree-width = clamp(
                                self.absolute-position.x + self.mouse-x - root.absolute-position.x,
                                120px, min(420px, root.width - 220px));
                        }
                    }
                }
            }

            // ── Left (split view): local folders, resizable ─────────────────
            if root.dual : LocalPane {
                width: root.local-w;
                entries: root.local-entries;
                path: root.local-path;
                loading: root.local-loading;
                status: root.local-status;
                selected-count: root.local-selected-count;
                quick-places: root.local-quick-places;
                drive-places: root.local-drive-places;
                bookmarks: root.local-bookmarks;
                recent: root.local-recent;
                bookmarked: root.local-bookmarked;
                navigate(path)        => { root.local-navigate(path); }
                up()                  => { root.local-up(); }
                home()                => { root.local-home(); }
                refresh()             => { root.local-refresh(); }
                places-refresh()      => { root.local-places-refresh(); }
                toggle-bookmark()     => { root.local-toggle-bookmark(); }
                remove-bookmark(path) => { root.local-remove-bookmark(path); }
                clear-recent()        => { root.local-clear-recent(); }
                open(path)            => { root.local-open(path); }
                toggle-select(i)      => { root.local-toggle-select(i); }
                select-range(a, b)    => { root.local-select-range(a, b); }
                copy-path(path)       => { root.local-copy-path(path); }
                upload(path)          => { root.local-upload(path); }
                upload-selected()     => { root.local-upload-selected(); }
                drag-begin(row, count, label, ax, ay) => {
                    root.begin-drag("local", row, count, label, ax, ay);
                }
                drag-move(ax, ay)     => { root.update-drag(ax, ay); }
                drag-end(ax, ay)      => { root.end-drag(ax, ay); }
                drag-cancel()         => { root.cancel-drag(); }
            }

            // Divider between the local and remote halves. Dragging moves it;
            // double-clicking puts it back in the middle.
            if root.dual : Rectangle {
                width: 5px;
                background: local-split.pressed ? Theme.accent : Theme.border-subtle;
                local-split := TouchArea {
                    x: -3px;
                    width: parent.width + 6px;
                    mouse-cursor: ew-resize;
                    pointer-event(ev) => {
                        if (ev.kind == PointerEventKind.down) {
                            root.local-resizing = true;
                        } else if (ev.kind == PointerEventKind.up) {
                            root.local-resizing = false;
                            root.persist-local-pane-width(root.local-pane-width);
                            root.persist-local-split-ratio(
                                root.width > 0px ? root.local-pane-width / root.width : 0.0);
                        }
                    }
                    moved => {
                        if (root.local-resizing) {
                            root.local-pane-width = clamp(
                                self.absolute-position.x + self.mouse-x - root.absolute-position.x,
                                160px, max(160px, root.width - 200px));
                        }
                    }
                    double-clicked => {
                        // Back to an even split.
                        root.local-pane-width = 0px;
                        root.persist-local-pane-width(0px);
                        root.persist-local-split-ratio(0.0);
                    }
                }
            }

            // ── Right: file listing ─────────────────────────────────────────
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 0;

                // Column headers
                column-header := Rectangle {
                    height: 20px;
                    background: Theme.bg-root;
                    HorizontalLayout {
                        padding-left: 8px; padding-right: 8px; spacing: 8px;
                        // Spacer matching the rows' checkbox so the header columns
                        // line up with the values below them (#dock).
                        Rectangle { width: 16px; }
                        Rectangle {
                            horizontal-stretch: 1;
                            min-width: root.name-min;
                            header-name-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.sort-request("name"); }
                                pointer-event(ev) => {
                                    if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.right) {
                                        root.column-menu-x = self.absolute-position.x + self.mouse-x - column-header.absolute-position.x;
                                        root.column-menu-y = self.absolute-position.y + self.mouse-y - column-header.absolute-position.y;
                                        column-menu.show();
                                    }
                                }
                            }
                            Text {
                                text: @tr("Name") + (root.sort-key == "name" ? (root.sort-dir > 0 ? " ↑" : " ↓") : "");
                                color: root.sort-key == "name" ? Theme.accent : Theme.text-muted;
                                font-size: Theme.fs-xs;
                                width: parent.width;
                                horizontal-alignment: left;
                                vertical-alignment: center;
                            }
                        }
                        if root.show-size-col : Rectangle {
                            width: 72px;
                            header-size-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.sort-request("size"); }
                                pointer-event(ev) => {
                                    if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.right) {
                                        root.column-menu-x = self.absolute-position.x + self.mouse-x - column-header.absolute-position.x;
                                        root.column-menu-y = self.absolute-position.y + self.mouse-y - column-header.absolute-position.y;
                                        column-menu.show();
                                    }
                                }
                            }
                            Text {
                                text: @tr("Size") + (root.sort-key == "size" ? (root.sort-dir > 0 ? " ↑" : " ↓") : "");
                                color: root.sort-key == "size" ? Theme.accent : Theme.text-muted;
                                font-size: Theme.fs-xs;
                                width: parent.width;
                                horizontal-alignment: right;
                                vertical-alignment: center;
                            }
                        }
                        if root.show-modified-col : Rectangle {
                            width: 116px;
                            header-modified-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.sort-request("modified"); }
                                pointer-event(ev) => {
                                    if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.right) {
                                        root.column-menu-x = self.absolute-position.x + self.mouse-x - column-header.absolute-position.x;
                                        root.column-menu-y = self.absolute-position.y + self.mouse-y - column-header.absolute-position.y;
                                        column-menu.show();
                                    }
                                }
                            }
                            Text {
                                text: @tr("Modified") + (root.sort-key == "modified" ? (root.sort-dir > 0 ? " ↑" : " ↓") : "");
                                color: root.sort-key == "modified" ? Theme.accent : Theme.text-muted;
                                font-size: Theme.fs-xs;
                                width: parent.width;
                                horizontal-alignment: right;
                                vertical-alignment: center;
                            }
                        }
                        if root.show-type-col : Rectangle {
                            width: 100px;
                            type-header-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.sort-request("type"); }
                                pointer-event(ev) => {
                                    if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.right) {
                                        root.column-menu-x = self.absolute-position.x + self.mouse-x - column-header.absolute-position.x;
                                        root.column-menu-y = self.absolute-position.y + self.mouse-y - column-header.absolute-position.y;
                                        column-menu.show();
                                    }
                                }
                            }
                            Text { text: @tr("Type") + (root.sort-key == "type" ? (root.sort-dir > 0 ? " ↑" : " ↓") : ""); color: root.sort-key == "type" ? Theme.accent : Theme.text-muted; font-size: Theme.fs-xs;
                                   width: parent.width; horizontal-alignment: right; vertical-alignment: center; }
                        }
                        if root.show-permissions-col : Rectangle {
                            width: 104px;
                            permissions-header-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.sort-request("permissions"); }
                                pointer-event(ev) => {
                                    if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.right) {
                                        root.column-menu-x = self.absolute-position.x + self.mouse-x - column-header.absolute-position.x;
                                        root.column-menu-y = self.absolute-position.y + self.mouse-y - column-header.absolute-position.y;
                                        column-menu.show();
                                    }
                                }
                            }
                            Text { text: @tr("Permissions") + (root.sort-key == "permissions" ? (root.sort-dir > 0 ? " ↑" : " ↓") : ""); color: root.sort-key == "permissions" ? Theme.accent : Theme.text-muted; font-size: Theme.fs-xs;
                                   width: parent.width; horizontal-alignment: right; vertical-alignment: center; }
                        }
                        if root.show-owner-col : Rectangle {
                            width: 84px;
                            owner-header-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.sort-request("owner"); }
                                pointer-event(ev) => {
                                    if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.right) {
                                        root.column-menu-x = self.absolute-position.x + self.mouse-x - column-header.absolute-position.x;
                                        root.column-menu-y = self.absolute-position.y + self.mouse-y - column-header.absolute-position.y;
                                        column-menu.show();
                                    }
                                }
                            }
                            Text { text: @tr("Owner") + (root.sort-key == "owner" ? (root.sort-dir > 0 ? " ↑" : " ↓") : ""); color: root.sort-key == "owner" ? Theme.accent : Theme.text-muted; font-size: Theme.fs-xs;
                                   width: parent.width; horizontal-alignment: right; vertical-alignment: center; }
                        }
                        if root.show-group-col : Rectangle {
                            width: 84px;
                            group-header-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.sort-request("group"); }
                                pointer-event(ev) => {
                                    if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.right) {
                                        column-menu.show();
                                    }
                                }
                            }
                            Text { text: @tr("Group") + (root.sort-key == "group" ? (root.sort-dir > 0 ? " ↑" : " ↓") : ""); color: root.sort-key == "group" ? Theme.accent : Theme.text-muted; font-size: Theme.fs-xs;
                                   width: parent.width; horizontal-alignment: right; vertical-alignment: center; }
                        }
                    }
                    column-menu := PopupWindow {
                        x: root.column-menu-x; y: root.column-menu-y;
                        width: 180px; height: 7 * 28px + 8px;
                        Rectangle {
                            background: Theme.popup-bg;
                            border-radius: Theme.radius-sm;
                            border-width: 1px;
                            border-color: Theme.border-strong;
                            drop-shadow-blur: 12px;
                            drop-shadow-color: #00000060;
                            VerticalLayout {
                                padding: 4px; spacing: 1px;
                                SftpMenuItem { icon: root.show-type ? "\u{E5CA}" : ""; label: @tr("Type"); clicked => { root.toggle-column("type"); } }
                                SftpMenuItem { icon: root.show-size ? "\u{E5CA}" : ""; label: @tr("Size"); clicked => { root.toggle-column("size"); } }
                                SftpMenuItem { icon: root.show-modified ? "\u{E5CA}" : ""; label: @tr("Modified"); clicked => { root.toggle-column("modified"); } }
                                SftpMenuItem { icon: root.show-permissions ? "\u{E5CA}" : ""; label: @tr("Permissions"); clicked => { root.toggle-column("permissions"); } }
                                SftpMenuItem { icon: root.show-owner ? "\u{E5CA}" : ""; label: @tr("Owner"); clicked => { root.toggle-column("owner"); } }
                                SftpMenuItem { icon: root.show-group ? "\u{E5CA}" : ""; label: @tr("Group"); clicked => { root.toggle-column("group"); } }
                                SftpMenuItem { icon: "\u{E5CA}"; label: @tr("Name"); enabled: false; }
                            }
                        }
                    }
                }
                Rectangle { height: 1px; background: Theme.border-subtle; }

                // File list. The area fills the panel height so right-click works
                // on the whitespace below the rows too (#84); the single menu
                // below greys out item actions when nothing was hit.
                file-area := Rectangle {
                    vertical-stretch: 1;
                    clip: true;
                    // Keyboard focus for the file list (#508): clicking a row or
                    // the whitespace focuses it, the paste chord uploads the
                    // clipboard's files, and every other key goes back to the
                    // terminal so no keystroke is lost. 0×0 at the area origin,
                    // outside the scroll view, so scrolling never clips it away.
                    file-keys := FocusScope {
                        x: 0; y: 0;
                        width: 0; height: 0;
                        key-pressed(event) => {
                            if (event.text == Key.Shift || event.text == Key.ShiftR
                                    || event.text == Key.Control || event.text == Key.ControlR
                                    || event.text == Key.Alt || event.text == Key.AltGr
                                    || event.text == Key.Meta || event.text == Key.MetaR) {
                                // A bare modifier: wait for the chord.
                                accept
                            } else if (root.match-shortcut(event.text, event.modifiers.control,
                                        event.modifiers.meta, event.modifiers.alt,
                                        event.modifiers.shift) == "paste"
                                    || (event.modifiers.control && !event.modifiers.alt
                                        && (event.text == "v" || event.text == "V"))) {
                                root.paste-upload(root.current-path);
                                accept
                            } else if ((event.text == Key.Delete
                                        || (Theme.is-mac && event.modifiers.meta && event.text == Key.Backspace))
                                    && !event.modifiers.control && !event.modifiers.alt
                                    && !event.modifiers.shift) {
                                // Del (Cmd+Backspace on macOS) deletes the checked
                                // entries, else the highlighted row, after the
                                // usual confirmation (#531).
                                if (root.selected-count > 0) {
                                    root.delete-selected();
                                } else if (root.selected-row >= 0 && root.selected-row < root.entries.length) {
                                    root.delete(root.entries[root.selected-row].full-path);
                                } else {
                                    // Nothing to delete: keep the old behaviour.
                                    root.forward-key(event.text,
                                        Theme.is-mac ? event.modifiers.meta : event.modifiers.control,
                                        event.modifiers.alt, event.modifiers.shift);
                                }
                                accept
                            } else {
                                root.forward-key(event.text,
                                    Theme.is-mac ? event.modifiers.meta : event.modifiers.control,
                                    event.modifiers.alt, event.modifiers.shift);
                                accept
                            }
                        }
                    }
                    ScrollView {
                        width: parent.width;
                        height: parent.height;
                        content-width: self.visible-width;
                        content-height: max(self.visible-height, file-list.preferred-height);

                        file-list := VerticalLayout {
                            spacing: 0;

                            if root.loading : Rectangle {
                                height: 40px;
                                Text { text: @tr("Loading..."); color: Theme.text-muted; font-size: Theme.fs-sm;
                                       horizontal-alignment: center; vertical-alignment: center; }
                            }

                            if !root.loading && root.entries.length == 0 : Rectangle {
                                height: 40px;
                                Text { text: @tr("Empty directory"); color: Theme.text-muted; font-size: Theme.fs-sm;
                                       horizontal-alignment: center; vertical-alignment: center; }
                            }

                            for entry[i] in root.entries : row := Rectangle {
                                height: 24px;
                                background: entry.selected
                                    ? #4a90e235
                                    : (i == root.selected-row
                                        ? #4a90e240
                                        : (row-ta.has-hover
                                            ? #4a90e225
                                            : (mod(i, 2) == 0 ? transparent : #ffffff08)));

                                row-ta := TouchArea {
                                    mouse-cursor: pointer;
                                    // In the split view a row can be dropped on the
                                    // local half (download); otherwise the row is
                                    // dragged out to the OS file manager (#504) and
                                    // a split-view drag that leaves the panel hands
                                    // over to that same OS drag.
                                    moved => {
                                        if (self.pressed && !root.drag-out-started
                                                && (abs(self.mouse-x - self.pressed-x) > 6px
                                                    || abs(self.mouse-y - self.pressed-y) > 6px)) {
                                            root.drag-out-started = true;
                                            if (root.dual) {
                                                root.begin-drag(
                                                    "remote",
                                                    i,
                                                    entry.selected && root.selected-count > 1 ? root.selected-count : 1,
                                                    entry.selected && root.selected-count > 1 ? @tr("Selected items") : entry.name,
                                                    self.absolute-position.x + self.mouse-x,
                                                    self.absolute-position.y + self.mouse-y);
                                            } else {
                                                root.drag-out(i);
                                            }
                                        } else if (root.drag-out-started && root.drag-active) {
                                            let ax = self.absolute-position.x + self.mouse-x;
                                            let ay = self.absolute-position.y + self.mouse-y;
                                            if (ax < root.absolute-position.x
                                                    || ax > root.absolute-position.x + root.width
                                                    || ay < root.absolute-position.y
                                                    || ay > root.absolute-position.y + root.height) {
                                                root.cancel-drag();
                                                root.drag-out-started = false;
                                                root.drag-out(i);
                                            } else {
                                                root.update-drag(ax, ay);
                                            }
                                        }
                                    }
                                    clicked => {
                                        root.selected-row = i;
                                        file-keys.focus();
                                        if (root.shift-click-pending) {
                                            root.shift-click-pending = false;
                                        } else {
                                            root.select-anchor = i;
                                        }
                                    }
                                    double-clicked => {
                                        if (entry.is-dir) {
                                            root.navigate(entry.full-path);
                                        } else {
                                            root.open-file(entry.full-path);
                                        }
                                    }
                                    pointer-event(ev) => {
                                        if (ev.kind == PointerEventKind.up) {
                                            if (root.drag-out-started && root.drag-active) {
                                                root.end-drag(self.absolute-position.x + self.mouse-x,
                                                              self.absolute-position.y + self.mouse-y);
                                            }
                                            root.drag-out-started = false;
                                        } else if (ev.kind == PointerEventKind.cancel) {
                                            if (root.drag-active) { root.cancel-drag(); }
                                            root.drag-out-started = false;
                                        } else if (ev.kind == PointerEventKind.down) {
                                            root.drag-out-started = false;
                                        }
                                        if (ev.kind == PointerEventKind.down
                                                && ev.button == PointerEventButton.left
                                                && ev.modifiers.shift) {
                                            root.shift-click-pending = true;
                                            root.select-range(root.select-anchor < 0 ? i : root.select-anchor, i);
                                            if (root.select-anchor < 0) { root.select-anchor = i; }
                                        }
                                        if (ev.kind == PointerEventKind.down
                                                && ev.button == PointerEventButton.right) {
                                            root.selected-row = i;
                                            root.menu-target = entry.full-path;
                                            root.menu-target-name = entry.name;
                                            root.menu-target-is-dir = entry.is-dir;
                                            root.menu-target-mode = entry.mode;
                                            root.menu-on-selection = entry.selected && root.selected-count >= 2;
                                            root.menu-x = self.absolute-position.x + self.mouse-x - file-area.absolute-position.x;
                                            root.menu-y = self.absolute-position.y + self.mouse-y - file-area.absolute-position.y;
                                            file-menu.show();
                                        }
                                    }
                                }

                                HorizontalLayout {
                                    padding-left: 8px; padding-right: 8px; spacing: 8px;
                                    // Multi-select checkbox (#100). Its own TouchArea
                                    // sits above the row, so toggling doesn't trigger
                                    // navigate/select.
                                    Rectangle {
                                        width: 16px;
                                        y: (parent.height - self.height) / 2;
                                        height: 16px;
                                        border-radius: 3px;
                                        border-width: 1px;
                                        border-color: entry.selected ? Theme.accent : Theme.border-strong;
                                        background: entry.selected ? Theme.accent : transparent;
                                        cb-ta := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => {
                                                // Keyboard focus to the list so Del acts on
                                                // the checked rows (#531).
                                                file-keys.focus();
                                                if (root.shift-click-pending) {
                                                    root.shift-click-pending = false;
                                                } else {
                                                    root.toggle-select(i);
                                                    root.select-anchor = i;
                                                }
                                            }
                                            pointer-event(ev) => {
                                                if (ev.kind == PointerEventKind.down
                                                        && ev.button == PointerEventButton.left
                                                        && ev.modifiers.shift) {
                                                    root.shift-click-pending = true;
                                                    root.select-range(root.select-anchor < 0 ? i : root.select-anchor, i);
                                                    if (root.select-anchor < 0) { root.select-anchor = i; }
                                                }
                                            }
                                        }
                                        if entry.selected : Text {
                                            text: "\u{E5CA}"; // check
                                            font-family: "Material Icons";
                                            color: #ffffff;
                                            font-size: 13px;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                            width: parent.width; height: parent.height;
                                        }
                                    }

                                    HorizontalLayout {
                                        horizontal-stretch: 1;
                                        min-width: root.name-min;
                                        spacing: 4px;
                                        Text {
                                            text: entry.is-dir ? "\u{E2C7}" : "\u{E24D}"; // folder / insert_drive_file
                                            font-family: "Material Icons";
                                            color: entry.is-dir ? Theme.accent : Theme.text-secondary;
                                            font-size: Theme.fs-sm;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: entry.name;
                                            color: entry.is-dir ? Theme.accent : Theme.text-primary;
                                            font-size: Theme.fs-sm;
                                            horizontal-stretch: 1;
                                            overflow: elide;
                                            vertical-alignment: center;
                                        }
                                    }
                                    if root.show-size-col : Text {
                                        text: entry.is-dir ? "" : entry.size;
                                        color: Theme.text-secondary; font-size: Theme.fs-xs;
                                        width: 72px; horizontal-alignment: right; vertical-alignment: center;
                                    }
                                    if root.show-modified-col : Text {
                                        text: entry.modified;
                                        color: Theme.text-muted; font-size: Theme.fs-xs;
                                         width: 116px; horizontal-alignment: right; vertical-alignment: center;
                                     }
                                    if root.show-type-col : Text {
                                        text: entry.file-type;
                                        color: Theme.text-secondary; font-size: Theme.fs-xs;
                                        width: 100px; horizontal-alignment: right; vertical-alignment: center;
                                    }
                                    if root.show-permissions-col : Text {
                                        text: entry.permissions;
                                        color: Theme.text-secondary; font-size: Theme.fs-xs;
                                        width: 104px; horizontal-alignment: right; vertical-alignment: center;
                                    }
                                    if root.show-owner-col : Text {
                                        text: entry.owner;
                                        color: Theme.text-secondary; font-size: Theme.fs-xs;
                                        width: 84px; horizontal-alignment: right; vertical-alignment: center;
                                    }
                                    if root.show-group-col : Text {
                                        text: entry.group;
                                        color: Theme.text-secondary; font-size: Theme.fs-xs;
                                        width: 84px; horizontal-alignment: right; vertical-alignment: center;
                                    }
                                }
                            }

                            // Whitespace below the rows: right-click here opens the
                            // menu with no target (item actions greyed out) (#84).
                            ws := Rectangle {
                                vertical-stretch: 1;
                                min-height: 24px;
                                ws-ta := TouchArea {
                                    clicked => { file-keys.focus(); }
                                    pointer-event(ev) => {
                                        if (ev.kind == PointerEventKind.down
                                                && ev.button == PointerEventButton.right) {
                                            root.selected-row = -1;
                                            root.menu-target = "";
                                            root.menu-on-selection = false;
                                            root.menu-x = self.absolute-position.x + self.mouse-x - file-area.absolute-position.x;
                                            root.menu-y = self.absolute-position.y + self.mouse-y - file-area.absolute-position.y;
                                            file-menu.show();
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // One context menu for the whole list (#84). Item actions are
                    // enabled only when an item was right-clicked (menu-target set);
                    // new/refresh are always available.
                    copy-target-menu := PopupWindow {
                        x: root.menu-x + 148px;
                        y: root.menu-y;
                        width: 148px;
                        height: max(1, root.transfer-targets.length) * 27px + 8px;
                        Rectangle {
                            background: Theme.popup-bg;
                            border-radius: Theme.radius-sm;
                            border-width: 1px;
                            border-color: Theme.border-strong;
                            drop-shadow-blur: 12px;
                            drop-shadow-color: #00000060;
                            VerticalLayout {
                                padding: 4px;
                                spacing: 1px;
                                for target in root.transfer-targets : SftpMenuItem {
                                    label: target.title;
                                    enabled: target.kind == "terminal" && target.connected && target.id != root.current-tab-id;
                                    clicked => {
                                        if (root.selected-count >= 2) {
                                            root.copy-selected-to-target(target.id);
                                        } else if (root.menu-target != "") {
                                            root.copy-to-target(root.menu-target, target.id);
                                        } else {
                                            root.copy-selected-to-target(target.id);
                                        }
                                    }
                                }
                            }
                        }
                    }

                    file-menu := PopupWindow {
                        x: root.menu-x;
                        y: root.menu-y;
                        width: 186px;
                        height: (15 + (root.dual ? 2 : 0)) * 27px + 8px;
                        Rectangle {
                            background: Theme.popup-bg;
                            border-radius: Theme.radius-sm;
                            border-width: 1px;
                            border-color: Theme.border-strong;
                            drop-shadow-blur: 12px;
                            drop-shadow-color: #00000060;
                            VerticalLayout {
                                padding: 4px;
                                spacing: 1px;
                                SftpMenuItem {
                                    label: @tr("Download");
                                    enabled: root.menu-target != "";
                                    clicked => { root.download(root.menu-target); }
                                }
                                // Split view only: pull straight into the folder
                                // the local pane is showing (no folder picker).
                                if root.dual : SftpMenuItem {
                                    label: @tr("Download to local folder");
                                    enabled: root.menu-target != "";
                                    clicked => { root.download-to-local(root.menu-target); }
                                }
                                if root.dual : SftpMenuItem {
                                    label: @tr("Download checked to local folder");
                                    enabled: root.selected-count > 0;
                                    clicked => { root.download-selected-to-local(); }
                                }
                                SftpMenuItem {
                                    label: @tr("View");
                                    enabled: root.menu-target != "" && !root.menu-target-is-dir;
                                    clicked => { root.view(root.menu-target); }
                                }
                                SftpMenuItem {
                                    label: @tr("Edit");
                                    enabled: root.menu-target != "" && !root.menu-target-is-dir;
                                    clicked => { root.edit(root.menu-target); }
                                }
                                SftpMenuItem {
                                    label: @tr("Open externally");
                                    enabled: root.menu-target != "" && !root.menu-target-is-dir;
                                    clicked => { root.open-external(root.menu-target); }
                                }
                                SftpMenuItem {
                                    label: @tr("Edit externally");
                                    enabled: root.menu-target != "" && !root.menu-target-is-dir;
                                    clicked => { root.edit-external(root.menu-target); }
                                }
                                SftpMenuItem {
                                    label: @tr("Rename");
                                    enabled: root.menu-target != "";
                                    clicked => { root.rename-request(root.menu-target, root.menu-target-name); }
                                }
                                SftpMenuItem {
                                    label: @tr("Permissions");
                                    enabled: root.menu-target != "";
                                    clicked => { root.chmod-request(root.menu-target, root.menu-target-name, root.menu-target-mode); }
                                }
                                SftpMenuItem {
                                    label: @tr("Copy path");
                                    enabled: root.menu-target != "";
                                    clicked => { root.copy-path(root.menu-target); }
                                }
                                SftpMenuItem {
                                    label: @tr("Copy to session...");
                                    enabled: (root.menu-target != "" || root.selected-count > 0) && root.transfer-targets.length > 1;
                                    clicked => { copy-target-menu.show(); }
                                }
                                // Right-clicking one of several checked rows
                                // deletes all of them; an unchecked row only
                                // itself (#531). Both paths ask for confirmation.
                                SftpMenuItem {
                                    label: root.menu-on-selection ? @tr("Delete checked items") : @tr("Delete");
                                    tint: #d86c6c;
                                    enabled: root.menu-target != "";
                                    clicked => {
                                        if (root.menu-on-selection) {
                                            root.delete-selected();
                                        } else {
                                            root.delete(root.menu-target);
                                        }
                                    }
                                }
                                Rectangle { height: 1px; background: Theme.border-subtle; }
                                // Upload copied files (#508): into the right-clicked
                                // folder, else the folder being shown.
                                SftpMenuItem {
                                    label: @tr("Paste");
                                    clicked => {
                                        root.paste-upload(root.menu-target != "" && root.menu-target-is-dir
                                            ? root.menu-target : root.current-path);
                                    }
                                }
                                SftpMenuItem {
                                    label: @tr("New folder");
                                    clicked => { root.new-folder(root.current-path); }
                                }
                                SftpMenuItem {
                                    label: @tr("New file");
                                    clicked => { root.new-file(root.current-path); }
                                }
                                SftpMenuItem {
                                    label: @tr("Refresh");
                                    clicked => { root.refresh(root.current-path); }
                                }
                                SftpMenuItem {
                                    label: @tr("Clear sort");
                                    enabled: root.sort-dir != 0;
                                    clicked => { root.clear-sort(); }
                                }
                            }
                        }
                    }
                }
            }
        }

        if root.panel-mode == "tunnels" : Rectangle {
            vertical-stretch: 1;
            clip: true;
            background: transparent;

            ScrollView {
                width: parent.width;
                height: parent.height;
                content-width: self.visible-width;
                content-height: max(self.visible-height, tunnel-body.preferred-height);

                tunnel-body := VerticalLayout {
                    padding: 10px;
                    spacing: 8px;

                    HorizontalLayout {
                        spacing: 6px;
                        Rectangle {
                            width: 54px; height: 24px; border-radius: Theme.radius-sm;
                            background: root.tunnel-kind == "local" ? Theme.accent : (tl-ta.has-hover ? Theme.bg-hover : Theme.bg-root);
                            tl-ta := TouchArea { mouse-cursor: pointer; clicked => { root.tunnel-kind = "local"; } }
                            Text { text: "-L"; color: root.tunnel-kind == "local" ? #ffffff : Theme.text-primary; font-size: Theme.fs-sm; horizontal-alignment: center; vertical-alignment: center; }
                        }
                        Rectangle {
                            width: 54px; height: 24px; border-radius: Theme.radius-sm;
                            background: root.tunnel-kind == "dynamic" ? Theme.accent : (td-ta.has-hover ? Theme.bg-hover : Theme.bg-root);
                            td-ta := TouchArea { mouse-cursor: pointer; clicked => { root.tunnel-kind = "dynamic"; } }
                            Text { text: "-D"; color: root.tunnel-kind == "dynamic" ? #ffffff : Theme.text-primary; font-size: Theme.fs-sm; horizontal-alignment: center; vertical-alignment: center; }
                        }
                        Rectangle {
                            width: 54px; height: 24px; border-radius: Theme.radius-sm;
                            background: root.tunnel-kind == "remote" ? Theme.accent : (tr-ta.has-hover ? Theme.bg-hover : Theme.bg-root);
                            tr-ta := TouchArea { mouse-cursor: pointer; clicked => { root.tunnel-kind = "remote"; } }
                            Text { text: "-R"; color: root.tunnel-kind == "remote" ? #ffffff : Theme.text-primary; font-size: Theme.fs-sm; horizontal-alignment: center; vertical-alignment: center; }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        Rectangle {
                            width: 72px; height: 24px; border-radius: Theme.radius-sm;
                            background: add-tunnel-ta.has-hover ? Theme.accent-hover : Theme.accent;
                            add-tunnel-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    if (root.tunnel-bind-port != "" && (root.tunnel-kind == "dynamic" || (root.tunnel-host != "" && root.tunnel-host-port != ""))) {
                                        root.tunnel-add(root.tunnel-name, root.tunnel-kind, root.tunnel-bind, root.tunnel-bind-port, root.tunnel-host, root.tunnel-host-port, root.tunnel-save, root.tunnel-auto-start);
                                    }
                                }
                            }
                            Text { text: @tr("Add"); color: #ffffff; font-size: Theme.fs-sm; horizontal-alignment: center; vertical-alignment: center; }
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        VerticalLayout {
                            horizontal-stretch: 1; spacing: 3px;
                            Text { text: @tr("Name (optional)"); color: Theme.text-secondary; font-size: Theme.fs-xs; }
                            Rectangle {
                                height: 24px; border-radius: Theme.radius-sm;
                                background: Theme.bg-root; border-width: 1px; border-color: Theme.border-subtle;
                                TextInput { x: 7px; width: parent.width - 14px; height: parent.height; text <=> root.tunnel-name; color: Theme.text-primary; font-family: Theme.ui-font-family; font-size: Theme.fs-sm; single-line: true; vertical-alignment: center; }
                            }
                        }
                        VerticalLayout {
                            width: 128px; spacing: 3px;
                            Text { text: root.tunnel-kind == "remote" ? @tr("Server listen address") : @tr("Local listen address"); color: Theme.text-secondary; font-size: Theme.fs-xs; overflow: elide; }
                            Rectangle {
                                height: 24px; border-radius: Theme.radius-sm;
                                background: Theme.bg-root; border-width: 1px; border-color: Theme.border-subtle;
                                TextInput { x: 7px; width: parent.width - 14px; height: parent.height; text <=> root.tunnel-bind; color: Theme.text-primary; font-family: Theme.ui-font-family; font-size: Theme.fs-sm; single-line: true; vertical-alignment: center; }
                            }
                        }
                        VerticalLayout {
                            width: 74px; spacing: 3px;
                            Text { text: @tr("Listen port"); color: Theme.text-secondary; font-size: Theme.fs-xs; overflow: elide; }
                            Rectangle {
                                height: 24px; border-radius: Theme.radius-sm;
                                background: Theme.bg-root; border-width: 1px; border-color: Theme.border-subtle;
                                TextInput { x: 7px; width: parent.width - 14px; height: parent.height; text <=> root.tunnel-bind-port; color: Theme.text-primary; font-family: Theme.ui-font-family; font-size: Theme.fs-sm; single-line: true; vertical-alignment: center; }
                            }
                        }
                    }

                    if root.tunnel-kind != "dynamic" : HorizontalLayout {
                        spacing: 8px;
                        VerticalLayout {
                            horizontal-stretch: 1; spacing: 3px;
                            Text { text: root.tunnel-kind == "remote" ? @tr("Local target host") : @tr("Server target host"); color: Theme.text-secondary; font-size: Theme.fs-xs; }
                            Rectangle {
                                height: 24px; border-radius: Theme.radius-sm;
                                background: Theme.bg-root; border-width: 1px; border-color: Theme.border-subtle;
                                TextInput { x: 7px; width: parent.width - 14px; height: parent.height; text <=> root.tunnel-host; color: Theme.text-primary; font-family: Theme.ui-font-family; font-size: Theme.fs-sm; single-line: true; vertical-alignment: center; }
                            }
                        }
                        VerticalLayout {
                            width: 76px; spacing: 3px;
                            Text { text: @tr("Target port"); color: Theme.text-secondary; font-size: Theme.fs-xs; }
                            Rectangle {
                                height: 24px; border-radius: Theme.radius-sm;
                                background: Theme.bg-root; border-width: 1px; border-color: Theme.border-subtle;
                                TextInput { x: 7px; width: parent.width - 14px; height: parent.height; text <=> root.tunnel-host-port; color: Theme.text-primary; font-family: Theme.ui-font-family; font-size: Theme.fs-sm; single-line: true; vertical-alignment: center; }
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        Rectangle {
                            width: 16px; height: 16px; border-radius: 3px; border-width: 1px; border-color: Theme.border-subtle;
                            background: root.tunnel-save ? Theme.accent : Theme.bg-root;
                            TouchArea { clicked => { root.tunnel-save = !root.tunnel-save; } }
                            Text { text: root.tunnel-save ? "X" : ""; color: #ffffff; horizontal-alignment: center; vertical-alignment: center; }
                        }
                        Text { text: @tr("Save to this SSH session"); color: Theme.text-secondary; font-size: Theme.fs-xs; }
                    }
                    if root.tunnel-save : HorizontalLayout {
                        spacing: 8px;
                        Rectangle {
                            width: 16px; height: 16px; border-radius: 3px; border-width: 1px; border-color: Theme.border-subtle;
                            background: root.tunnel-auto-start ? Theme.accent : Theme.bg-root;
                            TouchArea { clicked => { root.tunnel-auto-start = !root.tunnel-auto-start; } }
                            Text { text: root.tunnel-auto-start ? "X" : ""; color: #ffffff; horizontal-alignment: center; vertical-alignment: center; }
                        }
                        Text { text: @tr("Start automatically when connecting"); color: Theme.text-secondary; font-size: Theme.fs-xs; }
                    }

                    Rectangle { height: 1px; background: Theme.border-subtle; }

                    if root.tunnels.length == 0 : Rectangle {
                        height: 36px;
                        Text { text: @tr("No tunnels"); color: Theme.text-muted; font-size: Theme.fs-sm; horizontal-alignment: center; vertical-alignment: center; }
                    }

                    for tun in root.tunnels : Rectangle {
                        height: 34px;
                        border-radius: Theme.radius-sm;
                        background: tunnel-row-ta.has-hover ? Theme.bg-hover : Theme.bg-root.with-alpha(0.42);
                        tunnel-row-ta := TouchArea {}
                        HorizontalLayout {
                            padding-left: 8px; padding-right: 8px; spacing: 8px;
                            Text { text: tun.active ? "●" : "○"; color: tun.active ? #28c76f : Theme.text-muted; width: 14px; font-size: Theme.fs-sm; vertical-alignment: center; horizontal-alignment: center; }
                            Text { text: tun.kind == "dynamic" ? "-D" : (tun.kind == "remote" ? "-R" : "-L"); color: Theme.text-muted; width: 28px; font-size: Theme.fs-sm; vertical-alignment: center; horizontal-alignment: center; }
                            Text { text: tun.name; color: Theme.text-primary; width: 120px; font-size: Theme.fs-sm; overflow: elide; vertical-alignment: center; }
                            Text { text: tun.bind + (tun.target != "" ? " → " + tun.target : ""); color: Theme.text-secondary; horizontal-stretch: 1; font-size: Theme.fs-xs; overflow: elide; vertical-alignment: center; }
                            Text { text: tun.status; color: tun.active ? Theme.accent : Theme.text-muted; width: 62px; font-size: Theme.fs-xs; overflow: elide; vertical-alignment: center; horizontal-alignment: right; }
                            Rectangle {
                                width: 48px; height: 22px; border-radius: Theme.radius-sm;
                                background: control-ta.has-hover ? Theme.bg-hover : transparent;
                                control-ta := TouchArea { mouse-cursor: pointer; clicked => { if (tun.active) { root.tunnel-stop(tun.id); } else { root.tunnel-start(tun.id); } } }
                                Text { text: tun.active ? @tr("Stop") : @tr("Start"); color: tun.active ? Theme.danger : Theme.accent; font-size: Theme.fs-xs; horizontal-alignment: center; vertical-alignment: center; }
                            }
                            Rectangle {
                                width: 52px; height: 22px; border-radius: Theme.radius-sm;
                                background: delete-ta.has-hover ? Theme.danger.with-alpha(0.24) : transparent;
                                delete-ta := TouchArea { mouse-cursor: pointer; clicked => { root.tunnel-delete(tun.id); } }
                                Text { text: @tr("Delete"); color: Theme.danger; font-size: Theme.fs-xs; horizontal-alignment: center; vertical-alignment: center; }
                            }
                        }
                    }
                }
            }
        }

        // --- Status bar (full width) --------------------------------------
        Rectangle {
            height: 18px;
            background: Theme.bg-panel-alt;
            Text {
                x: 8px;
                text: root.status;
                color: Theme.text-muted;
                font-size: Theme.fs-xs;
                vertical-alignment: center;
                height: parent.height;
                overflow: elide;
                width: parent.width - 16px;
            }
        }
    }

    // --- Split-view drag feedback -----------------------------------------
    // Highlight the pane that will receive the drop. Geometry was captured in
    // `update-drag` (an event handler), never from a binding: peeking at
    // `absolute-position` here would recurse through the layout.
    if root.drag-active && (root.drop-local || root.drop-remote) : Rectangle {
        x: root.drop-x;
        y: root.drop-y;
        width: root.drop-w;
        height: root.drop-h;
        background: Theme.accent.with-alpha(0.10);
        border-width: 2px;
        border-color: Theme.accent;
    }

    // The item being dragged, next to the cursor (no TouchArea: the row that
    // started the drag keeps the pointer grab until release).
    if root.drag-active : Rectangle {
        x: clamp(root.drag-x + 14px, 0px, max(0px, root.width - self.width));
        y: clamp(root.drag-y + 12px, 0px, max(0px, root.height - self.height));
        width: drag-ghost.preferred-width + 16px;
        height: 22px;
        background: Theme.popup-bg;
        border-width: 1px;
        border-color: Theme.accent;
        border-radius: Theme.radius-sm;
        drop-shadow-blur: 8px;
        drop-shadow-color: #00000070;
        drag-ghost := HorizontalLayout {
            padding-left: 8px;
            padding-right: 8px;
            spacing: 4px;
            Text {
                text: root.drag-label;
                color: Theme.text-primary;
                font-size: Theme.fs-xs;
                vertical-alignment: center;
            }
            if root.drag-count > 1 : Text {
                text: root.drag-count;
                color: Theme.accent;
                font-size: Theme.fs-xs;
                vertical-alignment: center;
            }
        }
    }
}
