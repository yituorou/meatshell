import { Theme, TooltipState } from "theme.slint";
import { ScrollView } from "std-widgets.slint";
import { TabInfo } from "tabs.slint";
import { OutlineIcon } from "widgets.slint";
import {
    SftpEntry, SftpTreeNode, SftpLocalPlace, TunnelInfo, TransferInfo,
    SftpIconBtn, SftpPillBtn, SftpMenuItem, SftpStarButton
} from "components/business/sftp_types_and_buttons.slint";
import { SftpPlacesButton } from "components/business/sftp_places_popup.slint";
import { LocalPane } from "components/business/sftp_local_pane.slint";
import { SftpInlineTransferStrip, SftpTransfersView, SftpTunnelsView } from "components/business/sftp_transfers_tunnels_views.slint";

export { SftpEntry, SftpTreeNode, SftpLocalPlace, TunnelInfo, TransferInfo }

// ---------------------------------------------------------------------------
// SftpPanel — left directory tree / local pane + right remote file listing
// ---------------------------------------------------------------------------

export component SftpPanel inherits Rectangle {
    // --- Properties --------------------------------------------------------
    in property <string>  current-path: "/";
    in property <[SftpEntry]>    entries;
    in property <string>  status: @tr("SFTP not connected");
    in property <bool>    loading: false;
    in property <[SftpTreeNode]> tree-nodes: [];
    in property <string> current-tab-id;
    in property <[TabInfo]> transfer-targets: [];
    in property <string> sort-key: "";
    in property <int> sort-dir: 0; // 0 default / 1 asc / -1 desc
    property <string> effective-sort-key: root.sort-key == "" ? "name" : root.sort-key;
    property <int> effective-sort-dir: root.sort-dir == 0 ? 1 : root.sort-dir;
    in-out property <bool> show-hidden: false;
    in-out property <bool> local-sub-open: false;
    in-out property <bool> remote-sub-open: false;
    in property <string> dock-edge: "bottom";
    in property <bool> sftp-fullscreen: false;
    callback set-dock-edge(string);
    callback toggle-fullscreen();
    in property <bool> show-type: true;
    in property <bool> show-size: true;
    in property <bool> show-modified: true;
    in property <bool> show-permissions: true;
    in property <bool> show-owner: true;
    in property <bool> show-group: true;
    callback toggle-column(string);
    in property <[TunnelInfo]> tunnels: [];
    in property <bool> collapsed: false;   // when true only the toolbar shows
    in property <bool> show-tree: true;    // hide the directory tree when narrow (#dock)
    in property <bool> compact: false;     // side-docked + collapsed → render nothing but a clean strip (#dock)
    // Split view (dual pane): a local-folder browser replaces the directory tree
    // on the left, the remote listing stays on the right, and each pane can copy
    // into the other. The remote path bar and its buttons keep working as before,
    // so the toolbar always describes the *remote* side.
    in property <bool> dual: false;
    in property <[SftpEntry]> local-entries;
    in property <string> local-path: "";
    in property <string> local-status: "";
    in property <bool> local-loading: false;
    in property <int> local-selected-count: 0;
    in property <[SftpLocalPlace]> local-quick-places;
    // Local list options (#532 follow-up).
    in-out property <bool> local-show-hidden: false;
    in property <string> local-sort-key;
    in property <int> local-sort-dir: 0;
    in property <string> local-filter;
    in property <[SftpLocalPlace]> local-drive-places;
    in property <[string]> local-bookmarks;
    in property <[string]> local-recent;
    in property <bool> local-bookmarked: false;
    // 0 = split the panel in the middle (the default); dragging the divider
    // stores an explicit width, reported back through `persist-local-pane-width`
    // so Rust can hit-test drops on the local half with the same geometry.
    in property <length> local-pane-default: 0px;
    in-out property <length> local-pane-width: 0px;
    // Persisted share of the panel (0 = even). Used when no width has been
    // dragged in this session, so the split survives a restart (#532).
    in property <float> local-split-ratio: 0.0;
    callback persist-local-pane-width(length);
    callback persist-local-split-ratio(float);
    init => { root.local-pane-width = root.local-pane-default; }
    property <bool> local-resizing: false;
    // Effective local extent: the dragged width, else the saved ratio, else
    // half the panel. The remote half always keeps ~200px so its Name column
    // and buttons stay usable in a narrow dock.
    property <length> local-w: clamp(
        root.local-pane-width > 0px
            ? root.local-pane-width
            : (root.local-split-ratio > 0.0 ? root.width * root.local-split-ratio : root.width / 2),
        160px,
        max(160px, root.width - 200px));
    // Tree is only meaningful in the classic view, and hidden by default in
    // the modern drawer layout until toggled on via the toolbar button.
    in-out property <bool> user-show-tree: false;
    property <bool> tree-shown: root.user-show-tree && root.show-tree && !root.dual;
    // Responsive columns: Name always keeps `name-min` so filenames stay readable.
    // Optional columns fill whatever is left in priority order (high → low):
    // Permissions → Type → Size → Modified → Owner → Group. The first *enabled*
    // column that no longer fits is hidden, together with every lower-priority
    // column — never the Name. Layout cost: chrome (checkbox + paddings + gap)
    // 40px; each extra column costs its width plus 8px inter-column spacing.
    in-out property <length> tree-width: 160px;
    callback persist-tree-width(length);
    property <bool> tree-resizing: false;
    property <length> list-w: root.tree-shown
        ? root.width - root.tree-width - 5px
        : (root.dual ? root.width - root.local-w - 5px : root.width);
    property <length> name-min: 180px;     // guaranteed Name column width
    property <length> chrome-w: 40px;      // checkbox + paddings + gap into Name
    property <length> extras-w: max(0px, root.list-w - root.chrome-w - root.name-min);
    // Per-column layout cost = visual width + 8px spacing.
    property <length> cost-permissions: 108px;
    property <length> cost-type: 96px;
    property <length> cost-size: 76px;
    property <length> cost-modified: 120px;
    property <length> cost-owner: 88px;
    property <length> cost-group: 88px;
    // Columns claim the space in priority order: Size → Type → Modified → Permissions → Owner → Group
    property <bool> fit-size: !root.show-size || root.extras-w >= root.cost-size;
    property <bool> show-size-col: root.show-size && root.fit-size;
    property <length> used-1: root.show-size-col ? root.cost-size : 0px;
    property <bool> fit-type: root.fit-size && (!root.show-type || root.extras-w - root.used-1 >= root.cost-type);
    property <bool> show-type-col: root.show-type && root.fit-type;
    property <length> used-2: root.used-1 + (root.show-type-col ? root.cost-type : 0px);
    property <bool> fit-modified: root.fit-type && (!root.show-modified || root.extras-w - root.used-2 >= root.cost-modified);
    property <bool> show-modified-col: root.show-modified && root.fit-modified;
    property <length> used-3: root.used-2 + (root.show-modified-col ? root.cost-modified : 0px);
    property <bool> fit-permissions: root.fit-modified && (!root.show-permissions || root.extras-w - root.used-3 >= root.cost-permissions);
    property <bool> show-permissions-col: root.show-permissions && root.fit-permissions;
    property <length> used-4: root.used-3 + (root.show-permissions-col ? root.cost-permissions : 0px);
    property <bool> fit-owner: root.fit-permissions && (!root.show-owner || root.extras-w - root.used-4 >= root.cost-owner);
    property <bool> show-owner-col: root.show-owner && root.fit-owner;
    property <length> used-5: root.used-4 + (root.show-owner-col ? root.cost-owner : 0px);
    property <bool> fit-group: root.fit-owner && (!root.show-group || root.extras-w - root.used-5 >= root.cost-group);
    property <bool> show-group-col: root.show-group && root.fit-group;
    property <int> selected-row: -1;       // clicked/highlighted file-list row (#70)
    in property <int> selected-count;      // number of checked entries (#100)
    property <int> select-anchor: -1;
    property <bool> shift-click-pending: false;
    property <bool> drag-out-started: false;
    property <length> menu-x;
    property <length> menu-y;
    property <string> menu-target;          // "" = whitespace
    property <string> menu-target-name;
    property <bool>   menu-target-is-dir;
    property <int>    menu-target-mode;     // permission bits for the chmod dialog
    property <bool>   menu-on-selection: false;
    property <string> panel-mode: "files";
    property <string> filter-text: "";
    in property <[TransferInfo]> transfers: [];
    in property <bool> has-active-transfers: false;
    in property <string> download-dir: "";
    callback cancel-transfer(string);
    callback clear-transfers();
    callback pick-download-dir();
    callback open-download-dir();
    callback local-sort-request(string, int);
    pure callback entry-matches(string, string, string) -> bool;

    property <string> tunnel-kind: "local";
    property <string> tunnel-name: "";
    property <string> tunnel-bind: "127.0.0.1";
    property <string> tunnel-bind-port: "1080";
    property <string> tunnel-host: "127.0.0.1";
    property <string> tunnel-host-port: "80";
    property <bool> tunnel-save: false;
    property <bool> tunnel-auto-start: true;
    property <bool> narrow-toolbar: false;

    property <length> column-menu-x: 8px;
    property <length> column-menu-y: 22px;

    // --- Callbacks ---------------------------------------------------------
    callback toggle-collapsed();    // minimise / restore the panel
    callback navigate(string);
    callback download(string);
    callback open-file(string);
    callback upload-clicked(string /* remote dir */, bool /* folder */);
    callback refresh(string);
    callback tree-expand(string);   // toggle expand/collapse + navigate
    callback delete(string);        // remove a remote file/dir
    callback toggle-select(int);    // toggle a row's multi-select checkbox (#100)
    callback select-range(int /* from */, int /* to */); // Shift+click: check exactly rows from..to
    // Path bookmarks + recent folders for this session (#500).
    in property <[string]> bookmarks;
    in property <[string]> recent;
    in property <bool> bookmarked;      // current-path is bookmarked
    callback toggle-bookmark(string);
    callback remove-bookmark(string);
    callback clear-recent();
    callback places-refresh();
    callback drag-out(int);
    callback download-selected();   // download all checked entries (#100)
    callback delete-selected();     // delete all checked entries (#100)
    callback copy-to-target(string /* path */, string /* target tab */);
    callback copy-selected-to-target(string /* target tab */);
    callback view(string);          // open read-only in the built-in viewer
    callback edit(string);          // open writable in the built-in editor
    callback open-external(string);     // open with the OS default app (#81)
    callback edit-external(string);     // open externally + watch/re-upload (#81)
    callback sort-request(string /* name|size|modified */);
    callback clear-sort();
    callback tunnel-add(string /* name */, string /* kind */, string /* bind */, string /* bind-port */, string /* host */, string /* host-port */, bool /* save */, bool /* auto-start */);
    callback tunnel-stop(string /* id */);
    callback tunnel-start(string /* id */);
    callback tunnel-delete(string /* id */);
    callback rename-request(string /* path */, string /* current name */);
    callback chmod-request(string /* path */, string /* name */, int /* mode */);
    callback copy-path(string);
    callback new-folder(string /* parent dir */);
    callback new-file(string /* parent dir */);
    callback create-entry-inline(string /* kind: mkdir|touch */, string /* parent dir */, string /* name */);
    property <string> inline-create-kind: "";
    property <string> inline-create-name: "";
    callback paste-upload(string /* remote dir */);
    callback match-shortcut(string, bool, bool, bool, bool) -> string;
    callback forward-key(string, bool /* ctrl */, bool /* alt */, bool /* shift */);
    callback toggle-dual();
    callback local-navigate(string /* path */);
    callback local-up();
    callback local-home();
    callback local-refresh();
    callback local-places-refresh();
    callback local-toggle-bookmark();
    callback local-remove-bookmark(string /* path */);
    callback local-clear-recent();
    callback local-toggle-hidden();
    callback local-sort(string /* column */);
    callback local-set-filter(string /* text */);
    callback local-remove-recent(string /* path */);
    callback local-move-bookmark(string /* path */, int /* -1 up, +1 down */);
    callback local-reveal();
    callback local-open(string /* local path */);
    callback local-toggle-select(int /* row */);
    callback local-select-range(int /* from */, int /* to */);
    callback local-copy-path(string /* local path */);
    callback local-upload(string /* local path */);
    callback local-upload-selected();
    callback download-to-local(string /* remote path */);
    callback download-selected-to-local();

    // --- Split-view drag & drop -------------------------------------------
    property <bool> drag-active: false;
    property <string> drag-from: "";     // "local" | "remote"
    property <int> drag-row: -1;
    property <int> drag-count: 1;
    property <string> drag-label: "";
    property <length> drag-x;
    property <length> drag-y;
    property <bool> drop-local: false;
    property <bool> drop-remote: false;
    property <length> drop-x;
    property <length> drop-y;
    property <length> drop-w;
    property <length> drop-h;
    property <length> content-top: root.narrow-toolbar && root.panel-mode == "files" ? 66px : 38px;

    public function begin-drag(from: string, row: int, count: int, label: string,
                               ax: length, ay: length) {
        root.drag-from = from;
        root.drag-row = row;
        root.drag-count = count;
        root.drag-label = label;
        root.drag-active = true;
        root.update-drag(ax, ay);
    }

    public function update-drag(ax: length, ay: length) {
        if (!root.drag-active) { return; }
        root.drag-x = ax - root.absolute-position.x;
        root.drag-y = ay - root.absolute-position.y;
        let top = root.content-top;
        let bottom = max(top, root.height - 18px);
        root.drop-local = root.drag-from == "remote"
            && root.drag-x >= 0px && root.drag-x <= root.local-w
            && root.drag-y >= top && root.drag-y <= bottom;
        root.drop-remote = root.drag-from == "local"
            && root.drag-x >= root.local-w + 5px && root.drag-x <= root.width
            && root.drag-y >= top && root.drag-y <= bottom;
        root.drop-x = root.drop-local ? 0px : root.local-w + 5px;
        root.drop-y = top;
        root.drop-w = root.drop-local ? root.local-w : max(0px, root.width - root.local-w - 5px);
        root.drop-h = max(0px, root.height - top - 18px);
    }

    public function end-drag(ax: length, ay: length) {
        if (!root.drag-active) { return; }
        root.update-drag(ax, ay);
        if (root.drag-from == "local" && root.drop-remote) {
            if (root.drag-count > 1) {
                root.local-upload-selected();
            } else if (root.drag-row >= 0 && root.drag-row < root.local-entries.length) {
                root.local-upload(root.local-entries[root.drag-row].full-path);
            }
        } else if (root.drag-from == "remote" && root.drop-local) {
            if (root.drag-count > 1) {
                root.download-selected-to-local();
            } else if (root.drag-row >= 0 && root.drag-row < root.entries.length) {
                root.download-to-local(root.entries[root.drag-row].full-path);
            }
        }
        root.cancel-drag();
    }

    public function cancel-drag() {
        root.drag-active = false;
        root.drag-from = "";
        root.drag-row = -1;
        root.drag-count = 1;
        root.drag-label = "";
        root.drop-local = false;
        root.drop-remote = false;
    }

    callback dock-drag-move(length /* abs-x */, length /* abs-y */);
    callback dock-drag-end();

    // -----------------------------------------------------------------------
    background: Theme.bg-root;
    clip: true;

    property <string> path-text: root.current-path;

    changed current-path => {
        root.path-text = root.current-path;
        root.selected-row = -1;
        root.select-anchor = -1;
    }

    dock-bg := TouchArea {
        mouse-cursor: self.pressed ? move : default;
        moved => {
            if (self.pressed) {
                root.dock-drag-move(self.absolute-position.x + self.mouse-x,
                                    self.absolute-position.y + self.mouse-y);
            }
        }
        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.up) { root.dock-drag-end(); }
            else if (ev.kind == PointerEventKind.cancel) { root.dock-drag-end(); }
        }
    }

    VerticalLayout {
        visible: !root.compact;
        spacing: 0;

        // --- Top Toolbar (full width: Mode Tabs + Split/Tree + Dock/Fullscreen Switcher) ---
        Rectangle {
            height: 38px;
            background: Theme.bg-panel;

            HorizontalLayout {
                height: 38px;
                padding-left: 8px;
                padding-right: 8px;
                spacing: 6px;

                // Segmented Mode Tabs: Files | Tunnels | Transfers
                Rectangle {
                    y: (parent.height - self.height) / 2;
                    height: 28px;
                    border-radius: 7px;
                    background: Theme.bg-root;
                    border-width: 1px;
                    border-color: Theme.border-subtle;
                    HorizontalLayout {
                        padding: 2px;
                        spacing: 2px;

                        // Files tab
                        Rectangle {
                            width: 52px;
                            height: 22px;
                            border-radius: 5px;
                            background: root.panel-mode == "files"
                                ? Theme.bg-active
                                : (files-tab-ta.has-hover ? Theme.bg-hover : transparent);
                            files-tab-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    TooltipState.hide(@tr("SFTP file browser"));
                                    root.panel-mode = "files";
                                }
                                changed has-hover => {
                                    if (self.has-hover) {
                                        TooltipState.show(@tr("SFTP file browser"), parent.absolute-position.x, parent.absolute-position.y, parent.width, parent.height);
                                    } else {
                                        TooltipState.hide(@tr("SFTP file browser"));
                                    }
                                }
                            }
                            Text {
                                text: @tr("Files");
                                color: root.panel-mode == "files" ? Theme.text-primary : Theme.text-secondary;
                                font-size: Theme.fs-xs;
                                font-weight: root.panel-mode == "files" ? 600 : 400;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        // Tunnels tab
                        Rectangle {
                            width: 64px;
                            height: 22px;
                            border-radius: 5px;
                            background: root.panel-mode == "tunnels"
                                ? Theme.bg-active
                                : (tunnels-tab-ta.has-hover ? Theme.bg-hover : transparent);
                            tunnels-tab-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    TooltipState.hide(@tr("SSH port forwarding (-L / -R / -D)"));
                                    root.panel-mode = "tunnels";
                                }
                                changed has-hover => {
                                    if (self.has-hover) {
                                        TooltipState.show(@tr("SSH port forwarding (-L / -R / -D)"), parent.absolute-position.x, parent.absolute-position.y, parent.width, parent.height);
                                    } else {
                                        TooltipState.hide(@tr("SSH port forwarding (-L / -R / -D)"));
                                    }
                                }
                            }
                            Text {
                                text: @tr("Tunnels");
                                color: root.panel-mode == "tunnels" ? Theme.text-primary : Theme.text-secondary;
                                font-size: Theme.fs-xs;
                                font-weight: root.panel-mode == "tunnels" ? 600 : 400;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        // Transfers tab (inline transfer manager + badge)
                        Rectangle {
                            width: root.transfers.length > 0 ? 84px : 66px;
                            height: 22px;
                            border-radius: 5px;
                            background: root.panel-mode == "transfers"
                                ? Theme.bg-active
                                : (transfers-tab-ta.has-hover ? Theme.bg-hover : transparent);
                            transfers-tab-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    TooltipState.hide(@tr("View file upload & download tasks"));
                                    root.panel-mode = "transfers";
                                }
                                changed has-hover => {
                                    if (self.has-hover) {
                                        TooltipState.show(@tr("View file upload & download tasks"), parent.absolute-position.x, parent.absolute-position.y, parent.width, parent.height);
                                    } else {
                                        TooltipState.hide(@tr("View file upload & download tasks"));
                                    }
                                }
                            }
                            HorizontalLayout {
                                padding-left: 6px;
                                padding-right: 6px;
                                spacing: 4px;
                                alignment: center;
                                if root.has-active-transfers : Rectangle {
                                    width: 6px;
                                    height: 6px;
                                    y: (parent.height - self.height) / 2;
                                    border-radius: 3px;
                                    background: Theme.success;
                                }
                                Text {
                                    text: root.transfers.length > 0
                                        ? (@tr("Transfers") + " (" + root.transfers.length + ")")
                                        : @tr("Transfers");
                                    color: root.panel-mode == "transfers"
                                        ? Theme.text-primary
                                        : (root.has-active-transfers ? Theme.text-primary : Theme.text-secondary);
                                    font-size: Theme.fs-xs;
                                    font-weight: root.panel-mode == "transfers" || root.has-active-transfers ? 600 : 400;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }

                // Split view toggle pill (with icon + tooltip)
                if root.panel-mode == "files" : SftpPillBtn {
                    y: (parent.height - self.height) / 2;
                    icon: "split";
                    label: root.width > 360px ? @tr("Split view") : "";
                    active: root.dual;
                    tooltip: @tr("Toggle local/remote split view");
                    clicked => { root.toggle-dual(); }
                }

                // Directory tree toggle (single-pane only)
                if root.panel-mode == "files" && !root.dual && root.show-tree : SftpIconBtn {
                    y: (parent.height - self.height) / 2;
                    icon: "tree";
                    active: root.user-show-tree;
                    tooltip: @tr("Toggle directory tree");
                    clicked => { root.user-show-tree = !root.user-show-tree; }
                }

                Rectangle { horizontal-stretch: 1; }

                // Quick Layout & Fullscreen Switcher Group: Bottom | Top | Left | Right | Fullscreen
                Rectangle {
                    y: (parent.height - self.height) / 2;
                    height: 28px;
                    border-radius: 7px;
                    background: Theme.bg-root;
                    border-width: 1px;
                    border-color: Theme.border-subtle;
                    HorizontalLayout {
                        padding: 1px;
                        spacing: 1px;

                        SftpIconBtn {
                            y: (parent.height - self.height) / 2;
                            icon: "dock-bottom";
                            active: !root.sftp-fullscreen && root.dock-edge == "bottom";
                            tooltip: @tr("Dock SFTP panel to bottom");
                            clicked => { root.set-dock-edge("bottom"); }
                        }

                        SftpIconBtn {
                            y: (parent.height - self.height) / 2;
                            icon: "dock-top";
                            active: !root.sftp-fullscreen && root.dock-edge == "top";
                            tooltip: @tr("Dock SFTP panel to top");
                            clicked => { root.set-dock-edge("top"); }
                        }

                        SftpIconBtn {
                            y: (parent.height - self.height) / 2;
                            icon: "dock-left";
                            active: !root.sftp-fullscreen && root.dock-edge == "left";
                            tooltip: @tr("Dock SFTP panel to left");
                            clicked => { root.set-dock-edge("left"); }
                        }

                        SftpIconBtn {
                            y: (parent.height - self.height) / 2;
                            icon: "dock-right";
                            active: !root.sftp-fullscreen && root.dock-edge == "right";
                            tooltip: @tr("Dock SFTP panel to right");
                            clicked => { root.set-dock-edge("right"); }
                        }

                        Rectangle {
                            width: 1px;
                            height: 16px;
                            y: (parent.height - self.height) / 2;
                            background: Theme.border-subtle;
                        }

                        SftpIconBtn {
                            y: (parent.height - self.height) / 2;
                            icon: root.sftp-fullscreen ? "minimize" : "maximize";
                            active: root.sftp-fullscreen;
                            tooltip-left: true;
                            tooltip: root.sftp-fullscreen ? @tr("Restore SFTP panel size") : @tr("Fullscreen SFTP panel");
                            clicked => { root.toggle-fullscreen(); }
                        }
                    }
                }

                // Collapse / Expand SFTP drawer button
                SftpIconBtn {
                    y: (parent.height - self.height) / 2;
                    icon: root.collapsed ? "chevron-up" : "chevron-down";
                    tooltip-left: true;
                    tooltip: root.collapsed ? @tr("Expand panel") : @tr("Collapse panel");
                    clicked => { root.toggle-collapsed(); }
                }
            }
        }
        Rectangle { height: 1px; background: Theme.border-subtle; }

        // --- Inline Live Transfer Progress Bar (no secondary popup needed!) --
        if root.transfers.length > 0 && root.panel-mode == "files" && !root.collapsed : SftpInlineTransferStrip {
            transfers: root.transfers;
            has-active-transfers: root.has-active-transfers;
            open-transfers-tab => { root.panel-mode = "transfers"; }
            clear-transfers => { root.clear-transfers(); }
        }
        if root.transfers.length > 0 && root.panel-mode == "files" && !root.collapsed : Rectangle {
            height: 1px;
            background: Theme.border-subtle;
        }

        // Inline New Folder / New File bar (replaces unnecessary popup modal)
        if root.inline-create-kind != "" && root.panel-mode == "files" : Rectangle {
            height: 36px;
            background: Theme.bg-panel;
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 10px;
                spacing: 8px;
                OutlineIcon {
                    y: (parent.height - self.height) / 2;
                    name: root.inline-create-kind == "mkdir" ? "folder-plus" : "file-plus";
                    icon-size: 16px;
                    color: Theme.text-secondary;
                }
                Text {
                    text: root.inline-create-kind == "mkdir" ? @tr("New folder") : @tr("New file");
                    color: Theme.text-secondary;
                    font-size: Theme.fs-xs;
                    font-weight: 600;
                    vertical-alignment: center;
                }
                Rectangle {
                    horizontal-stretch: 1;
                    height: 26px;
                    y: (parent.height - self.height) / 2;
                    border-radius: Theme.radius-sm;
                    background: Theme.bg-root;
                    border-width: 1px;
                    border-color: Theme.border-strong;
                    sftp-inline-input := TextInput {
                        x: 8px;
                        width: parent.width - 16px;
                        height: parent.height;
                        text <=> root.inline-create-name;
                        color: Theme.text-primary;
                        font-family: Theme.ui-font-family;
                        font-size: Theme.fs-sm;
                        vertical-alignment: center;
                        single-line: true;
                        init => { self.focus(); }
                        accepted => {
                            if (root.inline-create-name != "") {
                                root.create-entry-inline(root.inline-create-kind, root.current-path, root.inline-create-name);
                                root.inline-create-kind = "";
                                root.inline-create-name = "";
                            }
                        }
                    }
                    if root.inline-create-name == "" : Text {
                        x: 8px;
                        width: parent.width - 16px;
                        height: parent.height;
                        text: root.inline-create-kind == "mkdir" ? @tr("Enter folder name...") : @tr("Enter file name...");
                        color: Theme.text-muted;
                        font-size: Theme.fs-sm;
                        horizontal-alignment: left;
                        vertical-alignment: center;
                    }
                }
                SftpIconBtn {
                    y: (parent.height - self.height) / 2;
                    icon: "check";
                    tooltip: @tr("Create");
                    clicked => {
                        if (root.inline-create-name != "") {
                            root.create-entry-inline(root.inline-create-kind, root.current-path, root.inline-create-name);
                            root.inline-create-kind = "";
                            root.inline-create-name = "";
                        }
                    }
                }
                SftpIconBtn {
                    y: (parent.height - self.height) / 2;
                    icon: "close";
                    tooltip: @tr("Cancel");
                    clicked => {
                        root.inline-create-kind = "";
                        root.inline-create-name = "";
                    }
                }
            }
        }
        if root.inline-create-kind != "" && root.panel-mode == "files" : Rectangle {
            height: 1px;
            background: Theme.border-subtle;
        }

        // --- Main area: tree (left) + file list (right) --------------------
        if root.panel-mode == "files" : HorizontalLayout {
            vertical-stretch: 1;
            spacing: 0;

            // ── Left: directory tree (hidden when the panel is narrow) ──────
            if root.tree-shown : VerticalLayout {
                width: root.tree-width;
                spacing: 0;

                Rectangle {
                    height: 24px;
                    background: Theme.bg-root;
                    Text {
                        x: 8px;
                        text: @tr("Directory tree");
                        color: Theme.text-muted;
                        font-size: Theme.fs-xs;
                        vertical-alignment: center;
                        height: parent.height;
                    }
                }
                Rectangle { height: 1px; background: Theme.border-subtle; }

                ScrollView {
                    vertical-stretch: 1;

                    tree-list := VerticalLayout {
                        spacing: 0;

                        for node[i] in root.tree-nodes : Rectangle {
                            height: 24px;
                            background: node-ta.has-hover
                                ? Theme.bg-hover
                                : (node.path == root.current-path
                                    ? Theme.accent.with-alpha(0.18)
                                    : transparent);

                            node-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.tree-expand(node.path); }
                            }

                            HorizontalLayout {
                                spacing: 0;
                                padding-top: 1px;

                                Rectangle { width: node.depth * 12px; }

                                Text {
                                    width: 14px;
                                    text: node.has-children
                                        ? (node.expanded ? "▼" : "▶")
                                        : " ";
                                    color: Theme.text-muted;
                                    font-size: 9px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                Text {
                                    text: node.depth == 0 ? "/" : node.name;
                                    color: node.path == root.current-path
                                        ? Theme.accent
                                        : Theme.text-primary;
                                    font-size: Theme.fs-sm;
                                    horizontal-stretch: 1;
                                    overflow: elide;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
            }

            // Draggable directory-tree divider (#287).
            if root.tree-shown : Rectangle {
                width: 5px;
                background: tree-split.pressed ? Theme.accent : Theme.border-subtle;
                tree-split := TouchArea {
                    x: -3px;
                    width: parent.width + 6px;
                    mouse-cursor: ew-resize;
                    pointer-event(ev) => {
                        if (ev.kind == PointerEventKind.down) {
                            root.tree-resizing = true;
                        } else if (ev.kind == PointerEventKind.up) {
                            root.tree-resizing = false;
                            root.persist-tree-width(root.tree-width);
                        }
                    }
                    moved => {
                        if (root.tree-resizing) {
                            root.tree-width = clamp(
                                self.absolute-position.x + self.mouse-x - root.absolute-position.x,
                                120px, min(420px, root.width - 220px));
                        }
                    }
                }
            }

            // ── Left (split view): local folders, resizable ─────────────────
            if root.dual : LocalPane {
                width: root.local-w;
                entries: root.local-entries;
                path: root.local-path;
                loading: root.local-loading;
                status: root.local-status;
                selected-count: root.local-selected-count;
                quick-places: root.local-quick-places;
                drive-places: root.local-drive-places;
                bookmarks: root.local-bookmarks;
                recent: root.local-recent;
                bookmarked: root.local-bookmarked;
                show-hidden <=> root.local-show-hidden;
                sub-open <=> root.local-sub-open;
                sort-key: root.local-sort-key;
                sort-dir: root.local-sort-dir;
                filter: root.local-filter;
                navigate(path)        => { root.local-navigate(path); }
                up()                  => { root.local-up(); }
                home()                => { root.local-home(); }
                refresh()             => { root.local-refresh(); }
                places-refresh()      => { root.local-places-refresh(); }
                toggle-bookmark()     => { root.local-toggle-bookmark(); }
                remove-bookmark(path) => { root.local-remove-bookmark(path); }
                clear-recent()        => { root.local-clear-recent(); }
                toggle-hidden()       => { root.local-toggle-hidden(); }
                sort(column)          => { root.local-sort(column); }
                set-filter(text)      => { root.local-set-filter(text); }
                remove-recent(path)   => { root.local-remove-recent(path); }
                move-bookmark(path, delta) => { root.local-move-bookmark(path, delta); }
                reveal()              => { root.local-reveal(); }
                open(path)            => { root.local-open(path); }
                toggle-select(i)      => { root.local-toggle-select(i); }
                select-range(a, b)    => { root.local-select-range(a, b); }
                copy-path(path)       => { root.local-copy-path(path); }
                upload(path)          => { root.local-upload(path); }
                upload-selected()     => { root.local-upload-selected(); }
                sort-request(k, d)    => { root.local-sort-request(k, d); }
                entry-matches(n, t, q) => { return root.entry-matches(n, t, q); }
                drag-begin(row, count, label, ax, ay) => {
                    root.begin-drag("local", row, count, label, ax, ay);
                }
                drag-move(ax, ay)     => { root.update-drag(ax, ay); }
                drag-end(ax, ay)      => { root.end-drag(ax, ay); }
                drag-cancel()         => { root.cancel-drag(); }
            }

            // Divider between the local and remote halves. Dragging moves it;
            // double-clicking puts it back in the middle.
            if root.dual : Rectangle {
                width: 5px;
                background: local-split.pressed ? Theme.accent : (Theme.dark ? #3a3d46 : Theme.border-subtle);
                local-split := TouchArea {
                    x: -3px;
                    width: parent.width + 6px;
                    mouse-cursor: ew-resize;
                    pointer-event(ev) => {
                        if (ev.kind == PointerEventKind.down) {
                            root.local-resizing = true;
                        } else if (ev.kind == PointerEventKind.up) {
                            root.local-resizing = false;
                            root.persist-local-pane-width(root.local-pane-width);
                            root.persist-local-split-ratio(
                                root.width > 0px ? root.local-pane-width / root.width : 0.0);
                        }
                    }
                    moved => {
                        if (root.local-resizing) {
                            root.local-pane-width = clamp(
                                self.absolute-position.x + self.mouse-x - root.absolute-position.x,
                                160px, max(160px, root.width - 200px));
                        }
                    }
                    double-clicked => {
                        // Back to an even split.
                        root.local-pane-width = 0px;
                        root.persist-local-pane-width(0px);
                        root.persist-local-split-ratio(0.0);
                    }
                }
            }

            // ── Right: file listing ─────────────────────────────────────────
            Rectangle {
                horizontal-stretch: 1;
                clip: true;

                VerticalLayout {
                    width: parent.width;
                    height: parent.height;
                    spacing: 0;

                    // --- Row 1: Dedicated Full-Width Remote Path & Navigation Bar ---
                    Rectangle {
                        height: 32px;
                        background: Theme.bg-panel;
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 4px;

                            // Remote pane badge (symmetrical with LocalPane's "本机" badge)
                            Rectangle {
                                width: rem-badge-txt.preferred-width + 12px;
                                height: 22px;
                                y: (parent.height - self.height) / 2;
                                border-radius: 5px;
                                background: Theme.bg-elevated;
                                border-width: 1px;
                                border-color: Theme.border-subtle;
                                rem-badge-txt := Text {
                                    text: @tr("Remote");
                                    color: Theme.text-secondary;
                                    font-size: 11px * Theme.ui-scale;
                                    font-weight: 600;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    width: parent.width;
                                    height: parent.height;
                                }
                            }

                            SftpIconBtn {
                                y: (parent.height - self.height) / 2;
                                icon: "up";
                                tooltip: @tr("Parent directory (..)");
                                clicked => { root.navigate(".."); }
                            }

                            SftpIconBtn {
                                y: (parent.height - self.height) / 2;
                                icon: "refresh";
                                tooltip: @tr("Refresh remote folder");
                                clicked => { root.refresh(root.current-path); }
                            }

                            // Full-width Remote path bar with subfolder autocomplete & Bookmark Star
                            Rectangle {
                                horizontal-stretch: 1;
                                min-width: 72px;
                                height: 24px;
                                y: (parent.height - self.height) / 2;
                                border-radius: 6px;
                                background: Theme.bg-root;
                                border-width: 1px;
                                border-color: remote-path-input.has-focus || root.remote-sub-open ? Theme.accent : Theme.border-subtle;
                                remote-path-input := TextInput {
                                    x: 8px;
                                    width: max(20px, parent.width - 54px);
                                    height: parent.height;
                                    text <=> root.path-text;
                                    color: Theme.text-primary;
                                    font-family: Theme.ui-font-family;
                                    font-size: Theme.fs-sm;
                                    vertical-alignment: center;
                                    single-line: true;
                                    accepted => {
                                        root.remote-sub-open = false;
                                        root.navigate(self.text);
                                    }
                                    edited => {
                                        root.remote-sub-open = true;
                                    }
                                    changed has-focus => {
                                        if (self.has-focus) {
                                            root.remote-sub-open = true;
                                        }
                                    }
                                }
                                // Quick subfolder autocomplete dropdown trigger button
                                Rectangle {
                                    x: parent.width - 48px;
                                    y: (parent.height - self.height) / 2;
                                    width: 22px;
                                    height: 20px;
                                    border-radius: 4px;
                                    background: root.remote-sub-open ? Theme.bg-active : (rsub-btn-ta.has-hover ? Theme.bg-hover : transparent);
                                    rsub-btn-ta := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            TooltipState.hide(@tr("Quick subfolder autocomplete"));
                                            root.remote-sub-open = !root.remote-sub-open;
                                            if (!root.remote-sub-open) {
                                                remote-path-input.clear-focus();
                                            }
                                        }
                                        changed has-hover => {
                                            if (self.has-hover) {
                                                TooltipState.show(@tr("Quick subfolder autocomplete"), parent.absolute-position.x, parent.absolute-position.y, parent.width, parent.height);
                                            } else {
                                                TooltipState.hide(@tr("Quick subfolder autocomplete"));
                                            }
                                        }
                                    }
                                    OutlineIcon {
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        name: root.remote-sub-open ? "chevron-up" : "chevron-down";
                                        icon-size: 13px * Theme.ui-scale;
                                        color: root.remote-sub-open || rsub-btn-ta.has-hover ? Theme.text-primary : Theme.text-muted;
                                    }
                                }
                                SftpStarButton {
                                    x: parent.width - 25px;
                                    y: (parent.height - self.height) / 2;
                                    bookmarked: root.bookmarked;
                                    toggled => { root.toggle-bookmark(root.current-path); }
                                }
                            }

                            SftpPlacesButton {
                                y: (parent.height - self.height) / 2;
                                bookmarks: root.bookmarks;
                                recent: root.recent;
                                current-path: root.current-path;
                                bookmarked: root.bookmarked;
                                opened => { root.places-refresh(); }
                                navigate(p) => { root.navigate(p); }
                                toggle-bookmark => { root.toggle-bookmark(root.current-path); }
                                remove-bookmark(p) => { root.remove-bookmark(p); }
                                clear-recent => { root.clear-recent(); }
                            }
                        }
                    }
                    Rectangle { height: 1px; background: Theme.border-subtle.with-alpha(0.6); }

                    // --- Row 2: Filter, Show/Hide Hidden Files & Remote Actions Bar ---
                    Rectangle {
                        height: 32px;
                        background: Theme.bg-panel;
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 4px;

                            // Full-width Real-time Filter Box
                            Rectangle {
                                horizontal-stretch: 1;
                                min-width: 72px;
                                height: 24px;
                                y: (parent.height - self.height) / 2;
                                border-radius: 6px;
                                background: Theme.bg-root;
                                border-width: 1px;
                                border-color: drfilter-input.has-focus || root.filter-text != "" ? Theme.accent : Theme.border-subtle;
                                OutlineIcon {
                                    x: 7px;
                                    y: (parent.height - self.height) / 2;
                                    name: "search";
                                    icon-size: 13px;
                                    color: root.filter-text != "" ? Theme.accent : Theme.text-muted;
                                }
                                drfilter-input := TextInput {
                                    x: 24px;
                                    width: max(20px, parent.width - (root.filter-text != "" ? 44px : 28px));
                                    height: parent.height;
                                    text <=> root.filter-text;
                                    color: Theme.text-primary;
                                    font-family: Theme.ui-font-family;
                                    font-size: Theme.fs-xs;
                                    vertical-alignment: center;
                                    single-line: true;
                                }
                                if root.filter-text == "" && !drfilter-input.has-focus : Text {
                                    x: 24px;
                                    width: max(0px, parent.width - 28px);
                                    height: parent.height;
                                    text: @tr("Filter files...");
                                    color: Theme.text-muted;
                                    font-size: Theme.fs-xs;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                if root.filter-text != "" : Rectangle {
                                    x: parent.width - 20px;
                                    y: (parent.height - self.height) / 2;
                                    width: 16px;
                                    height: 16px;
                                    border-radius: 4px;
                                    background: drclr-ta.has-hover ? Theme.bg-hover : transparent;
                                    drclr-ta := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.filter-text = ""; }
                                    }
                                    OutlineIcon {
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        name: "close";
                                        icon-size: 11px;
                                        color: Theme.text-muted;
                                    }
                                }
                            }

                            // Show / Hide Hidden Files (dotfiles starting with .)
                            SftpIconBtn {
                                y: (parent.height - self.height) / 2;
                                icon: root.show-hidden ? "eye" : "eye-off";
                                active: root.show-hidden;
                                tooltip: root.show-hidden ? @tr("Hide hidden files (.*)") : @tr("Show hidden files (.*)");
                                clicked => { root.show-hidden = !root.show-hidden; }
                            }

                            SftpIconBtn {
                                y: (parent.height - self.height) / 2;
                                icon: "folder-plus";
                                active: root.inline-create-kind == "mkdir";
                                tooltip: @tr("New folder");
                                clicked => {
                                    if (root.inline-create-kind == "mkdir") {
                                        root.inline-create-kind = "";
                                    } else {
                                        root.inline-create-kind = "mkdir";
                                        root.inline-create-name = "";
                                    }
                                }
                            }

                            SftpIconBtn {
                                y: (parent.height - self.height) / 2;
                                icon: "file-plus";
                                active: root.inline-create-kind == "touch";
                                tooltip: @tr("New file");
                                clicked => {
                                    if (root.inline-create-kind == "touch") {
                                        root.inline-create-kind = "";
                                    } else {
                                        root.inline-create-kind = "touch";
                                        root.inline-create-name = "";
                                    }
                                }
                            }

                            if root.list-w > 420px : SftpIconBtn {
                                y: (parent.height - self.height) / 2;
                                icon: "copy";
                                tooltip: @tr("Copy path");
                                clicked => { root.copy-path(root.current-path); }
                            }

                            if root.list-w > 450px : SftpIconBtn {
                                y: (parent.height - self.height) / 2;
                                icon: "paste";
                                tooltip: @tr("Paste path and go");
                                clicked => {
                                    remote-path-input.select-all();
                                    remote-path-input.paste();
                                    root.navigate(remote-path-input.text);
                                }
                            }

                            SftpPillBtn {
                                y: (parent.height - self.height) / 2;
                                icon: "upload";
                                label: root.list-w > 280px ? @tr("Upload") : "";
                                primary: true;
                                tooltip-left: true;
                                tooltip: @tr("Upload files to current directory");
                                clicked => { root.upload-clicked(root.current-path, false); }
                            }

                            SftpIconBtn {
                                y: (parent.height - self.height) / 2;
                                icon: "folder-upload";
                                tooltip-left: true;
                                tooltip: @tr("Upload folder to current directory");
                                clicked => { root.upload-clicked(root.current-path, true); }
                            }

                            if root.selected-count > 0 : SftpIconBtn {
                                y: (parent.height - self.height) / 2;
                                icon: "download";
                                tooltip-left: true;
                                tooltip: @tr("Download checked items");
                                clicked => { root.download-selected(); }
                            }
                            if root.selected-count > 0 : SftpIconBtn {
                                y: (parent.height - self.height) / 2;
                                icon: "trash";
                                danger: true;
                                tooltip-left: true;
                                tooltip: @tr("Delete checked items");
                                clicked => { root.delete-selected(); }
                            }
                        }
                    }
                    Rectangle { height: 1px; background: Theme.border-subtle; }

                    // Column headers (Single Exclusive Sort: Asc/Desc)
                    column-header := Rectangle {
                        height: 26px;
                        background: Theme.bg-root;
                        HorizontalLayout {
                            padding-left: 8px; padding-right: 8px; spacing: 8px;
                            Rectangle { width: 16px; }
                            Rectangle {
                                horizontal-stretch: 1;
                                min-width: root.name-min;
                                border-radius: 4px;
                                background: header-name-ta.has-hover ? Theme.bg-hover : transparent;
                                header-name-ta := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        TooltipState.hide(@tr("Sort by name (asc/desc)"));
                                        root.sort-request("name");
                                    }
                                    changed has-hover => {
                                        if (self.has-hover) {
                                            TooltipState.show(@tr("Sort by name (asc/desc)"), parent.absolute-position.x, parent.absolute-position.y, parent.width, parent.height);
                                        } else {
                                            TooltipState.hide(@tr("Sort by name (asc/desc)"));
                                        }
                                    }
                                    pointer-event(ev) => {
                                        if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.right) {
                                            root.column-menu-x = self.absolute-position.x + self.mouse-x - column-header.absolute-position.x;
                                            root.column-menu-y = self.absolute-position.y + self.mouse-y - column-header.absolute-position.y;
                                            column-menu.show();
                                        }
                                    }
                                }
                                Text {
                                    text: @tr("Name") + (root.effective-sort-key == "name" ? (root.effective-sort-dir > 0 ? " ↑" : " ↓") : " ↕");
                                    color: root.effective-sort-key == "name" ? Theme.accent : (header-name-ta.has-hover ? Theme.text-primary : Theme.text-muted);
                                    font-size: Theme.fs-xs;
                                    font-weight: root.effective-sort-key == "name" ? 600 : 500;
                                    width: parent.width;
                                    horizontal-alignment: left;
                                    vertical-alignment: center;
                                }
                            }
                            if root.show-size-col : Rectangle {
                                width: 68px;
                                border-radius: 4px;
                                background: header-size-ta.has-hover ? Theme.bg-hover : transparent;
                                header-size-ta := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        TooltipState.hide(@tr("Sort by size (asc/desc)"));
                                        root.sort-request("size");
                                    }
                                    changed has-hover => {
                                        if (self.has-hover) {
                                            TooltipState.show(@tr("Sort by size (asc/desc)"), parent.absolute-position.x, parent.absolute-position.y, parent.width, parent.height);
                                        } else {
                                            TooltipState.hide(@tr("Sort by size (asc/desc)"));
                                        }
                                    }
                                    pointer-event(ev) => {
                                        if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.right) {
                                            root.column-menu-x = self.absolute-position.x + self.mouse-x - column-header.absolute-position.x;
                                            root.column-menu-y = self.absolute-position.y + self.mouse-y - column-header.absolute-position.y;
                                            column-menu.show();
                                        }
                                    }
                                }
                                Text {
                                    text: @tr("Size") + (root.effective-sort-key == "size" ? (root.effective-sort-dir > 0 ? " ↑" : " ↓") : " ↕");
                                    color: root.effective-sort-key == "size" ? Theme.accent : (header-size-ta.has-hover ? Theme.text-primary : Theme.text-muted);
                                    font-size: Theme.fs-xs;
                                    font-weight: root.effective-sort-key == "size" ? 600 : 500;
                                    width: parent.width;
                                    horizontal-alignment: right;
                                    vertical-alignment: center;
                                }
                            }
                            if root.show-type-col : Rectangle {
                                width: 88px;
                                border-radius: 4px;
                                background: type-header-ta.has-hover ? Theme.bg-hover : transparent;
                                type-header-ta := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        TooltipState.hide(@tr("Sort by type (asc/desc)"));
                                        root.sort-request("type");
                                    }
                                    changed has-hover => {
                                        if (self.has-hover) {
                                            TooltipState.show(@tr("Sort by type (asc/desc)"), parent.absolute-position.x, parent.absolute-position.y, parent.width, parent.height);
                                        } else {
                                            TooltipState.hide(@tr("Sort by type (asc/desc)"));
                                        }
                                    }
                                    pointer-event(ev) => {
                                        if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.right) {
                                            root.column-menu-x = self.absolute-position.x + self.mouse-x - column-header.absolute-position.x;
                                            root.column-menu-y = self.absolute-position.y + self.mouse-y - column-header.absolute-position.y;
                                            column-menu.show();
                                        }
                                    }
                                }
                                Text {
                                    text: @tr("Type") + (root.effective-sort-key == "type" ? (root.effective-sort-dir > 0 ? " ↑" : " ↓") : " ↕");
                                    color: root.effective-sort-key == "type" ? Theme.accent : (type-header-ta.has-hover ? Theme.text-primary : Theme.text-muted);
                                    font-size: Theme.fs-xs;
                                    font-weight: root.effective-sort-key == "type" ? 600 : 500;
                                    width: parent.width;
                                    horizontal-alignment: right;
                                    vertical-alignment: center;
                                }
                            }
                            if root.show-modified-col : Rectangle {
                                width: 112px;
                                border-radius: 4px;
                                background: header-modified-ta.has-hover ? Theme.bg-hover : transparent;
                                header-modified-ta := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        TooltipState.hide(@tr("Sort by modified time (asc/desc)"));
                                        root.sort-request("modified");
                                    }
                                    changed has-hover => {
                                        if (self.has-hover) {
                                            TooltipState.show(@tr("Sort by modified time (asc/desc)"), parent.absolute-position.x, parent.absolute-position.y, parent.width, parent.height);
                                        } else {
                                            TooltipState.hide(@tr("Sort by modified time (asc/desc)"));
                                        }
                                    }
                                    pointer-event(ev) => {
                                        if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.right) {
                                            root.column-menu-x = self.absolute-position.x + self.mouse-x - column-header.absolute-position.x;
                                            root.column-menu-y = self.absolute-position.y + self.mouse-y - column-header.absolute-position.y;
                                            column-menu.show();
                                        }
                                    }
                                }
                                Text {
                                    text: @tr("Modified") + (root.effective-sort-key == "modified" ? (root.effective-sort-dir > 0 ? " ↑" : " ↓") : " ↕");
                                    color: root.effective-sort-key == "modified" ? Theme.accent : (header-modified-ta.has-hover ? Theme.text-primary : Theme.text-muted);
                                    font-size: Theme.fs-xs;
                                    font-weight: root.effective-sort-key == "modified" ? 600 : 500;
                                    width: parent.width;
                                    horizontal-alignment: right;
                                    vertical-alignment: center;
                                }
                            }
                            if root.show-permissions-col : Rectangle {
                                width: 100px;
                                border-radius: 4px;
                                background: permissions-header-ta.has-hover ? Theme.bg-hover : transparent;
                                permissions-header-ta := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        TooltipState.hide(@tr("Sort by permissions (asc/desc)"));
                                        root.sort-request("permissions");
                                    }
                                    changed has-hover => {
                                        if (self.has-hover) {
                                            TooltipState.show(@tr("Sort by permissions (asc/desc)"), parent.absolute-position.x, parent.absolute-position.y, parent.width, parent.height);
                                        } else {
                                            TooltipState.hide(@tr("Sort by permissions (asc/desc)"));
                                        }
                                    }
                                    pointer-event(ev) => {
                                        if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.right) {
                                            root.column-menu-x = self.absolute-position.x + self.mouse-x - column-header.absolute-position.x;
                                            root.column-menu-y = self.absolute-position.y + self.mouse-y - column-header.absolute-position.y;
                                            column-menu.show();
                                        }
                                    }
                                }
                                Text {
                                    text: @tr("Permissions") + (root.effective-sort-key == "permissions" ? (root.effective-sort-dir > 0 ? " ↑" : " ↓") : " ↕");
                                    color: root.effective-sort-key == "permissions" ? Theme.accent : (permissions-header-ta.has-hover ? Theme.text-primary : Theme.text-muted);
                                    font-size: Theme.fs-xs;
                                    font-weight: root.effective-sort-key == "permissions" ? 600 : 500;
                                    width: parent.width;
                                    horizontal-alignment: right;
                                    vertical-alignment: center;
                                }
                            }
                            if root.show-owner-col : Rectangle {
                                width: 80px;
                                border-radius: 4px;
                                background: owner-header-ta.has-hover ? Theme.bg-hover : transparent;
                                owner-header-ta := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        TooltipState.hide(@tr("Sort by owner (asc/desc)"));
                                        root.sort-request("owner");
                                    }
                                    changed has-hover => {
                                        if (self.has-hover) {
                                            TooltipState.show(@tr("Sort by owner (asc/desc)"), parent.absolute-position.x, parent.absolute-position.y, parent.width, parent.height);
                                        } else {
                                            TooltipState.hide(@tr("Sort by owner (asc/desc)"));
                                        }
                                    }
                                    pointer-event(ev) => {
                                        if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.right) {
                                            root.column-menu-x = self.absolute-position.x + self.mouse-x - column-header.absolute-position.x;
                                            root.column-menu-y = self.absolute-position.y + self.mouse-y - column-header.absolute-position.y;
                                            column-menu.show();
                                        }
                                    }
                                }
                                Text {
                                    text: @tr("Owner") + (root.effective-sort-key == "owner" ? (root.effective-sort-dir > 0 ? " ↑" : " ↓") : " ↕");
                                    color: root.effective-sort-key == "owner" ? Theme.accent : (owner-header-ta.has-hover ? Theme.text-primary : Theme.text-muted);
                                    font-size: Theme.fs-xs;
                                    font-weight: root.effective-sort-key == "owner" ? 600 : 500;
                                    width: parent.width;
                                    horizontal-alignment: right;
                                    vertical-alignment: center;
                                }
                            }
                            if root.show-group-col : Rectangle {
                                width: 80px;
                                border-radius: 4px;
                                background: group-header-ta.has-hover ? Theme.bg-hover : transparent;
                                group-header-ta := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        TooltipState.hide(@tr("Sort by group (asc/desc)"));
                                        root.sort-request("group");
                                    }
                                    changed has-hover => {
                                        if (self.has-hover) {
                                            TooltipState.show(@tr("Sort by group (asc/desc)"), parent.absolute-position.x, parent.absolute-position.y, parent.width, parent.height);
                                        } else {
                                            TooltipState.hide(@tr("Sort by group (asc/desc)"));
                                        }
                                    }
                                    pointer-event(ev) => {
                                        if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.right) {
                                            column-menu.show();
                                        }
                                    }
                                }
                                Text {
                                    text: @tr("Group") + (root.effective-sort-key == "group" ? (root.effective-sort-dir > 0 ? " ↑" : " ↓") : " ↕");
                                    color: root.effective-sort-key == "group" ? Theme.accent : (group-header-ta.has-hover ? Theme.text-primary : Theme.text-muted);
                                    font-size: Theme.fs-xs;
                                    font-weight: root.effective-sort-key == "group" ? 600 : 500;
                                    width: parent.width;
                                    horizontal-alignment: right;
                                    vertical-alignment: center;
                                }
                            }
                        }
                        column-menu := PopupWindow {
                            x: root.column-menu-x; y: root.column-menu-y;
                            width: 184px; height: 7 * 29px + 10px;
                            Rectangle {
                                background: Theme.popup-bg;
                                border-radius: Theme.radius-md;
                                border-width: 1px;
                                border-color: Theme.border-strong;
                                drop-shadow-blur: 14px;
                                drop-shadow-color: #00000060;
                                VerticalLayout {
                                    padding: 5px; spacing: 1px;
                                    SftpMenuItem { icon: root.show-size ? "check" : ""; label: @tr("Size"); clicked => { root.toggle-column("size"); } }
                                    SftpMenuItem { icon: root.show-type ? "check" : ""; label: @tr("Type"); clicked => { root.toggle-column("type"); } }
                                    SftpMenuItem { icon: root.show-modified ? "check" : ""; label: @tr("Modified"); clicked => { root.toggle-column("modified"); } }
                                    SftpMenuItem { icon: root.show-permissions ? "check" : ""; label: @tr("Permissions"); clicked => { root.toggle-column("permissions"); } }
                                    SftpMenuItem { icon: root.show-owner ? "check" : ""; label: @tr("Owner"); clicked => { root.toggle-column("owner"); } }
                                    SftpMenuItem { icon: root.show-group ? "check" : ""; label: @tr("Group"); clicked => { root.toggle-column("group"); } }
                                    SftpMenuItem { icon: "check"; label: @tr("Name"); enabled: false; }
                                }
                            }
                        }
                    }
                    Rectangle { height: 1px; background: Theme.border-subtle; }

                    // File list
                    file-area := Rectangle {
                        vertical-stretch: 1;
                        clip: true;
                        file-keys := FocusScope {
                            x: 0; y: 0;
                            width: 0; height: 0;
                            key-pressed(event) => {
                                if (event.text == Key.Shift || event.text == Key.ShiftR
                                        || event.text == Key.Control || event.text == Key.ControlR
                                        || event.text == Key.Alt || event.text == Key.AltGr
                                        || event.text == Key.Meta || event.text == Key.MetaR) {
                                    accept
                                } else if (root.match-shortcut(event.text, event.modifiers.control,
                                            event.modifiers.meta, event.modifiers.alt,
                                            event.modifiers.shift) == "paste"
                                        || (event.modifiers.control && !event.modifiers.alt
                                            && (event.text == "v" || event.text == "V"))) {
                                    root.paste-upload(root.current-path);
                                    accept
                                } else if ((event.text == Key.Delete
                                            || (Theme.is-mac && event.modifiers.meta && event.text == Key.Backspace))
                                        && !event.modifiers.control && !event.modifiers.alt
                                        && !event.modifiers.shift) {
                                    if (root.selected-count > 0) {
                                        root.delete-selected();
                                    } else if (root.selected-row >= 0 && root.selected-row < root.entries.length) {
                                        root.delete(root.entries[root.selected-row].full-path);
                                    } else {
                                        root.forward-key(event.text,
                                            Theme.is-mac ? event.modifiers.meta : event.modifiers.control,
                                            event.modifiers.alt, event.modifiers.shift);
                                    }
                                    accept
                                } else {
                                    root.forward-key(event.text,
                                        Theme.is-mac ? event.modifiers.meta : event.modifiers.control,
                                        event.modifiers.alt, event.modifiers.shift);
                                    accept
                                }
                            }
                        }
                        ScrollView {
                            width: parent.width;
                            height: parent.height;
                            content-width: self.visible-width;
                            content-height: max(self.visible-height, file-list.preferred-height);

                            file-list := VerticalLayout {
                                spacing: 0;

                                if root.loading : Rectangle {
                                    height: 40px;
                                    Text { text: @tr("Loading..."); color: Theme.text-muted; font-size: Theme.fs-sm;
                                           horizontal-alignment: center; vertical-alignment: center; }
                                }

                                if !root.loading && root.entries.length == 0 : Rectangle {
                                    height: 40px;
                                    Text { text: @tr("Empty directory"); color: Theme.text-muted; font-size: Theme.fs-sm;
                                           horizontal-alignment: center; vertical-alignment: center; }
                                }

                                for entry[i] in root.entries : row := Rectangle {
                                    property <bool> matched: !root.entry-matches("a", "", "") ? true : root.entry-matches(entry.name, entry.file-type, (root.show-hidden ? "" : "__hide_dot__:") + root.filter-text);
                                visible: self.matched;
                                height: self.matched ? 32px : 0px;
                                background: entry.selected
                                    ? Theme.bg-active
                                    : (i == root.selected-row
                                        ? Theme.bg-active
                                        : (row-ta.has-hover
                                            ? Theme.bg-hover
                                            : transparent));
                                if self.matched : Rectangle {
                                    y: parent.height - 1px;
                                    width: 100%;
                                    height: 1px;
                                    background: Theme.border-subtle.with-alpha(0.45);
                                }

                                row-ta := TouchArea {
                                    enabled: parent.matched;
                                    mouse-cursor: pointer;
                                    moved => {
                                        if (self.pressed && !root.drag-out-started
                                                && (abs(self.mouse-x - self.pressed-x) > 6px
                                                    || abs(self.mouse-y - self.pressed-y) > 6px)) {
                                            root.drag-out-started = true;
                                            if (root.dual) {
                                                root.begin-drag(
                                                    "remote",
                                                    i,
                                                    entry.selected && root.selected-count > 1 ? root.selected-count : 1,
                                                    entry.selected && root.selected-count > 1 ? @tr("Selected items") : entry.name,
                                                    self.absolute-position.x + self.mouse-x,
                                                    self.absolute-position.y + self.mouse-y);
                                            } else {
                                                root.drag-out(i);
                                            }
                                        } else if (root.drag-out-started && root.drag-active) {
                                            let ax = self.absolute-position.x + self.mouse-x;
                                            let ay = self.absolute-position.y + self.mouse-y;
                                            if (ax < root.absolute-position.x
                                                    || ax > root.absolute-position.x + root.width
                                                    || ay < root.absolute-position.y
                                                    || ay > root.absolute-position.y + root.height) {
                                                root.cancel-drag();
                                                root.drag-out-started = false;
                                                root.drag-out(i);
                                            } else {
                                                root.update-drag(ax, ay);
                                            }
                                        }
                                    }
                                    clicked => {
                                        root.selected-row = i;
                                        file-keys.focus();
                                        if (root.shift-click-pending) {
                                            root.shift-click-pending = false;
                                        } else {
                                            root.select-anchor = i;
                                        }
                                    }
                                    double-clicked => {
                                        if (entry.is-dir) {
                                            root.navigate(entry.full-path);
                                        } else {
                                            root.open-file(entry.full-path);
                                        }
                                    }
                                    pointer-event(ev) => {
                                        if (ev.kind == PointerEventKind.up) {
                                            if (root.drag-out-started && root.drag-active) {
                                                root.end-drag(self.absolute-position.x + self.mouse-x,
                                                              self.absolute-position.y + self.mouse-y);
                                            }
                                            root.drag-out-started = false;
                                        } else if (ev.kind == PointerEventKind.cancel) {
                                            if (root.drag-active) { root.cancel-drag(); }
                                            root.drag-out-started = false;
                                        } else if (ev.kind == PointerEventKind.down) {
                                            root.drag-out-started = false;
                                        }
                                        if (ev.kind == PointerEventKind.down
                                                && ev.button == PointerEventButton.left
                                                && ev.modifiers.shift) {
                                            root.shift-click-pending = true;
                                            root.select-range(root.select-anchor < 0 ? i : root.select-anchor, i);
                                            if (root.select-anchor < 0) { root.select-anchor = i; }
                                        }
                                        if (ev.kind == PointerEventKind.down
                                                && ev.button == PointerEventButton.right) {
                                            root.selected-row = i;
                                            root.menu-target = entry.full-path;
                                            root.menu-target-name = entry.name;
                                            root.menu-target-is-dir = entry.is-dir;
                                            root.menu-target-mode = entry.mode;
                                            root.menu-on-selection = entry.selected && root.selected-count >= 2;
                                            root.menu-x = self.absolute-position.x + self.mouse-x - file-area.absolute-position.x;
                                            root.menu-y = self.absolute-position.y + self.mouse-y - file-area.absolute-position.y;
                                            file-menu.show();
                                        }
                                    }
                                }

                                if self.matched : HorizontalLayout {
                                    padding-left: 8px; padding-right: 8px; spacing: 8px;
                                    Rectangle {
                                        width: 16px;
                                        y: (parent.height - self.height) / 2;
                                        height: 16px;
                                        opacity: entry.selected || root.selected-count > 0 || row-ta.has-hover || cb-ta.has-hover ? 1.0 : 0.0;
                                        border-radius: 4px;
                                        border-width: 1px;
                                        border-color: entry.selected ? Theme.accent : Theme.border-strong;
                                        background: entry.selected ? Theme.accent : transparent;
                                        cb-ta := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => {
                                                file-keys.focus();
                                                if (root.shift-click-pending) {
                                                    root.shift-click-pending = false;
                                                } else {
                                                    root.toggle-select(i);
                                                    root.select-anchor = i;
                                                }
                                            }
                                            pointer-event(ev) => {
                                                if (ev.kind == PointerEventKind.down
                                                        && ev.button == PointerEventButton.left
                                                        && ev.modifiers.shift) {
                                                    root.shift-click-pending = true;
                                                    root.select-range(root.select-anchor < 0 ? i : root.select-anchor, i);
                                                    if (root.select-anchor < 0) { root.select-anchor = i; }
                                                }
                                            }
                                        }
                                        if entry.selected : Text {
                                            text: "\u{E5CA}"; // check
                                            font-family: "Material Icons";
                                            color: #ffffff;
                                            font-size: 13px;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                            width: parent.width; height: parent.height;
                                        }
                                    }

                                    HorizontalLayout {
                                        horizontal-stretch: 1;
                                        min-width: root.name-min;
                                        spacing: 6px;
                                        Text {
                                            text: entry.is-dir ? "\u{E2C7}" : "\u{E24D}"; // folder / insert_drive_file
                                            font-family: "Material Icons";
                                            color: entry.is-dir ? Theme.accent : Theme.text-muted;
                                            font-size: 17px * Theme.ui-scale;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: entry.name;
                                            color: Theme.text-primary;
                                            font-size: Theme.fs-sm;
                                            font-weight: entry.is-dir ? 500 : 400;
                                            horizontal-stretch: 1;
                                            overflow: elide;
                                            vertical-alignment: center;
                                        }
                                    }
                                    if root.show-size-col : Text {
                                        text: entry.is-dir ? "" : entry.size;
                                        color: Theme.text-secondary; font-size: Theme.fs-xs;
                                        width: 68px; horizontal-alignment: right; vertical-alignment: center;
                                    }
                                    if root.show-type-col : Text {
                                        text: entry.file-type;
                                        color: Theme.text-secondary; font-size: Theme.fs-xs;
                                        width: 88px; horizontal-alignment: right; vertical-alignment: center; overflow: elide;
                                    }
                                    if root.show-modified-col : Text {
                                        text: entry.modified;
                                        color: Theme.text-muted; font-size: Theme.fs-xs;
                                        width: 112px; horizontal-alignment: right; vertical-alignment: center;
                                    }
                                    if root.show-permissions-col : Text {
                                        text: entry.permissions;
                                        color: Theme.text-secondary; font-size: Theme.fs-xs;
                                        width: 100px; horizontal-alignment: right; vertical-alignment: center;
                                    }
                                    if root.show-owner-col : Text {
                                        text: entry.owner;
                                        color: Theme.text-secondary; font-size: Theme.fs-xs;
                                        width: 80px; horizontal-alignment: right; vertical-alignment: center;
                                    }
                                    if root.show-group-col : Text {
                                        text: entry.group;
                                        color: Theme.text-secondary; font-size: Theme.fs-xs;
                                        width: 80px; horizontal-alignment: right; vertical-alignment: center;
                                    }
                                }
                            }

                            // Whitespace below the rows: right-click here opens the
                            // menu with no target (item actions greyed out) (#84).
                            ws := Rectangle {
                                vertical-stretch: 1;
                                min-height: 24px;
                                ws-ta := TouchArea {
                                    clicked => { file-keys.focus(); }
                                    pointer-event(ev) => {
                                        if (ev.kind == PointerEventKind.down
                                                && ev.button == PointerEventButton.right) {
                                            root.selected-row = -1;
                                            root.menu-target = "";
                                            root.menu-on-selection = false;
                                            root.menu-x = self.absolute-position.x + self.mouse-x - file-area.absolute-position.x;
                                            root.menu-y = self.absolute-position.y + self.mouse-y - file-area.absolute-position.y;
                                            file-menu.show();
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // One context menu for the whole list (#84).
                    copy-target-menu := PopupWindow {
                        x: root.menu-x + 148px;
                        y: root.menu-y;
                        width: 156px;
                        height: max(1, root.transfer-targets.length) * 29px + 10px;
                        Rectangle {
                            background: Theme.popup-bg;
                            border-radius: Theme.radius-md;
                            border-width: 1px;
                            border-color: Theme.border-strong;
                            drop-shadow-blur: 14px;
                            drop-shadow-color: #00000060;
                            VerticalLayout {
                                padding: 5px;
                                spacing: 1px;
                                for target in root.transfer-targets : SftpMenuItem {
                                    label: target.title;
                                    icon: "server";
                                    enabled: target.kind == "terminal" && target.connected && target.id != root.current-tab-id;
                                    clicked => {
                                        if (root.selected-count >= 2) {
                                            root.copy-selected-to-target(target.id);
                                        } else if (root.menu-target != "") {
                                            root.copy-to-target(root.menu-target, target.id);
                                        } else {
                                            root.copy-selected-to-target(target.id);
                                        }
                                    }
                                }
                            }
                        }
                    }

                    file-menu := PopupWindow {
                        x: root.menu-x;
                        y: root.menu-y;
                        width: 196px;
                        height: (15 + (root.dual ? 2 : 0)) * 28px + 10px;
                        Rectangle {
                            background: Theme.popup-bg;
                            border-radius: Theme.radius-md;
                            border-width: 1px;
                            border-color: Theme.border-strong;
                            drop-shadow-blur: 14px;
                            drop-shadow-color: #00000060;
                            VerticalLayout {
                                padding: 5px;
                                spacing: 1px;
                                SftpMenuItem {
                                    label: @tr("Download");
                                    icon: "download";
                                    enabled: root.menu-target != "";
                                    clicked => { root.download(root.menu-target); }
                                }
                                if root.dual : SftpMenuItem {
                                    label: @tr("Download to local folder");
                                    icon: "download";
                                    enabled: root.menu-target != "";
                                    clicked => { root.download-to-local(root.menu-target); }
                                }
                                if root.dual : SftpMenuItem {
                                    label: @tr("Download checked to local folder");
                                    icon: "download";
                                    enabled: root.selected-count > 0;
                                    clicked => { root.download-selected-to-local(); }
                                }
                                SftpMenuItem {
                                    label: @tr("View");
                                    icon: "eye";
                                    enabled: root.menu-target != "" && !root.menu-target-is-dir;
                                    clicked => { root.view(root.menu-target); }
                                }
                                SftpMenuItem {
                                    label: @tr("Edit");
                                    icon: "edit";
                                    enabled: root.menu-target != "" && !root.menu-target-is-dir;
                                    clicked => { root.edit(root.menu-target); }
                                }
                                SftpMenuItem {
                                    label: @tr("Open externally");
                                    icon: "folder";
                                    enabled: root.menu-target != "" && !root.menu-target-is-dir;
                                    clicked => { root.open-external(root.menu-target); }
                                }
                                SftpMenuItem {
                                    label: @tr("Edit externally");
                                    icon: "edit";
                                    enabled: root.menu-target != "" && !root.menu-target-is-dir;
                                    clicked => { root.edit-external(root.menu-target); }
                                }
                                SftpMenuItem {
                                    label: @tr("Rename");
                                    icon: "edit";
                                    enabled: root.menu-target != "";
                                    clicked => { root.rename-request(root.menu-target, root.menu-target-name); }
                                }
                                SftpMenuItem {
                                    label: @tr("Permissions");
                                    icon: "lock";
                                    enabled: root.menu-target != "";
                                    clicked => { root.chmod-request(root.menu-target, root.menu-target-name, root.menu-target-mode); }
                                }
                                SftpMenuItem {
                                    label: @tr("Copy path");
                                    icon: "copy";
                                    enabled: root.menu-target != "";
                                    clicked => { root.copy-path(root.menu-target); }
                                }
                                SftpMenuItem {
                                    label: @tr("Copy to session...");
                                    icon: "server";
                                    enabled: (root.menu-target != "" || root.selected-count > 0) && root.transfer-targets.length > 1;
                                    clicked => { copy-target-menu.show(); }
                                }
                                SftpMenuItem {
                                    label: root.menu-on-selection ? @tr("Delete checked items") : @tr("Delete");
                                    icon: "trash";
                                    tint: #d86c6c;
                                    enabled: root.menu-target != "";
                                    clicked => {
                                        if (root.menu-on-selection) {
                                            root.delete-selected();
                                        } else {
                                            root.delete(root.menu-target);
                                        }
                                    }
                                }
                                Rectangle { height: 1px; background: Theme.border-subtle; }
                                SftpMenuItem {
                                    label: @tr("Paste");
                                    icon: "paste";
                                    clicked => {
                                        root.paste-upload(root.menu-target != "" && root.menu-target-is-dir
                                            ? root.menu-target : root.current-path);
                                    }
                                }
                                SftpMenuItem {
                                    label: @tr("New folder");
                                    icon: "folder-plus";
                                    clicked => {
                                        root.inline-create-kind = "mkdir";
                                        root.inline-create-name = "";
                                    }
                                }
                                SftpMenuItem {
                                    label: @tr("New file");
                                    icon: "file-plus";
                                    clicked => {
                                        root.inline-create-kind = "touch";
                                        root.inline-create-name = "";
                                    }
                                }
                                SftpMenuItem {
                                    label: @tr("Refresh");
                                    icon: "refresh";
                                    clicked => { root.refresh(root.current-path); }
                                }
                                SftpMenuItem {
                                    label: @tr("Clear sort");
                                    icon: "close";
                                    enabled: root.sort-dir != 0;
                                    clicked => { root.clear-sort(); }
                                }
                            }
                        }
                    }
                }
                }

                // --- Floating Subfolder Quick Autocomplete Dropdown (Remote Pane) ---
                if root.remote-sub-open && root.entries.length > 0 : TouchArea {
                    z: 499;
                    x: 0px;
                    y: 32px;
                    width: parent.width;
                    height: max(0px, parent.height - 32px);
                    clicked => {
                        root.remote-sub-open = false;
                        remote-path-input.clear-focus();
                    }
                }
                if root.remote-sub-open && root.entries.length > 0 : Rectangle {
                    z: 500;
                    x: 8px;
                    y: 32px;
                    width: max(180px, parent.width - 16px);
                    height: min(168px, max(28px, rsub-col.preferred-height)) + 36px;
                    background: Theme.popup-bg;
                    border-radius: Theme.radius-md;
                    border-width: 1px;
                    border-color: Theme.border-strong;
                    drop-shadow-blur: 14px;
                    drop-shadow-color: #00000055;
                    TouchArea {}
                    VerticalLayout {
                        padding: 6px;
                        spacing: 2px;
                        alignment: start;
                        HorizontalLayout {
                            height: 22px;
                            padding-left: 6px;
                            padding-right: 4px;
                            spacing: 6px;
                            OutlineIcon {
                                y: (parent.height - self.height) / 2;
                                name: "folder";
                                icon-size: 13px;
                                color: Theme.accent;
                            }
                            Text {
                                horizontal-stretch: 1;
                                text: @tr("Current directory subfolders (click to complete)");
                                color: Theme.text-muted;
                                font-size: Theme.fs-xs;
                                font-weight: 600;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            Rectangle {
                                width: 20px;
                                height: 20px;
                                y: (parent.height - self.height) / 2;
                                border-radius: 4px;
                                background: rsub-cls-ta.has-hover ? Theme.bg-hover : transparent;
                                rsub-cls-ta := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.remote-sub-open = false;
                                        remote-path-input.clear-focus();
                                    }
                                }
                                OutlineIcon {
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    name: "close";
                                    icon-size: 11px;
                                    color: Theme.text-muted;
                                }
                            }
                        }
                        if rsub-col.preferred-height == 0px : Rectangle {
                            height: 28px;
                            Text {
                                x: 8px;
                                width: parent.width - 16px;
                                height: parent.height;
                                text: @tr("Empty directory");
                                color: Theme.text-muted;
                                font-size: Theme.fs-xs;
                                vertical-alignment: center;
                            }
                        }
                        ScrollView {
                            visible: rsub-col.preferred-height > 0px;
                            height: rsub-col.preferred-height > 0px ? min(168px, rsub-col.preferred-height) : 0px;
                            content-width: self.visible-width;
                            content-height: rsub-col.preferred-height;
                            rsub-col := VerticalLayout {
                                x: 0px;
                                y: 0px;
                                width: parent.visible-width;
                                height: self.preferred-height;
                                padding: 0px;
                                spacing: 0px;
                                alignment: start;
                                for entry in root.entries : VerticalLayout {
                                    padding: 0px;
                                    spacing: 0px;
                                    if entry.is-dir && root.entry-matches(
                                        entry.name,
                                        entry.file-type,
                                        (root.show-hidden ? "" : "__hide_dot__:") + "__sub__:" + root.current-path + "\n" + root.path-text) : Rectangle {
                                        height: 28px;
                                        border-radius: 5px;
                                        background: rsub-item-ta.has-hover ? Theme.bg-hover : transparent;
                                        rsub-item-ta := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => {
                                                root.path-text = entry.full-path;
                                                root.remote-sub-open = false;
                                                remote-path-input.clear-focus();
                                                root.navigate(entry.full-path);
                                            }
                                        }
                                        HorizontalLayout {
                                            padding-left: 8px;
                                            padding-right: 8px;
                                            spacing: 6px;
                                            OutlineIcon {
                                                y: (parent.height - self.height) / 2;
                                                name: "folder";
                                                icon-size: 14px;
                                                color: Theme.accent;
                                            }
                                            Text {
                                                text: entry.name;
                                                color: Theme.text-primary;
                                                font-size: Theme.fs-xs;
                                                font-weight: 600;
                                                vertical-alignment: center;
                                            }
                                            Text {
                                                horizontal-stretch: 1;
                                                text: entry.full-path;
                                                color: Theme.text-muted;
                                                font-size: Theme.fs-xs;
                                                overflow: elide;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // --- Integrated Transfers View (`panel-mode == "transfers"`) -------
        if root.panel-mode == "transfers" : SftpTransfersView {
            vertical-stretch: 1;
            download-dir: root.download-dir;
            transfers: root.transfers;
            pick-download-dir => { root.pick-download-dir(); }
            open-download-dir => { root.open-download-dir(); }
            clear-transfers => { root.clear-transfers(); }
            cancel-transfer(id) => { root.cancel-transfer(id); }
        }

        if root.panel-mode == "tunnels" : SftpTunnelsView {
            vertical-stretch: 1;
            tunnel-kind <=> root.tunnel-kind;
            tunnel-name <=> root.tunnel-name;
            tunnel-bind <=> root.tunnel-bind;
            tunnel-bind-port <=> root.tunnel-bind-port;
            tunnel-host <=> root.tunnel-host;
            tunnel-host-port <=> root.tunnel-host-port;
            tunnel-save <=> root.tunnel-save;
            tunnel-auto-start <=> root.tunnel-auto-start;
            tunnels: root.tunnels;
            tunnel-add(n, k, b, bp, h, hp, s, a) => { root.tunnel-add(n, k, b, bp, h, hp, s, a); }
            tunnel-stop(id) => { root.tunnel-stop(id); }
            tunnel-start(id) => { root.tunnel-start(id); }
            tunnel-delete(id) => { root.tunnel-delete(id); }
        }
    }

    // --- Split-view drag feedback -----------------------------------------
    // Highlight the pane that will receive the drop. Geometry was captured in
    // `update-drag` (an event handler), never from a binding: peeking at
    // `absolute-position` here would recurse through the layout.
    if root.drag-active && (root.drop-local || root.drop-remote) : Rectangle {
        x: root.drop-x;
        y: root.drop-y;
        width: root.drop-w;
        height: root.drop-h;
        background: Theme.accent.with-alpha(0.10);
        border-width: 2px;
        border-color: Theme.accent;
    }

    // The item being dragged, next to the cursor (no TouchArea: the row that
    // started the drag keeps the pointer grab until release).
    if root.drag-active : Rectangle {
        x: clamp(root.drag-x + 14px, 0px, max(0px, root.width - self.width));
        y: clamp(root.drag-y + 12px, 0px, max(0px, root.height - self.height));
        width: drag-ghost.preferred-width + 16px;
        height: 22px;
        background: Theme.popup-bg;
        border-width: 1px;
        border-color: Theme.accent;
        border-radius: Theme.radius-sm;
        drop-shadow-blur: 8px;
        drop-shadow-color: #00000070;
        drag-ghost := HorizontalLayout {
            padding-left: 8px;
            padding-right: 8px;
            spacing: 4px;
            Text {
                text: root.drag-label;
                color: Theme.text-primary;
                font-size: Theme.fs-xs;
                vertical-alignment: center;
            }
            if root.drag-count > 1 : Text {
                text: root.drag-count;
                color: Theme.accent;
                font-size: Theme.fs-xs;
                vertical-alignment: center;
            }
        }
    }
}
