// Embedded cross-platform fonts (compile-time): terminal monospace + UI icons.
// Embedding means Windows / Linux / macOS all render the same glyphs without
// relying on Consolas / Segoe MDL2 Assets being installed.
//
// "Meatshell Mono" is Cascadia Mono re-named to a unique family (#114): full
//   box-drawing + block-elements + braille (needed by htop/btop graphs). The
//   original "Cascadia Mono" name collides with the system font family, so on a
//   machine without Cascadia installed (e.g. Win11 Home) the OS font matcher
//   substituted a glyph-poor fallback and box/braille rendered as tofu. A unique
//   name (like Material Icons) can't be shadowed, so the embedded font is always
//   used.
// Material Icons: open-source icon font replacing Windows-only Segoe MDL2 Assets.
import "fonts/MeatshellMono-Regular.ttf";
import "fonts/MeatshellMono-Bold.ttf";
import "fonts/MaterialIcons-Regular.ttf";

import { Theme, ThemePalette, TooltipState } from "theme.slint";
import { Sidebar, DiskInfo } from "sidebar.slint";
import { TabBar, TabInfo, LaunchItem } from "tabs.slint";
import { Welcome, SessionInfo } from "welcome.slint";
import { SessionDialog, SessionDraft, PortFwd, TriggerDraft, JumpHop } from "session_dialog.slint";
import { ConfirmDialog } from "confirm_dialog.slint";
import { ModalLayer, ModalKind } from "modal.slint";
import { LabeledInput, PrimaryButton, GhostButton, DockExpandButton, IconButton, ToolStrip, OutlineIcon } from "widgets.slint";
import { TerminalView, TermSpan, TermMatch, FindStatus, QuickCmd, QuickDockPanel } from "terminal_view.slint";
import { SftpEntry, SftpTreeNode, SftpLocalPlace, TunnelInfo, TransferInfo } from "sftp_panel.slint";
import { ProcWindow, ProcRow } from "proc_window.slint";
import { SystemInfoWindow, SysInfoRow, SysMetricRow, SysNetRow } from "system_info_window.slint";
import { EditorWindow } from "editor_window.slint";
import { EditorPane, EditorFindResult, EditorDoc } from "editor_pane.slint";
import { InterfacePanel, OutputRuleItem, WslProfileInfo, CustomAgentInfo, UpdateMirrorRow, ColorThemeItem, TerminalSchemeItem, ShortcutBinding } from "interface_panel.slint";
// Re-export so `slint::include_modules!` generates the detached Rust window types.
export { ProcWindow, SystemInfoWindow, EditorWindow }
import { ComboBox, SpinBox, LineEdit, Button, ScrollView, CheckBox, Palette } from "std-widgets.slint";

export { SessionInfo, LaunchItem, SessionDraft, JumpHop, TabInfo, SftpEntry, SftpTreeNode, TunnelInfo, TransferInfo, QuickCmd, PortFwd, WslProfileInfo, CustomAgentInfo, UpdateMirrorRow, ThemePalette, ColorThemeItem, TerminalSchemeItem, ShortcutBinding }

import { TerminalState, PaneInfo, SplitterInfo, PanelGeomInfo, DividerGeomInfo, WinBtn, ShortcutRow, EditableShortcutRow } from "components/business/app_chrome_helpers.slint";
import { StartupEmptyPane } from "pages/startup_empty_pane.slint";
import { TransferManagerPopup } from "pages/dialogs/transfer_manager_popup.slint";
import { SettingsMenuPopup } from "pages/dialogs/settings_menu_popup.slint";
import { QuickCommandManageDialog, QuickCommandGroupDialog } from "pages/dialogs/quick_command_dialogs.slint";
import { SftpPromptDialog, ConfirmCloseDialog, ChmodDialog } from "pages/dialogs/sftp_chmod_dialogs.slint";
import { ShortcutsDialog, AboutModalDialog } from "pages/dialogs/shortcuts_about_dialogs.slint";
import { GroupEditModal, TabRenameModal, BatchImportModal, CredentialPromptModal, MfaPromptModal } from "pages/dialogs/session_batch_cred_modals.slint";

export { TerminalState, PaneInfo, SplitterInfo, PanelGeomInfo, DividerGeomInfo }

component IconBtn inherits Rectangle {
    in property <string> icon;
    in property <brush> icon-color: Theme.text-secondary;
    in property <length> icon-size: 18px;
    in property <length> btn-size: 30px;
    in property <string> tooltip;
    in property <bool> tooltip-right: false;
    in property <bool> active;
    // `breathe=true` makes the button add a separate pulse layer underneath
    // the icon. Used by the Transfers button to signal in-flight transfers
    // in the toolbar accent without breaking the icon's silhouette
    // (#breathing-light). All other IconBtn instances leave this false.
    in property <bool> breathe: false;
    // `badge=true` draws a small red dot on the top-right corner (the Updates
    // button uses it to flag a newer release instead of a popup banner).
    in property <bool> badge: false;
    callback clicked();
    width: root.btn-size;
    height: root.btn-size;
    border-radius: 8px;
    // Base stays transparent; the two layers below paint onto this.
    background: transparent;

    // Layer 1 — static hover/active background (no animation, no looping).
    static-bg := Rectangle {
        x: 0px; y: 0px;
        width: 100%; height: 100%;
        border-radius: 8px;
        background: root.active ? Theme.bg-active : (ta.has-hover ? Theme.bg-hover : transparent);
    }

    // Layer 2 — breathing pulse, only while `breathe=true`.
    breathe-layer := Rectangle {
        x: 0px; y: 0px;
        width: 100%; height: 100%;
        border-radius: 8px;
        background: Theme.accent;
        visible: root.breathe;
        opacity: root.breathe
            ? 0.275 - 0.275 * cos(animation-tick() / 1400ms * 180deg)
            : 0;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    OutlineIcon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        name: root.icon;
        icon-size: root.icon-size;
        color: root.active ? Theme.text-primary : (ta.has-hover ? Theme.text-primary : root.icon-color);
    }
    // Ringed in the toolbar background so it reads as a cut-out over the icon.
    if root.badge : Rectangle {
        x: parent.width - 10px;
        y: 2px;
        width: 8px;
        height: 8px;
        border-radius: 4px;
        background: #e5484d;
        border-width: 1.5px;
        border-color: Theme.bg-panel;
    }
    if ta.has-hover && root.tooltip != "" : Rectangle {
        z: 300;
        y: root.tooltip-right ? (parent.height - self.height) / 2 : parent.height + 5px;
        x: root.tooltip-right ? parent.width + 8px : parent.width - self.width;
        width: tip-txt.preferred-width + 16px;
        height: 24px;
        background: Theme.dark ? #2f2f2f : #171717;
        border-radius: 6px;
        border-width: Theme.dark ? 1px : 0px;
        border-color: #444444;
        tip-txt := Text {
            text: root.tooltip;
            color: #ffffff;
            font-size: 11.5px * Theme.ui-scale;
            font-weight: 500;
            horizontal-alignment: center;
            vertical-alignment: center;
            width: parent.width;
            height: parent.height;
        }
    }
}

export component AppWindow inherits Window {
    title: "meatshell";
    icon: @image-url("../assets/icon.png");
    // Frameless when we draw our own title bar (#119); Rust sets custom-titlebar
    // true on Windows/Linux. Slint maps no-frame → winit set_decorations(false).
    no-frame: root.custom-titlebar;
    min-width: 720px;
    min-height: 420px;
    preferred-width: 1440px;
    preferred-height: 900px;
    // Always-opaque base; the wallpaper Image (when active) covers it and panels
    // frost over the image. Using window-base (not bg-root) keeps the window
    // itself opaque even though bg-root turns translucent in immersive mode.
    background: Theme.window-base;
    // A CJK-capable default so UI text (incl. fullwidth punctuation like ：（）)
    // never tofus on glyph fallback (#54). Rust sets Theme.ui-font-family to a
    // system CJK font on startup; empty on Linux keeps the Slint default.
    default-font-family: Theme.ui-font-family;

    // --- Sidebar data ------------------------------------------------------
    in property <string> connection-state: @tr("Not connected");
    in property <string> status-heading: @tr("Local overview");
    in property <bool> is-local-mode: true;
    in property <bool> metrics-available: true;
    in property <string> conn-host;             // clean IP/host for click-to-copy (#192)
    in property <int> conn-state;                       // 0 gray / 1 green / 2 yellow
    in property <string> resource-title: @tr("Local resources");    // @tr("Local resources") | @tr("Server resources")
    in property <float> cpu-percent;
    in property <float> mem-percent;
    in property <float> swap-percent;
    in property <string> mem-detail;
    in property <string> swap-detail;
    // Dual network panel.  "top" follows the active tab (remote NIC on a
    // session tab, local on the welcome tab); "bot" is always the local machine.
    in property <string> net-top-up;        // ↑ tx rate text
    in property <string> net-top-down;      // ↓ rx rate text
    in property <[float]> net-top-history;
    in property <string> net-bot-up;
    in property <string> net-bot-down;
    in property <[float]> net-bot-history;
    in property <[string]> net-ifaces;      // remote NIC names for the selector
    in property <string> net-selected;      // currently selected NIC
    in property <bool> net-show-selector;   // only on a live session tab
    in property <[DiskInfo]> disks;         // active tab's filesystem usage
    in property <string> app-version;       // from Rust: env!("CARGO_PKG_VERSION")
    callback select-net-iface(string);

    // --- Top-right popups --------------------------------------------------
    in-out property <bool> download-open: false;  // download manager popup
    in-out property <bool> settings-open: false;  // settings menu popup

    // Immersive custom title bar (#119). Rust sets `custom-titlebar` true on
    // Windows/Linux (frameless); macOS keeps native decorations. The callbacks
    // drive the winit window via Rust.
    // Default true so the window is frameless from creation (no native-bar flash);
    // Rust sets it false on macOS, which keeps native decorations.
    in-out property <bool> custom-titlebar: true;
    // macOS immersive title bar: Rust makes the native bar transparent and lets
    // content render under it, so we reserve this much space at the top for the
    // traffic-light buttons + a clean drag strip (0 elsewhere). See setup_macos_platform.
    property <length> titlebar-inset: root.is-mac && !root.term-fullscreen ? 28px : 0px;
    in-out property <bool> window-maximized: false;
    // Rust disables live model updates while the native window is unfocused,
    // minimized or occluded. Cached samples are applied when it becomes active.
    in-out property <bool> dynamic-ui-active: true;
    callback win-minimize();
    callback win-maximize-toggle();
    callback win-close();
    callback win-drag();          // start an OS window-move
    callback win-resize(int);     // start an OS resize; arg = direction code
    in-out property <bool> sidebar-collapsed: false; // left panel hidden
    changed sidebar-collapsed => {
        if (!root.sidebar-collapsed) { root.refresh-sidebar(); }
    }
    callback set-sidebar-collapsed(bool);       // apply + persist
    in-out property <bool> home-monitor-open: false;
    out property <bool> has-active-session:
        root.terminals.length > 0 && root.active-tab-id != "" && root.active-tab-id != "welcome";
    out property <bool> effective-sidebar-collapsed:
        root.has-active-session ? root.sidebar-collapsed : !root.home-monitor-open;
    changed has-active-session => {
        if (root.has-active-session) {
            if (!root.collapse-sidebar-default && root.sidebar-dock == "left") {
                if (root.welcome-as-sidebar && root.welcome-sidebar-dock == "left") {
                    root.welcome-collapsed = true;
                }
                if (root.quick-panel-open && root.quick-panel-dock == "left") {
                    root.quick-panel-collapsed = true;
                }
                root.sidebar-collapsed = false;
            }
        } else {
            root.home-monitor-open = false;
            if (root.welcome-as-sidebar && root.welcome-sidebar-dock == "left") {
                root.welcome-collapsed = false;
            }
        }
        root.dock-layout-changed();
        root.refresh-sidebar();
    }
    changed home-monitor-open => {
        if (root.home-monitor-open) {
            if (root.sidebar-dock == "left" && root.welcome-as-sidebar && root.welcome-sidebar-dock == "left") {
                root.welcome-collapsed = true;
            }
            root.refresh-sidebar();
        } else if (!root.has-active-session && root.welcome-as-sidebar && root.welcome-sidebar-dock == "left") {
            root.welcome-collapsed = false;
        }
        root.dock-layout-changed();
    }
    // User-draggable size of the resource sidebar. width is used when docked
    // left/right, height when docked top/bottom. Seeded / persisted via the
    // persist-* callbacks (fired on drag end).
    in-out property <length> sidebar-width: 280px;
    in-out property <length> sidebar-height: 240px;
    property <bool> sidebar-dragging;            // splitter being dragged
    callback persist-sidebar-width(float /* logical px */);

    // --- Panel docking (resource sidebar; SFTP follows in a later phase) ----
    // Which window edge the resource panel is docked to: left|right|top|bottom.
    in-out property <string> sidebar-dock: "left";
    property <bool> sidebar-horizontal: root.sidebar-dock == "left" || root.sidebar-dock == "right";
    // Drag-to-dock state: while a panel's header is dragged, a 4-edge snap
    // overlay shows and `dock-target` tracks the edge under the cursor.
    // `out` (Rust-read) backs the drag-aware deferral in refresh_dock: the
    // push must wait while a panel drag holds the pointer.
    out property <bool> panel-dragging;
    property <float> drag-nx;   // cursor x within the dock area, 0..1
    property <float> drag-ny;   // cursor y within the dock area, 0..1
    property <string> dock-target:
        !root.panel-dragging ? ""
        : root.drag-nx < 0.22 ? "left"
        : root.drag-nx > 0.78 ? "right"
        : root.drag-ny < 0.22 ? "top"
        : root.drag-ny > 0.78 ? "bottom"
        : "";
    callback persist-sidebar-dock(string);
    // The top-right toolbar icons float over the tab row; when the sidebar docks
    // top/right it covers that corner, so shift the icons to stay over the tabs.
    property <length> toolbar-x-off:
        root.dock-right-gap + 4px;
    property <length> toolbar-y-off:
        root.dock-top-gap;
    property <length> toolbar-y:
        (root.custom-titlebar ? 43px : 5px + root.titlebar-inset) + root.toolbar-y-off;
    in-out property <bool> about-open: false;     // centered About dialog
    callback open-repo();                          // open the project's GitHub page
    in-out property <bool> shortcuts-open: false; // centered keyboard-shortcuts dialog (#103)
    // Customisable shortcuts: rows set by Rust; `shortcut-recording` is the
    // action id waiting for a new chord ("" = not recording).
    in-out property <[ShortcutBinding]> shortcut-bindings;
    in-out property <string> shortcut-recording: "";
    in-out property <string> shortcut-status: "";
    in-out property <bool> shortcut-status-error: false;
    // Key event → action id ("" = not a shortcut). Implemented in Rust
    // (src/app/shortcuts.rs) so every handler shares one keymap.
    callback match-shortcut(string /* text */, bool /* control */, bool /* meta */,
                            bool /* alt */, bool /* shift */, bool /* alt-screen */) -> string;
    callback shortcut-record(string /* id */, string /* text */, bool /* control */,
                             bool /* meta */, bool /* alt */, bool /* shift */);
    callback shortcut-reset(string /* id */);
    callback shortcut-reset-all();
    callback shortcuts-refresh();
    // Opening the dialog: fresh rows (the language may have changed) and no
    // leftover recording / status from last time.
    changed shortcuts-open => {
        root.shortcut-recording = "";
        root.shortcut-status = "";
        if (root.shortcuts-open) { root.shortcuts-refresh(); }
    }
    in property <string> download-dir;      // preset SFTP download folder ("" = ask)
    // Download (Transfers) popup size + resize-drag state. The popup is an
    // embedded Rectangle (not a top-level window), so its resize is driven in
    // pure Slint via a bottom-right grip — mirroring the interface dialog's
    // #dl-resize grip so both popups share one resize affordance.
    in-out property <length> dl-w: 420px;    // current popup width
    in-out property <length> dl-h: 360px;    // current popup height
    in-out property <bool> dl-custom-sized: false;
    in-out property <string> dl-filter: "all"; // "all" | "active" | "done"
    in-out property <bool> dl-resizing: false;
    in-out property <length> dl-base-w;     // width captured when the drag started
    in-out property <length> dl-base-h;     // height captured when the drag started
    in-out property <length> dl-grab-x;     // pointer x (logical) when the drag started
    in-out property <length> dl-grab-y;     // pointer y (logical) when the drag started
    // `true` while at least one transfer is active or preparing; drives the
    // breathing indicator on the toolbar Transfers button (#breathing-light).
    in-out property <bool> has-active-transfers: false;
    // Start an OS resize from the bottom-right grip; mirrors ProcWindow so the
    // main window gets the same visual affordance when the OS frame is hidden
    // (custom-titlebar mode on Windows/Linux, #main-resize-grip).
    callback win-resize-se();
    // Process monitor is now a detachable top-level window (ProcWindow). Rust
    // shows/hides it in response to open-processes(); proc-list/proc-available
    // stay here as the live data source shared with that window (#23).
    callback open-processes();
    in-out property <bool> process-window-open: false;
    in property <bool> proc-available;       // a live remote session is active
    in property <[ProcRow]> proc-list;       // top remote processes by CPU
    callback open-system-info();
    in-out property <bool> system-info-window-open: false;
    in property <bool> system-info-available; // connected Linux session only (#268)
    in property <[SysMetricRow]> sys-metrics;
    in property <[SysNetRow]> sys-net-rows;
    in property <[DiskInfo]> sys-disks;
    in property <[SysInfoRow]> sys-overview-rows;
    in property <[SysInfoRow]> sys-cpu-info-rows;
    in property <[SysInfoRow]> sys-gpu-info-rows;
    in property <[SysInfoRow]> sys-cpu-usage-rows;
    in property <[SysInfoRow]> sys-memory-rows;
    in property <[SysInfoRow]> sys-swap-rows;
    in property <[SysInfoRow]> sys-network-rows;
    in property <[SysInfoRow]> sys-filesystem-rows;
    // Command bar (#55): quick commands + history, fed from Rust.
    in property <[QuickCmd]> quick-commands;
    in-out property <bool> quick-commands-as-sidebar: false;
    callback set-quick-commands-as-sidebar(bool);
    in-out property <bool> quick-panel-open: false;
    in-out property <bool> quick-panel-collapsed: false;
    in-out property <length> quick-panel-width: 260px;
    in-out property <length> quick-panel-height: 220px;
    in-out property <string> quick-panel-dock: "right";
    property <string> quick-external-command;
    property <bool> quick-external-send-enter;
    property <int> quick-external-sequence;
    in property <[string]> command-history;          // oldest first (newest last, #113)
    in property <[string]> history-view;             // filtered dropdown, oldest first (newest last, #101)
    in property <[string]> history-preview;          // history-view flattened to one line each (#419)
    callback run-command(string /* tab-id */, string /* cmd */, bool /* to-all */);
    callback copy-text(string);                 // copy a history command (#96)
    callback delete-history(int /* index */);   // remove a history entry (#96)
    callback delete-history-cmd(string /* cmd */);   // remove a history entry by command (#101)
    callback search-history(string /* query */);     // filter the history dropdown (#101)
    in-out property <bool> quick-cmd-manage-open: false;  // manage dialog
    in-out property <length> qcm-dialog-width: 640px;
    in-out property <length> qcm-dialog-height: 640px;
    property <bool> qcm-dialog-resizing;
    property <length> qcm-resize-base-width;
    property <length> qcm-resize-base-height;
    property <length> qcm-resize-grab-x;
    property <length> qcm-resize-grab-y;
    in-out property <string> qcm-name;                // manage form: name field
    in-out property <string> qcm-command;             // manage form: command field
    in-out property <string> qcm-group;               // manage form: group field (#55)
    in-out property <bool> qcm-send-enter: true;      // click sends+executes (B站)
    in-out property <int> qcm-edit-index: -1;         // -1 = add, >=0 = edit that entry (#55)
    callback add-quick-command(string /* name */, string /* command */, string /* group */, bool /* send-enter */);
    callback save-quick-command(int /* index */, string /* name */, string /* command */, string /* group */, bool /* send-enter */);
    callback delete-quick-command(int /* index */);
    callback edit-quick-command(int /* index */);
    callback duplicate-quick-command(int /* index */);
    callback move-quick-command(int /* index */, string /* group */);
    callback reorder-quick-command(int /* index */, bool /* move up */);
    callback toggle-quick-group(string /* group */);  // collapse/expand a group (#55)
    // Quick-command group management (mirror session groups) (#55).
    in-out property <bool> qcg-open: false;           // group name dialog open
    property <string> qcg-name;                       // group dialog: name field
    property <string> qcg-orig;                       // group dialog: "" = new, else rename target
    callback submit-quick-group(string /* orig */, string /* name */);
    callback delete-quick-group(string /* name */);
    in property <[TransferInfo]> transfers; // download/upload records (newest first)
    in property <[string]> about-libs;      // open-source libraries used
    in-out property <bool> lang-en: false;  // current UI language (false = 中文)
    // Two-way binding to Theme.dark — Rust reads/writes this property and
    // Slint propagates it to every widget that references Theme colours.
    in-out property <bool> dark-mode <=> Theme.dark;
    // Keep Slint's std-widgets (LineEdit / Button / ComboBox in the dialogs) in
    // step with our theme — otherwise in light mode they keep the platform/dark
    // palette and their text/borders blend into the light dialog background.
    init => { Palette.color-scheme = root.dark-mode ? ColorScheme.dark : ColorScheme.light; }
    changed dark-mode => {
        Palette.color-scheme = root.dark-mode ? ColorScheme.dark : ColorScheme.light;
        root.refresh-editor-syntax();
    }
    in-out property <string> term-font-family <=> Theme.term-font-family;
    in-out property <length> term-font-size <=> Theme.term-font-size;
    in-out property <float> terminal-line-spacing: 1.0;
    in-out property <bool> term-font-bold <=> Theme.term-font-bold;
    in-out property <string> term-cursor-style: "block";
    in-out property <color> term-cursor-color: Theme.term-cursor;
    in-out property <bool> output-highlight-enabled: true;
    in-out property <bool> json-format-output: true;
    in-out property <string> output-highlight-preset: "log";
    in property <[OutputRuleItem]> output-highlight-rules;
    in-out property <string> output-highlight-rule-status;
    in-out property <float> ui-scale <=> Theme.ui-scale;   // global UI zoom (#100)
    in-out property <float> panel-font <=> Theme.panel-font;  // settings-panel font scale
    callback set-panel-font(int);                          // apply + persist (percent)
    in-out property <string> ui-font-family <=> Theme.ui-font-family;
    // Window focused & visible — Rust drives it from winit events; gates the
    // cursor blink so an idle background window stops repainting (#127).
    in-out property <bool> window-focused <=> Theme.window-focused;
    // macOS flag — Rust sets it so shortcuts switch to Cmd (⌘) there (#158).
    in-out property <bool> is-mac <=> Theme.is-mac;
    in property <bool> is-windows: false;
    in-out property <string> renderer-mode: "software";
    callback set-renderer-mode(string);                    // applies next launch (#280)
    // Wallpaper / immersive theming — Rust drives these from the wallpaper module.
    in-out property <image> wallpaper-img <=> Theme.wallpaper;
    in-out property <bool> wallpaper-active <=> Theme.wallpaper-active;
    in-out property <color> wp-accent <=> Theme.wp-accent;
    in-out property <color> wp-tint <=> Theme.wp-tint;
    // User-adjustable wallpaper overlay opacity (0.30–1.00), persisted.
    in-out property <float> wallpaper-overlay <=> Theme.panel-alpha;
    callback persist-wallpaper-overlay(float);
    // Colour theme presets + the immersive-colours switch (Settings ›
    // Wallpaper & theme). Rust fills the palettes from the chosen preset.
    in-out property <ThemePalette> theme-palette-dark <=> Theme.palette-dark;
    in-out property <ThemePalette> theme-palette-light <=> Theme.palette-light;
    in-out property <bool> immersive-colors <=> Theme.immersive;
    in property <[ColorThemeItem]> color-themes;
    in-out property <string> color-theme: "default";
    in-out property <string> color-theme-custom: "#4A90E2";
    callback set-color-theme(string);
    callback set-color-theme-custom(string) -> bool;
    callback set-immersive-colors(bool);
    // Terminal color schemes (iTerm2-Color-Schemes + custom themes).
    in-out property <bool> term-scheme-active <=> Theme.term-scheme-active;
    in-out property <bool> term-scheme-is-dark <=> Theme.term-scheme-is-dark;
    in-out property <color> term-scheme-bg <=> Theme.term-scheme-bg;
    in-out property <color> term-scheme-fg <=> Theme.term-scheme-fg;
    in-out property <color> term-scheme-cursor <=> Theme.term-scheme-cursor;
    in-out property <color> term-scheme-cursor-text <=> Theme.term-scheme-cursor-text;
    in-out property <color> term-scheme-selection <=> Theme.term-scheme-selection;
    in-out property <color> term-scheme-selection-text <=> Theme.term-scheme-selection-text;
    in-out property <color> term-scheme-accent <=> Theme.term-scheme-accent;
    in property <[TerminalSchemeItem]> terminal-schemes;
    in property <TerminalSchemeItem> active-terminal-scheme;
    in-out property <string> terminal-scheme-id: "default";
    in-out property <string> terminal-scheme-search: "";
    in-out property <string> terminal-scheme-category: "all";
    in property <int> terminal-schemes-total: 0;
    in property <bool> terminal-schemes-has-more: false;
    in-out property <string> terminal-scheme-status: "";
    callback select-terminal-scheme(string);
    callback toggle-favorite-terminal-scheme(string);
    callback filter-terminal-schemes(string, string);
    callback load-more-terminal-schemes();
    callback reset-terminal-scheme();
    callback import-terminal-scheme();
    callback export-terminal-scheme();
    callback delete-custom-terminal-scheme(string);
    in property <[string]> term-fonts;             // installed monospace families
    in-out property <bool> interface-open: false;  // Interface settings overlay
    // Interface card position (draggable by its title bar, clamped inside the
    // window so it can't leave the parent); init centered.
    // Centred, snapped to whole logical pixels: a half-pixel origin makes the
    // card's text render on subpixel offsets and look blurry (#v0.5).
    property <length> ifd-w: min(root.width - 48px, max(680px, 840px * Theme.panel-font));
    property <length> ifd-h: min(root.height - 48px, max(480px, 600px * Theme.panel-font));
    property <length> ifd-x: round((root.width - root.ifd-w) / 2 / 1px) * 1px;
    property <length> ifd-y: round((root.height - root.ifd-h) / 2 / 1px) * 1px;
    property <bool> ifd-dragging;
    property <bool> ifd-resizing;
    property <length> ifd-base-x;
    property <length> ifd-base-y;
    property <length> ifd-base-w;
    property <length> ifd-base-h;
    property <length> ifd-grab-x;
    property <length> ifd-grab-y;

    // A drag/resize assignment breaks the initial centering bindings. Recenter
    // every time the modal opens so coordinates from a larger/DPI-different
    // monitor can never leave the settings card outside the current window.
    changed interface-open => {
        // A later open from the toolbar starts on the first page again.
        if (!root.interface-open) {
            root.interface-start-page = "general";
        }
        if (root.interface-open) {
            root.shortcut-recording = "";
            root.shortcut-status = "";
            root.shortcuts-refresh();
            root.ifd-dragging = false;
            root.ifd-resizing = false;
            root.ifd-w = clamp(root.ifd-w, min(680px, root.width - 48px), max(680px, root.width - 48px));
            root.ifd-h = clamp(root.ifd-h, min(480px, root.height - 48px), max(480px, root.height - 48px));
            root.ifd-x = round((root.width - root.ifd-w) / 2 / 1px) * 1px;
            root.ifd-y = round((root.height - root.ifd-h) / 2 / 1px) * 1px;
        }
    }
    callback set-term-font(string);                // apply + persist font family
    callback set-term-font-size(int);              // apply + persist font size (px)
    // Font zoom: Ctrl+=/-/0 → `tab-id`'s session only; Ctrl+Shift+=/-/0 →
    // every session in this window (scope: false = session, true = window).
    callback zoom-term-font(string /* tab-id */, int /* direction */, bool /* window-wide */);
    callback set-terminal-line-spacing(float);
    callback set-term-font-bold(bool);             // apply + persist bold terminal text
    callback set-term-cursor-style(string);        // apply + persist cursor shape (#275)
    callback set-output-highlight(bool, string);   // enable + built-in preset
    callback set-json-format-output(bool);
    callback add-output-highlight-rule(string, bool, bool, bool, string) -> bool;
    callback remove-output-highlight-rule(int);
    callback set-output-highlight-rule-enabled(int, bool);
    callback set-ui-scale(int);                    // apply + persist UI scale (percent) (#100)
    // Immersive wallpaper (set by Rust). The active id + custom file basename
    // feed the Interface → Wallpaper picker.
    in-out property <string> current-wallpaper: "";
    in-out property <string> custom-wallpaper-name: "";
    in property <[WslProfileInfo]> wsl-profiles;
    in-out property <string> wsl-new-directory: "~";
    callback set-wallpaper(string);                // apply + persist a wallpaper id
    callback pick-wallpaper-file();                // open the OS file dialog (Rust)
    // SFTP follows the terminal's cd; opt out in Interface settings.
    in-out property <bool> sftp-follow-cd: true;
    callback set-sftp-follow-cd(bool);             // apply + persist
    // Hide the quick-command bar under the terminal; toolbar toggle persists it.
    in-out property <bool> cmd-bar-hidden: false;
    callback set-cmd-bar-hidden(bool);             // apply + persist
    // Zen (focus) mode toggle shortcut: Ctrl+Alt+Z (⌘⌥Z on macOS).
    callback toggle-zen-key();
    // Always ask where to save on each download (#87); default off.
    in-out property <bool> download-always-ask: false;
    callback set-download-always-ask(bool);        // apply + persist
    // Session logging (#265): global default + where files go.
    in-out property <bool> session-log-enabled: false;
    in-out property <string> session-log-dir;          // effective folder
    in-out property <bool> session-log-dir-custom: false;
    callback set-session-log-enabled(bool);        // apply + persist
    callback pick-session-log-dir();
    callback reset-session-log-dir();
    callback open-session-log-dir();
    in-out property <bool> paste-confirm-enabled: true;
    callback set-paste-confirm-enabled(bool);
    in-out property <bool> extra-paste-shortcuts-enabled: true;
    callback set-extra-paste-shortcuts-enabled(bool);
    // SSH keepalive (Settings › Connection, #515).
    in-out property <bool> ssh-keepalive-enabled: true;
    in-out property <int> ssh-keepalive-interval: 30;
    in-out property <int> ssh-keepalive-max: 3;
    callback set-ssh-keepalive(bool, int, int);
    in-out property <bool> zen-mode: false;
    callback set-zen-mode(bool);
    // Zen empties/restores the whole dock stack without resizing the frame, so
    // every entry point (keyboard toggle AND the settings switch through the
    // two-way binding) must re-run the dock geometry — one hook covers them all
    // (#dock-stack).
    changed zen-mode => { root.dock-layout-changed(); }
    // Terminal fullscreen (#495): Alt+Enter puts the window into borderless
    // OS fullscreen and drops every piece of chrome (title bar, tab strips,
    // toolbar, docked panels, status strip) so the terminal gets the whole
    // screen — like Xshell's full-screen view. Transient per window, never
    // persisted. Rust owns the toggle: it only enters while a terminal tab is
    // active and keeps this flag in sync with the native window state.
    in-out property <bool> term-fullscreen: false;
    callback toggle-term-fullscreen();
    // Leave fullscreen if the active tab is no longer a terminal (Rust check).
    callback term-fullscreen-check();
    // Everything zen hides is hidden in terminal fullscreen too.
    property <bool> hide-panels: root.zen-mode || root.term-fullscreen;
    changed term-fullscreen => {
        if (root.term-fullscreen) {
            root.settings-open = false;
            root.download-open = false;
        }
        root.dock-layout-changed();
    }
    // Collapse-by-default settings + shared SFTP collapse state (#78).
    in-out property <bool> collapse-sidebar-default: false;
    callback set-collapse-sidebar-default(bool);   // apply + persist
    // Render the welcome/session list as a left sidebar instead of a tab (v0.5).
    in-out property <bool> welcome-as-sidebar: false;
    callback set-welcome-as-sidebar(bool);         // apply + persist
    in-out property <bool> update-check-enabled: true;   // startup new-version check (#184)
    callback set-update-check-enabled(bool);       // apply + persist
    in-out property <bool> mcp-enabled: true;
    in-out property <bool> mcp-use-saved-credentials: true;
    in-out property <bool> mcp-allow-commands: true;
    in-out property <bool> mcp-allow-file-transfers: true;
    // MCP client config snippet shown in Settings › MCP (set by Rust).
    in property <string> mcp-config-json;
    callback set-mcp-permissions(bool, bool, bool, bool);
    callback add-wsl-profile(string, string, string);
    callback remove-wsl-profile(string);
    callback pick-wsl-directory();
    // Drag-resizable width of that welcome sidebar (logical px), persisted.
    in-out property <length> welcome-sidebar-width: 268px;
    callback persist-welcome-sidebar-width(float);
    in-out property <string> welcome-sidebar-dock: "left";
    property <bool> welcome-sidebar-horizontal:
        root.welcome-sidebar-dock == "left" || root.welcome-sidebar-dock == "right";
    property <length> welcome-sidebar-taken:
        root.welcome-collapsed ? 36px : root.welcome-sidebar-width;
    callback persist-welcome-sidebar-dock(string);
    // Welcome sidebar collapsed to the edge icon strip (IDEA-style), persisted.
    in-out property <bool> welcome-collapsed: false;
    callback set-welcome-collapsed(bool);          // apply + persist
    in-out property <bool> collapse-sftp-default: false;
    callback set-collapse-sftp-default(bool);      // apply + persist
    in-out property <bool> sftp-collapsed: false;       // (legacy global; per-tab now)
    in-out property <length> sftp-saved-height: 220px;  // restore height on un-collapse
    in-out property <length> sftp-tree-width: 160px;
    callback persist-sftp-tree-width(length);
    in-out property <bool> sftp-show-type: true;
    in-out property <bool> sftp-show-size: true;
    in-out property <bool> sftp-show-modified: true;
    in-out property <bool> sftp-show-permissions: true;
    in-out property <bool> sftp-show-owner: true;
    in-out property <bool> sftp-show-group: true;
    callback toggle-sftp-column(string);
    // Per-session SFTP state: persist the collapse + sizes into that tab's
    // TerminalState so split panes / other tabs keep their own (#v0.5).
    callback set-pane-sftp-collapsed(string /* tab-id */, bool);
    callback set-pane-sftp-height(string /* tab-id */, length);
    callback set-pane-sftp-width(string /* tab-id */, length);
    callback set-pane-sftp-saved-height(string /* tab-id */, length);
    // Confirm-before-close when there are live session tabs (#88): a stray
    // double-click on the title-bar icon / X shouldn't drop active sessions.
    in-out property <bool> confirm-close-open: false;
    callback confirm-close-yes();                  // quit the app for real
    in-out property <bool> terminal-restore-cover: false;
    // Host-key confirmation (#109-5). Rust opens this when a server presents an
    // unknown / changed host key; the user's answer flows back via the callbacks
    // and Rust closes the dialog.
    in-out property <bool> hostkey-prompt-open: false;
    in-out property <bool> hostkey-prompt-is-test: false;
    in-out property <bool> hostkey-changed: false; // true = key differs from stored
    in-out property <string> hostkey-title;
    in-out property <string> hostkey-message;
    in-out property <string> hostkey-detail;       // host:port + type + fingerprint
    in-out property <string> hostkey-confirm-label; // trust-button text (from Rust, bilingual)
    callback hostkey-accept();                     // trust (and remember) the key
    callback hostkey-reject();                      // abort the connection
    // Connect-time credential prompt (#110). Rust opens this when a session is
    // missing its username and/or password; the answer flows back via accept.
    in-out property <bool> cred-prompt-open: false;
    in-out property <bool> cred-prompt-is-test: false;
    in-out property <string> cred-host;            // host shown in the dialog title
    in-out property <bool> cred-need-user: false;
    in-out property <bool> cred-need-password: false;
    in-out property <string> cred-user;            // username field value
    in-out property <string> cred-password;        // password field value
    in-out property <bool> cred-remember: false;   // persist to the saved session
    callback cred-accept();                        // use the entered credentials
    callback cred-reject();                        // cancel the connection
    // MFA / keyboard-interactive prompt (#86-MFA). Rust opens this when a bastion
    // (e.g. JumpServer with MFA) sends a verification-code challenge mid-login.
    in-out property <bool> mfa-prompt-open: false;
    in-out property <bool> mfa-prompt-is-test: false;
    in-out property <string> mfa-host;             // host shown in the dialog title
    in-out property <string> mfa-prompt;           // the server's prompt text
    in-out property <bool> mfa-echo: false;        // false = hide typed input
    in-out property <string> mfa-answer;           // the entered code
    callback mfa-submit();                         // send the entered answer
    callback mfa-cancel();                         // cancel the connection
    // Group create / rename dialog (#41).
    in-out property <bool> group-dialog-open: false;
    in-out property <string> group-dialog-orig;    // "" = create, else rename
    in-out property <string> group-dialog-name;
    in-out property <string> group-dialog-error;
    callback delete-group(string /* name */);
    callback submit-group(string /* orig */, string /* name */) -> string;
    callback toggle-theme();               // flip dark ↔ light
    // Session sync / broadcast input (#78 pt.4): mirror keystrokes to every
    // online session. Default off (it types into ALL sessions at once).
    in-out property <bool> sync-input: false;
    callback set-sync-input(bool);
    // Keep this window above other applications (#450). Per window and not
    // persisted; Rust mirrors it onto this window's editor/monitor windows.
    in-out property <bool> pinned: false;
    always-on-top: root.pinned;
    callback pinned-changed(bool);
    // Mirror SFTP uploads to other sessions while sync-input is on (#sync).
    in-out property <bool> sync-upload-enabled: false;
    callback set-sync-upload-enabled(bool);
    // WebDAV config sync (#185): manual upload/download of portable session JSON.
    in-out property <bool> webdav-enabled: false;
    in-out property <string> webdav-url;
    in-out property <string> webdav-username;
    in-out property <string> webdav-password;
    in-out property <string> webdav-remote-path;
    in-out property <bool> webdav-accept-invalid-certs: false;
    in-out property <string> webdav-status;
    callback save-webdav-settings(bool, string, string, string, string, bool);
    callback webdav-upload();
    callback webdav-download();
    in-out property <length> sftp-panel-height: 220px; // shared; lets Rust locate the drop zone
    in-out property <length> sftp-panel-width: 380px;  // SFTP extent when docked left/right
    in-out property <string> sftp-dock: "bottom";      // SFTP dock edge, shared across tabs
    // Split (local/remote) view state, remembered across restarts (#532).
    in-out property <bool> sftp-split-enabled: false;
    in-out property <string> sftp-last-local-dir;       // last local folder shown
    in-out property <float> sftp-local-split: 0.0;      // 0 = even split
    // Local folder bookmarks + recently opened folders, machine-wide (#532).
    in-out property <[string]> local-bookmarks;
    in-out property <[string]> local-recent;
    // Local pane display options (#532 follow-up): hidden files, sort column.
    in-out property <bool> sftp-local-show-hidden: false;
    in-out property <string> sftp-local-sort-key;
    in-out property <int> sftp-local-sort-dir: 0;
    callback pick-download-dir();            // open a folder picker
    callback open-download-dir();            // reveal the folder in the OS
    callback clear-transfers();              // wipe the transfer history
    callback cancel-transfer(string);        // cancel an in-progress transfer by id (#100)
    callback set-language(string);           // switch UI language ("zh" / "en")

    // --- Updates ----------------------------------------------------------
    in property <bool> update-available: false;   // red dot on the toolbar Updates button
    in property <string> update-version;
    in property <bool> update-busy;
    in property <bool> update-ready;
    in property <bool> update-error;
    in property <bool> update-install-supported;
    // AUR installs: the update runs in a terminal tab, then MeatShell restarts.
    in property <bool> update-via-terminal;
    in property <string> update-status;
    property <string> update-action-label: root.update-via-terminal
        ? (root.update-ready
            ? (root.lang-en ? "Restart" : "重启")
            : (root.lang-en ? "Update in terminal" : "在终端中更新"))
        : root.update-ready
        ? (root.lang-en ? "Install and restart" : "安装并重启")
        : root.update-install-supported
            ? (root.lang-en ? "Download update" : "下载更新")
            : (root.lang-en ? "Release page" : "发布页面");
    callback check-for-updates();
    callback update-action();
    callback open-update-url();
    // Download mirrors (Chinese UI only; used in a mainland China time zone).
    in property <[UpdateMirrorRow]> update-mirrors;
    in property <bool> update-mirrors-testing;
    in property <bool> update-china-tz;
    in property <string> update-mirror-error;
    callback add-update-mirror(string);
    callback remove-update-mirror(string);
    callback reset-update-mirrors();
    callback test-update-mirrors();
    in property <bool> update-mirror-auto: true;
    callback select-update-mirror(string);
    callback set-update-mirror-auto(bool);

    // --- Editor tabs (#70, #494) ------------------------------------------
    // Settings → SFTP: open text files as tabs in this window (true) or in the
    // detached EditorWindow (false). Each open file is a row here and a tab of
    // kind "editor" in the panes; the tab shows only the editor (no SFTP panel
    // or command bar) and can be dragged to split like any other tab.
    in-out property <bool> editor-embedded: false;
    callback set-editor-embedded(bool);       // apply + persist
    in property <[EditorDoc]> editor-docs;
    callback open-editor-tab(string /* owner tab */, string /* path */, string /* name */,
                             string /* content */, bool /* readonly */);
    callback editor-doc-edited(string /* id */, string /* content */);
    callback editor-doc-highlight(string /* id */, string /* content */);
    callback editor-doc-save(string /* id */);
    callback editor-doc-replace-all(string /* id */, string /* query */, string /* replacement */);
    callback refresh-editor-syntax();         // theme changed: recolour every doc
    // Closing a tab with unsaved edits asks first (#287).
    in-out property <bool> editor-discard-confirm-open: false;
    in-out property <string> editor-discard-id;
    callback editor-discard-confirmed(string /* id */);
    callback editor-count-matches(string /* content */, string /* query */) -> int;
    callback editor-find-step(string /* content */, string /* query */, int /* current */, bool /* reverse */) -> EditorFindResult;

    // --- Session list ------------------------------------------------------
    in property <[SessionInfo]> sessions;
    in property <[SessionInfo]> recent-sessions;
    // New-tab launch menu (#427): local shells and the agent CLIs found here.
    in property <[LaunchItem]> launch-shells;
    in property <[LaunchItem]> agents;
    // Settings → AI agents: user-defined launchers for undetected agents.
    in property <[CustomAgentInfo]> custom-agents;
    in-out property <string> agent-new-name;
    in-out property <string> agent-new-command;
    in-out property <string> agent-new-directory;
    callback add-custom-agent(string, string, string);
    callback remove-custom-agent(string);
    callback pick-agent-directory();
    // Rebuild the launch menu, the "agents" group and the settings list.
    callback refresh-agent-launchers();
    // Settings page to show when the panel opens (see InterfacePanel).
    in-out property <string> interface-start-page: "general";
    // Bumped by Rust whenever the sessions model is rebuilt wholesale
    // (set_vec). A rebuild destroys the dragging row's pointer grab, so
    // Welcome watches this to clear its shared drag state instead of
    // leaving a card lifted forever.
    in property <int> sessions-revision: 0;
    in-out property <string> host-search-query;
    callback host-search-changed(string);

    // --- Tabs --------------------------------------------------------------
    in property <[TabInfo]> tabs;
    // --- Split panes (v0.5) — flattened from the Rust split tree -----------
    in property <[PaneInfo]> panes;
    in property <[SplitterInfo]> splitters;
    // --- Docked-panel edge stacks (#dock-stack) ---------------------------
    // Every expanded dock panel's absolute rect plus the dividers between
    // stacked panels, computed by Rust from `DockStacks::compute_geom`.
    in property <[PanelGeomInfo]> dock-panels;
    in property <[DividerGeomInfo]> dock-dividers;
    // Central content rect (the terminal) left over after every edge stack is
    // carved off; gaps are the taken thickness on each side.
    in-out property <length> dock-central-x: 0px;
    in-out property <length> dock-central-y: 0px;
    in-out property <length> dock-central-w: 1200px;
    in-out property <length> dock-central-h: 800px;
    property <length> dock-left-gap: root.dock-central-x;
    property <length> dock-right-gap: root.width - root.dock-central-x - root.dock-central-w;
    property <length> dock-top-gap: root.dock-central-y;
    property <length> dock-bottom-gap: root.height - root.dock-central-y - root.dock-central-h;
    callback stack-split-drag(string /* edge */, int /* index */, float /* pos */);
    // Reports the real dock-area size (window minus title bar): the Rust dock
    // engine must measure in THIS frame, not the window frame, or every panel
    // sits ~43px too low at the bottom edge (#dock-stack).
    callback dock-area-resized(length /* w */, length /* h */);
    // Any panel dock/collapse/size change must land in Rust to recompute the
    // dock geometry (#dock-stack).
    callback dock-layout-changed();
    // Drag a stacked panel's in-edge (central-facing) resize handle. `gi` is
    // the index into dock-panels; `pos` is the cursor's distance from the
    // panel's outer edge along the dock normal (the new extent, px).
    callback panel-extent-drag(int /* panel index */, float /* pos */);
    in-out property <string> active-tab-id: "welcome";
    in property <[TerminalState]> terminals;

    // --- Dialog state ------------------------------------------------------
    in-out property <bool> dialog-open: false;
    in-out property <bool> dialog-editing: false;
    in-out property <string> dialog-id;
    in-out property <string> dialog-name;
    in-out property <string> dialog-host;
    in-out property <string> dialog-port: "22";
    in-out property <string> dialog-user;
    in-out property <string> dialog-auth: "password";
    in-out property <string> dialog-password;
    in-out property <string> dialog-key-path;
    in-out property <string> dialog-key-inline;
    in-out property <bool> dialog-key-inline-mode: false;
    in-out property <string> dialog-proxy-type: "none";  // "none" | "socks5" | "http"
    in-out property <string> dialog-proxy-hostport;
    in-out property <string> dialog-group;
    // Existing group names (from Rust) for the dialog's group dropdown (#179).
    in property <[string]> session-groups;
    // SSH route editor (#211): candidates and ordered rows.
    in property <[string]> jump-choices;
    in property <[string]> jump-ids;
    in-out property <[JumpHop]> dialog-jumps;
    in-out property <bool> dialog-allow-secret-reveal: false;
    in-out property <bool> dialog-allow-mcp-access: true;
    callback reveal-session-secret(bool) -> string;
    callback add-jump();
    callback update-jump(int, int);
    callback delete-jump(int);
    callback move-jump(int, int);
    in-out property <string> dialog-kind: "ssh";
    in-out property <string> dialog-serial-port;
    // Existing serial port names (from Rust) for the dialog's serial port dropdown.
    in property <[string]> session-serial-ports;
    in-out property <string> dialog-baud: "115200";
    in-out property <string> dialog-data-bits: "8";
    in-out property <string> dialog-stop-bits: "1";
    in-out property <string> dialog-parity: "none";
    in-out property <string> dialog-flow: "none";
    // Windows logon domain for an RDP session ("" = none).
    in-out property <string> dialog-rdp-domain;
    // "fullscreen" | "custom" | "<width>x<height>" plus the custom size.
    in-out property <string> dialog-rdp-resolution: "1280x720";
    in-out property <string> dialog-rdp-width: "1280";
    in-out property <string> dialog-rdp-height: "720";
    in-out property <bool> dialog-rdp-legacy-tls: false;
    in-out property <bool> dialog-rdp-admin: false;
    in-out property <bool> dialog-rdp-smart-sizing: false;
    in-out property <string> dialog-rdp-cert-policy: "ignore";
    in-out property <string> dialog-rdp-network: "auto";
    in-out property <bool> dialog-rdp-sound: false;
    in-out property <bool> dialog-rdp-clipboard: true;
    in-out property <bool> dialog-rdp-gfx: false;
    in-out property <string> dialog-rdp-extra-args: "";
    in-out property <bool> dialog-rdp-show-advanced: false;
    in-out property <string> dialog-rdp-preview: "";
    in-out property <string> dialog-encoding: "UTF-8";
    in-out property <bool> dialog-vt100-drawing: true;
    in-out property <string> dialog-term-type: "xterm-256color";
    in-out property <string> dialog-session-log: "default";
    in-out property <bool> dialog-disable-shell-integration: false;
    in-out property <string> dialog-sftp-mode: "";
    in-out property <string> dialog-sftp-command: "";
    in-out property <string> dialog-note;
    in-out property <string> dialog-test-status;

    // Delete-confirmation modal state (#28).
    in-out property <bool> confirm-delete-open: false;
    in-out property <bool> confirm-delete-batch: false;   // delete checked entries (#100)
    in-out property <string> confirm-delete-tab;
    in-out property <string> confirm-delete-path;

    // One priority policy per AppWindow. Rendering and keyboard ownership both
    // use this value; lower layers retain drafts while covered.
    out property <ModalKind> active-modal:
        root.confirm-close-open ? ModalKind.exit-confirm :
        root.mfa-prompt-open ? ModalKind.mfa :
        root.cred-prompt-open ? ModalKind.credentials :
        root.hostkey-prompt-open ? ModalKind.host-key :
        root.confirm-delete-open ? ModalKind.delete-confirm :
        root.paste-confirm-open ? ModalKind.paste-confirm :
        root.qcg-open ? ModalKind.command-group :
        root.sftp-prompt-open ? ModalKind.sftp-prompt :
        root.chmod-open ? ModalKind.permissions :
        root.tab-rename-open ? ModalKind.tab-rename :
        root.group-dialog-open ? ModalKind.group :
        root.batch-import-open ? ModalKind.batch-import :
        root.dialog-open ? ModalKind.session :
        root.quick-cmd-manage-open ? ModalKind.quick-commands :
        root.interface-open ? ModalKind.settings :
        root.about-open ? ModalKind.about :
        root.shortcuts-open ? ModalKind.shortcuts : ModalKind.none;
    out property <bool> modal-open: root.active-modal != ModalKind.none;
    changed active-modal => {
        if !root.modal-open {
            shortcut-scope.focus();
            root.terminal-focus-sequence += 1;
        } else {
            root.settings-open = false;
            root.download-open = false;
        }
    }

    // --- Callbacks up to Rust ---------------------------------------------
    callback new-session-clicked();
    callback import-ssh-config();             // import hosts from ~/.ssh/config
    in-out property <string> ssh-import-hint;  // result text shown after import
    callback export-sessions();               // export all sessions to a file (#46)
    callback import-sessions();               // import sessions from a file (#46)
    in-out property <bool> batch-import-open: false;  // text batch-import dialog (#150)
    in-out property <string> batch-import-text;       // the textarea content
    callback batch-import-confirm(string /* pasted text */);
    // Multi-line terminal paste safety prompt (#262).
    in-out property <bool> paste-confirm-open: false;
    in-out property <string> paste-confirm-tab;
    // Preview only — Rust truncates this before set. The full paste payload
    // lives on the Rust side until the user confirms (#434 / slint#12985).
    in-out property <string> paste-confirm-preview;
    in-out property <bool> paste-confirm-large: false;
    property <int> terminal-focus-sequence;
    callback paste-confirmed(string /* tab-id */);
    callback paste-confirm-cancelled();
    callback connect-session(string /* session-id */);
    callback edit-session(string /* session-id */);
    callback duplicate-session(string /* session-id */);
    callback move-session(string /* session-id */, string /* group */);
    callback reorder-session(string /* session-id */, int /* dir: -1 up, 1 down */) -> bool;
    callback reorder-session-end();
    callback toggle-group(string /* group */);
    callback remove-session(string /* session-id */);
    callback session-dialog-submit(SessionDraft);
    callback session-dialog-test(SessionDraft);
    callback session-dialog-preview-rdp(SessionDraft) -> string;
    callback session-dialog-cancel();
    callback session-dialog-closed();
    callback session-dialog-stop-test();
    callback session-dialog-changed();
    callback session-dialog-pick-key();
    // Port forwards for the session being edited (#56).
    in-out property <[PortFwd]> dialog-forwards;
    in-out property <[TriggerDraft]> dialog-triggers;
    callback add-forward();
    callback update-forward(int /* index */, PortFwd);
    callback delete-forward(int /* index */);
    callback add-trigger();
    callback update-trigger(int /* index */, TriggerDraft);
    callback delete-trigger(int /* index */);

    callback tab-selected(string);
    callback tab-closed(string);
    callback new-tab-clicked();
    callback new-window-clicked();   // open another application window (#multi-window)
    // Per-pane tab actions (v0.5): the int is the pane (leaf) id.
    callback pane-tab-selected(int /* pane-id */, string /* tab-id */);
    callback pane-tab-closed(int /* pane-id */, string /* tab-id */);
    callback pane-new-tab(int /* pane-id */);
    // Drag-to-reorder inside a pane's strip (#408), committed once on drop: move
    // the tab at `from` to `to`, where `to` indexes the list with `from` removed.
    callback pane-tab-move(int /* pane-id */, int /* from */, int /* to */);
    // Where a tab dragged in from elsewhere would land in this pane's strip;
    // -1 when the cursor left it. Rust remembers the last report and uses it when
    // the drop lands on a tab strip (#408).
    callback pane-tab-drop-index(int /* pane-id */, int /* index */);
    callback pane-focus(int /* pane-id */);
    callback cycle-tab(bool /* reverse */);
    // Split pane `pane-id`, peeling `tab-id` into a new pane on `dir`
    // ("left"/"right"/"up"/"down").
    callback pane-split(int /* pane-id */, string /* tab-id */, string /* dir */);
    callback pane-merge(int /* pane-id */);
    // Open another connection to the same session as `tab-id` (a new tab).
    callback tab-duplicate(string /* tab-id */);
    // Rename an open session's tab. Request pre-fills the dialog (Rust reads
    // the current title); submit applies the new display name.
    callback tab-rename-request(string /* tab-id */);
    // Save the ssh connection running in a local tab as a session (#501).
    callback tab-save-session(string /* tab-id */);
    // Session log from the tab menu (#535).
    callback tab-log-active(string /* tab-id */) -> bool;
    callback tab-log-toggle(string /* tab-id */);
    callback rename-tab(string /* tab-id */, string /* new-title */);
    in-out property <bool> tab-rename-open: false;
    in-out property <string> tab-rename-id: "";
    in-out property <string> tab-rename-value: "";
    // Drag-to-split (v0.5): cursor moved / dropped while dragging `tab-id`, in
    // pane-area coordinates. Rust hit-tests the pane + edge zone. `over-own-strip`
    // means the source strip is already showing an insertion gap of its own, so no
    // pane drop-zone must light up (#408).
    callback tab-drag-move(string /* tab-id */, length /* x */, length /* y */,
                           bool /* over-own-strip */);
    callback tab-drag-drop(string /* tab-id */, length /* x */, length /* y */);
    // The drag ended without a drop (pointer grab lost, or an in-strip drag that
    // landed back on its own slot): clear whatever highlight it put up (#408).
    callback tab-drag-cancel();
    // Live tab-drag cursor in pane-area coordinates, republished so every pane's
    // tab strip can tell whether the drag is hovering over it (#408). Pane rects
    // come from the model, so the hit-test below needs nothing from the layout.
    property <bool> tab-drag-live;
    property <length> tab-drag-px;
    property <length> tab-drag-py;
    // Drop-zone highlight (set by Rust during a drag): the region the dropped
    // tab's new pane would occupy.
    in property <bool> drag-active;
    in property <length> drag-hl-x;
    in property <length> drag-hl-y;
    in property <length> drag-hl-w;
    in property <length> drag-hl-h;
    // Splitter drag: move split `split-id`'s boundary to `pos` (px along its axis).
    callback splitter-drag(int /* split-id */, length /* pos */, bool /* vertical */);
    // Reports the pane-area size to Rust so it can flatten the split tree into
    // absolute pane / splitter rects. Fired whenever the content area resizes.
    callback content-resized(length /* w */, length /* h */);
    // pane-area origin in window coordinates; tab drag-out converts
    // drop points to global screen coordinates with this (#tab-detach).
    out property <length> content-origin-x: pane-area.absolute-position.x;
    out property <length> content-origin-y: pane-area.absolute-position.y;
    // Asks Rust to recompute the sidebar (status + resources) for whatever tab
    // is now active.  Fired on every active-tab change, UI- or code-driven.
    callback refresh-sidebar();
    changed active-tab-id => {
        root.refresh-sidebar();
        // Closing the last session destroys the terminal's IME focus anchor
        // and nothing else re-claims focus — with no focused item, Slint
        // delivers keys nowhere, stranding the zen escape shortcut (and every
        // window-level shortcut). Re-anchor on the shortcut scope whenever the
        // welcome tab is active and no terminal remains.
        if (root.active-tab-id == "welcome" && root.terminals.length == 0) {
            shortcut-scope.focus();
        }
        // Terminal fullscreen only makes sense on a terminal tab (#495).
        if (root.term-fullscreen) {
            root.term-fullscreen-check();
        }
    }

    // Raw keystroke forwarding: Rust converts key+modifiers to PTY bytes.
    callback send-key(string /* tab-id */, string /* key */, bool /* ctrl */, bool /* alt */, bool /* shift */);
    callback terminal-scrollback-key(string /* tab-id */, string /* key */) -> bool;
    callback diagnose-key-event(string /* tab-id */, string /* key */, bool /* raw control */, bool /* raw meta */, bool /* alt */, bool /* shift */);
    // Notifies Rust of a PTY resize (pixel dimensions; Rust converts to cols/rows).
    callback terminal-resize(string /* tab-id */, float /* width-px */, float /* height-px */);

    // --- SFTP callbacks ---------------------------------------------------
    // Navigate to a new remote directory (or ".." to go up).
    callback sftp-navigate(string /* tab-id */, string /* path */);
    // Trigger a download: Rust opens a save-folder dialog then transfers.
    callback sftp-download(string /* tab-id */, string /* remote-path */);
    callback sftp-open-file(string /* tab-id */, string /* remote-path */);   // (#493)
    // Trigger an upload: Rust opens a file-picker dialog then transfers.
    callback sftp-upload-clicked(string /* tab-id */, string /* remote-dir */, bool /* folder */);
    // Upload the files / folders on the OS clipboard (#508).
    callback sftp-paste-upload(string /* tab-id */, string /* remote-dir */);
    // Refresh the current directory listing.
    callback sftp-refresh(string /* tab-id */, string /* path */);
    // Toggle expand/collapse of a tree node (also navigates to that directory).
    callback sftp-tree-expand(string /* tab-id */, string /* path */);
    callback sftp-delete(string /* tab-id */, string /* path */);
    callback sftp-toggle-select(string /* tab-id */, int /* row */);   // (#100)
    callback sftp-select-range(string /* tab-id */, int /* from */, int /* to */); // Shift+click
    // SFTP path bookmarks + recent folders (#500), stored per session.
    callback sftp-record-visit(string /* tab-id */, string /* path */);
    callback sftp-toggle-bookmark(string /* tab-id */, string /* path */);
    callback sftp-remove-bookmark(string /* tab-id */, string /* path */);
    callback sftp-clear-recent(string /* tab-id */);
    callback sftp-places-refresh(string /* tab-id */);
    callback sftp-drag-out(string /* tab-id */, int /* row */);   // to Explorer (#504)
    callback sftp-download-selected(string /* tab-id */);              // (#100)
    callback sftp-delete-selected(string /* tab-id */);               // (#100)
    callback sftp-copy-to-target(string /* tab-id */, string /* remote-path */, string /* target-tab-id */);
    callback sftp-copy-selected-to-target(string /* tab-id */, string /* target-tab-id */);
    callback sftp-view(string /* tab-id */, string /* path */);
    callback sftp-edit(string /* tab-id */, string /* path */);
    callback sftp-open-external(string /* tab-id */, string /* path */);
    callback sftp-edit-external(string /* tab-id */, string /* path */);
    callback sftp-sort-request(string /* tab-id */, string /* key */);
    callback sftp-clear-sort(string /* tab-id */);
    callback tunnel-add(string /* tab-id */, string /* name */, string /* kind */, string /* bind */, string /* bind-port */, string /* host */, string /* host-port */, bool /* save */, bool /* auto-start */);
    callback tunnel-stop(string /* tab-id */, string /* tunnel-id */);
    callback tunnel-start(string /* tab-id */, string /* tunnel-id */);
    callback tunnel-delete(string /* tab-id */, string /* tunnel-id */);
    // SFTP context-menu extensions (#69): rename / chmod / mkdir / touch share
    // one single-input prompt dialog; copy-path goes straight to the clipboard.
    in-out property <bool> sftp-prompt-open: false;
    in-out property <string> sftp-prompt-kind;   // "rename"|"chmod"|"mkdir"|"touch"
    in-out property <string> sftp-prompt-tab;    // tab the action applies to
    in-out property <string> sftp-prompt-target; // path acted on (or parent dir)
    in-out property <string> sftp-prompt-value;  // user input
    callback sftp-prompt-submit(string /* tab */, string /* kind */, string /* target */, string /* value */);
    callback sftp-copy-path(string);             // put the path on the clipboard

    // --- Split (dual-pane) SFTP view --------------------------------------
    // The left pane browses local folders, the right pane the remote host; the
    // transfer buttons in between copy the checked (or clicked) entries.
    callback sftp-toggle-dual(string /* tab-id */);
    callback sftp-local-navigate(string /* tab-id */, string /* path */);   // "..", "~" or a path
    callback sftp-local-up(string /* tab-id */);
    callback sftp-local-home(string /* tab-id */);
    callback sftp-local-refresh(string /* tab-id */);
    callback sftp-local-open(string /* tab-id */, string /* local-path */);  // OS default app
    callback sftp-local-toggle-select(string /* tab-id */, int /* row */);
    callback sftp-local-select-range(string /* tab-id */, int /* from */, int /* to */);
    callback sftp-local-copy-path(string /* local-path */);
    callback sftp-local-upload(string /* tab-id */, string /* local-path */);
    callback sftp-local-upload-selected(string /* tab-id */);
    callback sftp-download-to-local(string /* tab-id */, string /* remote-path */);
    callback sftp-download-selected-to-local(string /* tab-id */);
    // Split-view divider moved (0 = back to an even split).
    callback persist-sftp-local-pane-width(string /* tab-id */, length /* px */);
    // Split-view preferences, remembered across restarts (#532).
    callback persist-sftp-split(bool /* enabled */);
    callback persist-sftp-local-split(float /* ratio, 0 = even */);
    callback sftp-local-places-refresh(string /* tab-id */);
    // Local bookmarks / recent folders (#532), machine-wide.
    callback sftp-local-toggle-bookmark(string /* tab-id */);
    callback sftp-local-remove-bookmark(string /* tab-id */, string /* path */);
    callback sftp-local-clear-recent(string /* tab-id */);
    callback sftp-local-sort-request(string /* tab-id */, string /* key */, int /* dir */);
    pure callback sftp-entry-matches(string /* name */, string /* file-type */, string /* query */) -> bool;
    // Local list options (#532 follow-up).
    callback sftp-local-toggle-hidden(string /* tab-id */);
    callback sftp-local-sort(string /* tab-id */, string /* column */);
    callback sftp-local-set-filter(string /* tab-id */, string /* text */);
    callback sftp-local-remove-recent(string /* tab-id */, string /* path */);
    callback sftp-local-move-bookmark(string /* tab-id */, string /* path */, int /* delta */);
    callback sftp-local-reveal(string /* tab-id */);

    // Visual chmod dialog (#84). Rust decomposes the current mode into nine
    // bools when opening and recomposes on apply (Slint has no bitwise ops).
    in-out property <bool> chmod-open: false;
    in-out property <string> chmod-tab;
    in-out property <string> chmod-path;
    in-out property <string> chmod-name;
    in-out property <bool> chmod-or; in-out property <bool> chmod-ow; in-out property <bool> chmod-ox;
    in-out property <bool> chmod-gr; in-out property <bool> chmod-gw; in-out property <bool> chmod-gx;
    in-out property <bool> chmod-tr; in-out property <bool> chmod-tw; in-out property <bool> chmod-tx;
    callback sftp-chmod-open(string /* tab */, string /* path */, string /* name */, int /* mode */);
    callback sftp-chmod-apply();                  // reads the bools, chmods, closes

    // --- Clipboard callbacks ----------------------------------------------
    // Paste clipboard text into the active terminal.
    callback paste-from-clipboard(string /* tab-id */);
    // Copy the current terminal screen buffer to the clipboard.
    callback copy-terminal-text(string /* tab-id */);
    // Clear a session's terminal buffer (its visible screen + scrollback).
    callback clear-terminal(string /* tab-id */);
    // Recompute search highlights for a session's visible screen.
    callback find-query-changed(string /* tab-id */, string /* query */);
    // Pointer over a tab's terminal output, from Slint's own hit testing; gates
    // the macOS wheel fallback (#540).
    callback terminal-output-hover(string /* tab-id */, bool /* hovered */);
    // Step through find matches across scrollback (#535); dir 0/1/-1.
    callback find-step(string /* tab-id */, string /* query */, int /* dir */) -> FindStatus;
    // Scroll a session's scrollback history by N lines (+ = up/older).
    callback terminal-scroll(string /* tab-id */, float /* delta-lines (fractional, momentum-aware) */);
    // Wheel forwarded to an alt-screen program (#170): tab-id, dir (+1 up/-1 down), col, row.
    callback terminal-wheel(string, int, int, int);
    callback terminal-scroll-to(string /* tab-id */, int /* offset */); // scrollbar drag (#103)
    // Mouse event forwarded to a mouse-tracking TUI app (#terminal-mouse).
    callback terminal-mouse(string /* tab-id */, int /* kind */, int /* button */, int /* row */, int /* col */) -> bool;
    // Drag-selection lifecycle (grid row/col coordinates).
    callback term-select-start(string /* tab-id */, int /* row */, int /* col */, bool /* ctrl */, bool /* shift */);
    callback term-select-update(string /* tab-id */, int /* row */, int /* col */);
    callback term-select-end(string /* tab-id */);
    callback term-select-clear(string /* tab-id */);   // drop the local selection (#542)
    callback term-select-word(string /* tab-id */, int /* row */, int /* col */);
    callback term-select-autoscroll(string /* tab-id */, int /* dir */);

    // Immersive wallpaper layer — painted behind everything, filling the window.
    // Panels/terminal frost over it (see Theme.frost). Only present when active.
    if Theme.wallpaper-active : Image {
        x: 0; y: 0;
        width: parent.width;
        height: parent.height;
        source: Theme.wallpaper;
        image-fit: cover;
    }

    // Zen (focus) mode keyboard toggle — same persist path as the Settings
    // switch (#zen).
    toggle-zen-key => {
        root.zen-mode = !root.zen-mode;
        root.set-zen-mode(root.zen-mode);
        // (Dock recompute comes from `changed zen-mode` on root.)
        // Entering zen with no terminals can leave nothing focused (the
        // welcome page may be hidden as a sidebar), which would strand the
        // Ctrl+Alt+Z escape shortcut — anchor focus on the shortcut scope.
        if (root.zen-mode && root.terminals.length == 0) {
            shortcut-scope.focus();
        }
    }

    // Window-wide shortcut interceptor (#multi-window). Slint delivers a key
    // to the focused item first and only bubbles it up the ancestor chain when
    // it is rejected there; a Window itself cannot bind key-pressed. This
    // passive FocusScope therefore wraps the whole main content and catches any
    // shortcut no descendant consumed — so new-window works on the welcome page
    // (where no TerminalView exists yet) and whenever focus is on a non-terminal
    // widget. It never takes focus itself (focus-on-click / focus-on-tab-
    // navigation are off), so it does not disturb the terminal IME anchor or any
    // other widget. A focused terminal accepts ⌘⇧N / Ctrl+Shift+N on its own
    // (terminal_view.slint), which stops propagation, so the two never
    // double-fire.
    shortcut-scope := FocusScope {
        focus-on-click: false;
        focus-on-tab-navigation: false;
        // A window restored into zen mode starts with nothing focused when no
        // focusable widget is on screen (e.g. the welcome page is hidden as a
        // sidebar and no terminal exists yet). Slint delivers keys only to the
        // focused item, so the Ctrl+Alt+Z escape shortcut would be stranded in
        // exactly that stuck state. Claim focus on the next event-loop turn —
        // deferred like the welcome scope so AccessKit/winit aren't re-entered
        // from `init` (#323); any real widget that takes focus later (welcome
        // page, terminal IME anchor) simply overrides this.
        property <bool> zen-focus-pending: false;
        init => { shortcut-scope.zen-focus-pending = root.zen-mode && root.terminals.length == 0; }
        Timer {
            interval: 0ms;
            running: shortcut-scope.zen-focus-pending;
            triggered => {
                shortcut-scope.zen-focus-pending = false;
                shortcut-scope.focus();
            }
        }
        key-pressed(e) => {
            // Window-wide fallback for the (customisable) window shortcuts:
            // new window, font zoom, zen, terminal fullscreen. A focused
            // terminal consumes these itself (terminal_view.slint), so there
            // is no double-fire; this catches them when focus sits elsewhere
            // (welcome page, sidebars, a hidden tab's view).
            let act = root.match-shortcut(e.text, e.modifiers.control, e.modifiers.meta,
                                          e.modifiers.alt, e.modifiers.shift, false);
            if (act == "new-window") {
                root.new-window-clicked();
                accept
            } else if (act == "zoom-in" || act == "zoom-out" || act == "zoom-reset"
                    || act == "zoom-in-all" || act == "zoom-out-all" || act == "zoom-reset-all") {
                root.zoom-term-font(root.active-tab-id,
                    (act == "zoom-in" || act == "zoom-in-all") ? 1
                        : (act == "zoom-out" || act == "zoom-out-all") ? -1 : 0,
                    act == "zoom-in-all" || act == "zoom-out-all" || act == "zoom-reset-all");
                accept
            } else if (act == "zen") {
                root.toggle-zen-key();
                accept
            } else if (act == "fullscreen") {
                root.toggle-term-fullscreen();
                accept
            } else {
                reject
            }
        }

        VerticalLayout {
            spacing: 0;

            // macOS immersive bar: a strip under the native traffic-light buttons.
            // Frosted like the other panels (bg-panel) so it matches in both themes —
            // a plain transparent strip would show the raw wallpaper here and look dark
            // in light mode. Left as a plain reserve (no TouchArea) so macOS's own title
            // bar keeps handling the window drag in this region.
            if root.titlebar-inset > 0px : Rectangle {
                height: root.titlebar-inset;
                background: Theme.bg-panel;
            }

            // Immersive custom title bar (#119) — only on frameless platforms
            // (Windows/Linux). App icon + name on the left, a draggable middle
            // (move window / double-click to maximize), then the toolbar icons and
            // window controls on the right. macOS keeps its native title bar and
            // shows the toolbar icons via the overlay further below.
            if root.custom-titlebar && !root.term-fullscreen : Rectangle {
                height: 38px;
                background: Theme.bg-panel;
                tb-drag := TouchArea {
                    pointer-event(e) => {
                        if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                            root.win-drag();
                        }
                    }
                    double-clicked => { root.win-maximize-toggle(); }
                }
                HorizontalLayout {
                    padding-left: 12px;
                    spacing: 8px;
                    // Vertical-centering wrappers so the icon and name line up (#119).
                    VerticalLayout {
                        alignment: center;
                        Image {
                            source: @image-url("../assets/icon.png");
                            width: 18px;
                            height: 18px;
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        Text {
                            text: "meatshell";
                            color: Theme.text-secondary;
                            font-size: Theme.fs-sm;
                        }
                    }
                    // Draggable spacer (no TouchArea → clicks fall to tb-drag).
                    Rectangle { horizontal-stretch: 1; }
                    // Window controls only — the app toolbar icons live in the tab
                    // row below, not here (#119).
                    WinBtn { icon: "\u{E15B}"; clicked => { root.win-minimize(); } }
                    WinBtn {
                        icon: root.window-maximized ? "\u{E3E0}" : "\u{E835}";
                        clicked => { root.win-maximize-toggle(); }
                    }
                    WinBtn { icon: "\u{E5CD}"; danger: true; clicked => { root.win-close(); } }
                }
            }

            // Dock area — fills below the title bar. The resource sidebar and the
            // central content are positioned by absolute geometry computed from
            // `sidebar-dock`, so the sidebar can sit on any window edge (#dock).
            dock-area := Rectangle {
            vertical-stretch: 1;
            // Feed the Rust dock engine the real area it lays panels into, and
            // re-run the geometry whenever that frame changes (window resize,
            // zen toggle) — `rest` no longer tracks parent sizes itself.
            changed width => { root.dock-area-resized(self.width, self.height); }
            changed height => { root.dock-area-resized(self.width, self.height); }
            // Left-edge layout (welcome-as-sidebar mode): a thin always-on icon strip
            // (IDEA-style) + the welcome/session sidebar (0 when collapsed). The rest
            // (resource panel + central terminal, which never collapses) sits to their
            // right in `rest`.
            // Collapsed-only (M5): the icon strip shows only while collapsed; the
            // panel itself (welcome-w) only while expanded — one or the other.
            property <bool> sidebar-strip-outside:
                !root.hide-panels && root.welcome-as-sidebar && !root.welcome-collapsed
                && root.effective-sidebar-collapsed && root.sidebar-dock == root.welcome-sidebar-dock;
            property <length> sidebar-outside-strip: dock-area.sidebar-strip-outside ? 36px : 0px;
            property <length> welcome-strip: (!root.hide-panels && root.welcome-as-sidebar && root.welcome-collapsed) ? 36px : 0px;
            property <length> welcome-size: (!root.hide-panels && root.welcome-as-sidebar && !root.welcome-collapsed) ? root.welcome-sidebar-width : 0px;
            property <length> welcome-taken: welcome-strip + welcome-size + sidebar-outside-strip;
            property <bool> welcome-horizontal: root.welcome-sidebar-horizontal;
            property <bool> welcome-sidebar-dragging;
            property <bool> combine-collapsed-tools:
                root.welcome-as-sidebar && root.welcome-collapsed
                && root.effective-sidebar-collapsed && root.sidebar-dock == root.welcome-sidebar-dock;
            // A collapsed quick-command sidebar joins an existing collapsed strip
            // on the same edge. Only when no such strip exists does it reserve its
            // own outermost 36px slot (#215).
            property <bool> quick-merge-welcome:
                root.quick-panel-open && root.quick-panel-collapsed
                && root.welcome-as-sidebar && root.welcome-collapsed
                && root.quick-panel-dock == root.welcome-sidebar-dock;
            property <bool> quick-merge-sidebar:
                root.quick-panel-open && root.quick-panel-collapsed
                && !dock-area.quick-merge-welcome && root.effective-sidebar-collapsed
                && root.quick-panel-dock == root.sidebar-dock;
            property <length> quick-outer-strip:
                !root.hide-panels && root.quick-panel-open && root.quick-panel-collapsed
                    && !dock-area.quick-merge-welcome && !dock-area.quick-merge-sidebar
                    ? 36px : 0px;
            property <bool> quick-outer-horizontal:
                root.quick-panel-dock == "left" || root.quick-panel-dock == "right";
            property <length> quick-left:
                root.quick-panel-dock == "left" ? dock-area.quick-outer-strip : 0px;
            property <length> quick-right:
                root.quick-panel-dock == "right" ? dock-area.quick-outer-strip : 0px;
            property <length> quick-top:
                root.quick-panel-dock == "top" ? dock-area.quick-outer-strip : 0px;
            property <length> quick-bottom:
                root.quick-panel-dock == "bottom" ? dock-area.quick-outer-strip : 0px;

            // ── Unified Left Activity Bar (ChatGPT Desktop style) ───────────
            // Occupies the outermost 44px on the left edge when panels are shown.
            // Top: Sessions | Resource Monitor | Quick Commands (mutually exclusive
            // when docked on the left). Bottom: Transfers | Theme | Updates | Settings.
            if !root.hide-panels && (root.dock-central-x >= 44px || root.dock-panels.length > 0) : Rectangle {
                x: 0px;
                y: 0px;
                z: 200;
                width: 44px;
                height: parent.height;
                background: Theme.bg-panel;

                // Right 1px divider
                Rectangle {
                    x: parent.width - 1px;
                    y: 0px;
                    width: 1px;
                    height: parent.height;
                    background: Theme.border-subtle;
                }

                VerticalLayout {
                    padding-top: 10px;
                    padding-bottom: 10px;
                    padding-left: 5px;
                    padding-right: 5px;
                    spacing: 6px;

                    // 1. Sessions / Quick Connect sidebar toggle
                    IconBtn {
                        btn-size: 34px;
                        icon-size: 18px;
                        icon: "sessions";
                        tooltip: root.lang-en ? "Sessions" : "会话列表";
                        tooltip-right: true;
                        active: root.welcome-as-sidebar && !root.welcome-collapsed;
                        clicked => {
                            if (!root.welcome-as-sidebar) {
                                root.welcome-as-sidebar = true;
                                root.set-welcome-as-sidebar(true);
                                root.welcome-sidebar-dock = "left";
                                root.persist-welcome-sidebar-dock("left");
                                root.welcome-collapsed = false;
                                root.set-welcome-collapsed(false);
                                if (root.sidebar-dock == "left" && !root.sidebar-collapsed) {
                                    root.sidebar-collapsed = true;
                                    root.set-sidebar-collapsed(true);
                                }
                                if (root.quick-panel-open && root.quick-panel-dock == "left" && !root.quick-panel-collapsed) {
                                    root.quick-panel-collapsed = true;
                                }
                            } else if (!root.welcome-collapsed && root.welcome-sidebar-dock == "left") {
                                root.welcome-collapsed = true;
                                root.set-welcome-collapsed(true);
                            } else {
                                root.welcome-sidebar-dock = "left";
                                root.persist-welcome-sidebar-dock("left");
                                root.welcome-collapsed = false;
                                root.set-welcome-collapsed(false);
                                if (root.sidebar-dock == "left" && !root.sidebar-collapsed) {
                                    root.sidebar-collapsed = true;
                                    root.set-sidebar-collapsed(true);
                                }
                                if (root.quick-panel-open && root.quick-panel-dock == "left" && !root.quick-panel-collapsed) {
                                    root.quick-panel-collapsed = true;
                                }
                            }
                            root.dock-layout-changed();
                        }
                    }

                    // 2. Resource Monitor sidebar toggle
                    IconBtn {
                        btn-size: 34px;
                        icon-size: 18px;
                        icon: "monitor";
                        tooltip: root.lang-en ? "Resource monitor" : "服务器监控";
                        tooltip-right: true;
                        active: !root.effective-sidebar-collapsed;
                        clicked => {
                            if (!root.has-active-session) {
                                root.home-monitor-open = !root.home-monitor-open;
                                if (root.home-monitor-open && root.sidebar-dock == "left") {
                                    if (root.welcome-as-sidebar && root.welcome-sidebar-dock == "left" && !root.welcome-collapsed) {
                                        root.welcome-collapsed = true;
                                        root.set-welcome-collapsed(true);
                                    }
                                    if (root.quick-panel-open && root.quick-panel-dock == "left" && !root.quick-panel-collapsed) {
                                        root.quick-panel-collapsed = true;
                                    }
                                }
                            } else if (!root.sidebar-collapsed) {
                                root.sidebar-collapsed = true;
                                root.set-sidebar-collapsed(true);
                            } else {
                                root.sidebar-collapsed = false;
                                root.set-sidebar-collapsed(false);
                                if (root.sidebar-dock == "left") {
                                    if (root.welcome-as-sidebar && root.welcome-sidebar-dock == "left" && !root.welcome-collapsed) {
                                        root.welcome-collapsed = true;
                                        root.set-welcome-collapsed(true);
                                    }
                                    if (root.quick-panel-open && root.quick-panel-dock == "left" && !root.quick-panel-collapsed) {
                                        root.quick-panel-collapsed = true;
                                    }
                                }
                            }
                            root.dock-layout-changed();
                        }
                    }

                    // 3. Quick Commands sidebar toggle
                    IconBtn {
                        btn-size: 34px;
                        icon-size: 18px;
                        icon: "bolt";
                        tooltip: @tr("Quick commands");
                        tooltip-right: true;
                        active: root.quick-panel-open && !root.quick-panel-collapsed;
                        clicked => {
                            if (root.quick-panel-open && !root.quick-panel-collapsed && root.quick-panel-dock == "left") {
                                root.quick-panel-collapsed = true;
                            } else {
                                if (!root.quick-commands-as-sidebar) {
                                    root.quick-commands-as-sidebar = true;
                                    root.set-quick-commands-as-sidebar(true);
                                }
                                root.quick-panel-dock = "left";
                                root.quick-panel-open = true;
                                root.quick-panel-collapsed = false;
                                if (root.welcome-as-sidebar && root.welcome-sidebar-dock == "left" && !root.welcome-collapsed) {
                                    root.welcome-collapsed = true;
                                    root.set-welcome-collapsed(true);
                                }
                                if (root.sidebar-dock == "left" && !root.sidebar-collapsed) {
                                    root.sidebar-collapsed = true;
                                    root.set-sidebar-collapsed(true);
                                }
                            }
                            root.dock-layout-changed();
                        }
                    }

                    // Flexible middle spacer
                    Rectangle { vertical-stretch: 1; }

                    // Bottom global utilities: Transfers, Theme, Updates, Settings
                    IconBtn {
                        btn-size: 34px;
                        icon-size: 18px;
                        icon: "transfer";
                        tooltip: @tr("Transfers manager");
                        tooltip-right: true;
                        active: root.download-open;
                        breathe: root.has-active-transfers;
                        clicked => {
                            root.download-open = !root.download-open;
                            root.settings-open = false;
                        }
                    }
                    IconBtn {
                        btn-size: 34px;
                        icon-size: 18px;
                        icon: Theme.dark ? "sun" : "moon";
                        tooltip: root.lang-en ? "Toggle theme" : "切换主题";
                        tooltip-right: true;
                        clicked => { root.toggle-theme(); }
                    }
                    IconBtn {
                        btn-size: 34px;
                        icon-size: 18px;
                        icon: "update";
                        badge: root.update-available;
                        tooltip: root.update-available
                            ? (root.lang-en ? "Update available: " : "有新版本：") + root.update-version
                            : (root.lang-en ? "Updates" : "软件更新");
                        tooltip-right: true;
                        clicked => {
                            root.settings-open = false;
                            root.download-open = false;
                            root.interface-start-page = "update";
                            root.interface-open = true;
                        }
                    }
                    IconBtn {
                        btn-size: 34px;
                        icon-size: 18px;
                        icon: "settings";
                        tooltip: root.lang-en ? "Settings" : "设置";
                        tooltip-right: true;
                        active: root.interface-open;
                        clicked => {
                            root.settings-open = false;
                            root.download-open = false;
                            root.ssh-import-hint = "";
                            root.interface-start-page = "general";
                            root.interface-open = true;
                        }
                    }
                }
            }

            if dock-area.quick-outer-strip > 0px && root.quick-panel-dock != "left" : ToolStrip {
                x: root.quick-panel-dock == "right" ? parent.width - parent.quick-outer-strip : 0px;
                y: root.quick-panel-dock == "bottom" ? parent.height - parent.quick-outer-strip : 0px;
                width: parent.quick-outer-horizontal ? parent.quick-outer-strip : parent.width;
                height: parent.quick-outer-horizontal ? parent.height : parent.quick-outer-strip;
                dock-edge: root.quick-panel-dock;
                glyph: "\u{E3E7}";
                tooltip: @tr("Quick commands");
                expand => {
                    root.quick-panel-collapsed = false;
                    root.dock-layout-changed();
                }
            }

            // Collapsed welcome → a thin icon strip on non-left edges.
            if root.welcome-as-sidebar && root.welcome-collapsed && root.welcome-sidebar-dock != "left" : ToolStrip {
                x: root.welcome-sidebar-dock == "right"
                    ? parent.width - parent.quick-right - parent.welcome-strip
                    : root.welcome-sidebar-dock == "left" ? parent.quick-left : parent.quick-left;
                y: root.welcome-sidebar-dock == "bottom"
                    ? parent.height - parent.quick-bottom - parent.welcome-strip
                    : root.welcome-sidebar-dock == "top" ? parent.quick-top : parent.quick-top;
                width: parent.welcome-horizontal ? parent.welcome-strip
                    : parent.width - parent.quick-left - parent.quick-right;
                height: parent.welcome-horizontal
                    ? parent.height - parent.quick-top - parent.quick-bottom : parent.welcome-strip;
                dock-edge: root.welcome-sidebar-dock;
                glyph: "\u{E88A}";   // session list / welcome
                show-second: parent.combine-collapsed-tools || parent.quick-merge-welcome;
                second-glyph: parent.combine-collapsed-tools ? "\u{E871}" : "\u{E3E7}";
                show-third: parent.combine-collapsed-tools && parent.quick-merge-welcome;
                third-glyph: "\u{E3E7}";
                expand => {
                    root.welcome-collapsed = false;
                    root.set-welcome-collapsed(false);
                    root.dock-layout-changed();
                }
                expand-second => {
                    if (parent.combine-collapsed-tools) {
                        if (!root.has-active-session) {
                            root.home-monitor-open = true;
                        } else {
                            root.sidebar-collapsed = false;
                            root.set-sidebar-collapsed(false);
                        }
                    } else if (parent.quick-merge-welcome) {
                        root.quick-panel-collapsed = false;
                    }
                    root.dock-layout-changed();
                }
                expand-third => {
                    if (parent.combine-collapsed-tools && parent.quick-merge-welcome) {
                        root.quick-panel-collapsed = false;
                    }
                    root.dock-layout-changed();
                }
            }

            // Collapsed resource panel → a ToolStrip icon bar on non-left edges.
            if !root.hide-panels && root.has-active-session && root.effective-sidebar-collapsed && root.sidebar-dock != "left" && !dock-area.combine-collapsed-tools && !dock-area.sidebar-strip-outside : ToolStrip {
                x: root.sidebar-dock == "right"
                    ? parent.width - 36px - parent.quick-right
                    : parent.quick-left;
                y: root.sidebar-dock == "bottom"
                    ? parent.height - 36px - parent.quick-bottom
                    : parent.quick-top;
                width: root.sidebar-horizontal
                    ? 36px : parent.width - parent.quick-left - parent.quick-right;
                height: root.sidebar-horizontal
                    ? parent.height - parent.quick-top - parent.quick-bottom
                    : 36px;
                dock-edge: root.sidebar-dock;
                glyph: "\u{E871}";   // dashboard — resource panel
                show-second: dock-area.quick-merge-sidebar;
                second-glyph: "\u{E3E7}";
                expand => {
                    if (!root.has-active-session) {
                        root.home-monitor-open = true;
                    } else {
                        root.sidebar-collapsed = false;
                        root.set-sidebar-collapsed(false);
                    }
                    root.dock-layout-changed();
                }
                expand-second => {
                    if (dock-area.quick-merge-sidebar) {
                        root.quick-panel-collapsed = false;
                    }
                    root.dock-layout-changed();
                }
            }

            if dock-area.sidebar-strip-outside && root.welcome-sidebar-dock != "left" : ToolStrip {
                x: root.welcome-sidebar-dock == "right"
                    ? parent.width - parent.quick-right - parent.sidebar-outside-strip
                    : root.welcome-sidebar-dock == "left" ? parent.quick-left : parent.quick-left;
                y: root.welcome-sidebar-dock == "bottom"
                    ? parent.height - parent.quick-bottom - parent.sidebar-outside-strip
                    : root.welcome-sidebar-dock == "top" ? parent.quick-top : parent.quick-top;
                width: parent.welcome-horizontal ? parent.sidebar-outside-strip
                    : parent.width - parent.quick-left - parent.quick-right;
                height: parent.welcome-horizontal
                    ? parent.height - parent.quick-top - parent.quick-bottom : parent.sidebar-outside-strip;
                dock-edge: root.welcome-sidebar-dock;
                glyph: "\u{E871}";
                show-second: parent.quick-merge-sidebar;
                second-glyph: "\u{E3E7}";
                expand => {
                    if (!root.has-active-session) {
                        root.home-monitor-open = true;
                    } else {
                        root.sidebar-collapsed = false;
                        root.set-sidebar-collapsed(false);
                    }
                    root.dock-layout-changed();
                }
                expand-second => {
                    if (parent.quick-merge-sidebar) {
                        root.quick-panel-collapsed = false;
                    }
                    root.dock-layout-changed();
                }
            }

            // Welcome / session list, to the right of the icon strip. Hidden when
            // collapsed — its icon stays in the strip; clicking it re-opens.
            if false : Rectangle {
                x: root.welcome-sidebar-dock == "right"
                    ? parent.width - parent.quick-right - parent.sidebar-outside-strip - parent.welcome-size
                  : root.welcome-sidebar-dock == "left"
                    ? parent.quick-left + parent.sidebar-outside-strip
                  : parent.quick-left;
                y: root.welcome-sidebar-dock == "bottom"
                    ? parent.height - parent.quick-bottom - parent.sidebar-outside-strip - parent.welcome-size
                  : root.welcome-sidebar-dock == "top"
                    ? parent.quick-top + parent.sidebar-outside-strip
                  : parent.quick-top;
                width: parent.welcome-horizontal ? parent.welcome-size
                    : parent.width - parent.quick-left - parent.quick-right;
                height: parent.welcome-horizontal
                    ? parent.height - parent.quick-top - parent.quick-bottom : parent.welcome-size;
                background: Theme.bg-panel;
                clip: true;
                Welcome {
                    width: parent.width;
                    height: parent.height;
                    compact: true;
                    dock-edge: root.welcome-sidebar-dock;
                    sessions: root.sessions;
                    import-hint: root.ssh-import-hint;
                    search-query <=> root.host-search-query;
                    sessions-revision: root.sessions-revision;
                    search-changed(query) => { root.host-search-changed(query); }
                    collapse => {
                        root.welcome-collapsed = true;
                        root.set-welcome-collapsed(true);
                    }
                    dock-drag-move(ax, ay) => {
                        root.panel-dragging = true;
                        root.drag-nx = (ax - dock-area.absolute-position.x) / dock-area.width;
                        root.drag-ny = (ay - dock-area.absolute-position.y) / dock-area.height;
                    }
                    dock-drag-end() => {
                        if (root.dock-target != "") {
                            root.welcome-sidebar-dock = root.dock-target;
                            if (root.sidebar-dock == root.dock-target) {
                                root.sidebar-collapsed = true;
                                root.set-sidebar-collapsed(true);
                            }
                            if (root.quick-panel-open && root.quick-panel-dock == root.dock-target) {
                                root.quick-panel-collapsed = true;
                            }
                            root.persist-welcome-sidebar-dock(root.welcome-sidebar-dock);
                        }
                        root.panel-dragging = false;
                    }
                    new-session => { root.new-session-clicked(); }
                    import-ssh-config => { root.import-ssh-config(); }
                    connect-session(id) => { root.connect-session(id); }
                    edit-session(id) => { root.edit-session(id); }
                    duplicate-session(id) => { root.duplicate-session(id); }
                    move-session(id, group) => { root.move-session(id, group); }
                    reorder-session(id, dir) => { return root.reorder-session(id, dir); }
                    reorder-end => { root.reorder-session-end(); }
                    toggle-group(group) => { root.toggle-group(group); }
                    create-group-inline(name) => { root.submit-group("", name); }
                    new-group => {
                        root.group-dialog-orig = "";
                        root.group-dialog-name = "";
                        root.group-dialog-error = "";
                        root.group-dialog-open = true;
                    }
                    edit-group(name) => {
                        root.group-dialog-orig = name;
                        root.group-dialog-name = name;
                        root.group-dialog-error = "";
                        root.group-dialog-open = true;
                    }
                    delete-group(name) => { root.delete-group(name); }
                    remove-session(id) => { root.remove-session(id); }
                }
                Rectangle {
                    x: root.welcome-sidebar-dock == "left" ? parent.width - 1px : 0px;
                    y: root.welcome-sidebar-dock == "top" ? parent.height - 1px : 0px;
                    width: root.welcome-sidebar-horizontal ? 1px : parent.width;
                    height: root.welcome-sidebar-horizontal ? parent.height : 1px;
                    background: Theme.border-subtle;
                }
            }

            // Drag the welcome sidebar's right edge to resize it (v0.5 M3b).
            if false : Rectangle {
                x: root.welcome-sidebar-dock == "left" ? parent.quick-left + parent.sidebar-outside-strip + parent.welcome-size - 2px
                  : root.welcome-sidebar-dock == "right" ? parent.width - parent.quick-right - parent.sidebar-outside-strip - parent.welcome-size - 2px
                  : parent.quick-left;
                y: root.welcome-sidebar-dock == "top" ? parent.quick-top + parent.sidebar-outside-strip + parent.welcome-size - 2px
                  : root.welcome-sidebar-dock == "bottom" ? parent.height - parent.quick-bottom - parent.sidebar-outside-strip - parent.welcome-size - 2px
                  : parent.quick-top;
                width: parent.welcome-horizontal ? 4px
                    : parent.width - parent.quick-left - parent.quick-right;
                height: parent.welcome-horizontal
                    ? parent.height - parent.quick-top - parent.quick-bottom : 4px;
                background: ws-split-ta.has-hover || dock-area.welcome-sidebar-dragging
                    ? Theme.accent : transparent;
                ws-split-ta := TouchArea {
                    mouse-cursor: dock-area.welcome-horizontal ? ew-resize : ns-resize;
                    pointer-event(ev) => {
                        if (ev.kind == PointerEventKind.down) {
                            dock-area.welcome-sidebar-dragging = true;
                        } else if (ev.kind == PointerEventKind.up) {
                            dock-area.welcome-sidebar-dragging = false;
                            root.persist-welcome-sidebar-width(root.welcome-sidebar-width / 1px);
                        }
                    }
                    moved => {
                        if (dock-area.welcome-sidebar-dragging) {
                            if (dock-area.welcome-horizontal) {
                                root.welcome-sidebar-width = clamp(
                                    root.welcome-sidebar-dock == "right"
                                        ? dock-area.absolute-position.x + dock-area.width
                                            - (self.absolute-position.x + self.mouse-x)
                                        : self.absolute-position.x + self.mouse-x
                                            - dock-area.absolute-position.x,
                                    160px, 480px);
                            } else {
                                root.welcome-sidebar-width = clamp(
                                    root.welcome-sidebar-dock == "bottom"
                                        ? dock-area.absolute-position.y + dock-area.height
                                            - (self.absolute-position.y + self.mouse-y)
                                        : self.absolute-position.y + self.mouse-y
                                            - dock-area.absolute-position.y,
                                    120px, 360px);
                            }
                        }
                    }
                }
            }

            // Everything except the welcome strip/sidebar — the resource panel,
            // splitter and the central tab/pane content — sits to the right of them.
            rest := Rectangle {
            // Geometry is owned by the Rust dock engine (#dock-stack): the
            // central rect left over after every edge stack is carved off.
            x: root.dock-central-x;
            y: root.dock-central-y;
            width: root.dock-central-w;
            height: root.dock-central-h;
            // A shared ToolStrip is already reserved outside `rest` while the
            // welcome panel is expanded, or by the merged welcome strip while both
            // panels are collapsed. Do not reserve the same 36px a second time.
            property <length> sb-w: root.hide-panels ? 0px
                : root.sidebar-collapsed ? 36px : 0px;
            property <length> sb-h: root.hide-panels ? 0px
                : root.sidebar-collapsed ? 36px : 0px;
            property <length> sp: 0px;
            // The collapsed bar (sb-h) already reserves the bottom strip now.
            property <length> bottom-strip-h: 0px;

            // Left sidebar — collapsible and drag-resizable, dockable to any edge.
            // Only shown while expanded; collapsing swaps it for the ToolStrip icon
            // bar below (mirrors the welcome sidebar), so no clipped widgets bleed
            // through the 36px strip (#resource-collapse).
            if false : Rectangle {
                x: root.sidebar-dock == "right" ? parent.width - parent.sb-w
                 : 0px;
                y: root.sidebar-dock == "bottom" ? parent.height - parent.sb-h
                 : 0px;
                width: root.sidebar-horizontal ? parent.sb-w : parent.width;
                height: root.sidebar-horizontal ? parent.height : parent.sb-h;
                clip: true;
                Sidebar {
                width: parent.width;
                height: parent.height;
                // Docked top/bottom → lay the resource widgets out in a row.
                lay-horizontal: !root.sidebar-horizontal;
                dock-edge: root.sidebar-dock;
                animate width, height { duration: root.sidebar-dragging ? 0ms : 150ms; easing: ease-out; }
                connection-state: root.connection-state;
                status-heading: root.status-heading;
                is-local-mode: root.is-local-mode;
                metrics-available: root.metrics-available;
                lang-en: root.lang-en;
                conn-host: root.conn-host;
                conn-state: root.conn-state;
                resource-title: root.resource-title;
                cpu-percent: root.cpu-percent;
                mem-percent: root.mem-percent;
                swap-percent: root.swap-percent;
                mem-detail: root.mem-detail;
                swap-detail: root.swap-detail;
                net-top-up: root.net-top-up;
                net-top-down: root.net-top-down;
                net-top-history: root.net-top-history;
                net-bot-up: root.net-bot-up;
                net-bot-down: root.net-bot-down;
                net-bot-history: root.net-bot-history;
                net-ifaces: root.net-ifaces;
                net-selected: root.net-selected;
                net-show-selector: root.net-show-selector;
                disks: root.disks;
                system-info-available: root.system-info-available;
                proc-available: root.proc-available;
                app-version: root.app-version;
                select-net-iface(i) => { root.select-net-iface(i); }
                show-system-info() => { root.open-system-info(); }
                show-processes() => { root.open-processes(); }
                copy-host(h) => { root.copy-text(h); }   // reuse the clipboard helper (#192)
                // Drag the sidebar header to dock it to another edge. Coordinates
                // arrive in window space; convert to dock-area-relative fractions.
                dock-drag-move(ax, ay) => {
                    root.panel-dragging = true;
                    root.drag-nx = (ax - dock-area.absolute-position.x) / dock-area.width;
                    root.drag-ny = (ay - dock-area.absolute-position.y) / dock-area.height;
                }
                dock-drag-end() => {
                    if (root.dock-target != "") {
                        root.sidebar-dock = root.dock-target;
                        if (root.welcome-as-sidebar && root.welcome-sidebar-dock == root.dock-target) {
                            root.welcome-collapsed = true;
                            root.set-welcome-collapsed(true);
                        }
                        if (root.quick-panel-open && root.quick-panel-dock == root.dock-target) {
                            root.quick-panel-collapsed = true;
                        }
                        root.persist-sidebar-dock(root.sidebar-dock);
                    }
                    root.panel-dragging = false;
                }
                toggle-collapse() => {
                    root.sidebar-collapsed = !root.sidebar-collapsed;
                    root.set-sidebar-collapsed(root.sidebar-collapsed);
                }
                }
            }

            // Splitter — drag to resize the sidebar. Orientation + which dimension it
            // adjusts follow the dock edge. Hidden while collapsed.
            Rectangle {
                visible: false;
                // Horizontal docks → a vertical 4px bar at the sidebar's inner edge;
                // vertical docks → a horizontal 4px bar.
                x: root.sidebar-dock == "left"   ? parent.sb-w
                 : root.sidebar-dock == "right"  ? parent.width - parent.sb-w - 4px
                 : 0px;
                y: root.sidebar-dock == "top"    ? parent.sb-h
                 : root.sidebar-dock == "bottom" ? parent.height - parent.sb-h - 4px
                 : 0px;
                width:  root.sidebar-horizontal ? 4px : parent.width;
                height: root.sidebar-horizontal ? parent.height : 4px;
                background: sb-split-ta.has-hover || root.sidebar-dragging
                    ? Theme.accent
                    : Theme.border-subtle;
                sb-split-ta := TouchArea {
                    mouse-cursor: root.sidebar-horizontal ? ew-resize : ns-resize;
                    pointer-event(ev) => {
                        if (ev.kind == PointerEventKind.down) {
                            root.sidebar-dragging = true;
                        } else if (ev.kind == PointerEventKind.up) {
                            root.sidebar-dragging = false;
                            root.persist-sidebar-width(root.sidebar-width / 1px);
                        }
                    }
                    moved => {
                        if (root.sidebar-dragging) {
                            if (root.sidebar-horizontal) {
                                // Track the cursor in stable dock-area coordinates.
                                // The splitter moves while resizing, so adding local
                                // mouse deltas to the current width feeds the movement
                                // back into itself and can suddenly widen the panel
                                // on Win10 (#244).
                                root.sidebar-width = clamp(
                                    root.sidebar-dock == "right"
                                        ? dock-area.absolute-position.x + dock-area.width
                                            - (self.absolute-position.x + self.mouse-x)
                                        : (self.absolute-position.x + self.mouse-x)
                                            - dock-area.absolute-position.x,
                                    160px, 520px);
                            } else {
                                root.sidebar-height = clamp(
                                    root.sidebar-dock == "bottom"
                                        ? dock-area.absolute-position.y + dock-area.height
                                            - (self.absolute-position.y + self.mouse-y)
                                        : (self.absolute-position.y + self.mouse-y)
                                            - dock-area.absolute-position.y,
                                    120px, 480px);
                            }
                        }
                    }
                }
            }

            // Right side: tabs + content — positioned in the rect left after the
            // sidebar is carved off its docked edge. Clipped so the terminal / SFTP
            // panel can never bleed (visually or for clicks) onto a panel docked on
            // the bottom or right (#dock).
            quick-area := Rectangle {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                clip: true;
                property <bool> quick-horizontal:
                    root.quick-panel-dock == "left" || root.quick-panel-dock == "right";
                property <length> quick-w: 0px;
                property <length> quick-h: 0px;
                property <length> quick-sp: 0px;

                central := Rectangle {
                x: root.quick-panel-open && !root.quick-panel-collapsed && root.quick-panel-dock == "left"
                    ? parent.quick-w + parent.quick-sp : 0px;
                y: root.quick-panel-open && !root.quick-panel-collapsed && root.quick-panel-dock == "top"
                    ? parent.quick-h + parent.quick-sp : 0px;
                width: root.quick-panel-open && !root.quick-panel-collapsed && parent.quick-horizontal
                    ? parent.width - parent.quick-w - parent.quick-sp : parent.width;
                height: root.quick-panel-open && !root.quick-panel-collapsed && !parent.quick-horizontal
                    ? parent.height - parent.quick-h - parent.quick-sp : parent.height;
                clip: true;
                // Split-pane area (v0.5): panes tile this rect; each pane has its own
                // tab strip + active terminal / welcome. Rust flattens the split tree
                // into `panes` for the size we report here.
                pane-area := Rectangle {
                    width: parent.width;
                    height: parent.height;
                    changed width => { root.content-resized(self.width, self.height); }
                    changed height => { root.content-resized(self.width, self.height); }
                for pane[pi] in root.panes : Rectangle {
                    x: pane.x; y: pane.y; width: pane.w; height: pane.h;
                    clip: true;
                    VerticalLayout {
                    spacing: 0;

                    // Terminal fullscreen hides every tab strip (#495); Ctrl+Tab
                    // still cycles tabs.
                    if !root.term-fullscreen : HorizontalLayout {
                    spacing: 0;
                    // (Collapsed resource panel now reserves its own ToolStrip slot in
                    // `rest`, so the tab strip no longer needs a spacer for it.)
                    TabBar {
                        horizontal-stretch: 1;
                        // Reserve room for the top-right toolbar icons that sit over
                        // this row so tabs don't slide underneath them (#122).
                        reserve-right: pane.reserve-right;
                        show-new-tab: !root.welcome-as-sidebar;
                        launch-shells: root.launch-shells;
                        launch-agents: root.agents;
                        can-merge-pane: root.panes.length > 1;
                        tabs: pane.tabs;
                        active-id: pane.active-id;
                        ext-drag-over: root.tab-drag-live
                            && root.tab-drag-px >= pane.x
                            && root.tab-drag-px <= pane.x + pane.w
                            && root.tab-drag-py >= pane.y
                            // The strip row is the TabBar's own 36px.
                            && root.tab-drag-py <= pane.y + 36px;
                        ext-drag-x: root.tab-drag-px - pane.x;
                        tab-selected(id) => { root.pane-tab-selected(pane.id, id); }
                        tab-closed(id) => { root.pane-tab-closed(pane.id, id); }
                        new-tab() => { root.pane-new-tab(pane.id); }
                        launch(id) => {
                            // Open it in this pane: connect-session adds the tab
                            // to the focused pane.
                            root.pane-focus(pane.id);
                            root.connect-session(id);
                        }
                        customize-agents => {
                            root.interface-start-page = "agents";
                            root.settings-open = false;
                            root.interface-open = true;
                        }
                        tab-move(from-index, to-index) => {
                            root.tab-drag-live = false;
                            root.pane-tab-move(pane.id, from-index, to-index);
                        }
                        drop-index-changed(index) => {
                            root.pane-tab-drop-index(pane.id, index);
                        }
                        tab-split(id, dir) => { root.pane-split(pane.id, id, dir); }
                        merge-pane() => { root.pane-merge(pane.id); }
                        tab-duplicate(id) => { root.tab-duplicate(id); }
                        tab-rename-request(id) => { root.tab-rename-request(id); }
                        tab-save-session(id) => { root.tab-save-session(id); }
                        tab-log-active(id) => { return root.tab-log-active(id); }
                        tab-log-toggle(id) => { root.tab-log-toggle(id); }
                        tab-drag-move(id, ax, ay, own-strip) => {
                            root.tab-drag-px = ax - pane-area.absolute-position.x;
                            root.tab-drag-py = ay - pane-area.absolute-position.y;
                            root.tab-drag-live = true;
                            root.tab-drag-move(id, root.tab-drag-px, root.tab-drag-py, own-strip);
                        }
                        tab-drag-drop(id, ax, ay) => {
                            root.tab-drag-live = false;
                            root.tab-drag-drop(id,
                                ax - pane-area.absolute-position.x,
                                ay - pane-area.absolute-position.y);
                        }
                        tab-drag-cancel() => {
                            root.tab-drag-live = false;
                            root.tab-drag-cancel();
                        }
                    }
                }

                // Content area swaps based on active tab kind.
                Rectangle {
                    vertical-stretch: 1;
                    background: Theme.bg-root;

                    // Lightweight central startup view when no session tab is open in this pane.
                    if pane.tabs.length == 0 : StartupEmptyPane {
                        width: parent.width;
                        height: parent.height;
                        hide-panels: root.hide-panels;
                        home-monitor-open <=> root.home-monitor-open;
                        lang-en: root.lang-en;
                        launch-shells: root.launch-shells;
                        ssh-import-hint: root.ssh-import-hint;
                        recent-sessions: root.recent-sessions;
                        new-session-clicked => { root.new-session-clicked(); }
                        connect-session(id) => { root.connect-session(id); }
                        import-ssh-config => { root.import-ssh-config(); }
                    }

                    // Welcome tab — fill the content area explicitly (some renderers
                    // don't auto-fill, which spread the header/card apart) (#dock).
                    if pane.active-id == "welcome" : Welcome {
                        width: parent.width;
                        height: parent.height;
                        sessions: root.sessions;
                        import-hint: root.ssh-import-hint;
                        search-query <=> root.host-search-query;
                        sessions-revision: root.sessions-revision;
                        search-changed(query) => { root.host-search-changed(query); }
                        new-session => { root.new-session-clicked(); }
                        import-ssh-config => { root.import-ssh-config(); }
                        connect-session(id) => { root.connect-session(id); }
                        edit-session(id) => { root.edit-session(id); }
                        duplicate-session(id) => { root.duplicate-session(id); }
                        move-session(id, group) => { root.move-session(id, group); }
                        reorder-session(id, dir) => { return root.reorder-session(id, dir); }
                        reorder-end => { root.reorder-session-end(); }
                        toggle-group(group) => { root.toggle-group(group); }
                        create-group-inline(name) => { root.submit-group("", name); }
                        new-group => {
                            root.group-dialog-orig = "";
                            root.group-dialog-name = "";
                            root.group-dialog-error = "";
                            root.group-dialog-open = true;
                        }
                        edit-group(name) => {
                            root.group-dialog-orig = name;
                            root.group-dialog-name = name;
                            root.group-dialog-error = "";
                            root.group-dialog-open = true;
                        }
                        delete-group(name) => { root.delete-group(name); }
                        remove-session(id) => { root.remove-session(id); }
                        cycle-tab(reverse) => { root.cycle-tab(reverse); }
                        match-shortcut(t, c, m, a, s, alt-screen) => {
                            return root.match-shortcut(t, c, m, a, s, alt-screen);
                        }
                    }

                    // Terminal tabs — one TerminalView per terminal state. Only
                    // the one matching `active-tab-id` is visible. Slint doesn't
                    // allow nesting `if` directly inside a `for`, so we toggle
                    // visibility instead and rely on the layout to overlap them.
                    for term[i] in root.terminals : TerminalView {
                        visible: term.id == pane.active-id;
                        active: term.id == root.active-tab-id;
                        // Fullscreen also hides the status strip (#495).
                        zen-mode: root.hide-panels;
                        width: term.id == pane.active-id ? parent.width : 0px;
                        height: term.id == pane.active-id ? parent.height : 0px;
                        tab-id: term.id;
                        status-line: term.status;
                        conn-host: term.id == root.active-tab-id ? root.conn-host : "";
                        conn-state: term.id == root.active-tab-id ? root.conn-state : 1;
                        is-local-mode: term.id == root.active-tab-id ? root.is-local-mode : false;
                        metrics-available: term.id == root.active-tab-id ? root.metrics-available : false;
                        lang-en: root.lang-en;
                        cpu-percent: term.id == root.active-tab-id ? root.cpu-percent : 0.0;
                        mem-percent: term.id == root.active-tab-id ? root.mem-percent : 0.0;
                        net-up: term.id == root.active-tab-id ? root.net-top-up : "";
                        net-down: term.id == root.active-tab-id ? root.net-top-down : "";
                        monitor-active: !root.effective-sidebar-collapsed;
                        proc-available: term.id == root.active-tab-id && root.proc-available;
                        system-info-available: term.id == root.active-tab-id && root.system-info-available;
                        toggle-monitor => {
                            if (!root.sidebar-collapsed) {
                                root.sidebar-collapsed = true;
                                root.set-sidebar-collapsed(true);
                            } else {
                                root.sidebar-collapsed = false;
                                root.set-sidebar-collapsed(false);
                                if (root.sidebar-dock == "left") {
                                    if (root.welcome-as-sidebar && root.welcome-sidebar-dock == "left" && !root.welcome-collapsed) {
                                        root.welcome-collapsed = true;
                                        root.set-welcome-collapsed(true);
                                    }
                                    if (root.quick-panel-open && root.quick-panel-dock == "left" && !root.quick-panel-collapsed) {
                                        root.quick-panel-collapsed = true;
                                    }
                                }
                            }
                            root.dock-layout-changed();
                        }
                        show-processes => { root.open-processes(); }
                        show-system-info => { root.open-system-info(); }
                        spans: term.spans;
                        cursor-row: term.cursor-row;
                        cursor-col: term.cursor-col;
                        cursor-style: root.term-cursor-style;
                        cursor-color: Theme.term-cursor;
                        terminal-line-spacing: root.terminal-line-spacing;
                        extra-paste-shortcuts-enabled: root.extra-paste-shortcuts-enabled;
                        rows-used: term.rows-used;
                        scroll-max: term.scroll-max;
                        scroll-offset: term.scroll-offset;
                        is-alt-screen: term.is-alt-screen;
                        mouse-tracked: term.mouse-tracked;
                        find-matches: term.find-matches;
                        find-current: term.find-current;
                        selection: term.selection;
                        sftp-panel-height: term.sftp-panel-height;
                        set-sftp-panel-height(v) => { root.set-pane-sftp-height(term.id, v); }
                        sftp-panel-width: term.sftp-panel-width;
                        set-sftp-panel-width(v) => { root.set-pane-sftp-width(term.id, v); }
                        sftp-dock <=> root.sftp-dock;
                        sftp-collapsed: term.sftp-collapsed;
                        set-sftp-collapsed(v) => { root.set-pane-sftp-collapsed(term.id, v); }
                        sftp-saved-height: term.sftp-saved-height;
                        set-sftp-saved-height(v) => { root.set-pane-sftp-saved-height(term.id, v); }
                        sftp-tree-width: root.sftp-tree-width;
                        persist-sftp-tree-width(v) => { root.persist-sftp-tree-width(v); }
                        sftp-show-type: root.sftp-show-type;
                        sftp-show-size: root.sftp-show-size;
                        sftp-show-modified: root.sftp-show-modified;
                        sftp-show-permissions: root.sftp-show-permissions;
                        sftp-show-owner: root.sftp-show-owner;
                        sftp-show-group: root.sftp-show-group;
                        toggle-sftp-column(key) => { root.toggle-sftp-column(key); }
                        sftp-path: term.sftp-path;
                        sftp-entries: term.sftp-entries;
                        sftp-status: term.sftp-status;
                        sftp-loading: term.sftp-loading;
                        sftp-tree-nodes: term.sftp-tree-nodes;
                        sftp-transfer-targets: root.tabs;
                        sftp-selected-count: term.sftp-selected-count;
                        sftp-sort-key: term.sftp-sort-key;
                        sftp-sort-dir: term.sftp-sort-dir;
                        sftp-available: term.sftp-available;
                        sftp-dual: term.sftp-dual;
                        sftp-local-path: term.sftp-local-path;
                        sftp-local-entries: term.sftp-local-entries;
                        sftp-local-status: term.sftp-local-status;
                        sftp-local-loading: term.sftp-local-loading;
                        sftp-local-selected-count: term.sftp-local-selected-count;
                        sftp-local-pane-width: term.sftp-local-pane-width;
                        sftp-local-quick-places: term.sftp-local-quick-places;
                        sftp-local-drive-places: term.sftp-local-drive-places;
                        sftp-local-bookmarks: term.sftp-local-bookmarks;
                        sftp-local-recent: term.sftp-local-recent;
                        sftp-local-bookmarked: term.sftp-local-bookmarked;
                        sftp-local-show-hidden: term.sftp-local-show-hidden;
                        sftp-local-sort-key: term.sftp-local-sort-key;
                        sftp-local-sort-dir: term.sftp-local-sort-dir;
                        sftp-local-filter: term.sftp-local-filter;
                        sftp-local-split: root.sftp-local-split;
                        persist-sftp-local-pane-width(v) => {
                            root.persist-sftp-local-pane-width(term.id, v);
                        }
                        sftp-local-toggle-bookmark() => {
                            root.sftp-local-toggle-bookmark(term.id);
                        }
                        sftp-local-remove-bookmark(path) => {
                            root.sftp-local-remove-bookmark(term.id, path);
                        }
                        sftp-local-clear-recent() => {
                            root.sftp-local-clear-recent(term.id);
                        }
                        sftp-local-toggle-hidden() => {
                            root.sftp-local-toggle-hidden(term.id);
                        }
                        sftp-local-sort(column) => {
                            root.sftp-local-sort(term.id, column);
                        }
                        sftp-local-set-filter(text) => {
                            root.sftp-local-set-filter(term.id, text);
                        }
                        sftp-local-remove-recent(path) => {
                            root.sftp-local-remove-recent(term.id, path);
                        }
                        sftp-local-move-bookmark(path, delta) => {
                            root.sftp-local-move-bookmark(term.id, path, delta);
                        }
                        sftp-local-reveal() => {
                            root.sftp-local-reveal(term.id);
                        }
                        persist-sftp-split(v) => { root.persist-sftp-split(v); }
                        persist-sftp-local-split(v) => { root.persist-sftp-local-split(v); }
                        sftp-local-places-refresh() => { root.sftp-local-places-refresh(term.id); }
                        tunnels: term.tunnels;
                        quick-commands: root.quick-commands;
                        quick-sidebar-enabled: root.quick-commands-as-sidebar;
                        quick-panel-docked: root.quick-panel-open && !root.quick-panel-collapsed;
                        cmd-bar-hidden: root.cmd-bar-hidden;
                        quick-external-command: root.quick-external-command;
                        quick-external-send-enter: root.quick-external-send-enter;
                        quick-external-sequence: root.quick-external-sequence;
                        focus-sequence: root.terminal-focus-sequence;
                        command-history: root.command-history;
                        history-view: root.history-view;
                        history-preview: root.history-preview;
                        run-command(cmd, all) => { root.run-command(term.id, cmd, all); }
                        copy-text(t) => { root.copy-text(t); }
                        delete-history(i) => { root.delete-history(i); }
                        delete-history-cmd(c) => { root.delete-history-cmd(c); }
                        search-history(q) => { root.search-history(q); }
                        manage-quick-commands() => {
                            root.qcm-name = "";
                            root.qcm-command = "";
                            root.qcm-group = "";
                            root.qcm-edit-index = -1;
                            root.quick-cmd-manage-open = true;
                        }
                        quick-dock-drag-move(ax, ay) => {
                            root.panel-dragging = true;
                            root.drag-nx = (ax - dock-area.absolute-position.x) / dock-area.width;
                            root.drag-ny = (ay - dock-area.absolute-position.y) / dock-area.height;
                        }
                        quick-dock-drag-end() => {
                            if (root.dock-target != "") {
                                root.quick-panel-dock = root.dock-target;
                                root.quick-panel-open = true;
                                root.quick-panel-collapsed = false;
                                root.dock-layout-changed();
                            }
                            root.panel-dragging = false;
                        }
                        toggle-quick-group(g) => { root.toggle-quick-group(g); }
                        edit-quick-command(i) => { root.edit-quick-command(i); }
                        duplicate-quick-command(i) => { root.duplicate-quick-command(i); }
                        delete-quick-command(i) => { root.delete-quick-command(i); }
                        move-quick-command(i, g) => { root.move-quick-command(i, g); }
                        new-quick-group() => { root.qcg-orig = ""; root.qcg-name = ""; root.qcg-open = true; }
                        rename-quick-group(g) => { root.qcg-orig = g; root.qcg-name = g; root.qcg-open = true; }
                        delete-quick-group(g) => { root.delete-quick-group(g); }
                        send-key(key, ctrl, alt, shift) => { root.send-key(term.id, key, ctrl, alt, shift) }
                        terminal-scrollback-key(key) => { root.terminal-scrollback-key(term.id, key) }
                        diagnose-key-event(key, control, meta, alt, shift) => {
                            root.diagnose-key-event(term.id, key, control, meta, alt, shift);
                        }
                        cycle-tab(reverse) => { root.cycle-tab(reverse); }
                        match-shortcut(t, c, m, a, s, alt-screen) => {
                            return root.match-shortcut(t, c, m, a, s, alt-screen);
                        }
                        new-window-key() => { root.new-window-clicked(); }
                        zoom-key(direction, window-wide) => { root.zoom-term-font(term.id, direction, window-wide); }
                        zen-key() => { root.toggle-zen-key(); }
                        fullscreen-key() => { root.toggle-term-fullscreen(); }
                        term-font-size-px: term.font-size > 0 ? term.font-size * 1.0 : root.term-font-size / 1px;
                        terminal-resize(w, h) => { root.terminal-resize(term.id, w, h) }
                        sftp-navigate(path) => { root.sftp-navigate(term.id, path); }
                        sftp-download(path) => { root.sftp-download(term.id, path); }
                        sftp-open-file(path) => { root.sftp-open-file(term.id, path); }
                        sftp-upload-clicked(dir, folder) => { root.sftp-upload-clicked(term.id, dir, folder); }
                        sftp-paste-upload(dir) => { root.sftp-paste-upload(term.id, dir); }
                        sftp-refresh(path) => { root.sftp-refresh(term.id, path); }
                        sftp-tree-expand(path) => { root.sftp-tree-expand(term.id, path); }
                        sftp-toggle-select(i) => { root.sftp-toggle-select(term.id, i); }
                        sftp-select-range(a, b) => { root.sftp-select-range(term.id, a, b); }
                        sftp-bookmarks: term.sftp-bookmarks;
                        sftp-recent: term.sftp-recent;
                        sftp-bookmarked: term.sftp-bookmarked;
                        sftp-toggle-bookmark(path) => { root.sftp-toggle-bookmark(term.id, path); }
                        sftp-remove-bookmark(path) => { root.sftp-remove-bookmark(term.id, path); }
                        sftp-clear-recent() => { root.sftp-clear-recent(term.id); }
                        sftp-places-refresh() => { root.sftp-places-refresh(term.id); }
                        sftp-drag-out(row) => { root.sftp-drag-out(term.id, row); }
                        sftp-download-selected() => { root.sftp-download-selected(term.id); }
                        sftp-copy-to-target(path, target) => { root.sftp-copy-to-target(term.id, path, target); }
                        sftp-copy-selected-to-target(target) => { root.sftp-copy-selected-to-target(term.id, target); }
                        // Confirm before deleting the checked entries (#100), reusing
                        // the delete-confirm dialog in batch mode.
                        sftp-delete-selected() => {
                            root.confirm-delete-tab = term.id;
                            root.confirm-delete-batch = true;
                            root.confirm-delete-path = root.lang-en ? "the selected items" : "选中的项目";
                            root.confirm-delete-open = true;
                        }
                        // Gate delete behind an in-app confirmation (#28): stash the
                        // target and open the modal; the real delete fires on confirm.
                        sftp-delete(path) => {
                            root.confirm-delete-tab = term.id;
                            root.confirm-delete-path = path;
                            root.confirm-delete-open = true;
                        }
                        sftp-view(path) => { root.sftp-view(term.id, path); }
                        sftp-edit(path) => { root.sftp-edit(term.id, path); }
                        sftp-open-external(path) => { root.sftp-open-external(term.id, path); }
                        sftp-edit-external(path) => { root.sftp-edit-external(term.id, path); }
                        sftp-sort-request(key) => { root.sftp-sort-request(term.id, key); }
                        sftp-clear-sort() => { root.sftp-clear-sort(term.id); }
                        tunnel-add(name, kind, bind, bind-port, host, host-port, save, auto-start) => {
                            root.tunnel-add(term.id, name, kind, bind, bind-port, host, host-port, save, auto-start);
                        }
                        tunnel-stop(id) => { root.tunnel-stop(term.id, id); }
                        tunnel-start(id) => { root.tunnel-start(term.id, id); }
                        tunnel-delete(id) => { root.tunnel-delete(term.id, id); }
                        // #69 context-menu extensions → shared prompt dialog.
                        sftp-rename-request(path, name) => {
                            root.sftp-prompt-kind = "rename";
                            root.sftp-prompt-tab = term.id;
                            root.sftp-prompt-target = path;
                            root.sftp-prompt-value = name;
                            root.sftp-prompt-open = true;
                        }
                        sftp-chmod-request(path, name, mode) => {
                            root.sftp-chmod-open(term.id, path, name, mode);
                        }
                        sftp-copy-path(path) => { root.sftp-copy-path(path); }
                        sftp-toggle-dual() => { root.sftp-toggle-dual(term.id); }
                        sftp-local-navigate(path) => { root.sftp-local-navigate(term.id, path); }
                        sftp-local-up() => { root.sftp-local-up(term.id); }
                        sftp-local-home() => { root.sftp-local-home(term.id); }
                        sftp-local-refresh() => { root.sftp-local-refresh(term.id); }
                        sftp-local-open(path) => { root.sftp-local-open(term.id, path); }
                        sftp-local-toggle-select(i) => { root.sftp-local-toggle-select(term.id, i); }
                        sftp-local-select-range(a, b) => { root.sftp-local-select-range(term.id, a, b); }
                        sftp-local-copy-path(path) => { root.sftp-local-copy-path(path); }
                        sftp-local-upload(path) => { root.sftp-local-upload(term.id, path); }
                        sftp-local-upload-selected() => { root.sftp-local-upload-selected(term.id); }
                        sftp-download-to-local(path) => { root.sftp-download-to-local(term.id, path); }
                        sftp-download-selected-to-local() => { root.sftp-download-selected-to-local(term.id); }
                        sftp-local-sort-request(k, d) => { root.sftp-local-sort-request(term.id, k, d); }
                        sftp-entry-matches(n, t, q) => { return root.sftp-entry-matches(n, t, q); }
                        transfers: root.transfers;
                        has-active-transfers: root.has-active-transfers;
                        download-dir: root.download-dir;
                        cancel-transfer(id) => { root.cancel-transfer(id); }
                        clear-transfers() => { root.clear-transfers(); }
                        pick-download-dir() => { root.pick-download-dir(); }
                        open-download-dir() => { root.open-download-dir(); }
                        sftp-new-folder(dir) => {
                            root.sftp-prompt-kind = "mkdir";
                            root.sftp-prompt-tab = term.id;
                            root.sftp-prompt-target = dir;
                            root.sftp-prompt-value = "";
                            root.sftp-prompt-open = true;
                        }
                        sftp-new-file(dir) => {
                            root.sftp-prompt-kind = "touch";
                            root.sftp-prompt-tab = term.id;
                            root.sftp-prompt-target = dir;
                            root.sftp-prompt-value = "";
                            root.sftp-prompt-open = true;
                        }
                        sftp-create-entry-inline(kind, dir, name) => {
                            root.sftp-prompt-submit(term.id, kind, dir, name);
                        }
                        paste-from-clipboard() => { root.paste-from-clipboard(term.id); }
                        copy-terminal-text() => { root.copy-terminal-text(term.id); }
                        clear-terminal() => { root.clear-terminal(term.id); }
                        find-query-changed(q) => { root.find-query-changed(term.id, q); }
                        output-hover(h) => { root.terminal-output-hover(term.id, h); }
                        find-step(q, d) => { return root.find-step(term.id, q, d); }
                        terminal-scroll(d) => { root.terminal-scroll(term.id, d); }
                        terminal-wheel(d, c, r) => { root.terminal-wheel(term.id, d, c, r); }
                        terminal-scroll-to(o) => { root.terminal-scroll-to(term.id, o); }
                        terminal-mouse(kind, btn, r, c) => { root.terminal-mouse(term.id, kind, btn, r, c); }
                        select-start(r, c, ctrl, shift) => { root.term-select-start(term.id, r, c, ctrl, shift); }
                        select-update(r, c) => { root.term-select-update(term.id, r, c); }
                        select-end() => { root.term-select-end(term.id); }
                        select-clear() => { root.term-select-clear(term.id); }
                        select-word(r, c) => { root.term-select-word(term.id, r, c); }
                        select-autoscroll(dir) => { root.term-select-autoscroll(term.id, dir); }
                    }

                    // Editor tabs (#494): same show-by-active-id scheme as the
                    // terminals above. Only the editor is shown — no SFTP panel
                    // or command bar; drag the tab to split it beside a terminal.
                    for doc in root.editor-docs : EditorPane {
                        visible: doc.id == pane.active-id;
                        width: doc.id == pane.active-id ? parent.width : 0px;
                        height: doc.id == pane.active-id ? parent.height : 0px;
                        doc-mode: true;
                        shown: doc.id == pane.active-id;
                        active: self.shown;
                        show-header: true;
                        show-close: false;
                        esc-closes: false;
                        doc-content: doc.content;
                        doc-revision: doc.revision;
                        can-save: !doc.orphaned;
                        status-note: doc.orphaned ? @tr("Connection closed") : "";
                        editor-name: doc.name;
                        editor-readonly: doc.readonly;
                        editor-dirty: doc.dirty;
                        editor-language: doc.language;
                        editor-syntax-source: doc.syntax-source;
                        editor-syntax-spans: doc.syntax-spans;
                        content-changed => { root.editor-doc-edited(doc.id, self.editor-content); }
                        save-file => { root.editor-doc-save(doc.id); }
                        editor-highlight(text) => { root.editor-doc-highlight(doc.id, text); }
                        editor-count-matches(content, query) => { return root.editor-count-matches(content, query); }
                        editor-find-step(content, query, current, reverse) => {
                            return root.editor-find-step(content, query, current, reverse);
                        }
                        editor-replace-all(query, replacement) => {
                            root.editor-doc-replace-all(doc.id, query, replacement);
                        }
                    }

                    // Windows may show the terminal model being reconstructed when
                    // restoring from minimize (#183). Briefly cover the terminal area
                    // until the restore repaint settles; the underlying PTY/buffer is
                    // untouched.
                    if root.terminal-restore-cover && pane.active-id != "welcome" && pane.tabs.length > 0 : Rectangle {
                        width: parent.width;
                        height: parent.height;
                        background: Theme.term-bg;
                    }
                }
                }
                }

                // Draggable splitters between panes. Single pane => the model is
                // empty, so this renders nothing. The handle is a thin 6px bar but its
                // TouchArea reaches ±5px beyond so it's easy to grab.
                for sp[si] in root.splitters : Rectangle {
                    x: sp.x; y: sp.y; width: sp.w; height: sp.h;
                    // A tab dropped on a pane boundary leaves the pointer hovering
                    // over this splitter. Highlight only while the splitter itself
                    // is being dragged, otherwise that hover looks like a stuck
                    // full-height tab insertion caret.
                    background: sp-ta.pressed ? Theme.accent : Theme.border-strong;
                    animate background { duration: 100ms; }
                    sp-ta := TouchArea {
                        x: sp.vertical ? -5px : 0px;
                        y: sp.vertical ? 0px : -5px;
                        width: sp.vertical ? parent.width + 10px : parent.width;
                        height: sp.vertical ? parent.height : parent.height + 10px;
                        mouse-cursor: sp.vertical ? ew-resize : ns-resize;
                        moved => {
                            if (self.pressed) {
                                root.splitter-drag(sp.split-id,
                                    sp.vertical ? sp.x - 5px + self.mouse-x
                                                : sp.y - 5px + self.mouse-y,
                                    sp.vertical);
                            }
                        }
                    }
                }

                // Drag-to-split drop-zone highlight (v0.5). Purely visual (no
                // TouchArea) so it never eats the drag; Rust sets the rect.
                if root.drag-active : Rectangle {
                    x: root.drag-hl-x;
                    y: root.drag-hl-y;
                    width: root.drag-hl-w;
                    height: root.drag-hl-h;
                    background: Theme.accent.with-alpha(0.22);
                    border-width: 2px;
                    border-color: Theme.accent;
                    border-radius: Theme.radius-sm;
                }
                }
            }

            if false : QuickDockPanel {
                x: root.quick-panel-dock == "right" ? parent.width - parent.quick-w : 0px;
                y: root.quick-panel-dock == "bottom" ? parent.height - parent.quick-h : 0px;
                width: parent.quick-horizontal ? parent.quick-w : parent.width;
                height: parent.quick-horizontal ? parent.height : parent.quick-h;
                commands: root.quick-commands;
                dock-edge: root.quick-panel-dock;
                activate(command, send-enter) => {
                    root.quick-external-command = command;
                    root.quick-external-send-enter = send-enter;
                    root.quick-external-sequence += 1;
                }
                toggle-group(group) => { root.toggle-quick-group(group); }
                manage => {
                    root.qcm-name = "";
                    root.qcm-command = "";
                    root.qcm-group = "";
                    root.qcm-edit-index = -1;
                    root.quick-cmd-manage-open = true;
                }
                close => { root.quick-panel-collapsed = true; }
                dock-drag-move(ax, ay) => {
                    root.panel-dragging = true;
                    root.drag-nx = (ax - dock-area.absolute-position.x) / dock-area.width;
                    root.drag-ny = (ay - dock-area.absolute-position.y) / dock-area.height;
                }
                dock-drag-end => {
                    if (root.dock-target != "") {
                        root.quick-panel-dock = root.dock-target;
                        if (root.sidebar-dock == root.dock-target) {
                            root.sidebar-collapsed = true;
                            root.set-sidebar-collapsed(true);
                        }
                        if (root.welcome-as-sidebar
                                && root.welcome-sidebar-dock == root.dock-target) {
                            root.welcome-collapsed = true;
                            root.set-welcome-collapsed(true);
                        }
                    }
                    root.panel-dragging = false;
                }
            }

            Rectangle {
                visible: false;
                x: root.quick-panel-dock == "left" ? parent.quick-w
                 : root.quick-panel-dock == "right" ? parent.width - parent.quick-w - 4px
                 : 0px;
                y: root.quick-panel-dock == "top" ? parent.quick-h
                 : root.quick-panel-dock == "bottom" ? parent.height - parent.quick-h - 4px
                 : 0px;
                width: parent.quick-horizontal ? 4px : parent.width;
                height: parent.quick-horizontal ? parent.height : 4px;
                background: quick-split-ta.has-hover ? Theme.accent : Theme.border-subtle;
                quick-split-ta := TouchArea {
                    x: quick-area.quick-horizontal ? -4px : 0px;
                    y: quick-area.quick-horizontal ? 0px : -4px;
                    width: quick-area.quick-horizontal ? 12px : parent.width;
                    height: quick-area.quick-horizontal ? parent.height : 12px;
                    mouse-cursor: quick-area.quick-horizontal ? ew-resize : ns-resize;
                    moved => {
                        if (self.pressed) {
                            if (quick-area.quick-horizontal) {
                                root.quick-panel-width = clamp(
                                    root.quick-panel-dock == "right"
                                        ? quick-area.width - ((self.absolute-position.x + self.mouse-x)
                                            - quick-area.absolute-position.x)
                                        : (self.absolute-position.x + self.mouse-x)
                                            - quick-area.absolute-position.x,
                                    180px, max(200px, quick-area.width - 240px));
                            } else {
                                root.quick-panel-height = clamp(
                                    root.quick-panel-dock == "bottom"
                                        ? quick-area.height - ((self.absolute-position.y + self.mouse-y)
                                            - quick-area.absolute-position.y)
                                        : (self.absolute-position.y + self.mouse-y)
                                            - quick-area.absolute-position.y,
                                    120px, max(140px, quick-area.height - 160px));
                            }
                        }
                    }
                }
            }


                        }
            }

            // Stacked docked panels (#dock-stack): every expanded panel is
            // placed here at the absolute rect Rust computed, so multiple
            // panels can share one edge (split by the dividers below). `if`
            // branches select the panel component; the old per-panel geometry
            // blocks above use `if false` and are kept for reference.
            for gp[gi] in root.dock-panels : Rectangle {
                x: gp.x;
                y: gp.y;
                width: gp.w;
                height: gp.h;
                clip: true;
                background: Theme.bg-panel;

                if gp.kind == "sidebar" : Sidebar {
                    width: parent.width;
                    height: parent.height;
                    lay-horizontal: gp.edge == "top" || gp.edge == "bottom";
                    dock-edge: gp.edge;
                    connection-state: root.connection-state;
                    status-heading: root.status-heading;
                    is-local-mode: root.is-local-mode;
                    metrics-available: root.metrics-available;
                    lang-en: root.lang-en;
                    conn-host: root.conn-host;
                    conn-state: root.conn-state;
                    resource-title: root.resource-title;
                    cpu-percent: root.cpu-percent;
                    mem-percent: root.mem-percent;
                    swap-percent: root.swap-percent;
                    mem-detail: root.mem-detail;
                    swap-detail: root.swap-detail;
                    net-top-up: root.net-top-up;
                    net-top-down: root.net-top-down;
                    net-top-history: root.net-top-history;
                    net-bot-up: root.net-bot-up;
                    net-bot-down: root.net-bot-down;
                    net-bot-history: root.net-bot-history;
                    net-ifaces: root.net-ifaces;
                    net-selected: root.net-selected;
                    net-show-selector: root.net-show-selector;
                    disks: root.disks;
                    system-info-available: root.system-info-available;
                    proc-available: root.proc-available;
                    app-version: root.app-version;
                    select-net-iface(i) => { root.select-net-iface(i); }
                    show-system-info() => { root.open-system-info(); }
                    show-processes() => { root.open-processes(); }
                    copy-host(h) => { root.copy-text(h); }
                    switch-to-sessions() => {
                        root.welcome-as-sidebar = true;
                        root.set-welcome-as-sidebar(true);
                        root.welcome-sidebar-dock = "left";
                        root.persist-welcome-sidebar-dock("left");
                        root.welcome-collapsed = false;
                        root.set-welcome-collapsed(false);
                        if (!root.has-active-session) {
                            root.home-monitor-open = false;
                        } else if (root.sidebar-dock == "left") {
                            root.sidebar-collapsed = true;
                            root.set-sidebar-collapsed(true);
                        }
                        root.dock-layout-changed();
                    }
                    dock-drag-move(ax, ay) => {
                        root.panel-dragging = true;
                        root.drag-nx = (ax - dock-area.absolute-position.x) / dock-area.width;
                        root.drag-ny = (ay - dock-area.absolute-position.y) / dock-area.height;
                    }
                    dock-drag-end() => {
                        if (root.dock-target != "") {
                            root.sidebar-dock = root.dock-target;
                            root.persist-sidebar-dock(root.sidebar-dock);
                            root.dock-layout-changed();
                        }
                        root.panel-dragging = false;
                    }
                    toggle-collapse() => {
                        if (!root.has-active-session) {
                            root.home-monitor-open = false;
                        } else {
                            root.sidebar-collapsed = !root.sidebar-collapsed;
                            root.set-sidebar-collapsed(root.sidebar-collapsed);
                        }
                        root.dock-layout-changed();
                    }
                }
                if gp.kind == "welcome" : Welcome {
                    width: parent.width;
                    height: parent.height;
                    compact: true;
                    dock-edge: gp.edge;
                    sessions: root.sessions;
                    import-hint: root.ssh-import-hint;
                    search-query <=> root.host-search-query;
                    sessions-revision: root.sessions-revision;
                    search-changed(query) => { root.host-search-changed(query); }
                    collapse => {
                        root.welcome-collapsed = true;
                        root.set-welcome-collapsed(true);
                        root.dock-layout-changed();
                    }
                    dock-drag-move(ax, ay) => {
                        root.panel-dragging = true;
                        root.drag-nx = (ax - dock-area.absolute-position.x) / dock-area.width;
                        root.drag-ny = (ay - dock-area.absolute-position.y) / dock-area.height;
                    }
                    dock-drag-end() => {
                        if (root.dock-target != "") {
                            root.welcome-sidebar-dock = root.dock-target;
                            root.persist-welcome-sidebar-dock(root.welcome-sidebar-dock);
                            root.dock-layout-changed();
                        }
                        root.panel-dragging = false;
                    }
                    new-session => { root.new-session-clicked(); }
                    import-ssh-config => { root.import-ssh-config(); }
                    connect-session(id) => { root.connect-session(id); }
                    edit-session(id) => { root.edit-session(id); }
                    duplicate-session(id) => { root.duplicate-session(id); }
                    move-session(id, group) => { root.move-session(id, group); }
                    reorder-session(id, dir) => { return root.reorder-session(id, dir); }
                    reorder-end => { root.reorder-session-end(); }
                    toggle-group(group) => { root.toggle-group(group); }
                    create-group-inline(name) => { root.submit-group("", name); }
                    new-group => {
                        root.group-dialog-orig = "";
                        root.group-dialog-name = "";
                        root.group-dialog-error = "";
                        root.group-dialog-open = true;
                    }
                    edit-group(name) => {
                        root.group-dialog-orig = name;
                        root.group-dialog-name = name;
                        root.group-dialog-error = "";
                        root.group-dialog-open = true;
                    }
                    delete-group(name) => { root.delete-group(name); }
                    remove-session(id) => { root.remove-session(id); }
                }
                if gp.kind == "quick" : QuickDockPanel {
                    width: parent.width;
                    height: parent.height;
                    commands: root.quick-commands;
                    dock-edge: gp.edge;
                    lang-en: root.lang-en;
                    entry-matches(n, t, q) => { return root.sftp-entry-matches(n, t, q); }
                    activate(command, send-enter) => {
                        root.quick-external-command = command;
                        root.quick-external-send-enter = send-enter;
                        root.quick-external-sequence += 1;
                    }
                    edit(i) => { root.edit-quick-command(i); }
                    toggle-group(group) => { root.toggle-quick-group(group); }
                    manage => {
                        root.qcm-name = "";
                        root.qcm-command = "";
                        root.qcm-group = "";
                        root.qcm-edit-index = -1;
                        root.quick-cmd-manage-open = true;
                    }
                    close => { root.quick-panel-collapsed = true; root.dock-layout-changed(); }
                    dock-drag-move(ax, ay) => {
                        root.panel-dragging = true;
                        root.drag-nx = (ax - dock-area.absolute-position.x) / dock-area.width;
                        root.drag-ny = (ay - dock-area.absolute-position.y) / dock-area.height;
                    }
                    dock-drag-end => {
                        if (root.dock-target != "") {
                            root.quick-panel-dock = root.dock-target;
                            root.dock-layout-changed();
                        }
                        root.panel-dragging = false;
                    }
                }
                // Drag the panel's in-edge (central-facing) edge to resize its
                // extent along the dock normal (width on left/right, height on
                // top/bottom) — the stacked renderer's replacement for the old
                // per-panel splitter (#dock-stack). Measured against the PANEL
                // origin (gp.x/gp.y already include any collapsed-strip band),
                // so the value lands straight on the panel's width/height prop.
                if gp.edge == "left" : Rectangle {
                    // Fully inside the panel: its `clip` would otherwise eat
                    // half of the grab area and leave a 2px target.
                    x: parent.width - 4px; y: 0px;
                    width: 4px; height: parent.height;
                    background: rr-l.has-hover ? Theme.accent : Theme.border-subtle;
                    rr-l := TouchArea {
                        mouse-cursor: ew-resize;
                        moved => {
                            if (self.pressed) {
                                root.panel-extent-drag(gi,
                                    ((self.absolute-position.x + self.mouse-x)
                                        - dock-area.absolute-position.x - gp.x) / 1px);
                            }
                        }
                    }
                }
                if gp.edge == "right" : Rectangle {
                    x: 0px; y: 0px;
                    width: 4px; height: parent.height;
                    background: rr-r.has-hover ? Theme.accent : Theme.border-subtle;
                    rr-r := TouchArea {
                        mouse-cursor: ew-resize;
                        moved => {
                            if (self.pressed) {
                                root.panel-extent-drag(gi,
                                    (gp.x + gp.w
                                        - ((self.absolute-position.x + self.mouse-x)
                                            - dock-area.absolute-position.x)) / 1px);
                            }
                        }
                    }
                }
                if gp.edge == "top" : Rectangle {
                    // Same reasoning as the left edge: keep the whole 4px inside.
                    x: 0px; y: parent.height - 4px;
                    width: parent.width; height: 4px;
                    background: rr-t.has-hover ? Theme.accent : Theme.border-subtle;
                    rr-t := TouchArea {
                        mouse-cursor: ns-resize;
                        moved => {
                            if (self.pressed) {
                                root.panel-extent-drag(gi,
                                    ((self.absolute-position.y + self.mouse-y)
                                        - dock-area.absolute-position.y - gp.y) / 1px);
                            }
                        }
                    }
                }
                if gp.edge == "bottom" : Rectangle {
                    x: 0px; y: 0px;
                    width: parent.width; height: 4px;
                    background: rr-b.has-hover ? Theme.accent : Theme.border-subtle;
                    rr-b := TouchArea {
                        mouse-cursor: ns-resize;
                        moved => {
                            if (self.pressed) {
                                root.panel-extent-drag(gi,
                                    (gp.y + gp.h
                                        - ((self.absolute-position.y + self.mouse-y)
                                            - dock-area.absolute-position.y)) / 1px);
                            }
                        }
                    }
                }
            }

            // Dividers between stacked panels on the same edge (#dock-stack).
            for dd[di] in root.dock-dividers : Rectangle {
                x: dd.x;
                y: dd.y;
                width: dd.w;
                height: dd.h;
                background: dd-ta.pressed ? Theme.accent : Theme.border-strong;
                animate background { duration: 100ms; }
                dd-ta := TouchArea {
                    mouse-cursor: dd.vertical ? ns-resize : ew-resize;
                    moved => {
                        if (self.pressed) {
                            root.stack-split-drag(dd.edge, dd.index,
                                dd.vertical
                                    ? ((self.absolute-position.y + self.mouse-y)
                                        - dock-area.absolute-position.y) / 1px
                                    : ((self.absolute-position.x + self.mouse-x)
                                        - dock-area.absolute-position.x) / 1px);
                        }
                    }
                }
            }

            // Drag-to-dock snap overlay — four edge zones; the one under the cursor
            // (root.dock-target) lights up. The zones stay input-transparent; the
            // single TouchArea below only ever sees a press when the drag lifecycle
            // broke (a live drag keeps its grab on the source), so a stranded
            // frame can be cleared with one click (#dock).
            if root.panel-dragging : Rectangle {
                x: 0; y: 0;
                width: parent.width;
                height: parent.height;
                // Self-heal: during a live drag the source keeps the pointer
                // grab, so this area sees nothing. The only way a press ever
                // lands here is a stale frame (the drag's end was lost) — one
                // click then clears it instead of stranding the preview.
                TouchArea {
                    clicked => { root.panel-dragging = false; }
                }
                Rectangle {   // left zone
                    x: 0; y: 0; width: parent.width * 0.22; height: parent.height;
                    background: root.dock-target == "left"
                        ? Theme.accent.with-alpha(0.35) : Theme.accent.with-alpha(0.10);
                    border-width: root.dock-target == "left" ? 2px : 0px;
                    border-color: Theme.accent;
                }
                Rectangle {   // right zone
                    x: parent.width * 0.78; y: 0; width: parent.width * 0.22; height: parent.height;
                    background: root.dock-target == "right"
                        ? Theme.accent.with-alpha(0.35) : Theme.accent.with-alpha(0.10);
                    border-width: root.dock-target == "right" ? 2px : 0px;
                    border-color: Theme.accent;
                }
                Rectangle {   // top zone
                    x: 0; y: 0; width: parent.width; height: parent.height * 0.22;
                    background: root.dock-target == "top"
                        ? Theme.accent.with-alpha(0.35) : Theme.accent.with-alpha(0.10);
                    border-width: root.dock-target == "top" ? 2px : 0px;
                    border-color: Theme.accent;
                }
                Rectangle {   // bottom zone
                    x: 0; y: parent.height * 0.78; width: parent.width; height: parent.height * 0.22;
                    background: root.dock-target == "bottom"
                        ? Theme.accent.with-alpha(0.35) : Theme.accent.with-alpha(0.10);
                    border-width: root.dock-target == "bottom" ? 2px : 0px;
                    border-color: Theme.accent;
                }
            }
        }
        }
    }

    // Top-right terminal-context icons (Pin window, Command bar toggle, Sync input).
    // Global tools (Transfers, Theme, Updates, Settings) live at the bottom of the
    // Left Activity Bar; fallback icons appear here only when panels are hidden (Zen).
    IconBtn {
        x: root.width - 36px - root.toolbar-x-off; y: root.toolbar-y;
        visible: !root.term-fullscreen;
        icon: "\u{F10D}";   // Material "push_pin" — always on top (#450)
        icon-size: 18px;
        icon-color: root.pinned ? Theme.accent : Theme.text-secondary;
        active: root.pinned;
        tooltip: root.lang-en
            ? (root.pinned ? "Unpin window (stop keeping on top)" : "Pin window (keep on top)")
            : (root.pinned ? "取消置顶" : "窗口置顶");
        clicked => { root.pinned = !root.pinned; root.pinned-changed(root.pinned); }
    }
    IconBtn {
        x: root.width - 70px - root.toolbar-x-off; y: root.toolbar-y;
        visible: !root.term-fullscreen;
        icon: "\u{E86F}";   // Material "code" — command bar
        icon-size: 18px;
        active: !root.cmd-bar-hidden;
        tooltip: root.lang-en
            ? (root.cmd-bar-hidden ? "Show command bar" : "Hide command bar")
            : (root.cmd-bar-hidden ? "显示命令栏" : "隐藏命令栏");
        clicked => { root.cmd-bar-hidden = !root.cmd-bar-hidden; root.set-cmd-bar-hidden(root.cmd-bar-hidden); }
    }
    IconBtn {
        x: root.width - 104px - root.toolbar-x-off; y: root.toolbar-y;
        visible: !root.term-fullscreen;
        icon: "\u{E627}";
        icon-size: 18px;
        icon-color: root.sync-input ? Theme.accent : Theme.text-secondary;
        active: root.sync-input;
        tooltip: root.lang-en
            ? (root.sync-input ? "Sync input: ON" : "Sync input")
            : (root.sync-input ? "会话同步：开" : "会话同步");
        clicked => { root.sync-input = !root.sync-input; root.set-sync-input(root.sync-input); }
    }

    // Frameless resize edges (#119): thin hit-zones that start an OS-level
    // resize via winit. Hidden when maximized.
    if root.custom-titlebar && !root.window-maximized && !root.term-fullscreen : Rectangle {
        width: 100%;
        height: 100%;
        TouchArea {  // top
            x: 8px; y: 0; width: parent.width - 16px; height: 5px;
            mouse-cursor: ns-resize;
            pointer-event(e) => { if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) { root.win-resize(0); } }
        }
        TouchArea {  // bottom
            x: 8px; y: parent.height - 5px; width: parent.width - 16px; height: 5px;
            mouse-cursor: ns-resize;
            pointer-event(e) => { if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) { root.win-resize(1); } }
        }
        TouchArea {  // left
            x: 0; y: 8px; width: 5px; height: parent.height - 16px;
            mouse-cursor: ew-resize;
            pointer-event(e) => { if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) { root.win-resize(3); } }
        }
        TouchArea {  // right
            x: parent.width - 5px; y: 8px; width: 5px; height: parent.height - 16px;
            mouse-cursor: ew-resize;
            pointer-event(e) => { if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) { root.win-resize(2); } }
        }
        TouchArea {  // top-left
            x: 0; y: 0; width: 8px; height: 8px;
            mouse-cursor: nwse-resize;
            pointer-event(e) => { if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) { root.win-resize(5); } }
        }
        TouchArea {  // top-right
            x: parent.width - 8px; y: 0; width: 8px; height: 8px;
            mouse-cursor: nesw-resize;
            pointer-event(e) => { if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) { root.win-resize(4); } }
        }
        TouchArea {  // bottom-left
            x: 0; y: parent.height - 8px; width: 8px; height: 8px;
            mouse-cursor: nesw-resize;
            pointer-event(e) => { if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) { root.win-resize(7); } }
        }
        TouchArea {  // bottom-right
            x: parent.width - 8px; y: parent.height - 8px; width: 8px; height: 8px;
            mouse-cursor: nwse-resize;
            pointer-event(e) => { if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) { root.win-resize(6); } }
        }
    }

    // --- Editor tabs: discard confirmation (#287, #494) --------------------
    // Closing an editor tab with unsaved edits asks first, like the detached
    // editor window. Rust opens this from the tab-close path.
    ConfirmDialog {
        is-open <=> root.editor-discard-confirm-open;
        is-mac: root.is-mac;
        dismiss-on-backdrop: false;
        title: @tr("Discard unsaved changes?");
        message: @tr("This file has unsaved changes. Close without saving?");
        confirm-label: @tr("Discard and close");
        confirm => {
            root.editor-discard-confirm-open = false;
            root.editor-discard-confirmed(root.editor-discard-id);
        }
        cancel => { root.editor-discard-confirm-open = false; }
    }

    // --- Download manager popup -------------------------------------------
    // Click-outside-to-close: a full-window transparent sensor sitting *under*
    // the popup. Clicking anywhere outside the popup hits this and closes it;
    // clicks inside the popup are caught by the popup's own TouchArea first.
    if root.download-open : TouchArea {
        width: parent.width;
        height: parent.height;
        clicked => { root.download-open = false; }
    }
    // Always present; toggled via `visible` (avoids destroying interactive
    // elements mid-event, which crashes when created/removed at the Window root).
    dl-card := TransferManagerPopup {
        x: 52px;
        y: max(48px, parent.height - self.height - 16px);
        download-open <=> root.download-open;
        transfers: root.transfers;
        has-active-transfers: root.has-active-transfers;
        lang-en: root.lang-en;
        download-dir: root.download-dir;
        dl-filter <=> root.dl-filter;
        dl-w <=> root.dl-w;
        dl-h <=> root.dl-h;
        dl-custom-sized <=> root.dl-custom-sized;
        dl-resizing <=> root.dl-resizing;
        dl-base-w <=> root.dl-base-w;
        dl-base-h <=> root.dl-base-h;
        dl-grab-x <=> root.dl-grab-x;
        dl-grab-y <=> root.dl-grab-y;
        clear-transfers => { root.clear-transfers(); }
        copy-text(t) => { root.copy-text(t); }
        pick-download-dir => { root.pick-download-dir(); }
        open-download-dir => { root.open-download-dir(); }
        cancel-transfer(id) => { root.cancel-transfer(id); }
    }

    // Process monitor is now ProcWindow (a detachable top-level window); the
    // former in-app overlay was removed in favour of a real OS window (#23).

    // --- Settings menu popup (top-right) ----------------------------------
    // Click-outside-to-close backdrop (same pattern as the download popup).
    if root.settings-open : TouchArea {
        width: parent.width;
        height: parent.height;
        clicked => { root.settings-open = false; }
    }
    SettingsMenuPopup {
        x: 42px;
        y: max(48px, parent.height - self.height - 12px);
        settings-open <=> root.settings-open;
        interface-open <=> root.interface-open;
        batch-import-open <=> root.batch-import-open;
        batch-import-text <=> root.batch-import-text;
        shortcuts-open <=> root.shortcuts-open;
        about-open <=> root.about-open;
        lang-en: root.lang-en;
        ssh-import-hint: root.ssh-import-hint;
        export-sessions => { root.export-sessions(); }
        import-sessions => { root.import-sessions(); }
        import-ssh-config => { root.import-ssh-config(); }
        set-language(lang) => { root.set-language(lang); }
    }

    // --- Group create / rename dialog (#41) -------------------------------
    if root.group-dialog-open : GroupEditModal {
        width: parent.width;
        height: parent.height;
        is-mac: root.is-mac;
        group-dialog-open <=> root.group-dialog-open;
        active-modal: root.active-modal;
        lang-en: root.lang-en;
        group-dialog-orig: root.group-dialog-orig;
        group-dialog-name <=> root.group-dialog-name;
        group-dialog-error <=> root.group-dialog-error;
        submit-group(orig, name) => { return root.submit-group(orig, name); }
    }

    // --- Rename-session dialog ----------------------------------------------
    if root.tab-rename-open : TabRenameModal {
        width: parent.width;
        height: parent.height;
        is-mac: root.is-mac;
        tab-rename-open <=> root.tab-rename-open;
        active-modal: root.active-modal;
        lang-en: root.lang-en;
        tab-rename-id: root.tab-rename-id;
        tab-rename-value <=> root.tab-rename-value;
        rename-tab(id, val) => { root.rename-tab(id, val); }
    }

    // --- Quick-command manage dialog (#55) --------------------------------
    if root.quick-cmd-manage-open : QuickCommandManageDialog {
        width: parent.width;
        height: parent.height;
        is-mac: root.is-mac;
        active-modal: root.active-modal;
        lang-en: root.lang-en;
        quick-cmd-manage-open <=> root.quick-cmd-manage-open;
        quick-commands: root.quick-commands;
        qcm-name <=> root.qcm-name;
        qcm-command <=> root.qcm-command;
        qcm-group <=> root.qcm-group;
        qcm-send-enter <=> root.qcm-send-enter;
        qcm-edit-index <=> root.qcm-edit-index;
        qcm-dialog-width <=> root.qcm-dialog-width;
        qcm-dialog-height <=> root.qcm-dialog-height;
        qcm-dialog-resizing <=> root.qcm-dialog-resizing;
        qcm-resize-base-width <=> root.qcm-resize-base-width;
        qcm-resize-base-height <=> root.qcm-resize-base-height;
        qcm-resize-grab-x <=> root.qcm-resize-grab-x;
        qcm-resize-grab-y <=> root.qcm-resize-grab-y;
        qcg-open <=> root.qcg-open;
        qcg-orig <=> root.qcg-orig;
        qcg-name <=> root.qcg-name;
        add-quick-command(name, cmd, grp, enter) => { root.add-quick-command(name, cmd, grp, enter); }
        save-quick-command(idx, name, cmd, grp, enter) => { root.save-quick-command(idx, name, cmd, grp, enter); }
        edit-quick-command(idx) => { root.edit-quick-command(idx); }
        duplicate-quick-command(idx) => { root.duplicate-quick-command(idx); }
        delete-quick-command(idx) => { root.delete-quick-command(idx); }
        reorder-quick-command(idx, up) => { root.reorder-quick-command(idx, up); }
        move-quick-command(idx, grp) => { root.move-quick-command(idx, grp); }
        delete-quick-group(grp) => { root.delete-quick-group(grp); }
    }

    // --- Quick-command group New / Rename mini-dialog ----------------------
    if root.qcg-open : QuickCommandGroupDialog {
        width: parent.width;
        height: parent.height;
        is-mac: root.is-mac;
        active-modal: root.active-modal;
        lang-en: root.lang-en;
        qcg-open <=> root.qcg-open;
        qcg-orig <=> root.qcg-orig;
        qcg-name <=> root.qcg-name;
        submit-quick-group(orig, name) => { root.submit-quick-group(orig, name); }
    }

    // --- SFTP generic single-input prompt (new-folder / new-file / rename) -
    if root.sftp-prompt-open : SftpPromptDialog {
        width: parent.width;
        height: parent.height;
        is-mac: root.is-mac;
        active-modal: root.active-modal;
        lang-en: root.lang-en;
        sftp-prompt-open <=> root.sftp-prompt-open;
        sftp-prompt-kind: root.sftp-prompt-kind;
        sftp-prompt-tab: root.sftp-prompt-tab;
        sftp-prompt-target: root.sftp-prompt-target;
        sftp-prompt-value <=> root.sftp-prompt-value;
        sftp-prompt-submit(kind, tab, target, val) => { root.sftp-prompt-submit(kind, tab, target, val); }
    }

    // --- Confirm-close modal (fires when user clicks X with live sessions) ---
    if root.confirm-close-open : ConfirmCloseDialog {
        width: parent.width;
        height: parent.height;
        is-mac: root.is-mac;
        active-modal: root.active-modal;
        lang-en: root.lang-en;
        confirm-close-open <=> root.confirm-close-open;
        confirm-close-yes => { root.confirm-close-yes(); }
    }

    // --- Chmod dialog (visual rwx checkboxes + live octal sync) ----------
    if root.chmod-open : ChmodDialog {
        width: parent.width;
        height: parent.height;
        is-mac: root.is-mac;
        active-modal: root.active-modal;
        lang-en: root.lang-en;
        chmod-open <=> root.chmod-open;
        chmod-name: root.chmod-name;
        chmod-or <=> root.chmod-or;
        chmod-ow <=> root.chmod-ow;
        chmod-ox <=> root.chmod-ox;
        chmod-gr <=> root.chmod-gr;
        chmod-gw <=> root.chmod-gw;
        chmod-gx <=> root.chmod-gx;
        chmod-tr <=> root.chmod-tr;
        chmod-tw <=> root.chmod-tw;
        chmod-tx <=> root.chmod-tx;
        sftp-chmod-apply => { root.sftp-chmod-apply(); }
    }

    // --- Shortcuts dialog (#61) — read-only cheat sheet of every binding ---
    if root.shortcuts-open : ShortcutsDialog {
        width: parent.width;
        height: parent.height;
        is-mac: root.is-mac;
        active-modal: root.active-modal;
        lang-en: root.lang-en;
        shortcuts-open <=> root.shortcuts-open;
        shortcut-bindings: root.shortcut-bindings;
        shortcut-recording <=> root.shortcut-recording;
        shortcut-status <=> root.shortcut-status;
        shortcut-status-error: root.shortcut-status-error;
        shortcut-record(id, key, ctrl, alt, shift, meta) => { root.shortcut-record(id, key, ctrl, alt, shift, meta); }
        shortcut-reset(id) => { root.shortcut-reset(id); }
        shortcut-reset-all => { root.shortcut-reset-all(); }
    }

    // --- About dialog (#61) ----------------------------------------------
    if root.about-open : AboutModalDialog {
        width: parent.width;
        height: parent.height;
        is-mac: root.is-mac;
        active-modal: root.active-modal;
        about-open <=> root.about-open;
        app-version: root.app-version;
        open-repo => { root.open-repo(); }
    }

    // --- Modal dialog -----------------------------------------------------
    session-editor := SessionDialog {
        width: parent.width;
        height: parent.height;
        is-open <=> root.dialog-open;
        is-editing <=> root.dialog-editing;
        is-mac: root.is-mac;
        covered: root.active-modal != ModalKind.session;
        draft-id <=> root.dialog-id;
        draft-name <=> root.dialog-name;
        draft-host <=> root.dialog-host;
        draft-port <=> root.dialog-port;
        draft-user <=> root.dialog-user;
        draft-auth <=> root.dialog-auth;
        draft-password <=> root.dialog-password;
        draft-key-path <=> root.dialog-key-path;
        draft-key-inline <=> root.dialog-key-inline;
        draft-key-inline-mode <=> root.dialog-key-inline-mode;
        draft-proxy-type <=> root.dialog-proxy-type;
        draft-proxy-hostport <=> root.dialog-proxy-hostport;
        draft-group <=> root.dialog-group;
        session-groups: root.session-groups;
        jump-choices: root.jump-choices;
        jumps: root.dialog-jumps;
        allow-secret-reveal <=> root.dialog-allow-secret-reveal;
        allow-mcp-access <=> root.dialog-allow-mcp-access;
        reveal-secret(key) => { root.reveal-session-secret(key) }
        add-jump => { root.add-jump(); }
        update-jump(row, choice) => { root.update-jump(row, choice); }
        delete-jump(row) => { root.delete-jump(row); }
        move-jump(from, to) => { root.move-jump(from, to); }
        draft-kind <=> root.dialog-kind;
        draft-serial-port <=> root.dialog-serial-port;
        session-serial-ports: root.session-serial-ports;
        draft-baud <=> root.dialog-baud;
        draft-data-bits <=> root.dialog-data-bits;
        draft-stop-bits <=> root.dialog-stop-bits;
        draft-parity <=> root.dialog-parity;
        draft-flow <=> root.dialog-flow;
        draft-rdp-domain <=> root.dialog-rdp-domain;
        draft-rdp-resolution <=> root.dialog-rdp-resolution;
        draft-rdp-width <=> root.dialog-rdp-width;
        draft-rdp-height <=> root.dialog-rdp-height;
        draft-rdp-legacy-tls <=> root.dialog-rdp-legacy-tls;
        draft-rdp-admin <=> root.dialog-rdp-admin;
        draft-rdp-smart-sizing <=> root.dialog-rdp-smart-sizing;
        draft-rdp-cert-policy <=> root.dialog-rdp-cert-policy;
        draft-rdp-network <=> root.dialog-rdp-network;
        draft-rdp-sound <=> root.dialog-rdp-sound;
        draft-rdp-clipboard <=> root.dialog-rdp-clipboard;
        draft-rdp-gfx <=> root.dialog-rdp-gfx;
        draft-rdp-extra-args <=> root.dialog-rdp-extra-args;
        show-rdp-advanced <=> root.dialog-rdp-show-advanced;
        rdp-preview <=> root.dialog-rdp-preview;
        draft-encoding <=> root.dialog-encoding;
        draft-vt100-drawing <=> root.dialog-vt100-drawing;
        draft-term-type <=> root.dialog-term-type;
        draft-session-log <=> root.dialog-session-log;
        draft-disable-shell-integration <=> root.dialog-disable-shell-integration;
        draft-sftp-mode <=> root.dialog-sftp-mode;
        draft-sftp-command <=> root.dialog-sftp-command;
        draft-note <=> root.dialog-note;
        test-status <=> root.dialog-test-status;
        forwards: root.dialog-forwards;
        triggers: root.dialog-triggers;
        submit(draft) => { root.session-dialog-submit(draft); }
        test-connection(draft) => { root.session-dialog-test(draft); }
        preview-rdp(draft) => { root.session-dialog-preview-rdp(draft) }
        cancel => { root.session-dialog-cancel(); }
        closed => { root.session-dialog-closed(); }
        stop-test => { root.session-dialog-stop-test(); }
        connection-draft-changed => { root.session-dialog-changed(); }
        pick-key-file => { root.session-dialog-pick-key(); }
        add-forward => { root.add-forward(); }
        update-forward(i, f) => { root.update-forward(i, f); }
        delete-forward(i) => { root.delete-forward(i); }
        add-trigger => { root.add-trigger(); }
        update-trigger(i, trigger) => { root.update-trigger(i, trigger); }
        delete-trigger(i) => { root.delete-trigger(i); }
    }

    // --- Delete confirmation (#28) ----------------------------------------
    ConfirmDialog {
        width: parent.width;
        height: parent.height;
        is-open <=> root.confirm-delete-open;
        is-mac: root.is-mac;
        covered: root.active-modal != ModalKind.delete-confirm;
        title: @tr("Confirm delete");
        message: root.confirm-delete-batch
            ? (root.lang-en ? "Delete the checked items? This cannot be undone."
                            : "删除选中的多个项目?此操作不可撤销。")
            : @tr("Delete this item? This cannot be undone.");
        detail: root.confirm-delete-path;
        confirm-label: @tr("Delete");
        confirm => {
            if (root.confirm-delete-batch) {
                root.sftp-delete-selected(root.confirm-delete-tab);
                root.confirm-delete-batch = false;
            } else {
                root.sftp-delete(root.confirm-delete-tab, root.confirm-delete-path);
            }
            root.confirm-delete-open = false;
        }
        cancel => { root.confirm-delete-batch = false; root.confirm-delete-open = false; }
    }

    // Multi-line paste can execute several shell commands at once. Keep the
    // prompt explicit; clicking the backdrop never accepts the paste (#262),
    // while Enter provides the expected keyboard confirmation (#392).
    ConfirmDialog {
        width: parent.width;
        height: parent.height;
        is-open <=> root.paste-confirm-open;
        is-mac: root.is-mac;
        covered: root.active-modal != ModalKind.paste-confirm;
        dismiss-on-backdrop: false;
        confirm-on-enter: true;
        title: root.lang-en ? "Confirm multi-line paste" : "确认多行粘贴";
        message: root.lang-en
            ? "The clipboard contains line breaks and may execute multiple commands. Review it before pasting."
            : "剪贴板内容包含换行，粘贴后可能连续执行多个命令，请确认内容后再继续。";
        detail: root.paste-confirm-preview;
        large-detail: root.paste-confirm-large;
        confirm-label: root.lang-en ? "Paste" : "粘贴";
        confirm => {
            root.paste-confirmed(root.paste-confirm-tab);
            root.paste-confirm-open = false;
            root.terminal-focus-sequence += 1;
        }
        cancel => {
            root.paste-confirm-cancelled();
            root.paste-confirm-open = false;
            root.terminal-focus-sequence += 1;
        }
    }

    // Host-key confirmation (#109-5). Reuses the confirm-dialog card. The backdrop
    // is NOT a dismiss here (#152): clicking outside the card used to count as a
    // reject and — worse — poison the host for the whole run. The user must pick
    // "Trust & connect" or the explicit Cancel/Reject button.
    ConfirmDialog {
        width: parent.width;
        height: parent.height;
        is-open <=> root.hostkey-prompt-open;
        is-mac: root.is-mac;
        covered: root.active-modal != ModalKind.host-key;
        dismiss-on-backdrop: false;
        title: root.hostkey-title;
        message: root.hostkey-message;
        detail: root.hostkey-detail;
        confirm-label: root.hostkey-confirm-label;
        secondary-label: root.dialog-open && root.hostkey-prompt-is-test ? (root.dialog-editing ? @tr("Save session") : @tr("Create session")) : "";
        secondary => { session-editor.submit-current(); }
        confirm => { root.hostkey-accept(); }
        cancel => { root.hostkey-reject(); }
    }

    // Batch-import connections from pasted text (#150).
    if root.batch-import-open : BatchImportModal {
        width: parent.width;
        height: parent.height;
        is-mac: root.is-mac;
        covered: root.active-modal != ModalKind.batch-import;
        lang-en: root.lang-en;
        batch-import-open <=> root.batch-import-open;
        batch-import-text <=> root.batch-import-text;
        batch-import-confirm(text) => { root.batch-import-confirm(text); }
    }

    // Connect-time credential prompt (#110). Backdrop / Cancel abort the connect.
    if root.cred-prompt-open : CredentialPromptModal {
        width: parent.width;
        height: parent.height;
        is-mac: root.is-mac;
        covered: root.active-modal != ModalKind.credentials;
        cred-host: root.cred-host;
        cred-need-user: root.cred-need-user;
        cred-need-password: root.cred-need-password;
        cred-user <=> root.cred-user;
        cred-password <=> root.cred-password;
        cred-remember <=> root.cred-remember;
        dialog-open: root.dialog-open;
        cred-prompt-is-test: root.cred-prompt-is-test;
        dialog-editing: root.dialog-editing;
        cred-accept => { root.cred-accept(); }
        cred-reject => { root.cred-reject(); }
        submit-current-session => { session-editor.submit-current(); }
    }

    // MFA / keyboard-interactive prompt (#86-MFA). A bastion (JumpServer with MFA
    // forced on) challenges for a verification code mid-login; backdrop / Cancel
    // abort the connect.
    if root.mfa-prompt-open : MfaPromptModal {
        width: parent.width;
        height: parent.height;
        is-mac: root.is-mac;
        covered: root.active-modal != ModalKind.mfa;
        lang-en: root.lang-en;
        mfa-host: root.mfa-host;
        mfa-prompt: root.mfa-prompt;
        mfa-echo: root.mfa-echo;
        mfa-answer <=> root.mfa-answer;
        dialog-open: root.dialog-open;
        mfa-prompt-is-test: root.mfa-prompt-is-test;
        dialog-editing: root.dialog-editing;
        mfa-submit => { root.mfa-submit(); }
        mfa-cancel => { root.mfa-cancel(); }
        submit-current-session => { session-editor.submit-current(); }
    }

    // --- Interface settings (modal overlay) -------------------------------
    // Embedded in the main window (not a detached window), so it can't be
    // dragged outside the parent. The dim backdrop + a focus-grabbing scope make
    // it modal: no mouse or keyboard input reaches the app while it's open. The
    // card itself is draggable by its title bar but clamped inside the window.
    if root.interface-open : ModalLayer {
        is-open: true;
        is-mac: root.is-mac;
        covered: root.active-modal != ModalKind.settings;
        cancel-requested => { root.interface-open = false; }
        width: 100%;
        height: 100%;
        background: #00000080;            // dim backdrop
        // ModalLayer owns keyboard focus and blocks backdrop scrolling (#140-3).
        // Keep backdrop dismissal disabled for settings.
        dismiss-on-backdrop: false;

        Rectangle {
            x: root.ifd-x;
            y: root.ifd-y;
            // Bigger base, and scales with the settings font size (#v0.5).
            width: root.ifd-w;
            height: root.ifd-h;
            background: Theme.bg-root;
            border-radius: 14px;
            border-width: 1px;
            border-color: Theme.border-strong;
            drop-shadow-blur: 28px;
            drop-shadow-color: #00000070;
            clip: true;
            TouchArea {}   // swallow inside clicks so they don't hit the backdrop

            VerticalLayout {
                // Title bar — drag to move (clamped inside the window).
                Rectangle {
                    height: 48px;
                    background: Theme.bg-panel;
                    border-top-left-radius: 14px;
                    border-top-right-radius: 14px;
                    title-drag := TouchArea {
                        mouse-cursor: move;
                        pointer-event(e) => {
                            if (e.kind == PointerEventKind.down) {
                                root.ifd-dragging = true;
                                root.ifd-base-x = root.ifd-x;
                                root.ifd-base-y = root.ifd-y;
                                root.ifd-grab-x = self.absolute-position.x + self.mouse-x;
                                root.ifd-grab-y = self.absolute-position.y + self.mouse-y;
                            } else if (e.kind == PointerEventKind.up) {
                                root.ifd-dragging = false;
                            }
                        }
                        moved => {
                            if (root.ifd-dragging) {
                                root.ifd-x = clamp(
                                    round((root.ifd-base-x + (self.absolute-position.x + self.mouse-x - root.ifd-grab-x)) / 1px) * 1px,
                                    0px, max(0px, root.width - root.ifd-w));
                                root.ifd-y = clamp(
                                    round((root.ifd-base-y + (self.absolute-position.y + self.mouse-y - root.ifd-grab-y)) / 1px) * 1px,
                                    0px, max(0px, root.height - root.ifd-h));
                            }
                        }
                    }
                    HorizontalLayout {
                        padding-left: 20px;
                        padding-right: 12px;
                        Text {
                            text: root.lang-en ? "Settings" : "设置";
                            color: Theme.text-primary;
                            font-size: 16px;
                            font-weight: 600;
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                        }
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 28px; height: 28px;
                                border-radius: 7px;
                                background: if-close-ta.has-hover ? Theme.bg-hover : transparent;
                                animate background { duration: 90ms; }
                                if-close-ta := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.interface-open = false; }
                                }
                                OutlineIcon {
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    name: "close";
                                    icon-size: 16px;
                                    color: if-close-ta.has-hover ? Theme.text-primary : Theme.text-secondary;
                                }
                            }
                        }
                    }
                }
                Rectangle { height: 1px; background: Theme.border-subtle; }

                InterfacePanel {
                    vertical-stretch: 1;
                    lang-en: root.lang-en;
                    dark-mode: root.dark-mode;
                    set-dark-mode(dark) => {
                        if (root.dark-mode != dark) {
                            root.toggle-theme();
                        }
                    }
                    toggle-language => {
                        root.set-language(root.lang-en ? "zh" : "en");
                    }
                    download-dir: root.download-dir;
                    pick-download-dir => { root.pick-download-dir(); }
                    open-download-dir => { root.open-download-dir(); }
                    import-ssh-config => { root.import-ssh-config(); }
                    import-connections => { root.import-sessions(); }
                    export-connections => { root.export-sessions(); }
                    open-batch-import => {
                        root.interface-open = false;
                        root.batch-import-text = "";
                        root.batch-import-open = true;
                    }
                    shortcut-bindings: root.shortcut-bindings;
                    shortcut-recording <=> root.shortcut-recording;
                    shortcut-status <=> root.shortcut-status;
                    shortcut-status-error: root.shortcut-status-error;
                    shortcut-record(id, txt, ctrl, meta, alt, shift) => {
                        root.shortcut-record(id, txt, ctrl, meta, alt, shift);
                    }
                    shortcut-reset(id) => { root.shortcut-reset(id); }
                    shortcut-reset-all => { root.shortcut-reset-all(); }
                    app-version: root.app-version;
                    open-repo => { root.open-repo(); }
                    is-windows: root.is-windows;
                    renderer-mode <=> root.renderer-mode;
                    term-fonts: root.term-fonts;
                    term-font-family: root.term-font-family;
                    term-font-size: root.term-font-size;
                    terminal-line-spacing <=> root.terminal-line-spacing;
                    term-font-bold: root.term-font-bold;
                    term-cursor-style <=> root.term-cursor-style;
                    output-highlight-enabled <=> root.output-highlight-enabled;
                    json-format-output <=> root.json-format-output;
                    output-highlight-preset <=> root.output-highlight-preset;
                    output-highlight-rules: root.output-highlight-rules;
                    output-highlight-rule-status <=> root.output-highlight-rule-status;
                    ui-scale: root.ui-scale;
                    sftp-follow-cd <=> root.sftp-follow-cd;
                    editor-embedded <=> root.editor-embedded;
                    collapse-sidebar-default <=> root.collapse-sidebar-default;
                    collapse-sftp-default <=> root.collapse-sftp-default;
                    sync-upload-enabled <=> root.sync-upload-enabled;
                    webdav-enabled <=> root.webdav-enabled;
                    webdav-url <=> root.webdav-url;
                    webdav-username <=> root.webdav-username;
                    webdav-password <=> root.webdav-password;
                    webdav-remote-path <=> root.webdav-remote-path;
                    webdav-accept-invalid-certs <=> root.webdav-accept-invalid-certs;
                    webdav-status <=> root.webdav-status;
                    download-always-ask <=> root.download-always-ask;
                    session-log-enabled <=> root.session-log-enabled;
                    session-log-dir: root.session-log-dir;
                    session-log-dir-custom: root.session-log-dir-custom;
                    paste-confirm-enabled <=> root.paste-confirm-enabled;
                    extra-paste-shortcuts-enabled <=> root.extra-paste-shortcuts-enabled;
                    ssh-keepalive-enabled <=> root.ssh-keepalive-enabled;
                    ssh-keepalive-interval <=> root.ssh-keepalive-interval;
                    ssh-keepalive-max <=> root.ssh-keepalive-max;
                    zen-mode <=> root.zen-mode;
                    welcome-as-sidebar <=> root.welcome-as-sidebar;
                    quick-commands-as-sidebar <=> root.quick-commands-as-sidebar;
                    update-check-enabled <=> root.update-check-enabled;
                    update-version: root.update-version;
                    update-busy: root.update-busy;
                    update-error: root.update-error;
                    update-install-supported: root.update-install-supported;
                    update-via-terminal: root.update-via-terminal;
                    update-status: root.update-status;
                    update-action-label: root.update-action-label;
                    check-for-updates => { root.check-for-updates(); }
                    update-action => { root.update-action(); }
                    open-update-url => { root.open-update-url(); }
                    update-mirrors: root.update-mirrors;
                    update-mirrors-testing: root.update-mirrors-testing;
                    update-china-tz: root.update-china-tz;
                    update-mirror-error: root.update-mirror-error;
                    add-update-mirror(url) => { root.add-update-mirror(url); }
                    remove-update-mirror(url) => { root.remove-update-mirror(url); }
                    reset-update-mirrors => { root.reset-update-mirrors(); }
                    test-update-mirrors => { root.test-update-mirrors(); }
                    update-mirror-auto: root.update-mirror-auto;
                    select-update-mirror(key) => { root.select-update-mirror(key); }
                    set-update-mirror-auto(v) => { root.set-update-mirror-auto(v); }
                    mcp-enabled <=> root.mcp-enabled;
                    mcp-use-saved-credentials <=> root.mcp-use-saved-credentials;
                    mcp-allow-commands <=> root.mcp-allow-commands;
                    mcp-allow-file-transfers <=> root.mcp-allow-file-transfers;
                    mcp-config-json: root.mcp-config-json;
                    copy-text(t) => { root.copy-text(t); }
                    wallpaper-overlay <=> root.wallpaper-overlay;
                    current-wallpaper: root.current-wallpaper;
                    custom-wallpaper-name: root.custom-wallpaper-name;
                    wsl-profiles: root.wsl-profiles;
                    wsl-new-directory <=> root.wsl-new-directory;
                    start-page: root.interface-start-page;
                    custom-agents: root.custom-agents;
                    agent-new-name <=> root.agent-new-name;
                    agent-new-command <=> root.agent-new-command;
                    agent-new-directory <=> root.agent-new-directory;
                    set-wallpaper(v) => { root.set-wallpaper(v); }
                    pick-wallpaper-file() => { root.pick-wallpaper-file(); }
                    color-themes: root.color-themes;
                    color-theme: root.color-theme;
                    color-theme-custom <=> root.color-theme-custom;
                    immersive-colors: root.immersive-colors;
                    set-color-theme(id) => { root.set-color-theme(id); }
                    set-color-theme-custom(hex) => { root.set-color-theme-custom(hex) }
                    set-immersive-colors(v) => { root.set-immersive-colors(v); }
                    terminal-schemes: root.terminal-schemes;
                    active-terminal-scheme: root.active-terminal-scheme;
                    terminal-scheme-id <=> root.terminal-scheme-id;
                    terminal-scheme-search <=> root.terminal-scheme-search;
                    terminal-scheme-category <=> root.terminal-scheme-category;
                    terminal-schemes-total: root.terminal-schemes-total;
                    terminal-schemes-has-more: root.terminal-schemes-has-more;
                    terminal-scheme-status <=> root.terminal-scheme-status;
                    select-terminal-scheme(id) => { root.select-terminal-scheme(id); }
                    toggle-favorite-terminal-scheme(id) => { root.toggle-favorite-terminal-scheme(id); }
                    filter-terminal-schemes(q, cat) => { root.filter-terminal-schemes(q, cat); }
                    load-more-terminal-schemes => { root.load-more-terminal-schemes(); }
                    reset-terminal-scheme => { root.reset-terminal-scheme(); }
                    import-terminal-scheme => { root.import-terminal-scheme(); }
                    export-terminal-scheme => { root.export-terminal-scheme(); }
                    delete-custom-terminal-scheme(id) => { root.delete-custom-terminal-scheme(id); }
                    set-term-font(v) => { root.set-term-font(v); }
                    set-term-font-size(v) => { root.set-term-font-size(v); }
                    set-terminal-line-spacing(v) => { root.set-terminal-line-spacing(v); }
                    set-term-font-bold(v) => { root.set-term-font-bold(v); }
                    set-term-cursor-style(v) => { root.set-term-cursor-style(v); }
                    set-output-highlight(enabled, preset) => {
                        root.set-output-highlight(enabled, preset);
                    }
                    set-json-format-output(enabled) => { root.set-json-format-output(enabled); }
                    add-output-highlight-rule(pattern, regex, case-sensitive, whole-line, color) => {
                        root.add-output-highlight-rule(
                            pattern, regex, case-sensitive, whole-line, color)
                    }
                    remove-output-highlight-rule(index) => {
                        root.remove-output-highlight-rule(index);
                    }
                    set-output-highlight-rule-enabled(index, enabled) => {
                        root.set-output-highlight-rule-enabled(index, enabled);
                    }
                    set-ui-scale(v) => { root.set-ui-scale(v); }
                    set-panel-font(v) => { root.set-panel-font(v); }
                    set-renderer-mode(v) => { root.set-renderer-mode(v); }
                    set-sftp-follow-cd(v) => { root.set-sftp-follow-cd(v); }
                    set-editor-embedded(v) => { root.set-editor-embedded(v); }
                    set-collapse-sidebar-default(v) => { root.set-collapse-sidebar-default(v); }
                    set-collapse-sftp-default(v) => { root.set-collapse-sftp-default(v); }
                    set-sync-upload-enabled(v) => { root.set-sync-upload-enabled(v); }
                    save-webdav-settings(enabled, url, username, password, remote-path, accept-invalid-certs) => {
                        root.save-webdav-settings(enabled, url, username, password, remote-path, accept-invalid-certs);
                    }
                    webdav-upload => { root.webdav-upload(); }
                    webdav-download => { root.webdav-download(); }
                    set-download-always-ask(v) => { root.set-download-always-ask(v); }
                    set-session-log-enabled(v) => { root.set-session-log-enabled(v); }
                    pick-session-log-dir => { root.pick-session-log-dir(); }
                    reset-session-log-dir => { root.reset-session-log-dir(); }
                    open-session-log-dir => { root.open-session-log-dir(); }
                    set-paste-confirm-enabled(v) => { root.set-paste-confirm-enabled(v); }
                    set-extra-paste-shortcuts-enabled(v) => { root.set-extra-paste-shortcuts-enabled(v); }
                    set-ssh-keepalive(on, interval, max) => { root.set-ssh-keepalive(on, interval, max); }
                    set-zen-mode(v) => { root.set-zen-mode(v); }
                    set-welcome-as-sidebar(v) => { root.set-welcome-as-sidebar(v); }
                    set-quick-commands-as-sidebar(v) => {
                        root.quick-commands-as-sidebar = v;
                        if (!v) {
                            root.quick-panel-open = false;
                            root.quick-panel-collapsed = false;
                        }
                        root.set-quick-commands-as-sidebar(v);
                    }
                    set-update-check-enabled(v) => { root.set-update-check-enabled(v); }
                    set-mcp-permissions(enabled, credentials, commands, files) => {
                        root.set-mcp-permissions(enabled, credentials, commands, files);
                    }
                    add-wsl-profile(name, distribution, directory) => { root.add-wsl-profile(name, distribution, directory); }
                    remove-wsl-profile(id) => { root.remove-wsl-profile(id); }
                    pick-wsl-directory => { root.pick-wsl-directory(); }
                    add-custom-agent(name, command, directory) => { root.add-custom-agent(name, command, directory); }
                    remove-custom-agent(id) => { root.remove-custom-agent(id); }
                    pick-agent-directory => { root.pick-agent-directory(); }
                    persist-wallpaper-overlay(v) => { root.persist-wallpaper-overlay(v); }
                }
            }
            // Crisp 1px outer border ring drawn above child backgrounds so the
            // 14px rounded corners stay clean in the software renderer.
            Rectangle {
                x: 0; y: 0;
                width: 100%; height: 100%;
                border-radius: 14px;
                border-width: 1px;
                border-color: Theme.border-strong;
                background: transparent;
            }
            Rectangle {
                // #ifd-resize: bottom-right resize grip — switched from
                // "open_in_full" glyph to the 3-dot diagonal pattern used by
                // ProcWindow (#grip-icon-3dots) so all three affordances share
                // one visual.
                x: parent.width - 16px;
                y: parent.height - 16px;
                width: 16px;
                height: 16px;
                background: transparent;
                // 保留原 \u{E3C2} open_in_full 视觉（注释保留以备切换） (#grip-icon-3dots)
                // Text {
                //     text: "\u{E3C2}";
                //     font-family: "Material Icons";
                //     color: Theme.text-muted;
                //     font-size: 14px;
                //     horizontal-alignment: center;
                //     vertical-alignment: center;
                // }
                // 替换为进程弹框(ProcWindow:457)同款 3 点对角手柄（内缩以避开 14px 圆角边框）
                Rectangle { x: parent.width - 8px;  y: parent.height - 8px;  width: 2px; height: 2px;
                            background: Theme.text-muted; }
                Rectangle { x: parent.width - 12px; y: parent.height - 8px;  width: 2px; height: 2px;
                            background: Theme.text-muted; }
                Rectangle { x: parent.width - 8px;  y: parent.height - 12px; width: 2px; height: 2px;
                            background: Theme.text-muted; }
                resize-ta := TouchArea {
                    mouse-cursor: nwse-resize;
                    pointer-event(e) => {
                        if (e.kind == PointerEventKind.down) {
                            root.ifd-resizing = true;
                            root.ifd-base-w = root.ifd-w;
                            root.ifd-base-h = root.ifd-h;
                            root.ifd-grab-x = self.absolute-position.x + self.mouse-x;
                            root.ifd-grab-y = self.absolute-position.y + self.mouse-y;
                        } else if (e.kind == PointerEventKind.up) {
                            root.ifd-resizing = false;
                        }
                    }
                    moved => {
                        if (root.ifd-resizing) {
                            root.ifd-w = clamp(
                                round((root.ifd-base-w + (self.absolute-position.x + self.mouse-x - root.ifd-grab-x)) / 1px) * 1px,
                                640px, max(640px, root.width - root.ifd-x));
                            root.ifd-h = clamp(
                                round((root.ifd-base-h + (self.absolute-position.y + self.mouse-y - root.ifd-grab-y)) / 1px) * 1px,
                                420px, max(420px, root.height - root.ifd-y));
                        }
                    }
                }
            }
        }
    }

    // --- Bottom-right resize grip (frameless platforms) -------------------
    // #main-resize-grip: mirrors ProcWindow's grip so the main window has the
    // same visual affordance + drag-resize behavior when the OS title bar is
    // hidden (custom-titlebar mode). Only rendered in frameless mode; otherwise
    // the OS frame already provides this corner.
    if root.custom-titlebar && !root.term-fullscreen : Rectangle {
        width: 16px;
        height: 16px;
        x: root.width - self.width;
        y: root.height - self.height;
        TouchArea {
            mouse-cursor: nwse-resize;
            pointer-event(e) => {
                if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                    root.win-resize-se();
                }
            }
        }
        // Classic dotted resize grip (a diagonal of 2px dots, bottom-right).
        Rectangle { x: parent.width - 5px;  y: parent.height - 5px;  width: 2px; height: 2px;
                    background: Theme.text-muted; }
        Rectangle { x: parent.width - 9px;  y: parent.height - 5px;  width: 2px; height: 2px;
                    background: Theme.text-muted; }
        Rectangle { x: parent.width - 5px;  y: parent.height - 9px;  width: 2px; height: 2px;
                    background: Theme.text-muted; }
    }

    // --- Root-level unoccluded floating tooltip overlay -------------------
    if TooltipState.text != "" : Rectangle {
        z: 9999;
        width: global-tip-txt.preferred-width + 16px;
        height: 25px;
        x: clamp(
            TooltipState.anchor-x + (TooltipState.anchor-w - self.width) / 2,
            6px,
            max(6px, root.width - self.width - 6px));
        y: (TooltipState.anchor-y + TooltipState.anchor-h + 32px > root.height)
            ? max(4px, TooltipState.anchor-y - self.height - 5px)
            : (TooltipState.anchor-y + TooltipState.anchor-h + 5px);
        border-radius: 6px;
        background: Theme.dark ? #2f2f2f : #171717;
        border-width: Theme.dark ? 1px : 0px;
        border-color: #444444;
        drop-shadow-blur: 10px;
        drop-shadow-offset-y: 2px;
        drop-shadow-color: #00000045;
        global-tip-txt := Text {
            text: TooltipState.text;
            color: #ffffff;
            font-size: 11.5px * Theme.ui-scale;
            font-weight: 500;
            horizontal-alignment: center;
            vertical-alignment: center;
            width: parent.width;
            height: parent.height;
        }
    }
}
