import { Theme } from "theme.slint";
import { DiskInfo, StatsBlock } from "components/business/resource_stat_row.slint";
import { NetBlock } from "components/business/resource_net_block.slint";
import { StatusBlock, DiskBlock } from "components/business/resource_status_disk.slint";

export { DiskInfo }

// --- Sidebar ---------------------------------------------------------------
// Left-hand or right-hand panel showing local or remote machine health.
export component Sidebar inherits Rectangle {
    in property <string> status-heading: @tr("Status");
    in property <string> connection-state: @tr("Not connected");
    in property <bool> system-info-available;
    in property <string> conn-host;
    in property <int> conn-state;
    in property <bool> is-local-mode: true;
    in property <bool> metrics-available: true;
    in property <bool> lang-en: false;
    in property <string> resource-title: @tr("Local resources");
    in property <float> cpu-percent;
    in property <float> mem-percent;
    in property <float> swap-percent;
    in property <string> mem-detail;
    in property <string> swap-detail;
    in property <string> net-top-up;
    in property <string> net-top-down;
    in property <[float]> net-top-history;
    in property <string> net-bot-up;
    in property <string> net-bot-down;
    in property <[float]> net-bot-history;
    in property <[string]> net-ifaces;
    in property <string> net-selected;
    in property <bool> net-show-selector;
    in property <[DiskInfo]> disks;
    in property <bool> proc-available;
    in property <string> app-version;
    callback select-net-iface(string);
    callback show-system-info();
    callback show-processes();
    callback copy-host(string);
    callback switch-to-sessions();
    callback dock-drag-move(length /* abs-x */, length /* abs-y */);
    callback dock-drag-end();
    callback toggle-collapse();
    in property <bool> lay-horizontal;
    in property <string> dock-edge;
    property <string> collapse-icon:
        root.dock-edge == "right"  ? "chevron-right"
      : root.dock-edge == "top"    ? "chevron-up"
      : root.dock-edge == "bottom" ? "chevron-down"
      : "chevron-left";

    width: 280px;
    background: Theme.bg-panel;
    border-width: 0;

    dock-bg := TouchArea {
        mouse-cursor: self.pressed ? move : default;
        moved => {
            if (self.pressed) {
                root.dock-drag-move(self.absolute-position.x + self.mouse-x,
                                    self.absolute-position.y + self.mouse-y);
            }
        }
        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.up || ev.kind == PointerEventKind.cancel) {
                root.dock-drag-end();
            }
        }
    }

    // --- Vertical stack (docked left/right) — card-based dashboard ---------
    if !root.lay-horizontal : Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        background: Theme.bg-panel;
        clip: true;

        VerticalLayout {
            padding: 10px * Theme.ui-scale;
            spacing: 10px * Theme.ui-scale;

            StatusBlock {
                conn-state: root.conn-state;
                status-heading: root.status-heading;
                connection-state: root.connection-state;
                conn-host: root.conn-host;
                is-local-mode: root.is-local-mode;
                lang-en: root.lang-en;
                system-info-available: root.system-info-available;
                proc-available: root.proc-available;
                collapse-icon: root.collapse-icon;
                dock-drag-move(x, y) => { root.dock-drag-move(x, y); }
                dock-drag-end() => { root.dock-drag-end(); }
                collapse() => { root.toggle-collapse(); }
                switch-to-sessions() => { root.switch-to-sessions(); }
                show-system-info() => { root.show-system-info(); }
                show-processes() => { root.show-processes(); }
                copy-host(h) => { root.copy-host(h); }
            }

            StatsBlock {
                resource-title: root.resource-title;
                system-info-available: root.system-info-available;
                proc-available: root.proc-available;
                metrics-available: root.metrics-available;
                lang-en: root.lang-en;
                cpu-percent: root.cpu-percent;
                mem-percent: root.mem-percent;
                swap-percent: root.swap-percent;
                mem-detail: root.mem-detail;
                swap-detail: root.swap-detail;
                show-system-info() => { root.show-system-info(); }
                show-processes() => { root.show-processes(); }
            }

            NetBlock {
                is-local-mode: root.is-local-mode;
                lang-en: root.lang-en;
                net-top-up: root.net-top-up;
                net-top-down: root.net-top-down;
                net-top-history: root.net-top-history;
                net-show-selector: root.net-show-selector;
                net-ifaces: root.net-ifaces;
                net-selected: root.net-selected;
                net-bot-up: root.net-bot-up;
                net-bot-down: root.net-bot-down;
                net-bot-history: root.net-bot-history;
                select-net-iface(i) => { root.select-net-iface(i); }
            }

            DiskBlock {
                vertical-stretch: 1;
                disks: root.disks;
                lang-en: root.lang-en;
            }
        }
    }

    // --- Horizontal row (docked top/bottom) --------------------------------
    if root.lay-horizontal : Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        background: Theme.bg-panel;
        clip: true;

        HorizontalLayout {
            padding: 10px;
            spacing: 10px;
            VerticalLayout {
                alignment: start;
                spacing: 8px;
                min-width: 220px;
                StatusBlock {
                    conn-state: root.conn-state;
                    status-heading: root.status-heading;
                    connection-state: root.connection-state;
                    conn-host: root.conn-host;
                    is-local-mode: root.is-local-mode;
                    lang-en: root.lang-en;
                    system-info-available: root.system-info-available;
                    proc-available: root.proc-available;
                    collapse-icon: root.collapse-icon;
                    dock-drag-move(x, y) => { root.dock-drag-move(x, y); }
                    dock-drag-end() => { root.dock-drag-end(); }
                    collapse() => { root.toggle-collapse(); }
                    switch-to-sessions() => { root.switch-to-sessions(); }
                    show-system-info() => { root.show-system-info(); }
                    show-processes() => { root.show-processes(); }
                }
                StatsBlock {
                    resource-title: root.resource-title;
                    system-info-available: root.system-info-available;
                    proc-available: root.proc-available;
                    metrics-available: root.metrics-available;
                    lang-en: root.lang-en;
                    cpu-percent: root.cpu-percent;
                    mem-percent: root.mem-percent;
                    swap-percent: root.swap-percent;
                    mem-detail: root.mem-detail;
                    swap-detail: root.swap-detail;
                    show-system-info() => { root.show-system-info(); }
                    show-processes() => { root.show-processes(); }
                }
            }
            NetBlock {
                min-width: 220px;
                is-local-mode: root.is-local-mode;
                lang-en: root.lang-en;
                net-top-up: root.net-top-up;
                net-top-down: root.net-top-down;
                net-top-history: root.net-top-history;
                net-show-selector: root.net-show-selector;
                net-ifaces: root.net-ifaces;
                net-selected: root.net-selected;
                net-bot-up: root.net-bot-up;
                net-bot-down: root.net-bot-down;
                net-bot-history: root.net-bot-history;
                select-net-iface(i) => { root.select-net-iface(i); }
            }
            DiskBlock {
                horizontal-stretch: 1;
                disks: root.disks;
                lang-en: root.lang-en;
            }
        }
    }
}
