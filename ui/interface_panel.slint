// Interface settings content (#23 follow-up).
//
// Embedded panel (not a window): it lives inside AppWindow's modal overlay, so
// the settings can't be dragged out of the parent and block input while open —
// while keeping the clean, minimal "label-left · control-right" design.
// Typography is fixed (literal px in the chrome) so it stays compact regardless
// of the global UI scale; only the font-preview reflects the real terminal size.

import { Theme } from "theme.slint";
import { ComboBox, ScrollView } from "std-widgets.slint";
import { LabeledInput, PrimaryButton, GhostButton } from "widgets.slint";
import { NavItem, SectionHeader, SettingRow, Switch, Stepper } from "components/common/settings_controls.slint";
import {
    OutputRuleItem, UpdateMirrorRow, WslProfileInfo, ColorThemeItem,
    TerminalSchemeItem, CustomAgentInfo, ShortcutBinding,
    CursorStyleButton
} from "components/business/appearance_pickers.slint";
import { TerminalSchemeSection } from "pages/settings/terminal_scheme_section.slint";
import { GeneralSettingsPage } from "pages/settings/general_settings_page.slint";
import { ConnectionSettingsPage, SftpSettingsPage } from "pages/settings/connection_sftp_pages.slint";
import { AgentsSettingsPage, UpdatesSettingsPage, AboutSettingsPage } from "pages/settings/agents_update_about_pages.slint";

export { OutputRuleItem, UpdateMirrorRow, WslProfileInfo, ColorThemeItem, TerminalSchemeItem, CustomAgentInfo, ShortcutBinding }

// The settings content (nav + pages). Embedded in AppWindow's modal overlay.
export component InterfacePanel inherits Rectangle {
    in property <bool> lang-en;
    in property <bool> is-windows;
    in property <bool> dark-mode: Theme.dark;
    callback set-dark-mode(bool);
    callback toggle-language();
    in property <string> download-dir;
    callback pick-download-dir();
    callback open-download-dir();
    callback import-ssh-config();
    callback import-connections();
    callback export-connections();
    callback open-batch-import();
    in property <[ShortcutBinding]> shortcut-bindings;
    in-out property <string> shortcut-recording;
    in-out property <string> shortcut-status;
    in property <bool> shortcut-status-error;
    callback shortcut-record(string, string, bool, bool, bool, bool);
    callback shortcut-reset(string);
    callback shortcut-reset-all();
    in property <string> app-version: "0.8.2";
    callback open-repo();

    in-out property <string> renderer-mode: "software";
    in property <[string]> term-fonts;
    in property <string> term-font-family;
    in property <length> term-font-size;
    in-out property <float> terminal-line-spacing: 1.0;
    in-out property <bool> term-font-bold;
    in-out property <string> term-cursor-style: "block";
    in-out property <bool> output-highlight-enabled;
    in-out property <bool> json-format-output: true;
    in-out property <string> output-highlight-preset;
    in property <[OutputRuleItem]> output-highlight-rules;
    in-out property <string> output-highlight-rule-status;
    in property <float> ui-scale;
    in-out property <bool> sftp-follow-cd;
    in-out property <bool> editor-embedded;
    in-out property <bool> collapse-sidebar-default;
    in-out property <bool> collapse-sftp-default;
    in-out property <bool> sync-upload-enabled;
    in-out property <bool> webdav-enabled;
    in-out property <string> webdav-url;
    in-out property <string> webdav-username;
    in-out property <string> webdav-password;
    in-out property <string> webdav-remote-path;
    in-out property <bool> webdav-accept-invalid-certs;
    in-out property <string> webdav-status;
    in-out property <bool> download-always-ask;
    in-out property <bool> session-log-enabled;
    in property <string> session-log-dir;
    in property <bool> session-log-dir-custom;
    in-out property <bool> paste-confirm-enabled: true;
    in-out property <bool> extra-paste-shortcuts-enabled: true;
    // SSH keepalive (Settings › Connection, #515).
    in-out property <bool> ssh-keepalive-enabled: true;
    in-out property <int> ssh-keepalive-interval: 30;
    in-out property <int> ssh-keepalive-max: 3;
    in-out property <bool> zen-mode: false;
    in-out property <bool> welcome-as-sidebar;
    in-out property <bool> quick-commands-as-sidebar;
    in-out property <bool> update-check-enabled;
    in property <string> update-version;
    in property <bool> update-busy;
    in property <bool> update-error;
    in property <bool> update-install-supported;
    in property <bool> update-via-terminal;
    in property <string> update-status;
    in property <string> update-action-label;
    callback check-for-updates();
    callback update-action();
    callback open-update-url();
    in property <[UpdateMirrorRow]> update-mirrors;
    in property <bool> update-mirrors-testing;
    in property <bool> update-china-tz;
    in property <string> update-mirror-error;
    callback add-update-mirror(string);
    callback remove-update-mirror(string);
    callback reset-update-mirrors();
    callback test-update-mirrors();
    in property <bool> update-mirror-auto: true;
    callback select-update-mirror(string /* key */);
    callback set-update-mirror-auto(bool);
    property <string> new-mirror;
    in-out property <bool> mcp-enabled: true;
    in-out property <bool> mcp-use-saved-credentials: true;
    in-out property <bool> mcp-allow-commands: true;
    in-out property <bool> mcp-allow-file-transfers: true;
    // Ready-to-paste MCP client entry with this executable's path (Rust).
    in property <string> mcp-config-json;
    callback copy-text(string);
    property <bool> mcp-json-copied: false;
    in-out property <float> wallpaper-overlay;   // frosted-panel opacity 0.30-1.00
    // Active wallpaper id: "" / "builtin:light" / "builtin:dark" / a file path.
    in property <string> current-wallpaper;
    in property <string> custom-wallpaper-name;   // basename for the file row
    // Colour theme presets + immersive colours (Wallpaper & theme page).
    in property <[ColorThemeItem]> color-themes;
    in property <string> color-theme: "default";
    in-out property <string> color-theme-custom: "#4A90E2";
    in property <bool> immersive-colors: true;
    callback set-color-theme(string);
    callback set-color-theme-custom(string) -> bool;
    callback set-immersive-colors(bool);

    // Terminal color schemes (iTerm2-Color-Schemes + custom themes).
    in property <[TerminalSchemeItem]> terminal-schemes;
    in property <TerminalSchemeItem> active-terminal-scheme;
    in-out property <string> terminal-scheme-id: "default";
    in-out property <string> terminal-scheme-search: "";
    in-out property <string> terminal-scheme-category: "all";
    in property <int> terminal-schemes-total: 0;
    in property <bool> terminal-schemes-has-more: false;
    in-out property <string> terminal-scheme-status: "";
    callback select-terminal-scheme(string);
    callback toggle-favorite-terminal-scheme(string);
    callback filter-terminal-schemes(string /* query */, string /* category */);
    callback load-more-terminal-schemes();
    callback reset-terminal-scheme();
    callback import-terminal-scheme();
    callback export-terminal-scheme();
    callback delete-custom-terminal-scheme(string);
    in property <[WslProfileInfo]> wsl-profiles;
    in-out property <string> wsl-new-name: "WSL";
    in-out property <string> wsl-new-distribution;
    in-out property <string> wsl-new-directory: "~";

    // Page shown when the panel opens; "agents" when opened from the tab
    // bar's launch menu (#427).
    in property <string> start-page: "general";
    property <string> ifd-page: root.start-page;
    property <bool> is-general-page:
        root.ifd-page == "general" || root.ifd-page == "wallpaper"
        || root.ifd-page == "sidebar" || root.ifd-page == "renderer";
    property <bool> is-terminal-page:
        root.ifd-page == "terminal" || root.ifd-page == "font"
        || root.ifd-page == "input" || root.ifd-page == "output"
        || root.ifd-page == "session-log";
    property <bool> is-sftp-page:
        root.ifd-page == "sftp" || root.ifd-page == "download"
        || root.ifd-page == "sync";
    property <bool> is-connection-page:
        root.ifd-page == "connection" || root.ifd-page == "webdav";
    property <bool> is-shortcuts-page: root.ifd-page == "shortcuts";
    property <bool> is-agents-page:
        root.ifd-page == "agents" || root.ifd-page == "mcp" || root.ifd-page == "wsl";
    property <bool> is-update-page: root.ifd-page == "update";
    property <bool> is-about-page: root.ifd-page == "about";

    in property <[CustomAgentInfo]> custom-agents;
    in-out property <string> agent-new-name;
    in-out property <string> agent-new-command;
    in-out property <string> agent-new-directory;
    property <string> new-rule-pattern;
    property <bool> new-rule-regex;
    property <bool> new-rule-case-sensitive;
    property <bool> new-rule-whole-line;
    property <string> new-rule-color: "red";
    property <bool> renderer-restart-required;
    property <bool> wp-is-custom:
        root.current-wallpaper != "" && root.current-wallpaper != "builtin:light"
        && root.current-wallpaper != "builtin:dark" && root.current-wallpaper != "builtin:tech"
        && root.current-wallpaper != "builtin:miku" && root.current-wallpaper != "builtin:ms";

    callback set-term-font(string);
    callback set-term-font-size(int);
    callback set-terminal-line-spacing(float);
    callback set-term-font-bold(bool);
    callback set-term-cursor-style(string);
    callback set-output-highlight(bool, string);
    callback set-json-format-output(bool);
    callback add-output-highlight-rule(string, bool, bool, bool, string) -> bool;
    callback remove-output-highlight-rule(int);
    callback set-output-highlight-rule-enabled(int, bool);
    callback set-ui-scale(int);
    callback set-panel-font(int);   // settings-panel font scale, percent
    callback set-renderer-mode(string);
    callback set-sftp-follow-cd(bool);
    callback set-editor-embedded(bool);
    callback set-collapse-sidebar-default(bool);
    callback set-collapse-sftp-default(bool);
    callback set-sync-upload-enabled(bool);
    callback save-webdav-settings(bool, string, string, string, string, bool);
    callback webdav-upload();
    callback webdav-download();
    callback set-download-always-ask(bool);
    callback set-session-log-enabled(bool);
    callback pick-session-log-dir();
    callback reset-session-log-dir();
    callback open-session-log-dir();
    callback set-paste-confirm-enabled(bool);
    callback set-extra-paste-shortcuts-enabled(bool);
    callback set-ssh-keepalive(bool /* enabled */, int /* interval s */, int /* max missed */);
    callback set-zen-mode(bool);
    callback set-welcome-as-sidebar(bool);
    callback set-quick-commands-as-sidebar(bool);
    callback set-update-check-enabled(bool);   // startup new-version check (#184)
    callback set-mcp-permissions(bool, bool, bool, bool);
    callback persist-wallpaper-overlay(float);   // save the overlay opacity
    callback set-wallpaper(string);    // none / builtin selection
    callback pick-wallpaper-file();    // open the OS file dialog (Rust)
    callback add-wsl-profile(string, string, string);
    callback remove-wsl-profile(string);
    callback pick-wsl-directory();
    callback add-custom-agent(string /* name */, string /* command */, string /* directory */);
    callback remove-custom-agent(string /* id */);
    callback pick-agent-directory();

    HorizontalLayout {
        // --- Left nav (ChatGPT Desktop Settings Sidebar) -------------------
        Rectangle {
            width: 204px;
            background: Theme.bg-panel;
            border-bottom-left-radius: 14px;
            Rectangle {
                x: parent.width - 1px; width: 1px; height: parent.height;
                background: Theme.border-subtle;
            }
            nav-scroll := ScrollView {
                width: 100%;
                height: 100%;
                content-width: self.visible-width;
                content-height: max(self.visible-height, nav-items.preferred-height);
                nav-items := VerticalLayout {
                    width: nav-scroll.visible-width;
                    padding: 12px;
                    spacing: 4px;
                    alignment: start;
                NavItem {
                    icon: "sliders"; label: root.lang-en ? "General & Appearance" : "通用与外观";
                    active: root.is-general-page;
                    clicked => { root.ifd-page = "general"; }
                }
                NavItem {
                    icon: "terminal"; label: root.lang-en ? "Terminal" : "终端";
                    active: root.is-terminal-page;
                    clicked => { root.ifd-page = "terminal"; }
                }
                NavItem {
                    icon: "folder"; label: root.lang-en ? "Files & SFTP" : "文件与传输";
                    active: root.is-sftp-page;
                    clicked => { root.ifd-page = "sftp"; }
                }
                NavItem {
                    icon: "globe"; label: root.lang-en ? "Connection & Data" : "连接与数据";
                    active: root.is-connection-page;
                    clicked => { root.ifd-page = "connection"; }
                }
                NavItem {
                    icon: "keyboard"; label: root.lang-en ? "Shortcuts" : "快捷键";
                    active: root.is-shortcuts-page;
                    clicked => { root.ifd-page = "shortcuts"; }
                }
                NavItem {
                    icon: "sparkle"; label: root.lang-en ? "AI & Agents" : "AI 与智能体";
                    active: root.is-agents-page;
                    clicked => { root.ifd-page = "agents"; }
                }
                NavItem {
                    icon: "update"; label: root.lang-en ? "Updates" : "软件更新";
                    active: root.is-update-page;
                    clicked => { root.ifd-page = "update"; }
                }
                NavItem {
                    icon: "info"; label: root.lang-en ? "About" : "关于";
                    active: root.is-about-page;
                    clicked => { root.ifd-page = "about"; }
                }
                }
            }
        }
        // --- Right content (ChatGPT Desktop Settings Main Content) ---------
        Rectangle {
            horizontal-stretch: 1;
            background: transparent;
            border-bottom-right-radius: 14px;

            settings-scroll := ScrollView {
                width: 100%;
                height: 100%;
                content-width: self.visible-width;
                content-height: max(self.visible-height, settings-pages.preferred-height);

                settings-pages := VerticalLayout {
                    width: settings-scroll.visible-width;

            // --- Terminal page (Color Schemes + Font + Input + Output + Session Log) ---
            if root.is-terminal-page : VerticalLayout {
                padding-left: 28px;
                padding-right: 28px;
                padding-top: 20px;
                padding-bottom: 28px;
                spacing: 0;
                alignment: start;

                // ── Terminal Color Scheme Manager (iTerm2-Color-Schemes) ──────
                TerminalSchemeSection {
                    lang-en: root.lang-en;
                    terminal-schemes: root.terminal-schemes;
                    active-terminal-scheme: root.active-terminal-scheme;
                    terminal-scheme-id <=> root.terminal-scheme-id;
                    terminal-scheme-search <=> root.terminal-scheme-search;
                    terminal-scheme-category <=> root.terminal-scheme-category;
                    terminal-schemes-total: root.terminal-schemes-total;
                    terminal-schemes-has-more: root.terminal-schemes-has-more;
                    terminal-scheme-status <=> root.terminal-scheme-status;
                    term-cursor-style: root.term-cursor-style;
                    select-terminal-scheme(id) => { root.select-terminal-scheme(id); }
                    toggle-favorite-terminal-scheme(id) => { root.toggle-favorite-terminal-scheme(id); }
                    filter-terminal-schemes(q, cat) => { root.filter-terminal-schemes(q, cat); }
                    load-more-terminal-schemes => { root.load-more-terminal-schemes(); }
                    reset-terminal-scheme => { root.reset-terminal-scheme(); }
                    import-terminal-scheme => { root.import-terminal-scheme(); }
                    export-terminal-scheme => { root.export-terminal-scheme(); }
                    delete-custom-terminal-scheme(id) => { root.delete-custom-terminal-scheme(id); }
                }

                Rectangle { height: 24px; }
                SectionHeader { text: root.lang-en ? "FONT & CURSOR" : "字体与光标"; height: 26px; }
                SettingRow {
                    label: root.lang-en ? "Terminal font" : "终端字体";
                    ComboBox {
                        width: 220px;
                        model: root.term-fonts;
                        current-value: root.term-font-family;
                        selected(v) => { root.set-term-font(v); }
                    }
                }
                SettingRow {
                    label: root.lang-en ? "Terminal font size" : "终端字体大小";
                    Stepper {
                        value: root.term-font-size / 1px; minimum: 8; maximum: 32; step: 1; unit: "px";
                        changed(v) => { root.set-term-font-size(v); }
                    }
                }
                SettingRow {
                    label: root.lang-en ? "Terminal line spacing" : "终端行距";
                    desc: root.lang-en ? "Adjust terminal row height from compact to loose."
                                       : "调整终端行高，可设置得更紧凑或更宽松。";
                    Stepper {
                        value: round(root.terminal-line-spacing * 100);
                        minimum: 80; maximum: 150; step: 5; unit: "%";
                        changed(v) => { root.terminal-line-spacing = v / 100; root.set-terminal-line-spacing(root.terminal-line-spacing); }
                    }
                }
                SettingRow {
                    label: root.lang-en ? "Bold terminal text" : "终端字体加粗";
                    desc: root.lang-en ? "Makes regular terminal output use a bold face."
                                       : "让普通终端输出使用加粗字重。";
                    Switch {
                        on: root.term-font-bold;
                        toggled(v) => { root.term-font-bold = v; root.set-term-font-bold(v); }
                    }
                }
                SettingRow {
                    label: root.lang-en ? "Cursor shape" : "光标类型";
                    desc: root.lang-en ? "Choose the terminal insertion cursor shape. Cursor color follows the active color scheme."
                                       : "选择终端输入光标的形状（光标颜色自动跟随当前终端配色方案）。";
                    show-divider: false;
                    HorizontalLayout {
                        spacing: 5px;
                        CursorStyleButton {
                            label: root.lang-en ? "Block" : "块状";
                            cursor-kind: "block";
                            selected: root.term-cursor-style == "block";
                            clicked => { root.term-cursor-style = "block"; root.set-term-cursor-style("block"); }
                        }
                        CursorStyleButton {
                            label: root.lang-en ? "Bar" : "竖线";
                            cursor-kind: "bar";
                            selected: root.term-cursor-style == "bar";
                            clicked => { root.term-cursor-style = "bar"; root.set-term-cursor-style("bar"); }
                        }
                        CursorStyleButton {
                            label: root.lang-en ? "Line" : "下划线";
                            cursor-kind: "underline";
                            selected: root.term-cursor-style == "underline";
                            clicked => { root.term-cursor-style = "underline"; root.set-term-cursor-style("underline"); }
                        }
                    }
                }

                Rectangle { height: 24px; }
                SectionHeader { text: root.lang-en ? "INPUT & PASTE" : "输入与粘贴"; height: 26px; }
                SettingRow {
                    label: root.lang-en ? "Confirm multiline paste" : "确认多行粘贴";
                    desc: root.lang-en ? "Show a review dialog before sending multiline content."
                                       : "发送多行内容前显示预览确认窗口。";
                    Switch {
                        on: root.paste-confirm-enabled;
                        toggled(v) => { root.paste-confirm-enabled = v; root.set-paste-confirm-enabled(v); }
                    }
                }
                SettingRow {
                    label: root.lang-en ? "Additional paste shortcuts" : "额外粘贴快捷键";
                    desc: root.lang-en ? "Enable Ctrl+Alt+V, Shift+Insert, and middle-click paste."
                                       : "启用 Ctrl+Alt+V、Shift+Insert 和鼠标中键粘贴。";
                    show-divider: false;
                    Switch {
                        on: root.extra-paste-shortcuts-enabled;
                        toggled(v) => { root.extra-paste-shortcuts-enabled = v; root.set-extra-paste-shortcuts-enabled(v); }
                    }
                }

                Rectangle { height: 24px; }
                SectionHeader { text: root.lang-en ? "OUTPUT HIGHLIGHTING" : "输出高亮与 JSON"; height: 26px; }
                SettingRow {
                    label: root.lang-en ? "Highlight plain terminal output" : "高亮纯文本终端输出";
                    desc: root.lang-en
                        ? "Adds client-side colours only when the program did not provide ANSI styling."
                        : "仅在程序未提供 ANSI 样式时由客户端补充颜色。";
                    Switch {
                        on: root.output-highlight-enabled;
                        toggled(v) => {
                            root.output-highlight-enabled = v;
                            root.set-output-highlight(v, root.output-highlight-preset);
                        }
                    }
                }
                SettingRow {
                    label: root.lang-en ? "Built-in rule set" : "内置规则集";
                    desc: root.lang-en
                        ? "Log levels is conservative; DevOps also recognises deployment and health states."
                        : "日志级别更保守；DevOps 还识别部署与健康状态。";
                    ComboBox {
                        width: 190px;
                        enabled: root.output-highlight-enabled;
                        model: [root.lang-en ? "Log levels" : "日志级别", "DevOps"];
                        current-value: root.output-highlight-preset == "devops"
                            ? "DevOps"
                            : (root.lang-en ? "Log levels" : "日志级别");
                        selected(v) => {
                            root.output-highlight-preset = v == "DevOps" ? "devops" : "log";
                            root.set-output-highlight(
                                root.output-highlight-enabled,
                                root.output-highlight-preset);
                        }
                    }
                }

                SettingRow {
                    label: root.lang-en ? "Format and colour JSON lines" : "格式化并着色 JSON 行";
                    desc: root.lang-en
                        ? "Pretty-prints only complete JSON objects or arrays that occupy a whole terminal line. Other output is unchanged."
                        : "仅美化占据完整一行且可正确解析的 JSON 对象或数组，其他终端输出保持原样。";
                    show-divider: false;
                    Switch {
                        on: root.json-format-output;
                        toggled(v) => {
                            root.json-format-output = v;
                            root.set-json-format-output(v);
                        }
                    }
                }

                Rectangle { height: 14px; }
                SectionHeader { text: root.lang-en ? "CUSTOM HIGHLIGHT RULES" : "自定义高亮规则"; height: 22px; }
                Text {
                    text: root.lang-en
                        ? "Custom rules run before the built-in preset and never overwrite ANSI colours."
                        : "自定义规则优先于内置规则，且不会覆盖程序输出的 ANSI 颜色。";
                    color: Theme.text-muted;
                    font-size: 12px * Theme.panel-font;
                    wrap: word-wrap;
                }
                Rectangle { height: 10px; }
                LabeledInput {
                    label: root.lang-en ? "Keyword or regular expression" : "关键词或正则表达式";
                    placeholder: root.new-rule-regex ? "timeout|connection refused" : "connection refused";
                    value <=> root.new-rule-pattern;
                    accepted => {
                        if root.add-output-highlight-rule(
                            root.new-rule-pattern, root.new-rule-regex,
                            root.new-rule-case-sensitive, root.new-rule-whole-line,
                            root.new-rule-color) {
                            root.new-rule-pattern = "";
                        }
                    }
                }
                Rectangle { height: 8px; }
                HorizontalLayout {
                    spacing: 8px;
                    ComboBox {
                        width: 130px;
                        model: [root.lang-en ? "Keyword" : "关键词", root.lang-en ? "Regex" : "正则"];
                        current-value: root.new-rule-regex
                            ? (root.lang-en ? "Regex" : "正则")
                            : (root.lang-en ? "Keyword" : "关键词");
                        selected(v) => {
                            root.new-rule-regex = v == "Regex" || v == "正则";
                        }
                    }
                    ComboBox {
                        width: 120px;
                        model: ["Red", "Yellow", "Green", "Cyan", "Magenta", "Gray"];
                        current-value: root.new-rule-color == "yellow" ? "Yellow"
                            : root.new-rule-color == "green" ? "Green"
                            : root.new-rule-color == "cyan" ? "Cyan"
                            : root.new-rule-color == "magenta" ? "Magenta"
                            : root.new-rule-color == "gray" ? "Gray" : "Red";
                        selected(v) => {
                            root.new-rule-color = v == "Yellow" ? "yellow"
                                : v == "Green" ? "green"
                                : v == "Cyan" ? "cyan"
                                : v == "Magenta" ? "magenta"
                                : v == "Gray" ? "gray" : "red";
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    PrimaryButton {
                        text: root.lang-en ? "Add rule" : "添加规则";
                        disabled: root.new-rule-pattern == "";
                        clicked => {
                            if root.add-output-highlight-rule(
                                root.new-rule-pattern, root.new-rule-regex,
                                root.new-rule-case-sensitive, root.new-rule-whole-line,
                                root.new-rule-color) {
                                root.new-rule-pattern = "";
                            }
                        }
                    }
                }
                SettingRow {
                    label: root.lang-en ? "Case sensitive" : "区分大小写";
                    Switch {
                        on: root.new-rule-case-sensitive;
                        toggled(v) => { root.new-rule-case-sensitive = v; }
                    }
                }
                SettingRow {
                    label: root.lang-en ? "Highlight whole line" : "高亮整行";
                    desc: root.lang-en
                        ? "Otherwise only matching text is coloured."
                        : "关闭时仅高亮匹配到的文字。";
                    show-divider: false;
                    Switch {
                        on: root.new-rule-whole-line;
                        toggled(v) => { root.new-rule-whole-line = v; }
                    }
                }
                if root.output-highlight-rule-status != "" : Text {
                    text: root.output-highlight-rule-status;
                    color: Theme.danger;
                    font-size: 12px * Theme.panel-font;
                    wrap: word-wrap;
                }

                for rule[index] in root.output-highlight-rules : Rectangle {
                    height: 44px;
                    Rectangle { y: 0px; width: 100%; height: 1px; background: Theme.border-subtle; }
                    HorizontalLayout {
                        spacing: 9px;
                        Rectangle {
                            width: 8px;
                            height: 8px;
                            border-radius: 4px;
                            background: rule.color == "yellow" ? Theme.warning
                                : rule.color == "green" ? Theme.success
                                : rule.color == "cyan" ? Theme.accent
                                : rule.color == "magenta" ? #d670d6
                                : rule.color == "gray" ? Theme.text-muted
                                : Theme.danger;
                            vertical-stretch: 0;
                        }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            spacing: 2px;
                            Text {
                                text: rule.pattern;
                                color: rule.enabled ? Theme.text-primary : Theme.text-muted;
                                font-family: Theme.term-font-family;
                                font-size: 12px * Theme.panel-font;
                                overflow: elide;
                            }
                            Text {
                                text: (rule.regex ? "Regex" : (root.lang-en ? "Keyword" : "关键词"))
                                    + (rule.case-sensitive ? " · Aa" : "")
                                    + (rule.whole-line ? (root.lang-en ? " · whole line" : " · 整行") : "");
                                color: Theme.text-muted;
                                font-size: 11px * Theme.panel-font;
                            }
                        }
                        Switch {
                            on: rule.enabled;
                            toggled(v) => { root.set-output-highlight-rule-enabled(index, v); }
                        }
                        Rectangle {
                            width: 28px;
                            height: 28px;
                            border-radius: 6px;
                            background: delete-ta.has-hover ? Theme.bg-hover : transparent;
                            delete-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.remove-output-highlight-rule(index); }
                            }
                            Text {
                                text: "\u{E872}";
                                font-family: "Material Icons";
                                color: Theme.text-muted;
                                font-size: 16px * Theme.panel-font;
                                width: 100%; height: 100%;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                Rectangle { height: 24px; }
                SectionHeader { text: root.lang-en ? "SESSION LOG" : "会话日志"; height: 26px; }
                SettingRow {
                    label: root.lang-en ? "Record session logs" : "记录会话日志";
                    desc: root.lang-en
                        ? "Save each new terminal tab's output as timestamped plain text. Keystrokes are not recorded."
                        : "将每个新终端标签页的输出保存为带时间戳的纯文本，不记录按键与隐藏密码。";
                    Switch {
                        on: root.session-log-enabled;
                        toggled(v) => { root.session-log-enabled = v; root.set-session-log-enabled(v); }
                    }
                }
                SettingRow {
                    label: root.lang-en ? "Log folder" : "日志目录";
                    desc: root.session-log-dir;
                    show-divider: false;
                    HorizontalLayout {
                        spacing: 6px;
                        if root.session-log-dir-custom : GhostButton {
                            text: root.lang-en ? "Default" : "恢复默认";
                            clicked => { root.reset-session-log-dir(); }
                        }
                        GhostButton {
                            text: root.lang-en ? "Change…" : "更改…";
                            clicked => { root.pick-session-log-dir(); }
                        }
                        GhostButton {
                            text: root.lang-en ? "Open" : "打开";
                            clicked => { root.open-session-log-dir(); }
                        }
                    }
                }
            }

            // --- General & Appearance page ------------------------------
            if root.is-general-page : GeneralSettingsPage {
                lang-en: root.lang-en;
                dark-mode: root.dark-mode;
                ui-scale: root.ui-scale;
                color-themes: root.color-themes;
                color-theme: root.color-theme;
                color-theme-custom <=> root.color-theme-custom;
                zen-mode <=> root.zen-mode;
                welcome-as-sidebar <=> root.welcome-as-sidebar;
                collapse-sidebar-default <=> root.collapse-sidebar-default;
                collapse-sftp-default <=> root.collapse-sftp-default;
                quick-commands-as-sidebar <=> root.quick-commands-as-sidebar;
                current-wallpaper: root.current-wallpaper;
                custom-wallpaper-name: root.custom-wallpaper-name;
                wp-is-custom: root.wp-is-custom;
                immersive-colors: root.immersive-colors;
                wallpaper-overlay <=> root.wallpaper-overlay;
                renderer-mode <=> root.renderer-mode;
                renderer-restart-required <=> root.renderer-restart-required;
                set-dark-mode(v) => { root.set-dark-mode(v); }
                toggle-language => { root.toggle-language(); }
                set-ui-scale(v) => { root.set-ui-scale(v); }
                set-panel-font(v) => { root.set-panel-font(v); }
                set-color-theme(id) => { root.set-color-theme(id); }
                set-color-theme-custom(hex) => { return root.set-color-theme-custom(hex); }
                set-zen-mode(v) => { root.set-zen-mode(v); }
                set-welcome-as-sidebar(v) => { root.set-welcome-as-sidebar(v); }
                set-collapse-sidebar-default(v) => { root.set-collapse-sidebar-default(v); }
                set-collapse-sftp-default(v) => { root.set-collapse-sftp-default(v); }
                set-quick-commands-as-sidebar(v) => { root.set-quick-commands-as-sidebar(v); }
                set-wallpaper(id) => { root.set-wallpaper(id); }
                pick-wallpaper-file => { root.pick-wallpaper-file(); }
                set-immersive-colors(v) => { root.set-immersive-colors(v); }
                persist-wallpaper-overlay(v) => { root.persist-wallpaper-overlay(v); }
                set-renderer-mode(v) => { root.set-renderer-mode(v); }
            }

            // --- Connection & Data page (Keepalive + Import/Export + WebDAV) ---
            if root.is-connection-page : ConnectionSettingsPage {
                lang-en: root.lang-en;
                ssh-keepalive-enabled <=> root.ssh-keepalive-enabled;
                ssh-keepalive-interval <=> root.ssh-keepalive-interval;
                ssh-keepalive-max <=> root.ssh-keepalive-max;
                webdav-enabled <=> root.webdav-enabled;
                webdav-url <=> root.webdav-url;
                webdav-username <=> root.webdav-username;
                webdav-password <=> root.webdav-password;
                webdav-remote-path <=> root.webdav-remote-path;
                webdav-accept-invalid-certs <=> root.webdav-accept-invalid-certs;
                webdav-status <=> root.webdav-status;
                set-ssh-keepalive(en, iv, mx) => { root.set-ssh-keepalive(en, iv, mx); }
                import-ssh-config => { root.import-ssh-config(); }
                open-batch-import => { root.open-batch-import(); }
                import-connections => { root.import-connections(); }
                export-connections => { root.export-connections(); }
                save-webdav-settings(en, u, usr, pwd, rp, ic) => { root.save-webdav-settings(en, u, usr, pwd, rp, ic); }
                webdav-download => { root.webdav-download(); }
                webdav-upload => { root.webdav-upload(); }
            }

            // --- Files & SFTP page (SFTP + Download + Multi-session Sync) ---
            if root.is-sftp-page : SftpSettingsPage {
                lang-en: root.lang-en;
                sftp-follow-cd <=> root.sftp-follow-cd;
                editor-embedded <=> root.editor-embedded;
                download-dir: root.download-dir;
                download-always-ask <=> root.download-always-ask;
                sync-upload-enabled <=> root.sync-upload-enabled;
                set-sftp-follow-cd(v) => { root.set-sftp-follow-cd(v); }
                set-editor-embedded(v) => { root.set-editor-embedded(v); }
                pick-download-dir => { root.pick-download-dir(); }
                open-download-dir => { root.open-download-dir(); }
                set-download-always-ask(v) => { root.set-download-always-ask(v); }
                set-sync-upload-enabled(v) => { root.set-sync-upload-enabled(v); }
            }

            // --- Keyboard Shortcuts page -------------------------------
            if root.is-shortcuts-page : sc-scope := FocusScope {
                width: 100%;
                focus-on-click: false;
                key-pressed(ev) => {
                    if (root.shortcut-recording != "") {
                        root.shortcut-record(root.shortcut-recording, ev.text,
                            ev.modifiers.control, ev.modifiers.meta,
                            ev.modifiers.alt, ev.modifiers.shift);
                        return accept;
                    }
                    reject
                }
                VerticalLayout {
                    padding-left: 28px;
                    padding-right: 28px;
                    padding-top: 20px;
                    padding-bottom: 28px;
                    spacing: 0;
                    alignment: start;

                    HorizontalLayout {
                        alignment: space-between;
                        height: 32px;
                        SectionHeader {
                            text: root.lang-en ? "KEYBOARD SHORTCUTS" : "键盘快捷键";
                            height: 32px;
                        }
                        GhostButton {
                            text: root.lang-en ? "Reset all" : "全部恢复默认";
                            clicked => {
                                root.shortcut-recording = "";
                                root.shortcut-status = "";
                                root.shortcut-reset-all();
                            }
                        }
                    }
                    Text {
                        text: root.shortcut-status != ""
                            ? root.shortcut-status
                            : (root.lang-en
                                ? "Click a shortcut badge, then press the new key combination (Esc to cancel)."
                                : "点击右侧快捷键徽章后直接按下新的组合键即可修改（按 Esc 取消）。");
                        color: root.shortcut-status != ""
                            ? (root.shortcut-status-error ? Theme.danger : Theme.accent)
                            : Theme.text-muted;
                        font-size: 12px * Theme.panel-font;
                        height: 28px;
                        vertical-alignment: center;
                    }
                    Rectangle { height: 6px; }

                    for item[idx] in root.shortcut-bindings : VerticalLayout {
                        spacing: 0;
                        if item.header != "" && idx > 0 : Rectangle { height: 14px; }
                        if item.header != "" : SectionHeader {
                            text: item.header;
                            height: 24px;
                        }
                        Rectangle {
                            height: 44px;
                            Rectangle {
                                y: parent.height - 1px;
                                width: 100%;
                                height: 1px;
                                background: Theme.border-subtle;
                            }
                            HorizontalLayout {
                                padding-top: 6px;
                                padding-bottom: 6px;
                                spacing: 10px;
                                Text {
                                    text: item.desc;
                                    color: Theme.text-primary;
                                    font-size: 14px * Theme.panel-font;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }
                                Rectangle {
                                    property <bool> rec: root.shortcut-recording == item.id;
                                    width: 156px;
                                    height: 30px;
                                    border-radius: 6px;
                                    background: self.rec ? Theme.bg-active
                                              : key-ta.has-hover ? Theme.bg-hover : Theme.bg-panel;
                                    border-width: 1px;
                                    border-color: self.rec ? Theme.accent : Theme.border-subtle;
                                    key-ta := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.shortcut-status = "";
                                            root.shortcut-recording = parent.rec ? "" : item.id;
                                            sc-scope.focus();
                                        }
                                    }
                                    Text {
                                        text: parent.rec
                                            ? (root.lang-en ? "Press keys…" : "请按键…")
                                            : item.keys;
                                        color: parent.rec ? Theme.accent : Theme.text-primary;
                                        font-family: Theme.ui-font-family;
                                        font-size: 12px * Theme.panel-font;
                                        font-weight: 500;
                                        width: 100%;
                                        height: 100%;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                                Rectangle {
                                    width: 48px;
                                    height: 30px;
                                    border-radius: 6px;
                                    background: !item.is-default
                                        ? (rst-ta.has-hover ? Theme.bg-hover : transparent)
                                        : transparent;
                                    rst-ta := TouchArea {
                                        enabled: !item.is-default;
                                        mouse-cursor: !item.is-default ? pointer : default;
                                        clicked => {
                                            root.shortcut-recording = "";
                                            root.shortcut-status = "";
                                            root.shortcut-reset(item.id);
                                        }
                                    }
                                    Text {
                                        text: !item.is-default ? (root.lang-en ? "Reset" : "重置") : "";
                                        color: Theme.text-secondary;
                                        font-size: 12px * Theme.panel-font;
                                        width: 100%;
                                        height: 100%;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // --- AI & Agents page (AI Agents + MCP + WSL on Windows) ---
            if root.is-agents-page : AgentsSettingsPage {
                lang-en: root.lang-en;
                is-windows: root.is-windows;
                custom-agents: root.custom-agents;
                agent-new-name <=> root.agent-new-name;
                agent-new-command <=> root.agent-new-command;
                agent-new-directory <=> root.agent-new-directory;
                mcp-enabled <=> root.mcp-enabled;
                mcp-use-saved-credentials <=> root.mcp-use-saved-credentials;
                mcp-allow-commands <=> root.mcp-allow-commands;
                mcp-allow-file-transfers <=> root.mcp-allow-file-transfers;
                mcp-config-json: root.mcp-config-json;
                mcp-json-copied <=> root.mcp-json-copied;
                wsl-profiles: root.wsl-profiles;
                wsl-new-name <=> root.wsl-new-name;
                wsl-new-distribution <=> root.wsl-new-distribution;
                wsl-new-directory <=> root.wsl-new-directory;
                pick-agent-directory => { root.pick-agent-directory(); }
                add-custom-agent(n, c, d) => { root.add-custom-agent(n, c, d); }
                remove-custom-agent(id) => { root.remove-custom-agent(id); }
                set-mcp-permissions(en, cred, cmd, ft) => { root.set-mcp-permissions(en, cred, cmd, ft); }
                copy-text(s) => { root.copy-text(s); }
                pick-wsl-directory => { root.pick-wsl-directory(); }
                add-wsl-profile(n, dist, dir) => { root.add-wsl-profile(n, dist, dir); }
                remove-wsl-profile(id) => { root.remove-wsl-profile(id); }
            }

            // --- Updates page ------------------------------------------
            if root.is-update-page : UpdatesSettingsPage {
                lang-en: root.lang-en;
                update-check-enabled <=> root.update-check-enabled;
                update-version: root.update-version;
                update-busy: root.update-busy;
                update-error: root.update-error;
                update-install-supported: root.update-install-supported;
                update-via-terminal: root.update-via-terminal;
                update-status: root.update-status;
                update-action-label: root.update-action-label;
                update-mirrors: root.update-mirrors;
                update-mirrors-testing: root.update-mirrors-testing;
                update-china-tz: root.update-china-tz;
                update-mirror-error: root.update-mirror-error;
                update-mirror-auto: root.update-mirror-auto;
                new-mirror <=> root.new-mirror;
                set-update-check-enabled(v) => { root.set-update-check-enabled(v); }
                check-for-updates => { root.check-for-updates(); }
                update-action => { root.update-action(); }
                open-update-url => { root.open-update-url(); }
                test-update-mirrors => { root.test-update-mirrors(); }
                set-update-mirror-auto(v) => { root.set-update-mirror-auto(v); }
                select-update-mirror(k) => { root.select-update-mirror(k); }
                remove-update-mirror(u) => { root.remove-update-mirror(u); }
                add-update-mirror(u) => { root.add-update-mirror(u); }
                reset-update-mirrors => { root.reset-update-mirrors(); }
            }

            // --- About page --------------------------------------------
            if root.is-about-page : AboutSettingsPage {
                lang-en: root.lang-en;
                app-version: root.app-version;
                open-repo => { root.open-repo(); }
            }

                }
            }
        }
    }
}
